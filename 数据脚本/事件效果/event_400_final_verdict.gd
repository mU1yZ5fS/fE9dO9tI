## 就在恩里科·贝林格葬礼举行前夕，《人民日报》发表了题为《别了，赫鲁晓夫们》的系列文章。效法彼时的《九评苏联共产党》模式，系统性揭露了意大利共产党是如何偏离社会主义革命正道，最终蜕变为现代修正主义马前卒的：早在20世纪30年代，资深社会法西斯主义者兼资产阶级民主主义的马前卒帕尔米罗·陶里亚蒂便借助意大利步入法西斯独裁时代的乱局打入意共最高领导层，趁机夺取了该党权力。为了实现加入政府，混得俸禄的所谓“政治理想”，陶里亚蒂公然同共产国际的人民阵线政策唱反调，并炮制了“共产党代表法西斯”的反革命黑货，以此向贝尼托·墨索里尼献媚。而当墨索里尼政权选择拒绝陶里亚蒂的马屁后。陶里亚蒂又开始打着反法西斯主义的旗号兜售“萨莱诺转向”这一投降主义纲领，以此将自身同亲法西斯主义军官，军国主义老贵族彼得罗·巴多格里奥并列。更在民族解放委员会中出卖诚实的共产党员以换取自己就任司法部长一职，还将应当清算的法西斯匪帮们系数以大赦之名放虎归山——间接促成了黑司令部意大利社会运动的诞生。所有的一切都导致意大利战后工人革命的大好局势被白白葬送。而意共也在此期间彻底蜕化为代表资产阶级利益的伪工人政党。目前大出风头的贝林格之流正是继承了陶里亚蒂修正主义路线衣钵的丑角，并竭尽所能分裂国际共产主义运动，梦想成为又一个新沙皇。所幸，历史的风终将消灭这些垃圾，并为此做出公平公正的审判。毕竟，“欧洲共产主义”的失败与意大利修正主义的每况愈下便是最佳证明。这一篇洋洋洒洒的文章得到了反修正主义者们的热烈欢迎，自然巩固了我们自60年代开始便树立的世界革命旗手形象。然而，如此雄文不受到当事国的反对显然是不可能的，意大利政府与“共产党”皆向我们发出了严正抗议。而苏东社会主义阵营也对我们的咄咄逼人态度表示困惑。可那又如何？资本主义的狗——我们只是将你们对国内无产阶级的态度稍稍复制了一遍予以奉还，怎么这时就要谈论什么“死者为大”与“国家尊严”了呢？而在修正主义头子贝林格死后，“共产党”内便因夺权而打得不可开交。最终，这个扮演资产阶级政权伴娘的附庸便因内斗而丧失了最后的利用价值，成了不足一提的存在。

func evaluate(world: WorldState) -> bool:
	if world == null:
		return false
	@warning_ignore("shadowed_variable_base_class")
	var d := world
	if d.size() <= W.I_YEAR:
		return false
	if world.completed_event_ids.has("event_400") or world.completed_event_ids.has("event_401"):
		return false
	if world.completed_event_ids.has("event_556") or world.completed_event_ids.has("event_396"):
		return false
	var italy := world.get_country_by_legacy_index(85)
	if italy == null:
		return false
	if italy.sub_government == GameConstants.SubGovernment.SOCIAL_DEMOCRAT or italy.sub_government == GameConstants.SubGovernment.LEFT_CONSERVATIVE or italy.sub_government == GameConstants.SubGovernment.RENEWAL_SOCIALIST or italy.sub_government == GameConstants.SubGovernment.PRAGMATIST:
		return false
	if not ((d.year >= 1984 and d.month >= 6 and d.day > 10) or (d.year >= 1984 and d.month >= 7) or d.year >= 1985):
		return false
	return italy.sub_government != GameConstants.SubGovernment.CONSTITUTIONAL_AUTHORITARIAN

func prepare(event_def: EventDef, world: WorldState) -> void:
	_bind_world()
	if event_def == null or world == null or event_def.options.size() < 5:
		return
	@warning_ignore("shadowed_variable_base_class")
	var d := world
	var italy := world.get_country_by_legacy_index(85)
	var opt := event_def.options
	if italy != null and italy.influence_china <= 0:
		_disable(opt[0], TXT_OPT0[0])
		_disable(opt[1], TXT_OPT1[0])
		event_def.description = TXT_DESC[0]
	else:
		_enable(opt[0], TXT_OPT0[1])
		_enable(opt[1], TXT_OPT1[1])
		event_def.description = TXT_DESC[1]
	_enable(opt[2], TXT_OPT2[0])
	_enable(opt[3], TXT_OPT3[0])
	if d.size() > W.I_POLITICAL_LINE and d.political_line == 0:
		_enable(opt[4], TXT_OPT4[0])
	else:
		_disable(opt[4], TXT_OPT4[1])

func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var italy := ws.get_country_by_legacy_index(85)
	var opt := int(context.get("option_index", -1))
	if italy != null and italy.influence_china > 0:
		if opt == 0:
			_add(178, 1)
			_add(179, 2)
			_add(W.I_BUDGET, -80)
			context["result_text"] = _fmt(TXT_R[0], ["\n", _fm_name(), ""]) + _funeral_tail()
		elif opt == 1:
			_add(W.I_DIPLO, -10)
			_add(W.I_BUDGET, -80)
			_add_relation(EmpireData.USA, -50)
			_add_relation(EmpireData.USSR, 50)
			_add(181, 2)
			context["result_text"] = _fmt(TXT_R[1], ["\n", _fm_name(), ""]) + _funeral_tail()
		elif opt == 2:
			_add_relation(EmpireData.USA, -10)
			_add_relation(EmpireData.USSR, 50)
			_add(W.I_DIPLO, -10)
			context["result_text"] = _fmt(TXT_R[2], ["\n", _fm_name(), ""]) + _funeral_tail()
		elif opt == 3:
			context["result_text"] = _fmt(TXT_R[3], ["\n", _fm_name(), ""]) + _funeral_tail()
		elif opt == 4:
			_add_relation(EmpireData.USA, 50)
			_add_relation(EmpireData.USSR, -10)
			_add(W.I_DIPLO, 20)
			if italy != null:
				italy.set_tag("对华贸易", false)
			context["result_text"] = _fmt(TXT_R[4], ["\n", _fm_name(), ""]) + _funeral_tail()
		if italy != null and italy.has_tag("soc_eu"):
			_add(180, 1)
			_add(179, 1)
		var num := 0
		for c in ws.countries:
			if c != null and c.has_tag("soc_eu"):
				num += 1
		if num > 4:
			_add(180, 999)
		if italy != null and italy.has_tag("sev"):
			_add(178, 2)
		if italy != null and italy.has_tag("亲苏"):
			_add(178, 2)
		if italy != null and not italy.has_tag("亲苏") and not italy.has_tag("亲中") and not italy.has_tag("亲美"):
			_add(179, 2)
		if italy != null and not italy.has_tag("eu"):
			_add(179, 2)
		if _raw(134) > 0:
			@warning_ignore("integer_division")
			_add(178, int(_raw(134) / 50))
		if italy != null and italy.level_of_development > 60:
			_add(181, 2)
		if italy != null and italy.level_of_development <= 60 and italy.level_of_development >= 20:
			_add(180, 2)
		if italy != null and italy.level_of_development < 20:
			_add(179, 2)
			_add(178, 1)
		if italy != null and italy.sub_government == GameConstants.SubGovernment.EUROCOMMUNIST:
			_add(179, 1)
			_add(180, 1)
		if italy != null and italy.government == GameConstants.Government.LIBERAL:
			_add(181, 2)
		if _raw(147) == 3:
			_add(180, 1)
		if _raw(147) == 6 or _raw(147) == 8:
			_add(179, 1)
		if ws.get_flag("YugAgree") and _mod_active(GameConstants.Modifier.FRENCH_PRESIDENT_MARCHAIS):
			_add(178, 1)
		elif _mod_active(GameConstants.Modifier.FRENCH_PRESIDENT_MARCHAIS):
			_add(180, 1)
		if _mod_active(GameConstants.Modifier.FRENCH_PRESIDENT_MITTERRAND):
			_add(181, 1)
		if ws.empires.size() > 1 and ws.empires[1] != null and (ws.empires[1].current_leader == 2 or ws.empires[1].current_leader == 3):
			_add(178, 1)
		if ws.empires.size() > 1 and ws.empires[1] != null and ws.empires[1].current_leader == 1:
			_add(180, 1)
		if ws.empires.size() > 1 and ws.empires[1] != null and ws.empires[1].current_leader == 7:
			_add(181, 2)
		var c15 := ws.get_country_by_legacy_index(15)
		if c15 != null and c15.government == GameConstants.Government.AUTHORITARIAN:
			_add(178, 1)
		if opt == 4:
			if _raw(180) >= _raw(178) and _raw(180) >= _raw(179) and _raw(180) >= _raw(181):
				if italy != null:
					italy.government = GameConstants.Government.REFORMIST
					italy.sub_government = GameConstants.SubGovernment.EUROCOMMUNIST
					italy.set_tag("亲美", false)
				context["result_text"] += _fmt(TXT_R_APPEND[0], ["\n", _fm_name(), ""])
			elif _raw(181) >= _raw(178) and _raw(181) >= _raw(179) and _raw(181) >= _raw(180):
				if italy != null:
					italy.government = GameConstants.Government.LIBERAL
					italy.sub_government = GameConstants.SubGovernment.SOCIAL_DEMOCRAT
					italy.set_tag("亲美", false)
				context["result_text"] += _fmt(TXT_R_APPEND[1], ["\n", _fm_name(), ""])
			elif _raw(179) >= _raw(178) and _raw(179) >= _raw(181) and _raw(179) >= _raw(180):
				if italy != null:
					italy.government = GameConstants.Government.REFORMIST
					italy.sub_government = GameConstants.SubGovernment.DEMOCRATIC_SOCIALIST
					italy.set_tag("亲美", false)
					italy.set_tag("nato", false)
					italy.set_tag("eu", false)
				context["result_text"] += _fmt(TXT_R_APPEND[2], ["\n", _fm_name(), ""])
			else:
				if italy != null:
					italy.government = GameConstants.Government.LIBERAL
					italy.sub_government = GameConstants.SubGovernment.SOCIAL_DEMOCRAT
					italy.set_tag("亲美", false)
				context["result_text"] += _fmt(TXT_R_APPEND[3], ["\n", _fm_name(), ""])
		else:
			if _raw(179) >= _raw(178) and _raw(179) >= _raw(181) and _raw(179) >= _raw(180):
				if italy != null:
					italy.government = GameConstants.Government.REFORMIST
					italy.sub_government = GameConstants.SubGovernment.DEMOCRATIC_SOCIALIST
					italy.set_tag("亲美", false)
					italy.set_tag("nato", false)
					italy.set_tag("eu", false)
				context["result_text"] += _fmt(TXT_R_APPEND[4], ["\n", _fm_name(), ""])
			else:
				if italy != null:
					italy.government = GameConstants.Government.SOCIALIST
					italy.sub_government = GameConstants.SubGovernment.SOVIET_STYLE
					italy.set_tag("亲美", false)
					italy.set_tag("nato", false)
					italy.set_tag("eu", false)
				context["result_text"] += _fmt(TXT_R_APPEND[5], ["\n", _fm_name(), ""])
	else:
		if opt == 2:
			_add_relation(EmpireData.USA, -10)
			_add_relation(EmpireData.USSR, 50)
			_add(W.I_DIPLO, -10)
			context["result_text"] = _fmt(TXT_R[5], ["\n", _fm_name(), ""]) + _funeral_tail()
		elif opt == 3:
			context["result_text"] = _fmt(TXT_R[6], ["\n", _fm_name(), ""]) + _funeral_tail()
		elif opt == 4:
			_add_relation(EmpireData.USA, 50)
			_add_relation(EmpireData.USSR, -10)
			_add(W.I_DIPLO, 20)
			context["result_text"] = _fmt(TXT_R[7], ["\n", _fm_name(), ""]) + _funeral_tail()

func _raw(i: int) -> int:
	if d.size() > i:
		return d.get_data_by_index(i)
	return 0

func _mod_active(i: int) -> bool:
	return i >= 0 and i < ws.modifiers.size() and ws.modifiers[i] != null and ws.modifiers[i].is_active

func _fm_name() -> String:
	if ws != null and ws.politics_positions.size() > 2:
		var pi := ws.politics_positions[2]
		if pi >= 0 and ws.politicians.size() > pi and ws.politicians[pi] != null:
			var p := ws.politicians[pi]
			if p.name_display != "":
				return p.name_display
	return "黄华"

func _funeral_tail() -> String:
	return TXT_R_APPEND[6]



