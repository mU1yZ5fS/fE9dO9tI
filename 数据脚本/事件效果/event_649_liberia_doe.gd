extends "res://数据脚本/event_script_base.gd"

## 原作 Event649.cs：从应许之地到应许之地（利比里亚多伊政变，二选项）。
## 触发：TimeScript.cs:11013-11019 —— 日>=12 且 月>=4 且 年>=1980
##   （或 月>=5 年>=1980 / 年>=1981）。
## 差异：Vyshi→亲美；c67=利比里亚。




const TXT_R0 := "我们的外交使团很快便带着贺电与数份有利可图的经济合同抵达蒙罗维亚，热烈祝贺“人民救赎委员会”为清算殖民主义余毒所作的努力，并表达了我方的合作意愿。多伊对此则欣然接受，旋即则迅速开始在全国建立“统治”——多伊以一场处刑前政府官员的全国电视直播拉开了利比里亚新时代的序幕，随后则是以引入军管为名暂停法律，事实上为对反对者实行大规模法外处决的迫害方式开了绿灯。接下来则又是曾在扎伊尔发生的原汁原味：本土信仰伏都教得以在多伊的亲自过问下登堂入室，多伊的土生克兰族同伴们也纷纷鸡犬升天，成为了新时代的征服者民族。粗糙而无效的政府改组与清洗狂潮使利比里亚就此向着非洲典型的盗贼政权一路狂奔，以至于我们的外交队伍都能获得些意外收获：由于新政府对管理国家方面一窍不通，其大多数对外经济事务事实上被外包给了其国际合作伙伴。其中赚得最盆满钵满的自然还是美国：多伊为当地美军活动大开绿灯、放松投资门槛，以及保持亲美外交态度等做法正中华盛顿下怀，让美国与“自由世界”纷纷这位“士官长”献上各类殷勤并投送大量援助……看起来我们算是又踩了个泥坑，可考虑到多伊政权终归不是类似南非那般的“国际孤儿”。至少我们现在仍能保持相安无事。至于利比里亚本身，事情可不会如此轻易就结束……"

const TXT_R1 := "我们无视了这种在非洲地区基本可说是常态的儿戏式政变，并决定将重心放在别处。根据国际组织的信息，我们应当庆幸自己没能涉足，并成为血腥暴君的帮凶：多伊以一场处刑前政府官员的全国电视直播拉开了利比里亚新时代的序幕，随后则是以引入军管为名暂停法律，事实上为对反对者实行大规模法外处决的迫害方式开了绿灯。接下来则又是曾在扎伊尔发生的原汁原味：本土信仰伏都教得以在多伊的亲自过问下登堂入室，多伊的土生克兰族同伴们也纷纷鸡犬升天，成为了新时代的征服者民族。粗糙而无效的政府改组与清洗狂潮使利比里亚就此向着非洲典型的盗贼政权一路狂奔。然而多伊为当地美军活动大开绿灯、放松投资门槛，以及保持亲美外交态度等做法正中华盛顿下怀，让美国与“自由世界”纷纷这位“士官长”献上各类殷勤并投送大量援助……虽说目前的结果看似皆大欢喜，但竭泽而渔式统治绝不会长久。利比里亚的事情可不会如此轻易就结束……"


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var liberia := ws.get_country_by_legacy_index(67)
	if liberia != null:
		liberia.government = 0
		liberia.sub_government = 13
		liberia.set_tag("亲美", true)
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			_add(W.I_BUDGET, 10)
			if liberia != null:
				liberia.set_tag("对华贸易", true)
			context["result_text"] = TXT_R0
		1:
			context["result_text"] = TXT_R1


