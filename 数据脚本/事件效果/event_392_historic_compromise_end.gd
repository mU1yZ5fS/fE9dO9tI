const TXT_R4 := "考虑到主要建制派政党无心在莫罗问题上同武装团体打拉锯战，其中的既得利益者更想抢在其下手前对阿尔多·莫罗宣判政治死刑。那么，为什么不如其所愿呢？毕竟，在对莫罗的突袭事实上已使得建立“民族团结政府”，并在该国主流派别内形成治理共识的计划胎死腹中。且作为该国政治巨头的天主教民主党与意大利共产党均对谈判持消极态度，绝无可能在自己手中达成以“恐怖分子”交换莫罗的交易（事实上背叛1977年内的共识）。那么，为什么不让他们得偿所愿，给这些建制派一场众望所归的“全面内战”呢？为此，我们决定对武装人士们晓之以情，动之以理，为意大利政坛送上更多“惊喜”——\n1978年5月9日注定为历史所铭记：这天，一辆红色雷诺轿车停在了分割天民党与共产党各自总部的马路间，在其后备箱内发现了被机枪扫射的惨不忍睹的阿尔多·莫罗遗体。随后，同莫罗事件类似的绑架-谋杀案，乃至直接了当的恐怖袭击（尤其针对执法人员与主流政党政客）在该国境内遍地开花。而受害者甚至还没法同前总理那般消受“缓冲期”，几乎就在失踪的数小时后便被立即处决——显然那些恐怖主义者们学得很快，几乎是瞬间便悟出了国家恐怖主义的高高在上态度，暴虐行事风格与毫不留情手腕：主张对恐怖运动斩草除根，并作为意大利总统有力候选的乔治·阿门多拉享受了前任法西斯领导人贝尼托·墨索里尼的同款待遇，硕大身躯被整个倒悬在路灯上；绰号“加特林修士”，领导该国宪兵镇压“铅色岁月”内各派武装团体，长期同“红色旅”作对的卡洛·阿尔贝托·德拉·齐爱萨在某次巡视中直接见识到绚烂烟火，死无全尸。就连天民党与共产党的总部大楼都曾遭遇过炸弹袭击，写有“为‘持续斗争’复仇”的威胁信件更是寄到了恩里科·贝林格的桌前。国内越发不可收拾的局势最终促使该国建制派越加同主张铁腕对铁腕，彻底摧毁一切反政府势力的内务部长弗朗切斯科·科西加靠拢，最终事实上完成了对议会等民选机构的自杀并将大权委以安全部门。而后者显然清楚该干什么——接下来就是“智利经验”的二次实战：紧急行政令获得了同公投般主宰一切国务的的强大权力；允许警察“抢先自卫”的《皇家法》被进一步收拢；激进派与左翼政党则遭遇无限期禁令；格杀勿论与押送特别监狱成了全国执法基调。“铅色岁月”至此来到了它的最高潮……恐怖与反恐终于成为了意大利政治本身……"


func prepare(event_def: EventDef, world: WorldState) -> void:
	_bind_world()
	if event_def == null or world == null or event_def.options.size() < 5:
		return
	var r391 := int(world.completed_event_ids.get("event_391", 0))
	var kidnapper: String = TXT_1072 if (r391 == 0 or r391 == 4 or r391 == 2) else TXT_1073
	event_def.description = TXT_DESC_FMT.format(["\n", kidnapper])
	var italy := world.get_country_by_legacy_index(85)
	var opt := event_def.options
	_enable(opt[0], event_def.options[0].text)
	if (r391 == 1 or r391 == 0 or r391 == 2) and _d(134) < 75 and italy != null and italy.level_of_development > 40:  # 原版 data[134]
		var txt: String = TXT_OPT1_LEFT if (r391 == 0 or r391 == 4 or r391 == 2) else TXT_OPT1_RIGHT
		_enable(opt[1], txt)
	else:
		_disable(opt[1], TXT_DIS1)
	_enable(opt[2], event_def.options[2].text)
	_enable(opt[3], event_def.options[3].text)
	if (r391 == 1 or r391 == 0 or r391 == 2) and _d(W.I_DIPLO) >= 900 and _d(134) >= 75 			and italy != null and italy.level_of_development <= 40:  # 原版 data[134]
		_enable(opt[4], event_def.options[4].text)
	else:
		_disable(opt[4], TXT_DIS4)


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var r391 := int(ws.completed_event_ids.get("event_391", 0))
	var left: bool = (r391 == 0 or r391 == 4 or r391 == 2)
	var italy := ws.get_country_by_legacy_index(85)
	var portugal := ws.get_country_by_legacy_index(87)
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			var txt := TXT_R0_HEAD
			if left:
				txt += TXT_R0_LEFT
				_add(172, -2)  # 原版 data[172]
				_add(176, -2)  # 原版 data[176]
				if italy != null and italy.内战中:
					_add(134, -20)  # 原版 data[134]
			else:
				txt += TXT_R0_RIGHT
				_add(175, -2)  # 原版 data[175]
				_add(177, -1)  # 原版 data[177]
			if portugal != null:
				portugal.special -= 5
			context["result_text"] = txt
		1:
			if left:
				context["result_text"] = TXT_R1_LEFT
			else:
				context["result_text"] = TXT_R1_RIGHT
			_add(W.I_AGENTS, -90)
			ws.set_flag("VasilyisGay", true)
			if portugal != null:
				portugal.special += 5
			_add_relation(EmpireData.USSR, 80)
			_add_relation(EmpireData.USA, 80)
		2:
			var txt2 := TXT_R2_HEAD
			if left:
				txt2 += TXT_R2_LEFT
				_add(172, -2)  # 原版 data[172]
				_add(176, -2)  # 原版 data[176]
				if italy != null and italy.内战中:
					_add(134, -20)  # 原版 data[134]
			else:
				txt2 += TXT_R2_RIGHT
				_add(175, -2)  # 原版 data[175]
				_add(177, -1)  # 原版 data[177]
			_add(W.I_DIPLO, 10)
			if portugal != null:
				portugal.special -= 5
			_add_relation(EmpireData.USA, -150)
			_add_power(EmpireData.USA, -15)
			_add_relation(EmpireData.USSR, 50)
			context["result_text"] = txt2
		3:
			var txt3 := TXT_R3_HEAD
			if left:
				txt3 += TXT_R3_LEFT
				_add(172, -2)  # 原版 data[172]
				_add(176, -2)  # 原版 data[176]
				if int(ws.completed_event_ids.get("event_291", 0)) != 4:
					_add(134, -20)  # 原版 data[134]
			else:
				txt3 += TXT_R3_RIGHT
				_add(175, -2)  # 原版 data[175]
				_add(177, -1)  # 原版 data[177]
			_add_relation(EmpireData.USSR, -150)
			_add_power(EmpireData.USSR, -15)
			_add_relation(EmpireData.USA, 50)
			if portugal != null:
				portugal.special -= 5
			context["result_text"] = txt3
		_:
			context["result_text"] = TXT_R4
			_add(134, 20)  # 原版 data[134]
			if italy != null:
				italy.level_of_development -= 10
			_add(W.I_ARMY, -50)
			_add(W.I_AGENTS, -100)
			if italy != null:
				italy.government = GameConstants.Government.AUTHORITARIAN
				italy.sub_government = GameConstants.SubGovernment.CONSTITUTIONAL_AUTHORITARIAN
			if portugal != null:
				portugal.special -= 15




func _d(index: int) -> int:
	if d.size() > index:
		return d[index]
	return 0







