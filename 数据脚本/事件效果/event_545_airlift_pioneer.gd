## 原作 Event545.cs：空运先锋（运输机发展，4选项）。
## 触发：ReqEventsDLC02/ReqEventForDLC02.cs:227-229 ——
##   science[24] && 工业>=1050 && science[16] && 年>=1983。
## 差异：old_modify_desc[50] → ModifierCatalog.get_def(50)。

const TXT_R0 := "我们决定把资金重点投入在军事领域，国务院常务会议原则批准大型运输机项目正式立项，代号072工程。旨在设计一款能承揽中国国内急难运输，还可以进行跨洲际的战略、救援物资投送的大型多用途战略运输机。新式运输机预计比伊尔-76更宽更高，最大载重能力达到66吨，可以载运主战坦克等重装备并具备一定的备战冗余。新式运输机采用涡扇-15新式发动机，总推力可达125kn至160kn，最高速度920公里一小时（425节），实用升限13,000米，最大航程7800km，负载重量66000千克，最大起飞重量220,000千克，总体已达到世界先进水准，甚至在一定程度上超越了我们北方的“朋友”。并且，这是我国第一次在大型运输机上采用喷气式引擎，这对我国的大型航空器建设起到了里程碑的意义。为后续的改装与研发后续型号起到了至关重要的作用。相应的，民用飞机也将会开始改进。对标英国法国联合设计的“协和式客机“属于我们自己的超音速客机项目也已上马，预计在本世纪末将会完成首飞。"
const TXT_R1 := "我们决定把资金着重投入于国内各地枢纽机场的建设，以及完成民用运输机运-10的开发和科研代号ARJ20（全写为“Advanced\u00a0Regional\u00a0Jet”“20世纪新一代支线飞机”）的立项，新型飞机预计在80年代末正式服役。尽管有人指责我们的设计是在抄袭波音707，但总的来讲，党和人民很满意。毕竟新式客机可比从前的螺旋桨飞机稳定多了。这也象征了也许在不久的将来，我们最终会有能力建造属于自己的大型客机，乃至大型运输机，但这都是后话了。"
const TXT_R2 := "我们决定把资金重点投入在军事领域，国务院常务会议原则批准大型运输机项目正式立项，代号072工程。旨在设计一款能承揽中国国内急难运输，还可以进行跨洲际的战略、救援物资投送的大型多用途战略运输机。新式运输机预计比伊尔-76更宽更高，最大载重能力达到66吨，可以载运主战坦克等重装备并具备一定的备战冗余。新式运输机采用涡扇-15新式发动机，总推力可达125kn至160kn，最高速度920公里一小时（425节），实用升限13,000米，最大航程7800km，负载重量66000千克，最大起飞重量220,000千克，总体已达到世界先进水准，甚至在一定程度上超越了我们北方的“朋友”。并且，这是我国第一次在大型运输机上采用喷气式引擎，这对我国的大型航空器建设起到了里程碑的意义。为后续的改装与研发后续型号起到了至关重要的作用。\n同时，我们也决定把资金着重投入于国内各地枢纽机场的建设，以及完成民用运输机运-10的开发和科研代号ARJ20（全写为“Advanced\u00a0Regional\u00a0Jet”“20世纪新一代支线飞机”）的立项，新型飞机预计在80年代末正式服役。尽管有人指责我们的设计是在抄袭波音707，但总的来讲，党和人民很满意。毕竟新式客机可比从前的螺旋桨飞机稳定多了。对标英国法国联合设计的“协和式客机“属于我们自己的超音速客机项目也已上马，预计在本世纪末将会完成首飞。"
const TXT_R3 := "最终我们决定制定一个长期的计划来发展空中力量，而现阶段依旧以购置为主。也许在遥远的将来，中国的航天力量将会远超美帝苏修，但眼下我们依旧需要脚踏实地的扎实基础。至少欧洲人愿意跨过整个大陆向我们出售空中客车A300型客机，用于解决我国航空的燃眉之急。"


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			_add(W.I_PARTY_SUPPORT, 100)
			_add(W.I_PEOPLE_SUPPORT, 100)
			_add(W.I_DIPLO, -50)
			_add(W.I_BUDGET, -100)
			_set_mod50("军用运输机：", "军力+1.0，支援战争消耗的干涉点数-0.2")
			context["result_text"] = TXT_R0
		1:
			_add(W.I_PARTY_SUPPORT, 150)
			_add(W.I_PEOPLE_SUPPORT, 150)
			_add(W.I_DIPLO, 30)
			_add(W.I_BUDGET, -150)
			_set_mod50("民用运输机：", "生活水平+1.0，人民支持度+1.0，思想自由化-0.5")
			context["result_text"] = TXT_R1
		2:
			_add(W.I_PARTY_SUPPORT, 250)
			_add(W.I_PEOPLE_SUPPORT, 250)
			_add(W.I_DIPLO, 50)
			_add(W.I_BUDGET, -250)
			_set_mod50("军用与民用运输机：", "军力+2.0，生活水平+1.5，人民支持度+2.0，思想自由化-1.0，支援战争消耗的干涉点数-0.5")
			context["result_text"] = TXT_R2
		3:
			context["result_text"] = TXT_R3


func _set_mod50(title: String, effect: String) -> void:
	var def := ModifierCatalog.get_def(50)
	if def != null:
		def.name_zh = title
		def.effect_zh = effect
