extends "res://数据脚本/event_script_base.gd"

## 原作 Event668.cs：文学的敌人是政治（文艺政策论战，四选项）。
## 触发：TimeScript.cs:10358-10363 —— data.year>=1979。
## 差异：
##  - 描述与 4 个选项的文案/显隐均按原版 VariantsOfEvents 三段式动态改写
##    （prepare 等价 SetActive(false)；原版另有 result5 空文本死分支，跳过）。
##  - result0/result2 对 old_modify_desc[3]/[7] 的覆盖是修正说明文案，
##    Godot ModifierCatalog 静态维护（modifier_catalog.gd），不在此处改写。

const TXT_DESC_MOD3 := "主席同志，在克服了各路走资派的层层阻挠后，我们成功的将毛主席最伟大的革命遗产延续了下来，中国将继续沿着反对一切修正主义与资本主义的道路前进。\n但在最近，北京发生了一场由知识分子为主体的抗议活动，他们极力的控诉我们十余年来对文艺的整顿与改造政策是“压制言论自由”“有悖人性”的，一部分人拿出毛主席主张的“大鸣大放”政策做背书，但更多人已经在大声呼吁结束无产阶级文化大革命。虽然根据我们的情报部门透露，这场运动极大概率是由党内的反对派故意组织煽动的人造运动，但我们自己也明白，在这场十余年的运动中由于各种原因，我们为贯彻无产阶级文艺路线所用的部分方式是较为片面与死板的，目的是为了在群众思想文化基础较差的情况下更方便的向他们宣传革命理念与降低我们在批判错误思想时的成本，张春桥等同志也曾坦言为面对瞬息变化的革命形式，应在未来对文学等领域进行解冻。\n毫无疑问，这次政治风波不仅仅是一次挑战，更可能是我们的机遇，尽管党内的一些同志建议我们立刻对反革命力量进行打击，但我们更应该利用这难得的机会，一举将因时间而略显沉寂的无产阶级文化大革命推向新阶段。领导人同志，革命战士应在大风大浪中历练，我们可不会被名为“自由”的陈词滥调弄得自乱手脚，告诉他们，我们不仅要应战，还要能打赢。"

const TXT_DESC_GOF3 := "主席同志，在顺利的击败所有可能的反动势力后，伟大的毛泽东主席旨在打倒党内走资派而发动的无产阶级文化大革命终于胜利结束了。\n在这场运动中，我们集中了空前的力量整顿文艺界，拔出了不少意图毒害人民，攻击社会主义政权的大毒草。但不得不承认，我们在运动中确实存在部分打击面过大的问题，最近发生在北京的事件就印证了这一点，大量的知识分子集结起来，要求我们放开压缩过度的舆论空气。领导人同志，十年文化大革命已经胜利了，为了缓和斗争运动带来的紧张氛围，推动社会未来的有序发展，我们是否应该为文人们稍微打开窗户透透气呢？\n但是…党内有大量老同志提醒我们这群秀才很可能居心不良，因为这群白面书生中有相当部分人员都是以前盖棺定论的黑秀才黑手黑帮凶。老同志们要求不能走右倾投降主义的路，并以雷霆手段进行干预，以捍卫“毛主席开辟的正确文艺路线”…无论如何，最终的决定权都在您的身上。"

const TXT_DESC_OTHER := "主席同志，自我们逮捕了万恶的四人帮，终结了那场祸害了中国人民整整十年的可怕动乱后，我们终于渐渐的从过去的阴影里走了出来。如今的人民终于可以摆脱压抑的政治空气可在春风下谈笑风生了…\n而在那场浩劫中，受伤最深的当属我们的知识分子朋友。在文革期间有大量的文艺工作者因为各种各样的理由遭遇迫害，被打为“资本主义文艺黑线”，而他们的作品要么被封杀，要么仅作为地下文学在小部分群体中传播。领导人同志，若我们要决心走出过去的阴影，我们是否应该重新给与他们一些表达自己的自由？相信得以重新提笔的他们一定会对我们表达感激，引导更多群众支持我们未来的政策。当然不得不提醒您，文人们自身的立场情况确实复杂，他们在支持我们解绑的同时，也可能会提出自己的诉求。"

const TXT_R0 := "革命战士在大风浪里炼红心，是时候为我们的革命事业注入新活力了。\n我们决定效仿文章“评新编历史剧《海瑞罢官》”的壮举，用一篇创新的新作品作为引燃运动的火绒。在我们的鼓励下，某地的一位勇敢的革命小将发表了一本特殊的小说《报纸上的鲜血》。该书极其罕见的以青海日报事件为背景，描写了一众造反派小将面对走资派镇压的种种反应，以激烈的言辞抨击了党内走资派镇压革命群众手段之血腥，高调的赞扬了群众的革命精神……这篇小说以与以往完全不同的大胆与较敏感的题材迅速引起了全国的注意，第一轮印刷的成书很快就被抢售一空。之后我们决定乘胜追击，在各大机关报纸上公开赞扬这本小说，以及作为政治上的背书，我们在之后的一场文艺座谈会中，为一部分确实蒙受冤屈的左翼立场文艺工作者平反，重组并恢复了一些艺术家协会的工作。这一强烈信号使全国的知识分子大为震撼，各自持不同立场的文人们立即行动了起来，因为各种原因压抑已久的左派作者们对此欢欣不已，重启了沉寂已久的写作活动，大量描述文化大革命时期红卫兵运动的作品一起涌现出来，其中大部分作品在回忆个人活动与表达拥护运动的同时，还直接攻击了党内的“黑线”（有的甚至对具体的党内成员指名道姓）除此之外，一些以新奇活泼的语言描绘革命给社会带来的新变化的作品与讲述自己参加上山下乡经历的作品也颇受欢迎。我们反客为主的一击让先前还在高呼“言论自由”的秀才们有些蒙圈，但回过神来的他们也开始手忙脚乱的投递自己的作品，借着空前的创作热潮与自由空气浑水摸鱼的抨击革命运动与党的政策，但是由于他们的作品中普遍浓郁的无病呻吟与幽默事例，迎接他们的只有群众的嘲笑与成为革命作家们写作素材，他们大作并没有获得意料中的成功……\n多亏了您的勇气，我们成功的像毛主席说的那样把坏事变成了好事，妙手回春般给文化大革命带来了第二次生命。有意思的是，原先呼吁放开文学政策的改革派们现在正激烈的反对您的新决策……"

const TXT_R1 := "北京的这次事件毫无疑问是对我们目前高压政策的一次警告，毕竟最高尚的革命如果重复上百次，群众也有感到厌恶的一天不是吗……既然我们已经宣布文化大革命已经“胜利结束”，那也是时候将工作转回日常轨道了。\n在您的授意下，中共中央正式决定为主管文艺工作的中宣部和文化部平反并建立文联筹备组，在接下来的中国文学艺术界联合会第三届全国委员会第三次扩大会议中，党宣布恢复各艺术协会的日常工作。由此，我国的文艺政策得到了一定程度的放开，一些在文化大革命中受到冲击的文学研究工作恢复正常，部分沦为地下文学的作品也得以被摆上台面，受中苏论战影响的一些苏联文学作品也一并回归到年轻人的书桌上。总体来看，我国的文学状况大致回到了十七年文学时期的状态，“山药蛋”与“干预生活”齐飞，“人道主义”与“虚假浪漫”共舞……大部分的文学工作者为此松了一口气。\n但在此期间，有部分学者朋友似乎对政策有些误解，开始在他们的文章中攻击文化大革命的历史，丑化社会主义制度，甚至用恶毒的语言攻击人民领袖毛泽东主席，这些言论显然不在言论自由的范畴，为此党内一致决定对这类作品不予出版，并对这些诽谤者进行严重警告。几个月后，《人民日报》引用刊登了《广州日报》发表的文章《向前看啊！文艺》再次提醒作家应该“拥护并宣传积极的价值观”部分学者对我们的表里不一感到沮丧，但没办法，这都是我们必须要做的，毕竟只有坚持毛主席所定下的既定方针才是我国稳定发展的保证。"

const TXT_R2 := "江青反革命集团已经覆灭，尤其炮制的“文化大革命”及其极左路线也应当一同被扫进历史的垃圾桶。文学界毫无疑问需要一场彻底的整顿。\n在“双百”方针得以重新确立，并在三报编委会联席会议公开否定“文艺黑线”存在的基础之上，我们彻底结束了文革路线对文艺界的摧残。1979年初，全国文艺界落实知识分子政策座谈会在北京召开，会议发出的《联合通知》要求按照实事求是、有错必纠的原则，加快对文艺界冤假错案的平反工作，有关周恩来前总理促进文艺民主的座谈会讲话也被要求全党重新学习。由此大量在文革中惨遭迫害的学者得到平反并重新开始工作，被冲击的中宣部文化部与各大文艺组织也重新开始工作。这意味着我们正式宣布放开过去对文艺的过度管控，知识分子们对此十分满意，在经历了长达十年的黑暗后，他们终于有机会抒发自己内心的苦闷了。不久后，由作者卢新华所著的短篇小说《伤痕》正式出版，小说讲述了女主角王晓华因为痛恨“叛徒”、“特务”的妈妈，决心离家去偏僻的农村生活。九年中，她一直处于矛盾和痛苦的纠结中，后来得知母亲平反，急忙赶回家中后却发现母亲因病离世的悲情故事。该小说引发了巨大的轰动，促使了许多作家以相似题材进行创作，有学者也将这种反映文革时期悲惨遭遇的作品称为“伤痕文学”。\n文学界迎来的春风为我们接下来要进行的改革提供免费的宣传，越来越多群众对我们的政策表示欢迎。但随着改革呼声同时而来的还有日渐增多的对我党执政合法性的质疑，在这些作品中不乏对我党整体的批评指责，部分作品甚至含沙射影的攻击我国的共产主义路线，暗示前任领袖毛泽东为“封建暴君”…之后，《广州日报》发表了文章《向前看啊！文艺》认为“伤痕文学”是“向后看”的文艺，而《河北文艺》则发表了文章《“歌德”与“缺德”》，认为文艺工作者应“歌德”—歌颂党、国家和社会主义，而不是“缺德”—专门揭露“阴暗面”，一股愤怒与不安的气氛似乎正在弥漫全党，一些老同志甚至开始将我们的决策与赫鲁晓夫做比较……"

const TXT_R3 := "得了吧！这些起来闹事的知识分子有多少是被中央盖棺定论的现行反革命，我们现正在是引领人民走向光明未来的关键时刻，哪轮得到这些闲着没事干的臭老九上桌吃饭，对于这种无药可救的寄生虫，必须予以人民专政的铁拳彻底完全的批倒批臭！\n在您震耳欲聋的疾呼声中，对于堕落分子的怒火燃遍了全党，新的一轮针对知识分子的大批大斗开始了。因您的号召下，警务机器倾巢出动，同时一大批本早已回归日常生活的“革命小将”再次穿上了尘封已久的65式军装投入到这场“最后革命”之中。一场激烈的警民联合行动后，大量反动作品被收缴，涉及数量远远超越了十年文革。为了彻底踏碎反动派的脊梁，您精心设计了一场“仪式”，那些被收缴的图书被集中到天安门广场与毛主席纪念馆前，在您慷慨激昂的发表完一场庆祝中国人民“战胜腐化的堕落文艺”的讲话后，小将们一边狂热的呼喊“打倒巴金！”“打倒廖沫沙！”“打倒路遥！”等涉及一众文学家的口号，一边将他们的心血作品扔入熊熊燃烧的火堆中，冲天的火焰仿佛照亮了全北京，而革命群众则脚踏灰烬，伴着红卫兵的战歌迈步离去，幸运的是这些书的作者看不到这些，因为他们早就被从家里揪出来接受一顿拳打脚踢，最后被像牲口一样扔进了前往新劳改学校的卡车里。至于剩余还没来得及处理的狺狺狂吠之徒，我们秉承着人道主义精神，统一将他们带到了上海宛平南路600号的“专业医院”里接受狂躁症的治疗，他们比起写文章，还是老老实实的为我国精神科做贡献好处大。\n秀才们在真正的牛棚里把自己的残余手稿藏在干草堆里，绝望的恳求有一天这些文字能重见天日，但有关焚书一夜的录像却被不禁流出到了国际社会，反华媒体借此事大做文章，将我们的领导人比作中国的希特勒，全世界的民主文明国家对此大为震撼，纷纷指责中国的“极权主义反智政策”，就连苏联也指责我们“走向了癫狂”……我们对这些评论不做任何评价，反正我们成功粉碎了内部敌人腐化人民的阴谋，而外部的敌人越反对，就越说明我们做对了。\n可所有人都没有意识到，在那天夜里燃起的火光旁，中国有史以来最叛逆最疯狂最堕落的知识分子正在天安门的城墙上默默的注视着一切，而他的另一个身体藏在篝火前方几十米不到的建筑物里，作为场上唯一的幸存者与漏网之鱼，他早已无法起身阻止这一切……"


func prepare(event_def: EventDef, world: WorldState) -> void:
	_bind_world()
	if event_def == null or world == null or event_def.options.size() < 4:
		return
	var mod3 := world.modifiers.size() > 3 and world.modifiers[3] != null \
		and world.modifiers[3].is_active
	var data := world
	var line := data.political_line if data.size() > W.I_POLITICAL_LINE else 1
	var gof := data.gang_of_four_path if data.size() > W.I_GANG_OF_FOUR_PATH else 0
	if mod3:
		event_def.description = TXT_DESC_MOD3
	elif gof == 3:
		event_def.description = TXT_DESC_GOF3
	else:
		event_def.description = TXT_DESC_OTHER
	var opt := event_def.options
	if mod3:
		_enable(opt[0], "为无产阶级文化大革命的新高潮欢呼吧！")
	else:
		if line < 2:
			_disable(opt[0], "不是已经胜利结束了吗？")
		elif line == 4:
			_disable(opt[0], "感觉像某个讨厌的浙江佬…")
		else:
			_disable(opt[0], "听起来有点像某个四川佬…")
	if not mod3 and line < 2:
		_enable(opt[1], "给文人们开窗透气，但还是得盯好他们")
	elif mod3:
		_disable(opt[1], "别再畏畏缩缩的了！")
	else:
		_disable(opt[1], "你还想天天跳忠字舞吗？")
	if not mod3 and line >= 2:
		_enable(opt[2], "这理应也是属于文化人的春天")
	elif mod3 or line == 0:
		_disable(opt[2], "软刀子杀人者最为可恶")
	else:
		_disable(opt[2], "这是对毛主席的背叛！")
	if not mod3 and line < 2:
		_enable(opt[3], "这群反动堕落文人最好给我立刻闭嘴！给我把革命小将全部叫回来！")
	elif mod3:
		_disable(opt[3], "这不符合四大自由的精神！")
	elif line == 4:
		_disable(opt[3], "这和焚书坑儒有什么区别！")
	else:
		_disable(opt[3], "极左时代的高压政策已经结束了！")


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			_add(W.I_PEOPLE_SUPPORT, 100)
			_add(W.I_THOUGHT_FREEDOM, 100)
			context["result_text"] = TXT_R0
		1:
			_add(W.I_PARTY_SUPPORT, 100)
			_add(W.I_PEOPLE_SUPPORT, 50)
			_add(W.I_THOUGHT_FREEDOM, 50)
			context["result_text"] = TXT_R1
		2:
			_add(W.I_PARTY_SUPPORT, -100)
			_add(W.I_PEOPLE_SUPPORT, 50)
			_add(W.I_THOUGHT_FREEDOM, 150)
			context["result_text"] = TXT_R2
		3:
			_add(W.I_PARTY_SUPPORT, 100)
			_add(W.I_PEOPLE_SUPPORT, -150)
			_add(W.I_THOUGHT_FREEDOM, -200)
			_add(W.I_AGENTS, -100)
			_add_relation(EmpireData.USA, -50)
			_add_relation(EmpireData.USSR, -50)
			context["result_text"] = TXT_R3



