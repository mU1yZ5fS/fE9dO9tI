extends "res://数据脚本/event_script_base.gd"

const T_658_0 := "非洲死亡之心"
const T_658_1 := "乍得是一个典型的萨赫勒国家。由于特殊的地理位置和法国殖民时代刻意重用南方民族，该国南北方的民族和文化截然不同。而南方人在独立以来就一直主导着整个国家。第一任总统弗朗索瓦·托姆巴巴耶的统治以独裁、极端腐败和偏袒南方人著称，同许多非洲独裁者一样，他对内实行独裁统治，推行大萨拉族主义和歧视北方人的政策，这导致了北部和东部的伊斯兰教地区与南方基督徒主导的政府之间的对立，起义层出不穷。1966年6月19日，马克思主义者易卜拉欣·阿巴查将乍得国内大部分反对南方中央政府的组织整合起来，组织成了带有左翼革命色彩的大帐篷性质组织——乍得民族解放阵线（FROLINAT，随着1968年阿巴查的去世以及这之后阵线内各派系夺取继承人职位的斗争，FROLINAT逐渐转变为亲利比亚的左翼民族主义组织，而马克思主义的要素则被完全边缘化），这标志着内战的开始。\n随着利比亚和法国的干预，以及叛军的分裂，乍得内战逐渐演变称三足鼎立的局势——南部政府军、控制北部与中部的古库尼·韦戴、控制东部的侯赛因·哈布雷。1975年，由于托姆巴巴耶向利比亚靠拢，法国扶持了一场政变，在将他杀死后，政变军官们推举了此前被捕入狱的费利克斯·马卢姆准将为总统。在反政府武装逐渐壮大的形势下，新的军政府主张通过谈判实现民族和解和全国统一，这得到了哈布雷派的支持，而古库尼则拒绝谈判。\n1978年8月，哈布雷同政府和解，他本人被马卢姆任命为总理。但随着古库尼派武装逼近首都，联盟很快便瓦解。马卢姆总统于1979年3月出逃。随后，乍得的各个派别在尼日利亚的调解下签署《拉各斯协议》结束了内战，一个涵盖11个不同派别的代表的民族团结过渡政府（GUNT）成立了，亲利比亚的古库尼·韦戴成为了总统，而反利比亚的哈布雷成为了国防部长，古库尼派中的强硬派艾哈迈德·阿西尔被任命为外交部长。\n然而，非洲各国的努力并没能真正停止乍得的内战。短暂的和解之后，武装冲突再次爆发。1980年3月，哈布雷的部队开始攻击古库尼派武装，乍得又一次陷入全面内战。12月，在利比亚的直接介入以及苏联和东德顾问的帮助下，古库尼获得了胜利。哈布雷派撤退到东北边境地区进行游击战。\n1981年，古库尼访问利比亚，两国决定合并，这一计划引起了非洲统一组织与法国的强烈不满，由尼日利亚、塞内加尔和扎伊尔组成的泛非和平部队陆续进驻乍得维持秩序。面对国际社会的反对声音，两人后来降低了声明的调门，将其描述为两国人民之间的“联盟”。{0}随着利比亚的撤军，哈布雷领导他的北方武装部队（FAN）从东北部向首都发起反攻。看来，乍得内战仍将继续下去。"
const T_658_2 := "尽管如此，这一事件还是削弱了古库尼的民族主义形象。随着国际压力的增加，古库尼表示愿意接受非统组织的调解，暗示利比亚军队将撤出乍得。然而，利比亚军队在乍得的存在和行动引发了乍得国内和国际的不满。到了1981年10月，由于卡扎菲的伊斯兰军团与古库尼的军队发生冲突，古库尼要求利比亚军队撤出乍得。由于卡扎菲寻求在1982年担任非统组织主席，同时也因为利比亚在乍得的处境变得复杂，利比亚军队在11月撤离。尽管如此，卡扎菲并未放弃对乍得的影响力，而是开始寻找一个更可靠的乍得领导人来实现他的目标。"
const T_658_3 := "不过这一切都因卡扎菲的身亡而不了了之，古库尼政府也陷入了孤立。"
const T_658_4 := "帮助GUNT，斩断法、美伸向非洲的黑手！"
const T_658_5 := "我们对“中东疯狗”和他的弟子不感兴趣"
const T_658_6 := "大家都受够卡扎菲了，让我们帮助哈布雷"
const T_658_7 := "让我们帮助哈布雷"
const T_658_8 := "我们还不至于要勾结美帝和法帝……"
const T_658_9 := "应该给乍得选一个立场更坚定的人……"
const T_658_10 := "卡扎菲不值得我们的帮助"
const T_658_11 := "已经不用这么做了"
const T_658_12 := "什么，原来他们还在打内战吗？"
const T_658_14 := "非洲死亡之心"
const T_658_15 := "乍得内战"
const T_658_16 := "UGNT"
const T_658_17 := "FAN"
const T_658_18 := "我们支持了利比亚和乍得UGNT政府反对法、美帝国主义的斗争。一艘货轮驶往利比亚，将我们的援助输往乍得这个非洲内陆国，让我们祝古库尼好运吧！\n"
const T_658_19 := "卡扎菲没有忘记我们的支持，来自利比亚的廉价石油将未我们的工业发展提供更多动力。\n"
const T_658_20 := "11月19日，FAN攻占了乍得东部重要城市阿贝歇，次年1月初，乌姆哈杰尔也沦陷了。非统组织要求双方开展和解谈判，但古库尼坚决拒绝和谈，并指责非统组织干涉乍得内政。希望局势会好转吧……"
const T_658_21 := "我们通过和法国的关系对FAN和哈布雷提供了我们的支援。一艘货轮驶往苏丹，将我们的援助输往乍得这个非洲内陆国，让我们祝哈布雷好运吧！\n11月19日，FAN攻占了乍得东部重要城市阿贝歇，次年1月初，乌姆哈杰尔也沦陷了。非统组织要求双方开展和解谈判，但古库尼坚决拒绝和谈，并指责非统组织干涉乍得内政。希望局势会好转吧……"
const T_658_22 := "我们的特工联系到利比亚和艾哈迈德·阿西尔，并为他们制定了一个他们难以拒绝的计划。一天夜里，忠于阿西尔的部队和利比亚的特工将古库尼逮捕了起来。第二天早上，古库尼宣布自己将因“身体原因”辞职，将总统的职位让给更能胜任此职的阿西尔，他自己将前往利比亚“度假”。作为唯一一个不反对利比亚和乍得的合并计划的领导人，想必他将更忠诚于世界第三理论和《绿皮书》，将这个内陆国带出西方帝国主义的阴影。\n我们支持了利比亚和乍得UGNT政府反对法、美帝国主义的斗争。一艘货轮驶往利比亚，将我们的援助输往乍得这个非洲内陆国，让我们祝阿西尔好运吧！\n卡扎菲没有忘记我们的支持，来自利比亚的廉价石油将未我们的工业发展提供更多动力。\n11月19日，FAN攻占了乍得东部重要城市阿贝歇，次年1月初，乌姆哈杰尔也沦陷了。非统组织要求双方开展和解谈判，阿西尔表示拒绝，宣布将忠于乍得革命和易卜拉欣·阿巴查的事业。希望局势会好转吧……"
const T_658_23 := "11月19日，FAN攻占了乍得东部重要城市阿贝歇，次年1月初，乌姆哈杰尔也沦陷了。非统组织要求双方开展和解谈判，但古库尼坚决拒绝和谈，并指责非统组织干涉乍得内政。希望局势会好转吧……"


## 原作 Event658.cs：非洲死亡之心（乍得内战，四选项）。
## 触发：TimeScript.cs:11086-11091 —— (日>=29 且 月>=10 且 年>=1981) || (月>=11 且 年>=1981) || 年>=1982。
## 差异：
##  - 描述后缀与 opt1/opt2 文案按 resultOfEvents[512] / [561] 动态选择（缺省按原版 int 默认 0）。
##  - OilProd += 100f 已建模（ws.oil_prod）。
##  - War 80：AmericanSupportDefender.SovietSupportAttacker → usa_side=1 / ussr_side=0。
##  - 死代码 result_num==5（button_text[5] 测试分支）跳过。

func prepare(event_def: EventDef, world: WorldState) -> void:
	_bind_world()
	if event_def == null or world == null or event_def.options.size() < 4:
		return
	var data := world.数值表
	var line := data[W.I_POLITICAL_LINE] if data.size() > W.I_POLITICAL_LINE else 2
	var r512 := int(world.completed_event_ids.get("event_512", 0))
	var r561 := int(world.completed_event_ids.get("event_561", 0))
	event_def.title = T_658_0
	var desc := T_658_1
	if r512 != 2 and r561 != 1:
		desc = desc.replace("{0}", T_658_2)
	else:
		desc = desc.replace("{0}", T_658_3)
	event_def.description = desc
	var libya := world.get_country_by_legacy_index(13)
	var france := world.get_country_by_legacy_index(21)
	var usa_rel := 0
	if world.empires.size() > EmpireData.USA and world.empires[EmpireData.USA] != null:
		usa_rel = world.empires[EmpireData.USA].relations
	var opt := event_def.options
	if line <= 2 and libya != null and libya.government != 3:
		_enable(opt[0], T_658_4)
	else:
		_disable(opt[0], T_658_5)
	if line >= 3 and ((france != null and france.has_tag("对华贸易")) or usa_rel >= 500):
		if r512 != 2 and r561 != 1:
			_enable(opt[1], T_658_6)
		else:
			_enable(opt[1], T_658_7)
	else:
		_disable(opt[1], T_658_8)
	if line <= 1 and libya != null and libya.has_tag("对华贸易") and r512 != 2:
		_enable(opt[2], T_658_9)
	else:
		if r512 != 2 and r561 != 1:
			_disable(opt[2], T_658_10)
		else:
			_disable(opt[2], T_658_11)
	_enable(opt[3], T_658_12)


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var chad := ws.get_country_by_legacy_index(57)
	_set_part(chad, 0, true)
	GameManager.start_war(80, T_658_16, T_658_17, 500, 500, 1, 0)
	if ws.wars.size() > 80 and ws.wars[80] != null:
		ws.wars[80].name_war = T_658_15
	var r512 := int(ws.completed_event_ids.get("event_512", 0))
	var r561 := int(ws.completed_event_ids.get("event_561", 0))
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			var text := T_658_18
			if r512 != 2 and r561 != 1:
				text += T_658_19
			text += T_658_20
			_war_add(80, 50, -50)
			_add(W.I_DIPLO, 50)
			_add(W.I_BUDGET, -150)
			_add(W.I_ARMY, -150)
			_add_relation(EmpireData.USA, 50)
			_add_relation(EmpireData.USSR, 50)
			ws.oil_prod += 100.0  # Event658.cs OilProd
			context["result_text"] = text
		1:
			_war_add(80, -50, 50)
			_add(W.I_DIPLO, -50)
			_add(W.I_BUDGET, -150)
			_add(W.I_ARMY, -150)
			_add_relation(EmpireData.USA, -50)
			context["result_text"] = T_658_21
		2:
			_war_add(80, 50, -50)
			_add(W.I_DIPLO, 50)
			_add(W.I_BUDGET, -150)
			_add(W.I_ARMY, -150)
			_add_relation(EmpireData.USSR, 50)
			ws.oil_prod += 100.0  # Event658.cs OilProd
			context["result_text"] = T_658_22
		3:
			context["result_text"] = T_658_23




func _war_add(war_id: int, d1: int, d2: int) -> void:
	if ws.wars.size() > war_id and ws.wars[war_id] != null:
		ws.wars[war_id].infl1 += d1
		ws.wars[war_id].infl2 += d2


func _set_part(country: CountryData, index: int, value: bool) -> void:
	if country == null:
		return
	while country.parts.size() <= index:
		country.parts.append(false)
	country.parts[index] = value
