const TXT_R1 := "考虑到文革时代激进诉求的退潮，党委机关越来越能泰然履职，且先前筹建的革命委员会也变得愈加建制化，打入党和国家机构进行改组的“合法阶级斗争”形式大行其道等诸多现实。党内持激进思想的同志不得不再度选择战略退却，继续与文革时代兴起的“逍遥新贵”们谋求某种共治格局：根据王洪文同志在1975年共青团代表大会筹备组内的观点（即将原共青团组织与民间红卫兵运动合二为一，并冠以“红卫兵”之名），以及先前组织革命委员会放弃巴黎公社的全面选举口号，转而追求“干部、群众与军方”结合等“历史经验”。党中央至此批准了王副主席主张，并得到华主席背书的系列决议：中国共青团以中国红卫兵之名实现重建，革命干部与积极群众在其中各占半壁江山，其基层组织需在地方革命委员会“行政授权”与党委“政治领导”下开展活动；紧随其后的则是全国总工会、少先队（前者更名为中华全国革命职工代表大会，后者被定为中国红小兵）等接受类似改组原则，至此改头换面，配套革命委员会形式并引入激进草根运动这一活水的原有党群组织；除此之外，党中央还决定大规模整合尚未在全国形成统一体系的各造反派组织，试图以党作为纽带，将其纳入到一致行动的统摄外围下。其典型便是以各地农代会为基础，重建革命战争时代的农民运动领导机构。革命委员会的代表委派形式亦得到拓展：妇女会与文艺工作组（当然，这自然是来自中央组织宣传组的指示）得以在其中获得一席，这自然加强了新兴势力对于各领域的发言权。大多数党员对党组织的实质扩张表示满意，群众也因参政道路扩宽，而风险反而未增而感到欣喜，社会秩序也得到了较好的维持。可如此改组自将遭遇熟悉的老生常谈：被收编后的造反运动与其在中央的代言人能否站稳脚跟，保持其原有的革命性，并实现澄清党内队伍与革命委员会的目标？党委内的老同志们会满意同来自三教九流的无资历行外人实现长期共治吗？制度化下的官僚主义繁文缛节与党组机构的膨胀会让往日的红卫兵们重蹈苏俄时代工农检察院覆辙，并事实上以党员身份确立对社会的霸权，恢复前17年党委独尊，实质军管的体系吗？而毛泽东主席恰是为扭转这一倾向，试图在新基础上建立社会主义而发动无产阶级文化大革命……只有时间会告诉我们结果究竟如何……"
const TXT_R2 := "考虑到各路宣传队在无外力支持的情况下本就持续萎缩，名存实亡。而整顿路线，重建我党权威已然成为有党内领导人背书的政治正确，那扫除鸡肋便是题中之义。早在今年九月初，便有同志提出“工宣队问题要解决，他们留在学校也不安心”的相关指示，并暗示应当迅速果断地解决这些历史遗留问题，为党重新行使其合法权力开路。于是在1977年11月6日，中共中央转发教育部党组的请示报告，至此工宣队、军宣队等派遣组织全部撤出学校与各大机关。与此同时，将全总、共青团等组织工作再度纳入正轨的筹建会议已然提上日程。预计我们将在1978年时彻底恢复上述机构的基本职能，并借此恢复党对于全国青年与工人运动的集中统一领导。除却激进派外的多数党内同志对此表示欢迎，而社会大体对此则反应平平——考虑到文化大革命闹得风风火火，最终结果却是冷冷清清，他们坠入政治冷感也是自然结果。当然，上述情况显然不代表政治异议的完全消弭，对集体领导与党内民主原则的重提已然开始滋生另类反对派；党外也开始出现以百花齐放为旗帜掩护其异端政治思潮。可和以往必须无需直面无政府状态的情况相比，目前的局势对大多数同志们来说挺好的。下一步便是计划将重点转向更加值得关注的事，比如对尾大不掉，越来越和党委职能冲突的革命委员会模式进行进一步改革；或是用为文革善后为由，推进实质上的人事改组。总之，党和国家的各项事务都正在{0}{1}同志的特别关照下兴旺起来，这只会巩固早在党内扎根已久者的立场。"


func prepare(event_def: EventDef, _world: WorldState) -> void:
	_bind_world()
	if event_def == null or event_def.options.size() < 3:
		return
	var r25 := int(ws.completed_event_ids.get("gang_of_four", 0))
	var r26 := int(ws.completed_event_ids.get("weak_alliance", 0))
	var line := _res(W.I_POLITICAL_LINE)
	var mod3 := ws.modifiers.size() > 3 and ws.modifiers[3] != null and ws.modifiers[3].is_active
	var desc := TXT_DESC_C
	if (r25 == 2 or r26 == 2) and line == 0 and mod3:
		desc = TXT_DESC_A.replace("{0}{1}", _leader_name())
	elif r25 == 2 or r26 == 2:
		desc = TXT_DESC_B
	event_def.description = TXT_DESC_PRE + desc
	var flag := line == 0 and mod3 and _res(W.I_PARTY_SUPPORT) >= 800 and r25 == 2 and r26 == 2
	var flag2 := line >= 0 and line < 2 and r25 == 2 and r26 == 2
	var opt := event_def.options
	if flag:
		_enable(opt[0], event_def.options[0].text)
	elif r25 != 2 or r26 != 2:
		_disable(opt[0], TXT_OPT0_DIS_A)
	else:
		_disable(opt[0], TXT_OPT0_DIS_B)
	if flag2:
		_enable(opt[1], event_def.options[1].text)
	else:
		_disable(opt[1], TXT_OPT1_DIS)
	if line > 0 or (not flag and not flag2):
		_enable(opt[2], event_def.options[2].text)
	else:
		_disable(opt[2], TXT_OPT2_DIS)


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			context["result_text"] = TXT_R0
			_add(W.I_PARTY_SUPPORT, -50)
			_add(W.I_PEOPLE_SUPPORT, 100)
			for i in ws.politicians.size():
				var p: PoliticianData = ws.politicians[i]
				if p != null and p.trait_alignment == 41:
					GameManager.kill_politician(i)
		1:
			context["result_text"] = TXT_R1
			_add(W.I_PARTY_SUPPORT, 100)
			_add(W.I_PEOPLE_SUPPORT, 50)
			_add(W.I_THOUGHT_FREEDOM, 50)
		2:
			context["result_text"] = TXT_R2.replace("{0}{1}", _leader_name())
			_add(W.I_PARTY_SUPPORT, 100)
			_add(W.I_PEOPLE_SUPPORT, 50)
			_add(W.I_THOUGHT_FREEDOM, 150)


func _leader_name() -> String:
	if ws.leader != null and ws.leader.name_display != "":
		return ws.leader.name_display
	return "华国锋"
