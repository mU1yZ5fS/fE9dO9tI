		return
	var data := world.数值表
	var line := data[W.I_POLITICAL_LINE] if data.size() > W.I_POLITICAL_LINE else 2
	var zaire := world.get_country_by_legacy_index(117)
	var opt := event_def.options
	event_def.title = T_659_0
	event_def.description = T_659_1
	_enable(opt[0], T_659_2)
	if line <= 3:
		_enable(opt[1], T_659_3)
	else:
		_disable(opt[1], T_659_4)
	if line <= 3:
		_enable(opt[2], T_659_5)
	else:
		_disable(opt[2], T_659_6)
	if zaire != null and zaire.has_tag("对华贸易"):
		_enable(opt[3], T_659_7)
	else:
		_disable(opt[3], T_659_8)
	if line >= 3:
		_enable(opt[4], T_659_9)
	else:
		_disable(opt[4], T_659_10)


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var uganda := ws.get_country_by_legacy_index(118)
	if uganda != null:
		uganda.influence_nato = 800
		uganda.influence_china = 50
		uganda.prc_influence = 100
		uganda.sov_influence = 50
		uganda.government = 0
		uganda.sub_government = 10
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			context["result_text"] = T_659_13
		1:
			if uganda != null:
				uganda.set_tag("对华贸易", true)
			context["result_text"] = T_659_14
		2:
			context["result_text"] = T_659_15
		3:
			context["result_text"] = T_659_16
		4:
			context["result_text"] = T_659_17


func _enable(opt: EventOption, text: String) -> void:
	opt.text = text
	opt.disabled_text = ""
	opt.enable_condition = null


func _disable(opt: EventOption, text: String) -> void:
	opt.text = text
	opt.disabled_text = text
	var n := ExprNode.new()
	n.type = ExprNode.Type.RESOURCE_AT_LEAST
	n.key = "party_system"
	n.value = 99999.0
	opt.enable_condition = n
