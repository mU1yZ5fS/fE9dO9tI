		_add(175, 2)
	if italy != null and italy.sub_government == 14:
		_add(176, 1)
	if _raw(181) >= _raw(178) and _raw(181) >= _raw(179) and _raw(181) >= _raw(180):
		_add(176, 2)
	if italy != null and italy.has_tag("soc_eu"):
