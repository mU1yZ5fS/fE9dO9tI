const TXT_GKCHP := "Die\u00a0Ratten\u00a0verlassen\u00a0das\u00a0sinkende\u00a0Schiff\n苏联的戏剧性政变给垂死挣扎的保守派续上了最后一口气。在索科洛夫元帅签订的“保守革命”协定上特别要求了驻德苏军停止移交政权，以一切力量确保东德的存在，如有必要则展开一场特别军事行动，而苏联军方会为他们埋单。就这样，代号“楚德湖”的特别行动就此展开。米哈伊·扎伊采夫上将在德国统一社会党的邀请下“善意”保卫该国的各大城市。国家人民军的海因茨·凯斯勒在苏联的授意下叫停了软弱不堪的文官政府，并出任该国领导人。新政府吸纳了SED内部的保守派和NVA的强硬派人士，就此组建了救国革命委员会。NVA，史塔西和苏联军队协同合作，各大城市纷纷上演了警民鱼水情。而且切断了同联邦德国的边境检查站。在美国局势空前收缩的大前提下，西德做出了最终让步，从法律之中剔除了要求两德完全合并的内容，民主德国方面以一轮军事演习作为回敬。\n政变后的民主德国遭受着前所未有的经济制裁，配给制和限电这一陌生的名词再度复活了，宵禁和灯火管控更是常态。"
const TXT_GKCHP_APPEND := "苏联则将保卫德国视为其重返舞台的关键一举，但当愤怒的德国人再次走上街头时，罗斯勇士还能再度击退愤怒的条顿骑士吗？"
const TXT_VIETNAM := "第二越南民主共和国\n东升西落的态势也影响到了民主德国，让“社会主义的壁垒”也不得不顺应时代进行改革。昂纳克政府选择多头下注：一面转向日益崛起的中国寻求帮助，一面则竭力保持与苏东集团的传统盟友关系，试图背靠经互会空间增强自身势力。两头讨好的政策事实上将民主德国变为类似冷战中期罗马尼亚的奇美拉：当局一面对作为中方盟友的反修正主义组织（如德国共产党【马列）】）采取隔离且平等（默许存在，但坚决限制其扩大影响力）的政策，一面则选择性参与经济互助委员会内事务，并常暗示苏联方需履行“援助社会主义世界”的国际义务。而民主德国国内的政策则仍缺乏根本变化：政府更热衷于将自身建立为自给自足的繁荣橱窗，在实现同西德长期对峙的同时确立优势。两头通吃而非一边倒的方略将柏林本身也成为了中苏博弈的中间地带，使民主德国得以扮演两大社会主义强权间沟通的中间人。当然，这种力量平衡本身也没有持续多久：仅在几年后，试图让东德服务于“改革新思维”与“欧洲大厦”迷梦的苏联便输光了前者仅有的信任。随着建立中立统一德国谈判的草草收场与社会主义阵营本身的瓦解，东德最终选择向东看齐，加入中国主导的欧洲新秩序内。与彼时更青睐于“发达社会主义苏联”，而非“民族资本主义中国”的越南领导人黎笋形成了有趣的历史互文。"
const TXT_ROMANIA := "第二罗马尼亚\n东升西落的态势也影响到了民主德国，让“社会主义的壁垒”也不得不顺应时代进行改革。昂纳克政府选择多头下注：一面转向日益崛起的中国寻求帮助，一面则竭力保持与苏东集团的传统盟友关系，试图背靠经互会空间增强自身势力。两头讨好的政策事实上将民主德国变为类似冷战中期罗马尼亚的奇美拉：当局一面对作为中方盟友的反修正主义组织（如德国共产党【马列）】）采取隔离且平等（默许存在，但坚决限制其扩大影响力）的政策，一面则选择性参与经济互助委员会内事务，并常暗示苏联方需履行“援助社会主义世界”的国际义务。而民主德国国内的政策则仍缺乏根本变化：政府更热衷于将自身建立为自给自足的繁荣橱窗，在实现同西德长期对峙的同时确立优势。两头通吃而非一边倒的方略将柏林本身也成为了中苏博弈的中间地带，使民主德国得以扮演两大社会主义强权间沟通的中间人。当然，这种力量平衡终有一日会被打破……"
const TXT_DRAGON := "非牛非驴，却生龙头\n在中华人民共和国的帮助下。统一社会党得以稳坐柏林人民宫，尽可能保留原汁原味的民主德国制度：即社会主义、计划经济与联邦框架。不过，外交侧重点的转换与中国顾问的到来还是为该国改革开了盖子。民主德国的政治实现了解冻，德国共产党（马列）东德支部与各派反修正主义者均得以实现平反，且在统一社会党内获得顾问席位。民族阵线内的力量对比亦呈现此消彼长趋势：作为“广泛劳动者”代言者的各路政党职能被虚化，让权力转而集中至另一批成员处——以自由德国工会联合会为代表的群众团体不仅在国家级议会内取得更多政治配额；更在类似中国三代会模式下同基层治理体系深度嵌合，并可挂靠捍卫共产主义总路线的政治授权发动政治动员与实施揭批。新兴政治势力的加盟令昂纳克时代的主要政治议程“经济与社会体制的步调一致”自然步入第二阶段：残存的私营部门与自由职业者借助第三次集体化转变为区域下辖的“社会自营所有制”；同群众团体密切关联的单位式社区得以快速发展，成为国家主导福利体系的补充；基于鞍钢宪法概念、工会民主原则与劳工集体监督多项扩充群众参与机制的改革在人民企业与产业联合体中得以广泛落实；计算机工业则因“增进人民福祉”需求而在个人化与小型化方向上迅速飞跃，更在效法中国“赤脚电工”、“三结合”运动与南斯拉夫地区盛行的自装“银河”电脑（Galaksija）热潮中彻底重塑社会生活。瓦尔特·乌布利希时代的“社会主义经济体制”计划至此在辩证否定基础上实现复生：个人终端的广泛推广、国内群众的广泛参与和经济体系的完全社会化共同铸就起以电子计算、礼品经济和自动化控制为显著特征的名副其实“全民所有制”。最终让民主德国各地工人也纷纷获得随时随地就经济生产、物资分配与劳动报酬等问题提出意见、参与决策与表决，以及持续监督经济计划运行的权利。于是，智利政权胎死腹中的控制论民主社会主义理想得以同经典社会主义实现会师，让昂纳克时代自诩的经济-社会奇迹和“另一个社会愿景”真切落到实处。"
const TXT_RUINS := "从废墟中崛起\n在中华人民共和国的帮助下。统一社会党不仅得以稳坐柏林人民宫，尽可能保留原汁原味的民主德国制度；甚至在此基础上更进一步，实现了卡尔·李卜‍克内西、恩斯特·台尔曼、威廉·皮克等间战时期共产党人的政治梦想：将全德国统一在德国共产党直系后裔的手中。几乎就在昂纳克宣布德国统一的同时，德国政坛元老威利·斯托夫便同知名反修正主义者威利·迪克胡特、民粹新星康拉德·瑙曼共同主导了对新国家机器的改组计划：德国统一社会党恢复德国共产党之名，并整合包括“K小组”、绿党、新社会运动等等全德范围内的各激进社会主义组织，试图将德国工人运动统一在唯一的革命党下；随后出台的新基本法则可被视为《斯巴达克同盟想要什么？》与《德国人民民族解放与社会解放纲领》的新时代版本：为彻底落实社会主义议程。资产阶级政党与分裂劳动群众团结的社会民主党被取缔，其生态位被奉行左翼政党民主原则，代表市民或其他各类劳动者的诸多小党取代；行之有效的社会化得到迅速贯彻落实，确立了“社会自营所有制”（整合原小型企业、自由职业者与合作社，由群众组织主管的区域网络）与“人民企业”（即计委直接过问的国营部门，工会与劳动集体在其中分享决策与监督权）两类所有制的霸权地位；在国际社会主义者的支持下，民主德国足以将国体根植于“莱忒”（Räte，即德国十一月革命时期效法苏维埃组织的直接民主部门）制度与平等主义理想实现完全重塑。\n借助全国统一的大势，昂纳克政权决定趁热打铁，将“经济与社会体制的步调一致”推进至全新阶段：出于扩充人民参与并否定旧有国家机器的需要，史塔西被改组为工农检察院性质机构，线人网络则改组为赤卫队以纠察反动势力。而源自西德的军情机构则被彻底解体，其主要负责人亦被迅速清算。为流行文化、性别权益、家庭自由化等开绿灯的激进进步立法则狂飙突进，并与废除军衔、头衔等改革一道成为平等主义一揽子工程的有机组成。借助“去纳粹化”、“去波恩化”的政治潮流。德国迅速引入了四大自由，在发展出挂靠共产主义意识形态忠诚的党外强势群众运动同时将传统社会组织改组为“三代会”模式，形成发达的单位式社区。基于鞍钢宪法概念、工会民主原则与劳工集体监督多项扩充群众参与机制的改革在人民企业与产业联合体中得以广泛落实；计算机工业则因“增进人民福祉”需求而在个人化与小型化方向上迅速飞跃，更在效法中国“赤脚电工”、“三结合”运动与南斯拉夫地区盛行的自装“银河”电脑（Galaksija）热潮中彻底重塑社会生活。瓦尔特·乌布利希时代的“社会主义经济体制”计划至此在辩证否定基础上实现复生：个人终端的广泛推广、国内群众的广泛参与和经济体系的完全社会化共同铸就起以电子计算、礼品经济和自动化控制为显著特征的名副其实“全民所有制”。最终让民主德国各地工人也纷纷获得随时随地就经济生产、物资分配与劳动报酬等问题提出意见、参与决策与表决，以及持续监督经济计划运行的权利。于是，智利政权胎死腹中的控制论民主社会主义理想、德国正统社会主义与现代反修正主义三者得以成功实现会师。不仅让昂纳克时代自诩的经济-社会奇迹和“另一个社会愿景”真切落到实处，更促使德国共产主义者得以逐步恢复自身作为欧洲社会主义排头兵的形象。"
