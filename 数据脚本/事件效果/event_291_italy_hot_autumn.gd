const TXT_R0 := "“工人主义”者以其对意大利国内激进左翼政治议程的霸权而闻名遐迩：相关组织不仅深度参与了1969年“火热之秋”期间的北方大罢工（以都灵菲亚特工厂罢工最为典型）与60-70年代的占领空间，建立自管社会中心（Centro-sociale-autogestito）运动，更在“铅色岁月”时期以“三巨头”格局（即倾向直接同当局武装斗争的“持续斗争”、以软抵抗方式组建公社推进社会主义议程“工人先锋队”，乃至前意大利社会党与意大利共产党内极左翼党员共同促成的争取共产主义的无产阶级团结党）事实上垄断了极左翼生态位。显然，同他们合作能够让我们获得直接调动意大利激进派主力的机会。通过外联部同志的运作，我们很快便同目前最具影响力的工人主义组织“工人自主”取得联系：该组织整合了曾在68运动期间风云一时的“持续斗争”与“工人力量”组织的部分力量，目前正在前社会党成员，工人主义理论家安东尼奥·奈格里的主持下积极挑战建制派的霸权——就在今年2月，得到工人主义启发的激进学生们占领了罗马第一大学，并将亲近共产党，试图维持秩序的工会活动家卢西亚诺·拉玛逐出校区。终于让先前鼓吹“极左极右一丘之貉”的共产党决心彻底与极左翼青年运动决裂，并同“工人自主”直接开战。意大利建制派至此形成所谓“民族团结，一致对外”的共识。不过他们注定无法如愿：背靠“国际纵队”支持的活动家们好好教训了装甲车，延迟对“革命老城”博洛尼亚清场进程的同时完成战略转移，将相当规模的有生力量转入地下；“敌台网络”在我们的支持下亦全力开动，致使占领大学运动，罢工浪潮与游行示威席卷全国，让当局不得不在主要城市中采取更为积极的戒严配对攻策略。值此关键时刻，建立统一抗暴与协调革命行动组织的目标便呼之欲出：就在博洛尼亚抗暴大会上，各派活动家决定以“工人自主”为主干实现组织化。工人联盟“自主”就此诞生，并将该国亲近其思想的各类活动主体（包括欧洲版嬉皮士“都会印第安人”，热心野猫式罢工的活动家，无政府主义的自占自管社会中心，意大利情境主义者等）整合为群众外围。与此同时，吸收“前线”、共产主义战斗队与争取共产主义的武装无产者等亲工人主义武装组织，参照俄国赤卫队经验的无产阶级纠察队亦开始筹建，并在我国教官指导下确立起武装自卫，根据地建设与持久人民战争的基本路线。至此确保了工人主义者作为该国政治一极的地位。虽说目前谈论推翻意大利政权为时尚早，可我们终究是迈出了万里长征第一步。"
const TXT_R1 := "当前意大利激进共产主义的历史可追溯至20世纪40年代的游击队运动——扎根本土，深入基层的反法西斯运动不仅锻造了如彼得罗·塞基亚这般强烈笃信武装斗争公式，坚定无产阶级专政目标的经典共产主义者；更有完全皈依列宁主义，试图将自身所属政党同共产党实现合并，建立统一社会主义运动的鲁道夫·莫兰迪。然而，随着帕尔米罗·陶里亚蒂主张的“萨莱诺转折”成为显学，以及社会党党魁彼得罗·南尼在1956年转而标榜“独立社会主义”，同天主教民主党靠拢的政治选择。意大利共产党与意大利社会党内的极左翼政治家们便只能另寻他法：前者的异议者依托《宣言》杂志形成所谓“宣言派”，通过掌握传媒的方式在左翼群体（其中不乏共产党成员的赞誉——毕竟它更不受“总路线”的拘束。即便“宣言派”为此被迫脱党自立）中获得了相当影响力；后者则在60年代初同社会党分道扬镳，参照德国独立社会民主党的模式单独活动。两大组织在1974年时通过组建争取共产主义的无产阶级团结党实现合并，并通过同工人先锋队此类工人主义组织，以及马里奥·卡帕纳等学生活动家牵线搭桥的方式成为极左翼巨头之一。他们能同工人主义者灵活合作，并不至于陷入同工人主义者一般的碎片化格局的特性足以让我们对此予以厚望。可考虑到团结党目前仍在合法-非法运动间裹足不前，并事实上逐步将自身活动矮化为议会竞选（在意大利国内保革对立持续加剧的格局下，这只会导致重蹈主流政党覆辙或自绝于激进派，且极左翼在1976年的选战结果也足以证明“此路不通”：即便有数个工人主义组织的加盟，联合选举名单“无产阶级民主”也仅获得1.5%选票）的现状。因此有必要对此进行点拨，而机会很快便会来到——就在今年2月，得到工人主义启发的激进学生们占领了罗马第一大学，并将亲近共产党，试图维持秩序的工会活动家卢西亚诺·拉玛逐出校区。而此举直接导致同青年运动暧昧不清的共产党彻底露出真面目，并力挺武装力量参与对工人主义政治势力的“清场”。意识到大难临头，大帐篷联盟“无产阶级民主”很快便从我们顾问的建议内寻得出路：米兰的抗暴大会最终变为建党全会，以团结党为主体的意大利重建共产党宣布成立，并参照内战时代的民族解放委员会模式迅速同各地工人主义组织建立同盟，原本“顺风顺水”的围剿很快就撞上了规模空前且训练有素的地下游击队网络这面铁壁。反动派的全面进攻得以踩下刹车，而复仇之日终会来到……"
const TXT_R3 := "意大利政治极端主义从来都不是极左翼方的独角戏。毕竟，新生的第一共和国在相当程度上保持了法西斯主义时代的原汁原味：虽说曾主宰该国政局的巨头国家法西斯党已然解体，可接替墨索里尼政权的新秩序代言者并无心力推行彻底的去法西斯化政策：所有的一切在民族解放委员会解体，左右对峙取代反法西斯成为时代主题；主流政党天主教民主党对墨索里尼时代无意愿行政-技术官僚的网开一面；乃至司法部长帕尔米罗·陶里亚蒂为巩固“民族团结”格局而实施的全国大赦等实践面前达到顶峰。最终成就了意大利战后法西斯主义复兴的条件：吸纳了前法西斯合作者与社会共和国部分班底的意大利社会运动近乎与第一共和国同步成立，并在“不复辟墨索里尼时代原汁原味，不翻案大西洋主义路线”的含糊其辞下扩充势力。这一运动很快便成为滋生新一代右翼活动家与激进主义者的保护伞：早在50年代时，皮诺·劳蒂便以社会运动名义建立文化运动“新秩序”学习中心，后者很快便同法国“秘密军”、西班牙欧洲之友等国际右翼势力，乃至伊比利亚半岛的独裁者达成积极采用恐怖手段，推进右翼政治议程的共识。随着时间步入60-70年代，极右翼亦开始转向更为激进的手段：“新秩序”学习中心被主张直接发动“革命战争”，同臭名昭著的丰塔纳广场爆炸案关联密切的“新秩序”政治运动取而代之，其碎块亦以发动无差别袭击的“民族先锋队”、“黑色教团”等形式示人。同“持续斗争”、“红色旅”等左翼集团分庭抗礼。考虑到先前的占领罗马第一大学（相关参与者有典型极左翼背景，并在此期间羞辱了意大利共产党方工会代表卢西亚诺·拉玛。终于导致共产党决心同议会外极左翼彻底决裂。对工人主义者的镇压至此一发不可收拾）已使意大利当局将重心转向“警右防左”。我们很快便寻得了让该国政治版图更加倾向右翼一方的机会：我们的资金不仅能够为在1976年选举大败的合法路线代表社会运动雪中送炭，更能保障亲右翼的社会活动中心与恐怖团体能在被官方围剿的情况下有效运转并接管左翼退出的社会空间。不过，随着干预的深入，我国情报人员似乎发现了更多有趣的内容——比如意大利国安部门在其中的深度参与：他们不仅雇佣“民族先锋队”活动家假扮马列主义者组织假旗行动，其中的部分人士更试图同“民族阵线”策动反左翼、反民主未遂政变……显然事情正在起变化……"
const TXT_R4 := "1977年注定是意大利的多事之秋。应当说，自1976年大选结果公布以来，该国的几乎全部政治势力便对此焦头烂额：首先是长期作为老二党的意大利共产党支持率暴增，以34%的选票成绩大放异彩，大有逐步追上天主教民主党之势。由于作为传统中左联盟一级的意大利社会党保持颓势，且意大利民主社会党、意大利自由党等老牌中间派小党的衰退。政治惯性已无力延续，并被天主教民主党主导的少数派单色政府取代。作为在政府部门内排斥共产党部长上任可能的补偿，共产党人彼得罗·英格拉奥被任命为众议院主席。这恰是天主教民主党领导人阿尔多·莫罗试图开启新政治议程，试图通过引入共产主义者建立稳定政府的背景。其次便是意大利激进党与“无产阶级民主”等激进派组织在选战中的兴起与进入议会，让该国试图从多方面挑战既定体制者得以测试并巩固其政治影响力。即便同主流政党相比影响有限，可终归是迈出了第一步。而它们代表的激进政治思潮显然迎来了第二春（对于右翼运动而言同样如此，毕竟作为合法路线代表的意大利社会运动在选战中表现同样糟糕，以6%的成绩成了反面教材）：就在今年2月，得到工人主义启发的激进学生们占领了罗马第一大学，并将亲近意大利共产党，试图维持秩序的工会活动家卢西亚诺·拉玛逐出校区。终于让先前鼓吹“极左极右一丘之貉”的共产党决心彻底与极左翼青年运动决裂，意大利建制派形成所谓“民族团结，一致对外”的共识。内务部长弗朗切斯科·科西加布置的镇压方案至此得到一路放行，作为老牌“红色基地”的博洛尼亚被装甲车给“清场”，以“工人自主”为代表的老牌左翼组织，以及新左翼齐聚的自管社会中心的很快成为众矢之的。城市游击战与占领社会空间运动席卷罗马、都灵、威尼斯等地区。与此同时，以“新秩序”政治运动为代表的极端右翼势力亦开始积极策动袭击，并在激烈斗争中迭代出试图摒弃一切“光荣传统”，在“革命武装核心”旗下活跃的所谓无政府-法西斯主义者。意大利半岛至此再度卷入无差别的意识形态搏斗中，一如1968年时那般。可考虑到各路极端主义者在此期间仍只能将活动局限于地区抵抗内，相互之间亦攻伐不休，更不足以谈论建立足以动摇该国建制派的全国性平台可能。显然政府重掌主动权不过时间问题。1977年10月举行的博洛尼亚抗暴大会便是证明——活动家们近乎是重蹈了“持续斗争”第二次代表大会覆辙，事实上自我终结了自1968年的政治激进主义实践。"


func prepare(event_def: EventDef, world: WorldState) -> void:
	_bind_world()
	if event_def == null or world == null or event_def.options.size() < 5:
		return
	var line := world.数值表[W.I_POLITICAL_LINE] if world.数值表.size() > W.I_POLITICAL_LINE else 1
	var war := world.数值表[W.I_WAR_SUPPORT] if world.数值表.size() > W.I_WAR_SUPPORT else 0
	var diplo := world.数值表[W.I_DIPLO] if world.数值表.size() > W.I_DIPLO else 0
	var opt := event_def.options
	if line <= 0:
		_enable(opt[0], event_def.options[0].text)
	else:
		_disable(opt[0], TXT_OPT0_DIS)
	if line <= 2:
		_enable(opt[1], event_def.options[1].text)
	else:
		_disable(opt[1], TXT_OPT1_DIS)
	if line <= 1:
		_enable(opt[2], event_def.options[2].text)
	else:
		_disable(opt[2], TXT_OPT2_DIS)
	if war > 300 and line <= 3 and diplo >= 900:
		_enable(opt[3], event_def.options[3].text)
	else:
		_disable(opt[3], TXT_OPT3_DIS)
	_enable(opt[4], event_def.options[4].text)


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var italy := ws.get_country_by_legacy_index(85)
	var albania := ws.get_country_by_legacy_index(20)
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			_add(W.I_AGENTS, -100)
			_add(W.I_BUDGET, -50)
			_add(W.I_ARMY, -50)
			_add(W.I_DIPLO, 10)
			_add(172, 4)
			if italy != null:
				italy.level_of_development -= 20
			_add(134, 40)
			if italy != null:
				italy.内战中 = true
			context["result_text"] = TXT_R0
		1:
			_add(W.I_AGENTS, -60)
			_add(W.I_BUDGET, -100)
			_add(W.I_ARMY, -40)
			_add(W.I_DIPLO, 10)
			_add(173, 2)
			if italy != null:
				italy.level_of_development -= 20
			_add(134, 40)
			if italy != null:
				italy.内战中 = true
			context["result_text"] = TXT_R1
		2:
			if albania != null and albania.has_tag("亲中"):
				_add(W.I_AGENTS, -100)
				_add(W.I_BUDGET, -100)
				_add(W.I_DIPLO, 20)
				_add(174, 2)
				if italy != null:
					italy.level_of_development -= 15
				_add(134, 30)
				context["result_text"] = TXT_R2_ALB
			else:
				_add(W.I_AGENTS, -125)
				_add(W.I_BUDGET, -125)
				_add(W.I_ARMY, -50)
				_add(W.I_DIPLO, 20)
				_add(174, 2)
				if italy != null:
					italy.level_of_development -= 15
				_add(134, 30)
				context["result_text"] = TXT_R2
			if italy != null:
				italy.内战中 = true
		3:
			_add(W.I_PARTY_SUPPORT, -50)
			_add(W.I_AGENTS, -50)
			_add(W.I_BUDGET, -100)
			_add(W.I_ARMY, -50)
			_add(W.I_DIPLO, 10)
			_add(175, 1)
			_add(177, 2)
			_add(182, 2)
			if italy != null:
				italy.level_of_development -= 10
			_add(134, 40)
			if italy != null:
				italy.政变中 = true
			context["result_text"] = TXT_R3
		4:
			if italy != null:
				italy.level_of_development += 5
			context["result_text"] = TXT_R4


func _enable(opt: EventOption, text: String) -> void:
	opt.text = text
	opt.disabled_text = ""
	opt.enable_condition = null


func _disable(opt: EventOption, text: String) -> void:
	opt.text = text
	opt.disabled_text = text
	var n := ExprNode.new()
	n.type = ExprNode.Type.RESOURCE_AT_LEAST
	n.key = "party_system"
	n.value = 99999.0
	opt.enable_condition = n




func _set_data(index: int, value: int) -> void:
	if d.size() > index:
		d[index] = value






func _mod_active(idx: int) -> bool:
	var w: WorldState = ws
	return w != null and w.modifiers.size() > idx and w.modifiers[idx] != null and w.modifiers[idx].is_active


func _set_mod_active(idx: int, value: bool) -> void:
	if ws.modifiers.size() > idx and ws.modifiers[idx] != null:
		ws.modifiers[idx].is_active = value


func _leader_name() -> String:
	if ws.leader != null and ws.leader.name_display != "":
		return ws.leader.name_display
	return "华国锋"


func _find_politician(name1: int, name2: int) -> int:
	for i in ws.politicians.size():
		var p := ws.politicians[i]
		if p != null and p.name_first == name1 and p.name_last == name2:
			return i
	return -1


func _set_leader_from(p: PoliticianData) -> void:
	if ws.leader == null or p == null:
		return
	ws.leader.name_display = p.name_display
	ws.leader.name_first = p.name_first
	ws.leader.name_last = p.name_last
	ws.leader.trait_personality = p.trait_personality
	ws.leader.trait_background = p.trait_background
	ws.leader.trait_alignment = p.trait_alignment
	ws.leader.trait_special = p.trait_special
	ws.leader.age = p.age
	ws.leader.face_type = p.face_type
	if p.face_parts.size() >= 8:
		ws.leader.face_parts = p.face_parts.duplicate()
	ws.leader.jacket = p.jacket

