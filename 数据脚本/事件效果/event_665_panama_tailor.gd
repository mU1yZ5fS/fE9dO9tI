extends "res://数据脚本/event_script_base.gd"

const T_665_0 := "巴拿马裁缝"
const T_665_1 := "巴拿马运河及其附属区域向来是地缘政治内的一大敏感问题：早在19世纪时，美国商人便试图效法苏伊士运河建设的经验寻找修建跨洋黄金水道的战略要地，并试图借此垄断这一区域内的航运收益。这最终导致了1903年的所谓《美巴条约》：根据华盛顿方安排，原本控制这一区域的哥伦比亚不得不出让主权，为新人让路。这便是巴拿马独立国家的诞生，而以“运河区”之名建立的美属租借地便是巴拿马向“恩主”缴纳的报酬。不过，这份交易显然不如表面那般公平——美国不仅利用该条约完成了修筑巴拿马运河的计划，更将各类军事设施搬入此地，改造为控制巴拿马与中美地峡的前线基地。至此拉开了美巴冲突序幕。\n面对70年代苏攻美守的国际风云变换与巴拿马本土民族主义力量蓬勃发展的压力，卡特政府决定以适当让步阻止“第二古巴”诞生，1977年达成的《托里霍斯-卡特条约》便是显著体现：美国宣称将放弃对运河区的控制权并逐步移交相关资产，最终在1999年时彻底归还巴拿马运河的相关工作。\n可上述条款在目前主持巴拿马局势的托里霍斯将军眼中不过是“残缺胜利”：毕竟其中有关运河区“中立化与联合防御”的说辞无疑为美国卷土重来开了窗，而履行移交时间表也不排除配套额外政治条款的可能（卡特宣称，要么巴拿马实施改革，要么巴拿马将永远失去收回运河的机会）。对这位自1968年政变发迹，主张立即清算“寡头、军阀与装神弄鬼者联盟，仅靠士兵乱扣‘恶棍’帽子，耀武扬威欺压人民”的旧体制，并试图朝铁托与纳赛尔自立模式看齐的老将而言，为争取运河完全回归的战斗还会继续。为此，他决心在国民警卫队的监督下奉行“穷人革命”：新宪法引入了受控多党民主，土地改革与社会福利事业亦一日千里。除此之外，该国还建立了旨在吸纳中下层群众，并将社会党国际部分原则写入纲领的民主革命党，事实上开始走第三条道路。与此同时，托里霍斯政权在外交上也不避讳同美国的老对手们有所往来：其中既有来自智利的社会民主主义者，也包括尼加拉瓜，萨尔瓦多和危地马拉等地的反政府游击队，乃至成为社会主义古巴的座上宾。试图以此巩固自立立场。\n从目前的局势来看，托里霍斯将军显然打算继续将同美国的冷战打下去，而这就给了局外人以参战机会——考虑到巴拿马小国寡民，只需稍稍发力，便可达到四两拨千斤效果。尤其是考虑到该国正处于试图扭转经济衰退局面与社会转型的敏感期内……"
const T_665_2 := "支持托里霍斯政权，将同美帝国主义的拉锯战打下去！"
const T_665_3 := "鞭长莫及，鞭长莫及啊"
const T_665_4 := "用托里霍斯人头交换美国的芳心，是个不错的买卖……"
const T_665_5 := "和美帝国主义打交道？与虎谋皮！！"
const T_665_6 := "巴拿马的命运什么时候轮到我们决定了？"
const T_665_8 := "巴拿马裁缝"
const T_665_9 := "{0}{1}同志亲自会见巴拿马参赞，并重申了我国和巴拿马间的世纪友谊：自毛泽东时代以来，我国便坚定不渝的支持巴拿马人民争取民族独立，收回运河地区的正义事业。如今，我们更有空前的决心与毅力支持巴拿马人民完成这一目标。双方就此签署《中巴关于深化新时代关系的相关声明》，宣布在相互承认，平等互利，友好互助基础上建立合作伙伴关系。与此同时，{0}{1}同志还以贷款协定与援助项目等“辅助形式”向托里霍斯将军抛出橄榄枝，暗示其同台湾当局断交并坚定反美立场的必要性。\n托里霍斯将军直截了当地接受了我们的支持，并在《巴拿马之星》上发表相关声明：巴拿马历来珍视同中国人民的珍贵友谊，并决心在中国支持下将巴拿马革命进行到底，更要竭尽所能把插手中美地区局势的美帝国主义者彻底驱逐出去。没多久，所谓“中华民国”在巴拿马地区的牛皮藓便被扫地出门。与之相对的则是浩浩荡荡开入巴拿马城的中方专员与物资：涉及修建数十个水果加工厂，并实现当地农业机械化耕作，旨在实现当地绿色革命的项目已经开工；双方还就开发巴拿马国内铜矿建立合资项目，组织中国-巴拿马联合货运公司与渔业船队等达成长期合作协定，合作前景广泛。与此同时，托里霍斯也开始参照我国民兵经验组建“人民战斗团”，以此对付国内外潜在反对势力。\n与此同时，我方安保人员破获了一起针对托里霍斯的暗杀计划，并从擒获的特工处搜出了中情局间谍与巴拿马国内反动派策划阴谋行动的蛛丝马迹。巴拿马国内的反美情绪至此达到新高峰，数十万人涌上巴拿马城组织支持政府的大游行，并高呼“斗争没有结束”，“打倒第五纵队”等口号，支持政府采取更为坚决强硬的手段。而这只会让美方被动应战，并对先前签署的《托里霍斯-卡特条约》事实上采取“无限期搁置”态度。"
const T_665_10 := "{0}{1}同志连同苏联外交部长安德烈·葛罗米柯一道前往会见巴拿马参赞，并重申了我国和巴拿马间的世纪友谊：自毛泽东时代以来，我国便坚定不渝的支持巴拿马人民争取民族独立，收回运河地区的正义事业。如今，我们更有空前的决心与毅力支持巴拿马人民完成这一目标。与此同时，葛罗米柯部长则向其援引了学习“古巴经验”的必要性：“即便您不打算当共产党，美国人也会为您签好入党手续”，并以贷款协定与援助项目等“辅助形式”向托里霍斯将军抛出橄榄枝。\n没多久，《中巴关于深化新时代关系的相关声明》与《苏巴友好同盟互助条约》便一同出炉。托里霍斯将军直截了当地接受了现状，并在《巴拿马之星》上发表相关声明：巴拿马决心在社会主义世界的支持下将革命进行到底，更要竭尽所能把插手中美地区局势的美帝国主义者彻底驱逐出去。没多久，原属西方国家的各外资企业便被系数国有化。巴拿马至此全面倒向社会主义阵营，并以古巴为中转站接受来自莫斯科的全面援助：苏联同巴拿马达成了征购热带水果的长期协定，并就开发该国境内矿石建立起合资项目，配套的水果加工厂、木材厂等设施纷纷开工。当然，上述援助并非毫无代价：巴拿马政权听取了苏方顾问的改组意见，将巴拿马人民党并入民主革命党内，筹建统一社会党，以此领导全巴拿马地区工会运动。托里霍斯同时还允许苏方人员在巴拿马城派驻军事专员并安装大功率雷达——不言自明。\n与此同时，苏联克格勃破获了一起针对托里霍斯的暗杀计划，并从擒获的特工处搜出了中情局间谍与巴拿马国内反动派策划阴谋行动的蛛丝马迹。巴拿马国内的反美情绪至此达到新高峰，数十万人涌上巴拿马城组织支持政府的大游行，并高呼“斗争没有结束”，“打倒第五纵队”等口号，支持政府采取更为坚决强硬的手段。托里霍斯就此顺藤摸瓜，立即跳船加入经济互助委员会，事实上完全转化为古巴一般的“军事前线”。而这只会让美方被动应战，并对先前签署的《托里霍斯-卡特条约》事实上采取“无限期搁置”态度，美洲冷战至此升温。巴拿马确实转向了我们乐见的立场，但不完全仰仗我们……"
const T_665_11 := "{0}{1}决定就巴拿马问题特别致电华盛顿当局，暗示托里霍斯所作所为显然是向卡斯特罗看齐，若仍任其胡作非为，后果不堪设想。而这正中白宫一方下怀，没多久，来自中情局的特工便开始同国安工作人员“打成一团”，并开始将消灭托里霍斯的蓝图变为现实。没多久，我们便同绰号“菠萝”的巴拿马军官，八面玲珑的实用主义者曼努埃尔·诺列加取得联系，并依靠他的人脉为托里霍斯安排了场有去无回的旅行。\n最终，事故发生在1981年7月31日：一架属于巴拿马空军的飞机在塞罗马尔水塔附近坠毁。虽说飞机是在晴朗天气时发生事故，可由于彼时巴拿马雷达性能不足，覆盖范围有限，飞机坠毁的消息过了一天后才得以上报。随后的搜救则更是迟滞缓慢——当然，彼时也别想找到什么幸存者了：特种部队只能在坠机处给托里霍斯收尸，陪同的四名助手和两名飞行员跟着成了陪葬。巴拿马至此全国静默，为将军之死默哀。国葬结束后，托里霍斯的遗体被暂时迁徙至巴拿马老城卡斯科维耶霍的一座公墓中。接下来便是诺列加将军大显身手的时候：他以追查“托里霍斯将军谋杀”之名事实上引入戒严，并将无数反对派连根拔起。民主革命党迎来改组且被边缘化，其他政党则被暂停活动，形成了军事独裁的原汁原味。当然，这对我们来说只有好处：诺列加开放了国内多项资源的开采特许，中国企业至此得以踏入该国，并收获宝贵利润。"
const T_665_12 := "1981年7月31日，一架属于巴拿马空军的飞机在塞罗马尔水塔附近坠毁。虽说飞机是在晴朗天气时发生事故，可由于彼时巴拿马雷达性能不足，覆盖范围有限，飞机坠毁的消息过了一天后才得以上报。随后的搜救则更是迟滞缓慢——当然，彼时也别想找到什么幸存者了：特种部队只能在坠机处给托里霍斯收尸，陪同的四名助手和两名飞行员跟着成了陪葬。巴拿马至此全国静默，为将军之死默哀。国葬结束后，托里霍斯的遗体被暂时迁徙至巴拿马老城卡斯科维耶霍的一座公墓中。\n托里霍斯将军之死打破了该国军事领导层内的微妙平衡，权力改组旋即而至。弗洛伦西奥·弗洛雷斯得以接过托里霍斯的指挥棒，就任总司令一职。但国家权力对比正朝着更有利于诺列加的方向。显然巴拿马正调整路线，逐步结束革命。与此同时，出于挽救经济危机的需要。该国正越加采取紧缩政策，开放私营部门创收，并积极参与毒品交易……逐步走上经典卡特尔政权之路……"


## 原作 Event665.cs：巴拿马裁缝（巴拿马，三选项）。
## 触发：TimeScript.cs:11128-11133 —— (日>=31 且 月>=7 且 年>=1981) || (月>=8 且 年>=1981) || 年>=1982。
## 差异：
##  - 原版 names1+names2 动态姓名 → ws.leader.name_display（空则回退“华国锋”）。
##  - 结果0 双分支均设置巴拿马 Torg；原版分支B重复 Torg=true，合并为一次。
##  - 死代码 result_num==5 跳过。

func prepare(event_def: EventDef, world: WorldState) -> void:
	_bind_world()
	if event_def == null or world == null or event_def.options.size() < 3:
		return
	event_def.title = T_665_0
	event_def.description = T_665_1
	var china := world.get_country_by_legacy_index(1)
	var nicaragua := world.get_country_by_legacy_index(147)
	var usa := world.get_country_by_legacy_index(51)
	var opt := event_def.options
	if _branch_a(world, china, nicaragua) or (china != null and china.has_tag("sev")) \
			or (nicaragua != null and nicaragua.has_tag("亲苏")):
		_enable(opt[0], T_665_2)
	else:
		_disable(opt[0], T_665_3)
	if usa != null and usa.development == 1 and world.techs != null \
			and world.techs.unlocked.size() > 20 and world.techs.unlocked[20]:
		_enable(opt[1], T_665_4)
	else:
		_disable(opt[1], T_665_5)
	_enable(opt[2], T_665_6)


func execute(context: Dictionary) -> void:
	if not _bind_world():
		return
	var china := ws.get_country_by_legacy_index(1)
	var nicaragua := ws.get_country_by_legacy_index(147)
	var panama := ws.get_country_by_legacy_index(141)
	var opt := int(context.get("option_index", -1))
	match opt:
		0:
			if _branch_a(ws, china, nicaragua):
				_add(W.I_BUDGET, -80)
				_add(W.I_AGENTS, -50)
				_add(W.I_ARMY, -50)
				_add(W.I_THOUGHT_FREEDOM, 10)
				ws.influence_prc += 20
				_add_relation(EmpireData.USA, -200)
				if panama != null:
					panama.government = GameConstants.Government.REFORMIST
					panama.sub_government = GameConstants.SubGovernment.DEMOCRATIC_SOCIALIST
					panama.set_tag("对华贸易", true)
					panama.set_tag("亲中", true)
				context["result_text"] = _leader_name() + T_665_9.replace("{0}{1}", "")
			elif (china != null and china.has_tag("sev")) or (nicaragua != null and nicaragua.has_tag("亲苏")):
				_add(W.I_BUDGET, -40)
				_add(W.I_THOUGHT_FREEDOM, 10)
				ws.influence_prc += 10
				_add_power(EmpireData.USSR, 30)
				_add_relation(EmpireData.USA, -100)
				if panama != null:
					panama.government = GameConstants.Government.REFORMIST
					panama.sub_government = GameConstants.SubGovernment.DEMOCRATIC_SOCIALIST
					panama.set_tag("对华贸易", true)
					panama.set_tag("亲苏", true)
				context["result_text"] = _leader_name() + T_665_10.replace("{0}{1}", "")
		1:
			_add(W.I_AGENTS, -50)
			_add(W.I_BUDGET, 10)
			_add_power(EmpireData.USA, 30)
			_add_power(EmpireData.USSR, -15)
			if panama != null:
				panama.government = GameConstants.Government.AUTHORITARIAN
				panama.sub_government = GameConstants.SubGovernment.CONSTITUTIONAL_AUTHORITARIAN
				panama.set_tag("对华贸易", true)
			context["result_text"] = _leader_name() + T_665_11.replace("{0}{1}", "")
		2:
			if panama != null:
				panama.government = GameConstants.Government.AUTHORITARIAN
				panama.sub_government = GameConstants.SubGovernment.CONSTITUTIONAL_AUTHORITARIAN
			context["result_text"] = T_665_12


func _branch_a(world: WorldState, china: CountryData, nicaragua: CountryData) -> bool:
	if world == null or china == null or nicaragua == null:
		return false
	if china.has_tag("sev"):
		return false
	return (nicaragua.government == GameConstants.Government.REFORMIST and nicaragua.has_tag("亲中")) \
			or world.is_socialism(nicaragua, true)


func _leader_name() -> String:
	if ws.leader != null and ws.leader.name_display != "":
		return ws.leader.name_display
	return "华国锋"



