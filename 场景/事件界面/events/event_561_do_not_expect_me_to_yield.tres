[resource]
script = ExtResource("4_def")
event_id = "event_561"
source_event_number = 561
trigger_priority = 56100
title = "不要期待我屈服"
description = "1974年，哈比卜·布尔吉巴同穆阿迈尔·卡扎菲一起签署了《杰尔巴宣言》，承诺将突尼斯和利比亚合并为统一的阿拉伯伊斯兰共和国。但是，这一计划因突尼斯方面的内部异议而最终流产。这使得狂热的泛阿拉伯主义者卡扎菲一直记恨着布尔吉巴政权，因此，在合并计划失败后，他庇护了萨拉赫·本·优素福（布尔吉巴过去的竞争者，更支持纳赛尔的泛阿拉伯主义，后被前者暗杀）的一批支持者所建立的突尼斯进步力量民族阵线，为他们提供军事训练，以用于颠覆布尔吉巴政权。在卡扎菲的支持下，他们组织起约300人的武装突击队（后来被命名为“突尼斯解放军”）。\n在“黑色星期四”两周年之际，利比亚政府决定将他们派上用场。在预定的行动日期前不久，一部分突击队员在阿尔及利亚高级情报官员苏莱曼·霍夫曼上校的批准下，经阿尔及利亚特贝萨市前往加夫萨；而另一批队员则以自贝鲁特和罗马回国的突尼斯公民的身份，携突尼斯护照潜入其国内。\n我们是否要做些什么？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_5")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
