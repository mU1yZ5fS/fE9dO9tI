[resource]
script = ExtResource("4_def")
event_id = "event_359"
source_event_number = 359
trigger_priority = 35900
title = "月球计划——第一批仪器"
description = "科学家们已经提出了一个我们自己的项目，对地球唯一的天然卫星进行研究。第一阶段包括从飞行路线探索月球的简易设备，可能还包括一个着陆站。事实上，问题太多了——这个项目对我们来说太复杂了，有失败的可能。需要实施这一项目么？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("E359_date"), SubResource("E359_not_done358")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
