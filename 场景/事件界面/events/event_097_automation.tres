[resource]
script = ExtResource("4_def")
event_id = "event_097"
source_event_number = 97
trigger_priority = 9700
title = "自动化？"
description = "这是我们最伟大的科学突破－最近以来我们与经济完全落后的情况斗争，现在我们的科学家在基于计算机系统开发自动化经济计划的机制方面取得了杰出成就，并开始开发允许自动化计划和调节全国企业的系统。距离系统的全面实施仍有相当距离，但现在如果我们想取得自动化经济的成功的话，我们可以并也应该引入基层地区的系统和协作。但是，许多官员和党员，认为引入这样一个不熟悉的系统太匆忙了，他们显然不喜欢它…"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
