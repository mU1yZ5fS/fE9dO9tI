[resource]
script = ExtResource("4_def")
event_id = "event_078"
source_event_number = 78
trigger_priority = 7800
title = "永远的总统"
description = "据我们所知，今年6月菲律宾将举行第一次总统选举。自1972年以来，该国一直处于由费迪南德·马科斯总统引入的戒严状态，在1981年1月他解除了戒严。他担任总统期间的特点是腐败猖獗、裙带关系和对人权的侵犯，这导致反对派的活动急剧增加，其中一个领导核心是毛派的菲律宾共产党和由其组成的全国民主阵线，长期以来一直在对马科斯政权进行运动和游击战争。然而，基于国家经济管制的有效经济改革、通过戒严来镇压反对派以及美国的支持，很可能使他在即将到来的选举中获胜。然而，我们有一个极好的机会破坏他的胜利——利用特勤部队向菲律宾共产党和全国民主阵线提供武器，我们可以对马科斯政权和这些假选举发起大规模抗议。但是，它值得吗？事实上，在1975年马科斯断绝与台湾的关系，并与中国建立关系后，周恩来承诺，中华人民共和国不会干涉菲律宾的政策，因此，也许与马科斯合作更好？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
