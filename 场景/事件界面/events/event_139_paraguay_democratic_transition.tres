[resource]
script = ExtResource("4_def")
event_id = "event_139"
source_event_number = 139
trigger_priority = 13900
title = "民主化转型"
description = "独裁者斯特罗斯纳下野后，对新政府清洗“黄金四角”的行动不闻不问。总统顾问老马里奥·阿夫多·贝尼特斯、国家警察局长弗朗西斯科·布雷斯和首都警察署长拉蒙·杜阿尔特·维拉试图说服斯特罗斯纳再次发动政变，并且扶植其子，空军上校古斯塔沃·斯特罗斯纳为新总统。然而，这一阴谋引发了红党（ANR）的内部分裂，且让军方得知此事。斯特罗斯纳的效忠派赢得了党内斗争并完全控制了红党，在黑帮阿基诺家族驱散反斯特罗斯纳派的密会后，红党内部进行了清洗。“黄金四角”的亲信被任命为所有重要岗位的负责人，一场你死我活的冲突箭在弦上。总统罗德里格斯召集了一批有影响力的军官：利诺·奥维耶多将军、菲烈克斯·巴尔莫里上校、洛伦佐·卡里罗上校、马里诺·冈萨雷斯上校和何塞·塞戈维亚上校，准备发动政变。1989年2月3日夜，罗德里格斯所辖的步兵与装甲部队保卫并进攻了亚松森的主要行政大楼与军事设施。由于私人警卫作出反应，政变部队未能当场活捉斯特罗斯纳，反而让他在预估能够镇压叛乱后躲进警卫设施准备顽抗，直到其子古斯塔沃·斯特罗斯纳劝说其“只有死路一条”，斯特罗斯纳才最终停止抵抗，向总统与弗雷特斯·达瓦洛斯将军投降。天明时，政变部队控制了警卫设施，罗德里格斯向全国发表讲话：罢免斯特罗斯纳、进行民主化改革、继续尊重人权、同天主教会合作、保护巴拉圭天主教传统。巴拉圭的第一次自由选举不日将召开。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
