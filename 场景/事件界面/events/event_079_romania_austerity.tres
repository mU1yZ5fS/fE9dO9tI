[resource]
script = ExtResource("4_def")
event_id = "event_079"
source_event_number = 79
trigger_priority = 7900
title = "紧缩政策"
description = "长期以来，罗马尼亚在苏东阵营中就是一个特殊的存在。在格奥尔基·乔治乌-德治的领导下，罗马尼亚清除了党内的莫斯科派，遣返了苏联驻军，反对国际分工，支持独立自主，在中苏分裂中从亲苏转向中立，且反对去斯大林化，形成了一条独特的民族共产主义-斯大林主义路线，在社会主义建设上取得了较好的成绩。\n在德治逝世后，尼古拉·齐奥塞斯库以“开明派”的形象获得党内元老的支持，击败了德治的亲密同僚格奥尔基·阿波斯托尔（甚至有消息来源称其为德治真正中意的接班人）与强硬派的代表亚历山德鲁·德勒吉奇两位竞争对手，成为了罗马尼亚的新任掌舵者。\n政治上，齐奥塞斯库进行了解冻，平反了被德治清洗的人员，并放松了文化政策。他谴责苏联对捷克斯洛伐克的干预，并积极与西方和第三世界开展外交，成功在西方把自己塑造为一位受欢迎的开明派共产党政治家。与此同时，齐奥塞斯库逐渐将党内元老边缘化，提拔亲信，巩固了自己的地位。1971年，齐奥塞斯库发表了《七月提纲》，宣布要加强党的领导作用，强调社会主义政治挂帅和罗马尼亚爱国主义，这次重新收拢文化政策甚至被部分人士称为“小型文化革命”，它彻底结束了齐奥塞斯库上台后的解冻时期，这使得罗国知识分子不满。围绕在齐奥塞斯库周围的“知识分子集团”也将齐奥塞斯库个人崇拜推向了巅峰，他的一些家族成员甚至也得以进入政治领域。这些做法也催生了党内的异见，如党内元老康斯坦丁·珀尔伏列斯库就在1979年的罗共十二大上公开对齐奥塞斯库的做法提出了批评，随后他被驱逐出会场，开除出党；一些高级官员也对齐奥塞斯库的政策提出过不同意见，但他们都一一被边缘化。\n经济上，齐奥塞斯库追求独立自主，推行高积累、高速度、高指标的政策，致力于建设大型工程和打造完整的工业体系。罗马尼亚也得益于与西方的良好关系，能够在齐奥塞斯库执政初期对西方开放，加入了IMF与关贸总协定，甚至与欧共体开展贸易。这使得他能够通过借债进行发展，开展大型项目的建设，以出口石油赚取外汇还债。但1979年以来的能源危机和国际利率上升使得这一模式难以为继，罗马尼亚的外债在1980年达到110亿美元，经济形势迅速恶化。在这种情况下，罗马尼亚的消费品价格在20世纪70年代末开始上涨，现在齐奥塞斯库决定转向紧缩政策，这意味着大量减少进口和扩大出口，以便获得利润来偿还债务。这不可避免地限制了该国居民的用水和用电，许多产品实行定量配给制度，将严重地损害罗马尼亚人民的生活水平。\n齐奥塞斯库是苏东阵营中唯一与我国保持良好关系的统治者，帮助他度过这场危机可能是值得的？或者，是时候改变一下我们对罗马尼亚的政策了？毕竟，毛主席曾说：“罗马尼亚这个党，在思想上和赫鲁晓夫相同的东西很多，完全是一种实用主义，不讲是非，如果不改正错误，绝不会有什么好下场。”"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
