[resource]
script = ExtResource("4_def")
event_id = "event_331"
source_event_number = 331
trigger_priority = 33100
title = "“束手束脚”"
description = "在中央委员会定期全体会议上，规范城市企业活动的问题被提了出来。据称，由于国家的不断干预，这些企业“束手束脚”，无法正常运作。但也许恰恰相反，他们效率低下的原因是他们太过自由了？群众也这么觉得，与之相对，他们要求最终将小资产阶级处理掉，因为小资产阶级拒绝充分履行自己的义务，但同时又常常侵犯雇工的权利。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
