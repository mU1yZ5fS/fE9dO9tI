[resource]
script = ExtResource("4_def")
event_id = "event_415"
source_event_number = 415
trigger_priority = 41500
title = "我的格林纳达？"
description = "近日，加勒比海上的小岛国格林纳达爆发了一场政变。奉行威权民粹主义的格林纳达联合工党被推翻。在莫里斯·毕晓普的领导下，来自新宝石运动的左翼分子夺取了该国政权。新政府立即开始同古巴和苏联进行合作。但仍选择仍留在英联邦内。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
