[resource]
script = ExtResource("4_def")
event_id = "event_093"
source_event_number = 93
trigger_priority = 9300
title = "民主的故乡——第一幕"
description = "希腊仍在从1974年被推翻的军政府的影响中恢复过来，议会选举已经提上日程。在右翼方面，自由保守主义的新民主党在上届议会中占有最多的席位，组成了第一届后上校政权的民主政府。与此同时，希腊社会上的左翼支持度正在上升，民主社会主义的泛希腊社会主义运动（PASOK）和希腊共产党等左翼政党也有望在本次大选中获得更多席位，但其中还没有任何一个左翼政党能单独与新民主党抗衡。在加入北约和欧共体的问题上，左翼与右翼也存在较大分歧。右翼希望重新加入北约（该国在1974年因为土耳其入侵塞浦路斯而退盟）并进入欧共体，泛希腊社会主义运动和希腊共产党则持反对态度。选举的结果会严重影响该国的局势。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
