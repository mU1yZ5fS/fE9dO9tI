[resource]
script = ExtResource("4_def")
event_id = "event_400"
source_event_number = 400
trigger_priority = 40000
title = "盖棺定论"
description = "来自帕多瓦的消息，本地时间6月11日12时45分。意大利共产党领导人恩里科·贝林格因突发脑溢血辞世，享年62岁。出于备战欧洲议会选举的需要，这位领导人在数日前于帕多瓦举行了政治集会，并在演讲期间染上中风。即便身体有明显不适，但他最终还是坚持完成了演讲。而人群如唱诗班般狂热，持续不断地高呼“恩里科！”之名。恩里科·贝林格于集会结束后返回酒店休息，并在此后直接陷入昏迷，身体健康急剧恶化。即便当地医疗机构为抢救这位领导人使尽浑身解数，可最终仍无力回天。意大利政府已计划为其举行一场葬礼，以送别这位风云人物。"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
