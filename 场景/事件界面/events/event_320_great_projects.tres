[resource]
script = ExtResource("4_def")
event_id = "event_320"
source_event_number = 320
trigger_priority = 32000
title = "大型工程"
description = "主席同志，如你所知，在我国，饥荒一直是一个不小的麻烦。其中既有错误指导和瞎指挥造成的惨案，也有纯粹的自然原因造成的问题。自然方面的主要问题在于水土流失和资源不平等。针对这个问题，农林部的同志们建议我们开展一项名为“三北防护林”的计划，本计划旨在我国东北，华北和西北地区修建一条巨大的绿色防护林带，旨在维护水土环境的前提下适当改善当地的环境。同时，水利部门也希望我们能把更多的重心转在水的问题上，我国水利资源可以说是南多北少，而且有一条大河：雅鲁藏布江的水源常常被浪费。水利部的同志给出了一个雄心勃勃的计划，在东-中-西三线修建运河，把南部丰富的水资源顺着运河与水泵调往北方，不仅可以借用沿途的河道，还能做到把重力势能运用在发电机上，一举多得的好计划。不过上述方案最大的弊端还是极端的费钱，而且极度费时，毕竟这几项雄心勃勃的计划可是可以和斯大林时期的自然改造计划相提并论的。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
