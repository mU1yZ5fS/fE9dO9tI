[sub_resource type="Resource" id="E2_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_option")
text = "让选举见鬼去吧！我们最好给泰共送去更多武器以让他们进行游击战"
disabled_text = "我们无法给泰国共产党更多的武器装备了"
enable_condition = SubResource("Expr_opt2_enable")
effects = Array[ExtResource("2_effect")]([SubResource("E2_custom")])
result_text = "（结果由 event_016_thailand_elections.gd 动态生成）"

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1976.4"

[resource]
script = ExtResource("4_event")
event_id = "thailand_elections"
source_event_number = 16
title = "泰国大选"
description = "在1973年军政府垮台，权力移交给民选政府后，泰国进入了一段“混乱民主”的时期。共产党在印支半岛的胜利滋长了左翼情绪，由目前同时进行游击战和合法活动的毛主义泰国共产党领导。他们反对右翼军队，地主和其他保王党，这经常导致冲突。在这种情况下，以及泰国经济危机爆发的背景下，民主总理克立·巴莫被迫提前举行选举。也许这是我们的机会，如果不引诱该国变色，那么至少要动荡帝国主义在印度支那的堡垒？"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
