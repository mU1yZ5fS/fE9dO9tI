[ext_resource type="Script" path="res://数据脚本/事件效果/event_016_thailand_elections.gd" id="5_custom"]

[sub_resource type="Resource" id="E0_power"]
script = ExtResource("2_effect")
type = 10
key = "0"
value = 5.0

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_option")
text = "不干涉"
effects = Array[ExtResource("2_effect")]([SubResource("E0_power")])
result_text = "1976年的竞选活动伴随着血腥的街头冲突。冲突造成了大约30人死亡。社尼·巴莫所领导的民主党—因为比库克立·巴莫所领导社会行动党更右翼—从而获得了大多数的选票。右翼国家党领袖邦朋·阿滴列讪成为副总理。极左派明显失去了影响力。"

[sub_resource type="Resource" id="Expr_ag20"]
script = ExtResource("3_expr")
key = "agents"
value = 20.0

[sub_resource type="Resource" id="Expr_stab1"]
script = ExtResource("3_expr")
type = 25
target = "34"
key = "stab"
value = 1.0

[sub_resource type="Resource" id="Expr_opt1_enable"]
script = ExtResource("3_expr")
