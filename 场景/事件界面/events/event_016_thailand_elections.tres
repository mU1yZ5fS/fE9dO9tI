children = Array[ExtResource("3_expr")]([SubResource("Expr_ag20"), SubResource("Expr_stab1")])

[sub_resource type="Resource" id="E1_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_option")
text = "支持泰国共产党，创建一个左派与民主人士的联盟"
disabled_text = "我们没有力量支持泰国共产党"
enable_condition = SubResource("Expr_opt1_enable")
effects = Array[ExtResource("2_effect")]([SubResource("E1_custom")])
result_text = "（结果由 event_016_thailand_elections.gd 动态生成）"

[sub_resource type="Resource" id="Expr_army20"]
