[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_024_026_political_transition.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1976.11"

[sub_resource type="Resource" id="Expr_path_3"]
script = ExtResource("3_expr")
type = 21
key = "gang_of_four_path"
value = 3.0

[sub_resource type="Resource" id="Expr_agents_70"]
script = ExtResource("3_expr")
key = "agents"
value = 70.0

[sub_resource type="Resource" id="Expr_agents_50"]
script = ExtResource("3_expr")
key = "agents"
value = 50.0

[sub_resource type="Resource" id="Effect_transition"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Arrest all four"
disabled_text = "Requires at least 70 agents"
enable_condition = SubResource("Expr_agents_70")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_transition")])
result_text = "The radical leadership and its network were arrested, although their increased influence made the operation more costly and violent than it would have been earlier."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Arrest only Wang Hongwen and Jiang Qing"
disabled_text = "Requires at least 50 agents"
enable_condition = SubResource("Expr_agents_50")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_transition")])
result_text = "The two most ambitious radical leaders were removed, while their remaining partners were kept inside the government under a revised compromise."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Abandon the struggle and transfer power gradually"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_transition")])
result_text = "Further concessions made Jiang Qing the new de facto leader. Hua Guofeng retained his life and a formal place in politics, but lost control of the state and party."

[resource]
script = ExtResource("4_event")
event_id = "weak_alliance"
source_event_number = 26
title = "Weak alliance"
description = "The compromise between Hua Guofeng and the radical left is cracking. Moderate party members are openly dissatisfied, while the four demand broader powers and harsher action against the opposition. Wang Dongxing and the 8341 Special Regiment remain loyal, but the radicals are now stronger than they were in October."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_path_3")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
