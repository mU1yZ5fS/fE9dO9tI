[resource]
script = ExtResource("4_def")
event_id = "event_675"
source_event_number = 675
trigger_priority = 67500
title = "霍比特之春"
description = "由于第三位置政治势力在欧洲主要国家内的崛起，我们所熟知的雅尔塔-波茨南体系已摇摇欲坠，世界似乎退回到了20世纪30年代的模样：今天，英国，法国，意大利，西班牙与葡萄牙五国代表齐聚马德里，商讨将“百面旗帜的欧罗巴”汇聚于“一个从符拉迪沃斯托克到都柏林的欧-苏帝国”中的相关事宜。此后，上述国家便以法国在五十年代提出的《欧洲防务共同体》计划为蓝本建立了堪称二代《钢铁条约》的所谓“欧罗巴解放阵线”：该组织将为各国提供“充分保障国家主权的平台”，并确保其成员可在经济、政治与军事上共进退；且所有加入“欧罗巴解放阵线”的政权都需遵守1962年3月1日奥斯瓦尔德·莫斯利、让·蒂里亚特等人签署的《威尼斯宣言》：即认同罗马传统，具有共同历史纽带，要求选举产生欧洲议会、彻底清算战后世界秩序（即终结美苏政治集团并瓦解联合国）与清除美国与苏联在欧洲的军事存在。最后，欧洲第三位置政客们以号召欧洲各国“回归民族主义传统，痛打美帝共济会犹太资本主义和苏帝无神论犹太共产主义”的演讲结束了会议。雅尔塔体系迎来了一个对手，我们又该如何回应？"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
