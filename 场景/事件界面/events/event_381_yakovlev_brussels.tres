[resource]
script = ExtResource("4_def")
event_id = "event_381"
source_event_number = 381
trigger_priority = 38100
title = "从波恩到符拉迪沃斯托克"
description = "苏联领导人亚历山大·雅科夫列夫在布鲁塞尔发表了演讲，并宣布苏联与其他社会主义国家采用“五年经济一体化计划”。根据相关方案，苏东集团将在在20世纪90年代彻底融入欧洲经济共同体，而经济互助委员会将被完全解散。\n下面是对雅科夫列夫先生宣布改革开始讲话的简短摘要：\n“苏联与我国工人阶级从未吃过资本主义时代的苦，受过资本主义时代的罪。因此，出于实现我国社会主义现代化，并建设共产主义社会的需要。有必要‘铸列宁的剑为普列汉诺夫的犁’，这样才能保卫我国的革命成果。俄罗斯的欠发达是万恶之源，是革命减速的罪魁。所以，我国并没有建立真正的社会主义，而是选择了国家资本主义！现在，我们必须抛弃这种畸形的资本主义形式，转而让我国社会自然发展，这样才能看到共产主义的地平线！”\n“我们必须坚定采纳三大原则——即保卫我国革命成果不遭亚细亚反动生产方式侵蚀的革命护国主义；即社会主义所仰赖的源泉，如鱼离不开水的民主主义；即作为第三道路，足以让我国整合各类制度优势，并实现社会主义现代化，自然向共产主义社会过渡的社会主义市场制度。”\n很难预料苏联接下来将发生什么......"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
