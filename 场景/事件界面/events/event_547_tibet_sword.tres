[resource]
script = ExtResource("4_def")
event_id = "event_547"
source_event_number = 547
trigger_priority = 54700
title = "高原上巍峨利剑"
description = "当金珠玛米和平解放西藏时，灰头土脸的奴隶们第一次感受到了作为人的尊严，第一次感受到了挣脱枷锁的滋味。最广大的西藏劳动人民无比热爱着党和毛主席的人民政府，甚至将其代替了过往祷念的神佛菩萨。但是，三四十年来，阴魂不散的非法喇嘛流亡政府无时无刻紧盯着西藏的局势，他们罪恶的黑手仍然没有完全退去。而那些被党和政府宽大处理的喇嘛们也怀有不可告人的异心，他们之中的不少人仍旧做着复辟神权地位的春秋大梦。这个群体的一部分活跃分子已经蛊惑了一些本是善良淳朴的底层藏族群众，一些人甚至渗透进了新西藏的党政机关。为了保卫属于人民的社会主义政权，也为了藏区人民的彻底觉醒，我党决定带领最广大藏区人民在新西藏毅然地发动前所未有的社会革命和清算。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
