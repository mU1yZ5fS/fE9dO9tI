[resource]
script = ExtResource("4_def")
event_id = "event_302"
source_event_number = 302
trigger_priority = 30200
title = "解决党的问题"
description = "对越战争根本称不上成功。但也不能蠢到单单责怪军队。战争乃至于战败是个别党员的过错，需要加以处理。谁能做替罪羊呢？指责极左派以脱离现实的心态发动战争，妄想掀起革命狂潮？或是指责自由派，称其与帝国主义勾结，破坏了前线的可行计划？抑或，最好别再挑起党内战争，而是停留在抽象层面，对破坏者进行大方向上的谴责，并让两派中最可恶的次要人物辞职了事？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
