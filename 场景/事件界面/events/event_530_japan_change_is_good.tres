[resource]
script = ExtResource("4_def")
event_id = "event_530"
source_event_number = 530
trigger_priority = 53000
title = "变则善，常变则至善"
description = "1979年大选之后，在野党的内外问题愈发复杂和严重。其中社会党又是最突出的那一个。该党的派系斗争与路线论战并未随着派阀的解散而彻底结束，而这些争斗又反过来加深了城市市民眼中社会党的“主义”“斗士”“派阀”等形象标签——恰恰是他们所厌恶的点。公明党和民主社会党对于“社公民路线”也开始不再像以往一样热衷，转而在互相配合的同时与自由民主党进行接触，试图实现“自公民路线”。\n面对如此局面，社会党书记长飞鸟田一雄决心改革，在尝试修改纲领、调整路线的同时也与民主社会党和公明党展开积极洽谈。为了表明决心，社会党与日本共产党的关系开始愈发疏远，这让后者愤怒地指责这是社会党“在与自民党建立事实上的大联合的道路上迈出的第一步”。而诸多媒体对于“社公民路线”能否得到良好落实也提出了诸多质疑。\n针对当下的情况，我们的相关人员提供了两种方案：第一种是以公明党和民主社会党为主体，迫使社会党做出彻底的改变并在此基础上建立一个新的中道革新政党；第二种是依靠工会、青年组织、反战反核团体等社会组织，促使社会党向共产党靠拢以实现曾经的“社共共斗”构想。那么，您的选择是？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
