custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "用一切手段去支持抗议者煽动推翻萨达特政权，并帮助纳赛尔主义者重掌权力"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们决定积极干预局势，支持抗议者。在我们的介入下，各个城市的抗议者得以在纳赛尔的旗号下组织起统一的指挥机构，许多武器通过秘密渠道落入他们手中，他们立即使用这些武器攻占政府机构，并筑起街垒同军警对峙。在开罗和其他一些城市，对峙双方开始了巷战并导致多人死伤。萨达特试图争取美国和以色列的支持，但这使文官和军官都对他产生了强烈的敌意，他们没有忘记1973年的失败。为了避免局势进一步恶化，不满萨达特的文官和军官联合起来发起了一场政变，逮捕了萨达特，并开始同抗议者进行谈判。在谈判后，正统纳赛尔主义者阿里·萨布里成为了新总统，开始将纳赛尔主义者、抗议者的组织、政变萨达特的官员组织、温和社会主义者、拆解出的阿社盟三党和共产党团结在全新的阿拉伯埃及纳赛尔民族团结阵线中。新政府开始恢复泛阿拉伯主义的宣传，并重启在阿拉伯共和国联邦中的活动，并恢复同苏联、中国、利比亚、叙利亚、伊拉克和其他社会主义国家的友好关系。与此同时，新总统还宣布取消“开放”政策和经济自由化，重启世俗化、打压伊斯兰主义者并在苏联和我们的援助下进行更开明的再纳赛尔主义化。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "帮助利比亚和叙利亚消灭萨达特"
disabled_text = "我们真的需要北非吗？"
enable_condition = SubResource("Expr_opt1")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们最终决定通过利比亚和叙利亚来干涉埃及内政。利比亚和叙利亚在我们的帮助和苏联克格勃的秘密批准下，联合起来制订了一项消灭埃及总统的计划。不久，利比亚和叙利亚就派遣民兵和特工秘密进入埃及进内，混入抗议者的队伍，并秘密向抗议者提供武器。而克格勃特工则通过埃及共产党和民族统一进步党的组织网络串联起抗议者，并将他们吸收入组织之内。10月19日，安瓦尔·萨达特在开罗解放广场对埃及抗议者讲话时被一名愤怒的抗议者枪击，当场身亡；而抗议者组织的民兵冲入位于开罗的政府机构，强行解除了萨达特的亲信们的职务，埃及进入了事实上的小型内战中。在叙利亚、利比亚、我们和苏联的支持下，抗议者取得了胜利。最终，经过多方妥协，前副总统、纳赛尔主义者阿里·萨布里成为了埃及新总统，而民族进步统一党的领导人哈立德·毛希丁在苏联人的支持下成为了总理，新政权由纳赛尔主义者、民族进步统一党和埃及共产党组成的阿拉伯埃及人民民主团结阵线领导。新政府开始恢复泛阿拉伯主义的宣传，并重启在阿拉伯共和国联邦中的活动，恢复同苏联、中国、利比亚、叙利亚、伊拉克和其他社会主义国家的友好关系。与此同时，新总统还宣布取消“开放”政策和经济自由化，重启世俗化、打压伊斯兰主义者并在政治上比纳赛尔时期更加左倾和开明。萨布里已经恢复了与苏联关于恢复经济和军事技术合作的谈判，至此，埃及再次转向左翼——但不是转向我们的方向……"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "纳赛尔主义者和萨达特都不值得信任，我们将培植埃及共产主义者的联合阵线，为革命做准备"
disabled_text = "我们不会支持深入干预北非国家"
enable_condition = SubResource("Expr_opt2")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们决定组织埃及共产主义者。我们联系到埃及的合法左翼——由共产主义者和自由军官组织的老革命哈立德·毛希丁领导的民族进步统一党，由他们牵头组织包含正统派的埃及共产党和受毛主义影响的“革命运动”组织等共产主义反对派的埃及人民民主革命阵线，阵线在民族进步统一党的合法旗帜下活动，积极在抗议活动中发展支持者，并向工会和军队渗透。萨达特将军队调动军队镇压了抗议。为了帮助埃及平息骚乱，国际货币基金组织向埃及提供了1.5亿美元的贷款，以重建秩序。削减食品补贴的政策被暂停，该国不得不重新考虑其国内和外交政策。在暴动发生后的几天里，萨达特总统在一次公开演讲中声称，这些暴力是由共产党组织和煽动的，得到了苏联和左翼的支持。在演讲中，骚乱的部分责任也被归咎于利比亚。对骚乱的镇压最终也结束了埃及的政治解冻，对持不同政见者的政策被再次收紧。去纳赛尔主义化仍在继续，埃以和平进程也在继续进行，萨达特也因此在阿拉伯世界被视为叛徒。在不久的未来，以色列将逐步归还西奈半岛。1977年3月，叙利亚、利比亚联合谴责埃及试图与以色列达成和解，埃利、埃叙断绝外交关系，阿拉伯共和国联邦无法继续维持，最终在同年6月30日正式解散。1978年，阿拉伯社会主义联盟被正式拆解，其中间翼组成了民族民主党，成为了埃及的新执政党。埃及的问题并没有在实际上解决，它仍在不久的将来等着萨达特……"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "纳赛尔主义者和萨达特都不值得信任，我们将培植埃及自由主义者的联合阵线，为革命做准备"
disabled_text = "这些人和萨达特的区别很大吗？"
enable_condition = SubResource("Expr_opt3")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们决定组织埃及自由主义者。我们联系到埃及的合法右翼——自由军官组织的老革命穆斯塔法·卡梅尔·穆拉德领导的自由社会主义党，由他们牵头组织包含前华夫脱党成员（1978年，他们重组为新华夫脱党）等自由主义反对派的埃及民族自由联盟，阵线在自由社会主义党的合法旗帜下活动，积极在抗议活动中发展支持者，并向中产阶层、知识分子群体和军队渗透。萨达特将军队调动军队镇压了抗议。为了帮助埃及平息骚乱，国际货币基金组织向埃及提供了1.5亿美元的贷款，以重建秩序。削减食品补贴的政策被暂停，该国不得不重新考虑其国内和外交政策。在暴动发生后的几天里，萨达特总统在一次公开演讲中声称，这些暴力是由共产党组织和煽动的，得到了苏联和左翼的支持。在演讲中，骚乱的部分责任也被归咎于利比亚。对骚乱的镇压最终也结束了埃及的政治解冻，对持不同政见者的政策被再次收紧。去纳赛尔主义化仍在继续，埃以和平进程也在继续进行，萨达特也因此在阿拉伯世界被视为叛徒。在不久的未来，以色列将逐步归还西奈半岛。1977年3月，叙利亚、利比亚联合谴责埃及试图与以色列达成和解，埃利、埃叙断绝外交关系，阿拉伯共和国联邦无法继续维持，最终在同年6月30日正式解散。1978年，阿拉伯社会主义联盟被正式拆解，其中间翼组成了民族民主党，成为了埃及的新执政党。埃及的问题并没有在实际上解决，它仍在不久的将来等着萨达特……"

[sub_resource type="Resource" id="Option_4"]
script = ExtResource("1_option")
text = "埃及内政并不值得我们关心"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "萨达特将军队调动军队镇压了抗议。为了帮助埃及平息骚乱，国际货币基金组织向埃及提供了1.5亿美元的贷款，以重建秩序。削减食品补贴的政策被暂停，该国不得不重新考虑其国内和外交政策。在暴动发生后的几天里，萨达特总统在一次公开演讲中声称，这些暴力是由共产党组织和煽动的，得到了苏联和左翼的支持。在演讲中，骚乱的部分责任也被归咎于利比亚。对骚乱的镇压最终也结束了埃及的政治解冻，对持不同政见者的政策被再次收紧。去纳赛尔主义化仍在继续，埃以和平进程也在继续进行，萨达特也因此在阿拉伯世界被视为叛徒。在不久的未来，以色列将逐步归还西奈半岛。1977年3月，叙利亚、利比亚联合谴责埃及试图与以色列达成和解，埃利、埃叙断绝外交关系，阿拉伯共和国联邦无法继续维持，最终在同年6月30日正式解散。1978年，阿拉伯社会主义联盟被正式拆解，其中间翼组成了民族民主党，成为了埃及的新执政党。埃及的问题并没有在实际上解决，他仍在不久的将来等着萨达特……"

[resource]
script = ExtResource("4_event")
event_id = "egyptian_unrest"
source_event_number = 37
trigger_priority = 3700
title = "埃及：纳赛尔的遗产"
description = "自贾迈勒·阿卜杜勒·纳赛尔去世后，阿拉伯社会主义联盟提名穆罕默德·安瓦尔·萨达特作为新总统。类似勃列日涅夫，一开始，纳赛尔的支持者将萨达特视为临时性的过渡人物，他们认为萨达特只不过是前总统的傀儡，因此将萨达特视为可以轻松操纵的人。不久，萨达特通过发起“纠正运动”，清洗了以阿社盟总书记、副总统阿里·萨布里为首的多位纳赛尔主义者，通过这些举措，他得以保住总统职位，成为真正的埃及领导人。|此后，萨达特逐渐开始抛弃纳赛尔的政治遗产，开始进行解冻和体制改革。对内，在政治上，萨达特削弱了秘密警察的权力，放松了政治控制，党禁被逐渐被放开，当局允许成立反对党，并开始拆解执政党阿拉伯社会主义联盟——其右翼组成了自由社会主义党，中间翼成立了埃及阿拉伯社会主义党，左翼组成了民族进步统一党。在解冻的影响下，许多政治犯被释放，民间建制外政治活动再次开始活跃，如埃及共产党在1975年重组，而为了打压纳赛尔主义者和共产主义者等左翼势力，萨达特选择扶持曾被纳赛尔打压的伊斯兰主义者，用他们的力量打压民间的左翼影响力，随着伊斯兰主义者影响力的上升，世俗化被逆转了；在经济上，埃及开始减少阿拉伯社会主义的要素，进行名为“开放”（Infitah）的经济自由化,鼓励外资的进入，进行市场化，结束国营部门的主导地位，并削减福利政策。对外，萨达特疏远了苏联，减少了两国合作，结束了苏联驻军，逐渐抛弃了泛阿拉伯主义（疏远了利比亚、埃及和叙利亚共同组织的阿拉伯共和国联邦），并开始同以色列接触，接近西方阵营，这些政策使得埃及同阿拉伯国家的关系极度恶化了，埃及同利比亚和叙利亚等国家近乎敌对。这些政策使得萨达特在国内外都不受欢迎。在经济下行、短缺经济和失业问题的影响下，当局的决定上涨食品价格的改革措施成为了压垮骆驼的最后一根稻草。很快，自发的民众抗议从亚历山大兵工厂开始蔓延到开罗、卢克索和阿斯旺等多个大城市，工人、学生和各个社会团体很快被动员起来，人群中不乏纳赛尔的支持者，他们高呼“纳赛尔，纳赛尔！”、“‘开放’政策是盗贼，正在窃取埃及人民的早餐”等口号，并对警察局等政府机构和阿社盟党部发起攻击。显然，现在正是干预埃及的好机会，我们是否要做些什么？"
display_script = ExtResource("5_custom")
show_notification = false
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3"), SubResource("Option_4")])
