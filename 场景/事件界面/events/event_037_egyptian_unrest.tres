[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Support the uprising and provoke Sadat's overthrow"
disabled_text = "Requires 60 agents, 40 budget or reserves, a hard political line, and an unstable Egypt"
enable_condition = SubResource("Expr_direct")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Armed unrest overthrew Sadat and installed an anti-American government of national unity under Ali Sabri."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Help Libya and Syria overthrow Sadat"
disabled_text = "Requires 20 agents, 20 budget or reserves, and political line no higher than 2"
enable_condition = SubResource("Expr_indirect")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Libyan and Syrian services attempted to remove Sadat with our covert assistance."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Egypt's affairs do not concern us"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Sadat made enough concessions to stabilize Egypt and continued his rapprochement with the United States and Israel."

[resource]
script = ExtResource("4_event")
event_id = "egyptian_unrest"
source_event_number = 37
title = "The end of the Egyptian pasha"
description = "Bread riots and opposition to Anwar Sadat have shaken Egypt. Direct intervention could install a friendly government; a cheaper covert operation may depend on regional contacts."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
