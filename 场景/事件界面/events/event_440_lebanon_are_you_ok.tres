[resource]
script = ExtResource("4_def")
event_id = "event_440"
source_event_number = 440
trigger_priority = 44000
title = "黎巴嫩，你可还好"
description = "自1975射向巴士的第一枪开始，整个国家脆弱的和平被彻底打破。宛如玻璃器皿的东地中海巴黎被撕下繁荣的面纱，狠狠地摔在了地上。数不尽的冲突、积压许久的仇恨覆压了古尔奈特的圣树，而皑皑白雪下是望不到头的尸骨。马龙派、逊尼派、什叶派、德鲁兹、亚美尼亚、巴勒斯坦……小小的十万平米分出了许多个派系，而生活在此的人们于分裂的漩涡中痛苦地撕裂自己。然而，现在巴勒斯坦问题的和平收场使得盘踞在这个国家的数十万巴勒斯坦人即将回归，而内战的局面也再一次发生深刻变化。也许，是时候结束这场旷日已久的兄弟之争，让雪松再一次生长在各群体的团结之壤上？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
