[resource]
script = ExtResource("4_def")
event_id = "event_506"
source_event_number = 506
trigger_priority = 50600
title = "从1922到1984"
description = "噩耗传来！中国人民的老朋友，几内亚人民的革命领袖塞古·杜尔死于一连串的心脏病并发症。随后，几内亚民主党选举了路易斯·兰萨那·贝阿沃吉作为总统。新总统相当软弱，这使得党内的右翼分子——兰萨纳·孔戴察觉到了可乘之机，他一直谋求向塞古·杜尔复仇。在美国的鼎力支持之下，孔戴掀起了一场反对贝阿沃吉总统的政变。事实上夺取了政权，原政府军仍然在负隅顽抗并呼吁世界各国的帮助。最高领导人同志，杜尔总统一直不希望西方势力染指他的祖国。几内亚是一块弹丸小国，但毛泽东主席也曾经鼎力支持过他们反抗葡萄牙干涉军。也许，到我们该出手的时候了？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
