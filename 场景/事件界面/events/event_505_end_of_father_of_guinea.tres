[resource]
script = ExtResource("4_def")
event_id = "event_505"
source_event_number = 505
trigger_priority = 50500
title = "几内亚之父的终结"
description = "主席同志，来自科纳克里的紧急报道。由于塞古·杜尔总统灾难性的经济政策，导致几内亚经济水平暴跌，而政府又限制私人企业的发展。着导致了小商贩的大规模罢工，而且正有激进化的倾向。杜尔总统本人对社会主义本就有极大的热情，但这可能会成为他的转折点。他很有可能会为了经济援助而转向美国。几内亚毕竟曾经作为非洲反殖民运动的桥头堡，常常支持我国的行动。也行我们应当拉这位“几内亚之父”一把？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
