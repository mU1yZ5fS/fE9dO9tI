[resource]
script = ExtResource("4_def")
event_id = "event_148"
source_event_number = 148
trigger_priority = 14800
title = "重蹈覆辙"
description = "1983年的委内瑞拉选举是笼罩在严重的经济危机——“黑色星期五”的阴云下进行的。当前的主要候选人有二：一是民主行动党（AD）的海梅·卢辛奇，他主张在严峻的经济形势下结合关键的社会项目来解决经济问题；二是来自社会基督教党（COPEI），曾在60年代任总统的拉斐尔·卡尔德拉。他持政治上的自由立场与经济上的社民立场，并主张在外交上促进拉丁美洲排除美英影响。除此之外，军方正在酝酿一个非法的军官团体“玻利瓦尔革命运动200（MBR-200）”。这一团体由军官乌戈·查韦斯与弗朗西斯科·卡德纳斯领导，坚持特立独行的左翼玻利瓦尔主义，将他们的使命视为从巨头、外企与腐败政客的统治手中解放委内瑞拉人民。但是他们真的有机会吗？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]()
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
