[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_033_041_world_and_party.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1977.5"

[sub_resource type="Resource" id="Expr_modifier_3_inactive"]
script = ExtResource("3_expr")
type = 3
key = "3"

[sub_resource type="Resource" id="Expr_budget_not_2"]
script = ExtResource("3_expr")
type = 22
key = "budget"
value = 2.0

[sub_resource type="Resource" id="Expr_line_not_0"]
script = ExtResource("3_expr")
type = 22
key = "political_line"
value = 0.0

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Do nothing; enough concessions"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "The Cultural Revolution ended, but no further liberalization followed. The public and reform wing were disappointed."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Limit change to modest civil liberalization"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Repressive control was reduced slightly, pleasing the public and non-radical party factions."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Loosen control and reduce pressure on tradition"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Civil controls and anti-traditional campaigns were relaxed, while state atheism remained."

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "Loosen control and supervise religion rather than suppress it"
disabled_text = "The current political line cannot accept this degree of liberalization"
enable_condition = SubResource("Expr_line_not_0")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Freedom of conscience was recognized under continued state supervision of religious institutions."

[resource]
script = ExtResource("4_event")
event_id = "end_of_revolution"
source_event_number = 35
title = "End of revolution"
description = "The Cultural Revolution is being wound down. The leadership must decide whether this means only an end to its excesses or a broader relaxation of civil and religious policy."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_modifier_3_inactive"), SubResource("Expr_budget_not_2")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
