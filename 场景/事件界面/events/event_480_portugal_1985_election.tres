[resource]
script = ExtResource("4_def")
event_id = "event_480"
source_event_number = 480
trigger_priority = 48000
title = "葡萄牙1985年议会选举"
description = "社会党和社民党的“中央集团“终于解体了。两党在此前就已多次产生分歧，最后，因为社民党主席卡洛斯·莫塔·平托在1986年总统选举候选人问题上同联盟内大部分人都有分歧，他最终被迫辞职。社民党代表大会任命前财政部长阿尼巴尔·卡瓦科·席尔瓦取代了他的职位，成为该党新的主席。同时，苏亚雷斯总理决定进行部长改组，由鲁伊·马切特接替平托担任国防部长和副总理的职位。由于社民党党内和国家层面的权力更迭，中央集团两党间就继续组建联合政府展开谈判。在谈判失败后，社会民主党的部长们于6月13日向共和国总统提交了辞呈。12天后，社会党因为没能获得议会关于组建少数派政府的信任，马里奥·苏亚雷斯向共和国总统提交了辞呈，安东尼奥·拉马尔霍·埃内亚斯总统宣布将在10月6日提前举行立法选举。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
