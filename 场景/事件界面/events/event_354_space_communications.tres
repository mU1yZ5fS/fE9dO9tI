[resource]
script = ExtResource("4_def")
event_id = "event_354"
source_event_number = 354
trigger_priority = 35400
title = "空间通信"
description = "我国正在迈入一个新时代，卫星通信将不仅能满足军事需要。有人提议在近地轨道上构建一个通信卫星系统，但这将需要许多少用的卫星，而发射地球同步卫星则需要一种特殊的火箭......另一方面，我们可以连通某国已经建成的网络。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("E354_date"), SubResource("E354_tech"), SubResource("E354_not353r2")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
