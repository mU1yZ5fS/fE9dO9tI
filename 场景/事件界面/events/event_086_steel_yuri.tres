[resource]
script = ExtResource("4_event")
event_id = "steel_yuri"
source_event_number = 86
title = "“钢铁尤里”的终结"
description = "根据我方特工的情报，长期饱受肾病折磨的苏联克格勃主席尤里·安德罗波夫的健康状况正在急剧恶化。与此同时，克格勃内部的反对派正在与米哈伊尔·苏斯洛夫和弗拉基米尔·谢尔比茨基秘密联络。一场针对安德罗波夫的政治风暴正在酝酿……"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_gate")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
