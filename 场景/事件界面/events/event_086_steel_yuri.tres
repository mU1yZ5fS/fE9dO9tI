[resource]
script = ExtResource("4_event")
event_id = "steel_yuri"
source_event_number = 86
title = "“钢铁尤里”的终结"
description = "我们得知，列昂尼德·勃列日涅夫刚刚前往维也纳，与美国总统卡特就第二轮的限制战略武器谈判协议进行谈判。当然，帝国主义者不会做任何“战略进攻性武器的限制”，但我们对此不感兴趣——勃列日涅夫将在国外待上足够的时间，因此我们能够打击苏联克格勃领导人尤里·安德罗波夫。他被认为是逐步改善苏美关系和在匈牙利模式下进行大规模改革的支持者。现在安德罗波夫开始被认为是勃列日涅夫最有可能的继任者。有两种方法可以让他出局：要么以因肾衰竭死亡为掩盖，从肉体上消灭他，要么试图“推动”与苏联秘密警察领导人关系极差的苏共主要理论家米哈伊尔·苏斯洛夫和苏共乌克兰党组织领导人弗拉基米尔·谢尔比茨基，召开苏共中央紧急全会，在会上彻底击垮安德罗波夫。乌克兰克格勃由维塔利·费多尔丘克上校领导，他服从谢尔比茨基，与他的盟友没有矛盾，所以我们成功的机会很大。"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_gate")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
