[resource]
script = ExtResource("4_def")
event_id = "event_392"
source_event_number = 392
trigger_priority = 39200
title = "“历史性妥协”的终结？"
description = "最近，前总理与天主教民主党的领导人阿尔多·莫罗在距他家不远的罗马一地被{1}绑架。莫罗是天主教民主党内最具影响力的领导人之一，并支持“历史性妥协”政策。也就在他被劫持的那天，莫罗原计划将参加议会内的重要会议，并提出在意大利建立民族团结政府的议案：其领导人是现任政府首脑安德烈奥蒂，并允许共产党人参与该政府。\n然而，激进分子成功制造了一场车祸，以此解除了前总理周围的防御并将其囚禁。他们声称，他们打算拿莫罗与数位已被当局逮捕的恐怖分子做交换。\n绝大多数的议会政党反对同恐怖分子谈判。认为这将“拿整个意大利的政治生态去实施绥靖政策”。只有意大利社会党的领导人贝蒂诺·克拉克西呼吁同恐怖分子谈判，以解救前总理莫罗。\n许多来自其他国家的政客，包括教皇与联合国秘书长均呼吁恐怖分子释放莫罗。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
