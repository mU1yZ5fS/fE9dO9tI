[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_071_073_india_and_iran_war.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1979.7"

[sub_resource type="Resource" id="Expr_result_min"]
script = ExtResource("3_expr")
type = 0
key = "india_election"
value = 1.0

[sub_resource type="Resource" id="Expr_result_max"]
script = ExtResource("3_expr")
type = 1
key = "india_election"
value = 2.0

[sub_resource type="Resource" id="Expr_janata"]
script = ExtResource("3_expr")
type = 21
key = "india_election"
value = 1.0

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Wish them good luck"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Janata's coalition collapsed, reopening the way for Indira Gandhi and a pro-Soviet Indian course."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Support Janata's left wing"
disabled_text = "Available only if Janata won the preceding election"
enable_condition = SubResource("Expr_janata")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Chinese aid helped Janata's left wing purge dual-party rightists and preserve a left-oriented government."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Support Janata's right wing"
disabled_text = "Available only if Janata won the preceding election"
enable_condition = SubResource("Expr_janata")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Chinese aid helped Janata's right wing remove the left and establish a liberal Indian government."

[resource]
script = ExtResource("4_event")
event_id = "janata_crisis"
source_event_number = 72
trigger_priority = 720
title = "Rescue the drowning"
description = "India's Janata coalition is splitting between left and right. China may let it collapse or subsidize one wing's victory."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_result_min"), SubResource("Expr_result_max")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
