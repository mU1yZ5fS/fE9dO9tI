[resource]
script = ExtResource("4_def")
event_id = "event_636"
source_event_number = 636
trigger_priority = 63600
title = "别让我失望啊，兄弟"
description = "尼加拉瓜的历史过去是、现在仍然是一个悲剧。地理的偶然性使该国付出了帝国主义的觊觎所导致的一切代价。如中美洲其他国家一样，在中美洲联邦解体后，尼加拉瓜就步入了几十年的保守派考迪罗统治中。1893年何塞·桑托斯·塞拉亚发动的自由主义革命将该国带向了中美洲最有成效也最名副其实的自由派统治。然而好景不长，美国的入侵还是宣告了自由党时代的终结。新政府甫一上台便将该国包括海关、银行和铁路在内的全部国有资产与内政外交的方方面面尽数交予美国，修建运河权也被仅仅以三百万美元出售。这激起了尼加拉瓜人民络绎不绝的反抗。\n就这样，在1926年为反对由美国扶持的保守派总统而发起的护宪战争与随后的反美战争中，一只叫奥古斯托·塞萨尔·桑地诺的跳蚤使美洲的巨人蒙受了前所未有的耻辱。桑地诺领导的是衣衫褴褛的小股游击队，却同时与一万二千名美国侵略者以及本国的国民警卫队作战打了整整七年。1933年，美国海军陆战队灰溜溜地离开了尼加拉瓜。他们走了，却没有真走。他们在离开的位置上安放上阿纳斯塔西奥·索摩查和他的士兵。在即将解放祖国之际，桑地诺却主动放下了武装，应邀到马那瓜与萨卡萨总统和谈。在战场中不败的桑地诺，却在背叛中被击败。而杀害他的刽子手、国民警卫队司令索摩查却在美国人的授意下被扶持为总统，属于无冕儿皇帝的时代到来了。\n然而，尽管他的名字不准被提及，尽管关于他的记忆被杀害他的凶手和凶手的儿子们所禁止，但尼加拉瓜人民的抵抗意志从来不会因为一个爱国者的倒下而消散。1961年11月8日，在古巴革命所掀起的拉丁美洲革命浪潮中，卡洛斯·丰塞卡等年轻人们与桑地诺的老战友桑托斯·洛佩斯上校成立了桑地诺民族解放阵线（FSLN）。在接下来的十年里，桑解阵的行动以切·格瓦拉的理论和古巴革命的例子为蓝本。随着政府的残暴、腐败的加剧与经济的日益恶化，桑地诺民族解放阵线的声望也日益水涨船高。在60年代末的行动遭受挫败后，桑解阵就在人民群众中进行动员，默默积蓄力量。1974年的行动打破了四年的沉默，让桑解阵再次回到大众的视线之内。\n在左翼方面，FSLN没有竞争对手：尼加拉瓜社会党（与社会党国际中的类似名称政党不同，该党宣称自己为马列主义政党）和1967年从前者中分裂出的尼加拉瓜共产党是彻头彻尾的改良派，躲在资产阶级反对派佩德罗·华金·查莫罗领导的UDEL的庇护之下，主张毛主义、坚持武装斗争的人民行动运动-马列（MAP-ML）也相对桑解阵来说规模较小。\n不过，由于战术与组织模式的分歧，桑解阵的领导层在70年代逐渐分裂为三个派系——主张格瓦拉主义与中国和越南式人民战争的“持久人民战争派”，主张以城市工人阶级为核心进行焦点主义式游击战的“无产阶级派”，与主张在两派观点中寻求平衡并团结一切反索摩查力量、立即进行一场起义的“起义派”（起义派还中混杂了一些左翼民族主义者与解放神学人士）。在1974年小索摩查又一次决定连任总统后，“民主解放联盟”（UDEL）成立了，该政党联盟涵盖了从资产阶级民主反对派到亲莫斯科的尼加拉瓜社会党在内的所有以合法手段进行斗争的异见者。而桑解阵在同年12月对一次政府高层聚会的袭击使得索摩查颜面尽失，他很快宣布国家进入紧急状态，并发动了大规模的镇压行动。\n尽管有着古巴的支持，但尼加拉瓜的革命者们仍然迫切的需要外部援助，也许我们该拉他们一把。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
