[resource]
script = ExtResource("4_def")
event_id = "event_142"
source_event_number = 142
trigger_priority = 14200
title = "选举，选举......"
description = "秘鲁的1985年大选于4月14日周日举行。选举将产生共和国总统与参众两院议员。秘鲁的行政与立法部门的人员被完全更新，前任总统卸任后授予终身参议员。民众中的左翼势力高度支持两位左翼候选人。一方是议会联盟产生的极左翼政党左翼联盟（UL），另一方是奉行第三道路的泛美主义政党阿普拉党（APRA）；余下的右翼是自由保守主义的基督教民主党（DK）与中右翼的人民党（NP），但他们只有结为选举联盟才有获选可能。阿普拉党的提名候选人是阿兰·加西亚，持有坚定的反帝、反北美、反共立场，主张维护某种形式的国家资本主义，梳理国家在社会中的主导地位。左翼的竞争者是前共产党员、前政治犯的阿方索·巴特兰斯，他不光是左翼公认的领导人，同时也是自治镇怀坎的创建者，在那里，各社区合作社与居住社区直选产生集中委员会以管理整个自治区。在其利马市长的任期，巴特兰斯还参与组织了一项社会援助分发项目。基民党-人民党选举联盟的候选人是来自基民党的路易斯·雷耶斯，利马市的前市长，民主政治、言论自由、无监管市场经济的狂热支持者。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
