[resource]
script = ExtResource("4_def")
event_id = "event_553"
source_event_number = 553
trigger_priority = 55300
title = "新意属东非？"
description = "革命民族主义在意大利母国的胜利极大的刺激了西亚德·巴雷少将。在欧加登的灾难性冒险之后，索马里民主共和国进入了灾难性的岁月：经济停滞，内政崩溃而低烈度反叛如波涛般涌起。无意驰援摩加迪沙的美利坚合众国伤透了巴雷的心，而这给了罗马方面一个新的机会。弗朗哥·弗雷达的意大利人民国正式向索马里民主共和国伸出了橄榄枝，包括了改建道路、翻修建筑、大兴基建、提供军事援助与帮助平叛。而索马里承诺将为意大利企业开采当地资源和发展畜牧业提供税收优惠，并提供49年的特许经营权，意大利还获得了摩加迪沙港口的一处土地作为海外保障基地。如今，大批意大利人的投资和意大利军人正开赴索马里，巴雷也在意大利顾问的帮助下改造国家。他颁布了一份新的宪法并修改了索马里革命社会主义党章程。在尊重索马里古老的伊斯兰互助传统和马克思主义的经济原理之外，额外吸纳了意大利革命的先进经验，奉行“3M主义”为指导思想的巴雷主义正在成为显学。联合国与美国对东非的政治变化深感遗憾。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_5"), SubResource("Expr_6"), SubResource("Expr_7")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
