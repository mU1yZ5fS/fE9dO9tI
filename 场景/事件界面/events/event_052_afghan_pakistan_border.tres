[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/core/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/core/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/core/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/core/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_048_052_063_afghanistan.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1980.1"

[sub_resource type="Resource" id="Expr_war_active"]
script = ExtResource("3_expr")
type = 30
value = 5.0

[sub_resource type="Resource" id="Expr_pakistan_pro_china"]
script = ExtResource("3_expr")
type = 10
key = "亲中"
target = "31"

[sub_resource type="Resource" id="Expr_ussr_side_1"]
script = ExtResource("3_expr")
type = 34
key = "ussr_side"
value = 1.0
target = "5"

[sub_resource type="Resource" id="Expr_ussr_side_not_1"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_ussr_side_1")])

[sub_resource type="Resource" id="Expr_country_1_sev"]
script = ExtResource("3_expr")
type = 10
key = "sev"
target = "1"

[sub_resource type="Resource" id="Expr_country_1_not_sev"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_country_1_sev")])

[sub_resource type="Resource" id="Expr_usa_deal"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_ussr_side_not_1"), SubResource("Expr_country_1_not_sev")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "让巴基斯坦自己处理"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "一切顺其自然。巴基斯坦当局压制激进的宗教宣传，且不允许过境者携带武器通过巴阿边境检查站，但他们既没有实力也没有意愿去实现这两点。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "向巴基斯坦提供援助，帮助巡逻边境和抓捕伊斯兰主义者"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们明确地提醒布托，现在是时候制止在边界上猖獗的恐怖分子，并派遣我们的特工和军队帮助他，我们和巴基斯坦开始在边界巡逻并追查激进的伊斯兰主义组织。我必须说，行动是成功的——伊斯兰主义者没有料到巴基斯坦会做出如此严厉的反应，他们几乎都毫无防备。原教旨主义者们现在发现自己没有能力像之前一样“援助”阿富汗兄弟了。祝他们在挖通过边境线下的地道时耗死自己。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "和美国谈判"
disabled_text = "不要帮助反动派！"
enable_condition = SubResource("Expr_usa_deal")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "在与美国达成默契协议并劝说布托不要妨碍我们之后，我们开始将美国武器和顾问运送到巴基斯坦-阿富汗边境，将它们移交到圣战者那里，圣战者半合法的越过边境，前往阿富汗。这大大帮助了阿富汗反政府武装对抗阿富汗民主共和国的进程，另一方面，美国的资金以“中介服务”的名义到了我们的口袋里。"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "搞这些干嘛？不如在巴基斯坦为阿富汗毛派起义者组织基地（需要5百万预算）"
disabled_text = "我们不能帮助阿富汗民主共和国的毛派起义者"
enable_condition = SubResource("Expr_ussr_side_1")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们继续向阿富汗的毛派起义者提供援助，驱赶伊斯兰教徒离开边境，为毛派组织训练营和补给中心，在那里我们提供武器并派遣教官，这对这些起义者有很大帮助。巴基斯坦当局还同意我们不受阻碍地向阿富汗派遣人员和武器。当然，我们必须为建立这样一个基础设施而付出代价，这同时使军队的供应紧张，苏联和美国对此也并不满意。"

[resource]
script = ExtResource("4_event")
event_id = "afghan_pakistan_border"
source_event_number = 52
trigger_priority = 520
title = "善邻难做"
description = "从阿富汗反政府示威活动和民主共和国政府的回应开始，许多伊斯兰激进分子、恐怖分子和阿訇逃往巴基斯坦，在那里他们与当地的“同事”结盟。随后，在阿富汗武装暴乱开始后，难民涌入巴基斯坦，在那里成立的伊斯兰恐怖组织的等待下。巴基斯坦本身并没有采取特别的措施来解决这些问题，似乎布托在这方面有足够的问题，但为他提供地下援助，以制止这种暴行是值得的吗？另一方面，美国对通过巴基斯坦帮助阿富汗叛军的可能性非常感兴趣，如果布托不能以任何方式与美国达成一致，那么他可以与我们达成一致。通过巴基斯坦运送美国武器和顾问，我们可以“削减”美国人的钱和打击苏联社会帝国主义。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_war_active"), SubResource("Expr_pakistan_pro_china")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
