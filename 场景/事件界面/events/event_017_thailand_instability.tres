[resource]
script = ExtResource("4_event")
event_id = "thailand_instability"
source_event_number = 17
title = "泰国动乱"
description = "在社会动荡和左右派频繁对抗的背景下，九月，泰国王室决定召回极右将军他侬·吉滴卡宗，这位前总理需要对其在位期间的血腥镇压负责，他本人在1973年被公众演说推翻。吉滴卡宗本人并不想参与政治，只想做个僧侣，但关于他的回归和与国王会面的官方公告还是引起了部分人的不满。总理巴莫辞职，但被驳回，一波学生和工会示威的浪潮席卷全国，其中一起发生在泰国国立政法大学，右翼武装分子已经突袭了那里。根据我们的信息，军队正准备严酷镇压示威。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
