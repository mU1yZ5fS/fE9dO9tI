[resource]
script = ExtResource("4_def")
event_id = "event_349"
source_event_number = 349
trigger_priority = 34900
title = "地下城市"
description = "在过去10年里，北京附近建起了一个巨大的防空洞系统，在与美国或苏联发生核战争的情况下，此处可以为数十万人提供避难所。近年来，国际局势逐渐改善，因此人们便开始怀疑起这一防空洞系统的必要性。我们是否应当把它们转交给民政当局？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
