[resource]
script = ExtResource("4_def")
event_id = "event_077"
source_event_number = 77
trigger_priority = 7700
title = "往脸上吐口水，在下巴上打一拳，头上一颗子弹"
description = "我们的居民从阿尔巴尼亚传达了有趣的信息——阿尔巴尼亚领导人恩维尔·霍查和党和国家第二号人物，总理穆罕默德·谢胡之间似乎存在严重分歧。很长一段时间以来，他是霍查最亲密的伙伴，并通过西古里米的力量确保了国家的稳定，亲自监督了20世纪40年代中期的几次镇压反动派叛乱，并以这句话闻名：“谁反对我们的领导地位，就往他脸上吐口水，在下巴上打一拳，而如果必要的话，在头上赏一颗子弹”，这甚至（在一个消极的背景下）在苏联共产党第二十二次代表大会上被引用。然而，在赫鲁晓夫的去斯大林化和阿尔巴尼亚与苏联和社会主义阵营分裂的背景下，阿尔巴尼亚的经济开始因这种孤立而遭遇困难。在劳动党中，越来越多的人倾向于恢复与苏联、南斯拉夫甚至意大利的关系，显然，谢胡就是其中之一，他被迫解决阿尔巴尼亚经济的紧急问题。他比霍查更实际和更倾向于谈判，他可能是一个有用的盟友。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
