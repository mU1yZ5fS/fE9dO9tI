[resource]
script = ExtResource("4_def")
event_id = "event_100"
source_event_number = 100
trigger_priority = 10000
title = "政府危机"
description = "在没完没了的政变后，孟加拉国的军权暂时稳定了，“元老”侯赛因·穆罕默德·艾尔沙德成功拿下总统宝座。在两年的右翼独裁政权下，针对自由派和社会主义者的大规模压迫开始了，他们大部分都是左翼党派人民联盟的成员。同时，国内耕者无其田与高层权力腐败始终没解决。由此，难对付的反政府示威在全国开始了，诉求之一就是启动大选程序。依我之见如果我们支持努力改善对华关系的政府，我们就能稳定东南亚的政变温床，但是如果我们能更激烈地催化示威并组织反对派对抗艾尔沙德，忠诚于我们的人就能掌权，但是全世界会怎么看?还是我们干脆不要介入？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
