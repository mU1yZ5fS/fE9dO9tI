[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_048_052_063_afghanistan.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1980.1"

[sub_resource type="Resource" id="Expr_iran_not_authoritarian"]
script = ExtResource("3_expr")
type = 26
key = "government"
value = 0.0
target = "8"

[sub_resource type="Resource" id="Expr_pakistan_pro_usa"]
script = ExtResource("3_expr")
type = 10
key = "亲美"
target = "31"

[sub_resource type="Resource" id="Expr_pakistan_not_pro_usa"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_pakistan_pro_usa")])

[sub_resource type="Resource" id="Expr_iran_pro_usa"]
script = ExtResource("3_expr")
type = 10
key = "亲美"
target = "8"

[sub_resource type="Resource" id="Expr_iran_not_pro_usa"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_iran_pro_usa")])

[sub_resource type="Resource" id="Expr_khalq_le_parcham"]
script = ExtResource("3_expr")
type = 32
key = "afghan_khalq"
value = 0.0
target = "afghan_parcham"

[sub_resource type="Resource" id="Expr_parcham_le_khalq"]
script = ExtResource("3_expr")
type = 32
key = "afghan_parcham"
value = 0.0
target = "afghan_khalq"

[sub_resource type="Resource" id="Expr_equal_factions"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_khalq_le_parcham"), SubResource("Expr_parcham_le_khalq")])

[sub_resource type="Resource" id="Expr_event_49_not_done"]
script = ExtResource("3_expr")
type = 6
ref_event_id = "afghan_soviet_plot"

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Do not respond"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "The DRA used Soviet advisers and aviation to gain an early advantage over the Islamists."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Condemn the entry of Soviet troops"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "China joined Western condemnation of the Soviet intervention as a violation of Afghan sovereignty."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Support the entry of Soviet troops"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "China defended the intervention as a legitimate measure under the Soviet-Afghan treaty."

[resource]
script = ExtResource("4_event")
event_id = "afghan_soviet_intervention"
source_event_number = 51
trigger_priority = 510
title = "Just hold and then leave..."
description = "Soviet troops have entered Afghanistan under conditions that leave China little direct leverage. We may condemn, endorse, or ignore the intervention."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_iran_not_authoritarian"), SubResource("Expr_pakistan_not_pro_usa"), SubResource("Expr_iran_not_pro_usa"), SubResource("Expr_equal_factions"), SubResource("Expr_event_49_not_done")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
