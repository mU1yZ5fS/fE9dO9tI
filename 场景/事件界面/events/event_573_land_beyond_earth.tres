[resource]
script = ExtResource("4_def")
event_id = "event_573"
source_event_number = 573
trigger_priority = 57300
title = "地球那边的土地"
description = "主席同志，现在是时候审视澳大利亚的局势了。如果我们想要确立自身在亚太地区的中心地位，便必须留意英美国家布置的压舱石。通过背靠美英特殊关系与英联邦框架，澳大利亚在国际社会内的影响力只会比其国土面积来得更“过分”：现代澳洲国家的历史可追溯至17世纪的大航海时代与将此地作为“热带版西伯利亚”运营的英国殖民当局，相关历史使其不可避免地沾染了大西洋主义习气。太平洋的巨型英国一面对美英亦步亦随，甘心充当冷战马前卒；一面则通过投资东南亚反共政权构筑太平洋岛链，施加其影响力。当然，澳洲也并非没有从反革命壁垒变为革命前线的机会：澳大利亚的工会组织相当发达，吸纳了该国超过50%的劳动人口，罢工活动也堪称世界之最。只要我们能将这些“经济行为”转化为政治斗争，那便能迈出澳洲社会主义转型的第一步。不过，前提当然是物色好本地激进左翼代言人：最好的选择当然是依托支持毛派群众路线的澳共（马列），并以此为基础从奉行欧洲共产主义的澳共、亲苏的社会党和托洛茨基主义者内萃取支持——前者正面临类似英国欧共同行的政策失利问题，后者则仍深陷匈牙利事件泥潭，苦于派系分裂。\n当然，我们也有其他的选择。考虑到澳大利亚政府并不排斥与东亚大国建立关系，通过合法手段争权也并非不可：我们的老朋友，中澳“建交之父”高夫·惠特拉姆在1972年大选内力压霸占政坛23年的自由党-乡村党保守派联盟，组建了工党领导的新政府。然而，工党政府与保守派联盟控制的议会不可避免地发生了排异反应。为兑现选举承诺而推行的系统改革方案也在经过议会后变得缺胳膊少腿，导致政府陷入债务危机。工党预备改选政府通过新预算案的举措则迎面撞上总督任命的自由党领袖马尔科姆·弗雷泽的挑战。而弗雷泽也不负选民……抑或是总督厚望，赢下了1975与1977年内选举。然而其争议举动事实上拉开了宪政危机序幕，使该国的政治生态长期处于不健康状态。只要我们能找准时机押注建制派其一，回报自不必多言。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
