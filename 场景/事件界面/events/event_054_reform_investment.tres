[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_053_062_reform_and_alliances.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_delay"]
script = ExtResource("3_expr")
type = 0
key = "investment_delay"
value = 6.0

[sub_resource type="Resource" id="Expr_not_liberal"]
script = ExtResource("3_expr")
type = 22
key = "political_line"
value = 2.0

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Postpone the question"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "The leadership postponed foreign investment while reformist frustration and public expectations continued to rise."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Open special economic zones"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Coastal special economic zones opened to foreign investment and won an enthusiastic response from Western governments and corporations."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Open the SEZs and state enterprises to joint investment"
disabled_text = "The current political line rejects such extensive foreign penetration"
enable_condition = SubResource("Expr_not_liberal")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "China opened both coastal zones and state joint ventures to foreign capital, accelerating reform and sharpening party conflict."

[resource]
script = ExtResource("4_event")
event_id = "reform_investment"
source_event_number = 54
trigger_priority = 540
title = "Reform and openness: investment"
description = "Six months into the opening course, the leadership must decide how far foreign capital may enter the Chinese economy."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_delay")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
