[sub_resource type="Resource" id="Expr_left_branch"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_line_at_least_1"), SubResource("Expr_party_at_most_7")])

[sub_resource type="Resource" id="Expr_coalition_67"]
script = ExtResource("3_expr")
