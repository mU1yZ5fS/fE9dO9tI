[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_042_047_revolution_and_reform.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_year_1979"]
script = ExtResource("3_expr")
key = "year"
value = 1979.0

[sub_resource type="Resource" id="Expr_year_1978"]
script = ExtResource("3_expr")
type = 21
key = "year"
value = 1978.0

[sub_resource type="Resource" id="Expr_month_1"]
script = ExtResource("3_expr")
key = "month"
value = 1.0

[sub_resource type="Resource" id="Expr_day_8"]
script = ExtResource("3_expr")
key = "day"
value = 8.0

[sub_resource type="Resource" id="Expr_1978_date"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_year_1978"), SubResource("Expr_month_1"), SubResource("Expr_day_8")])

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_year_1979"), SubResource("Expr_1978_date")])

[sub_resource type="Resource" id="Expr_agents_50"]
script = ExtResource("3_expr")
key = "agents"
value = 50.0

[sub_resource type="Resource" id="Expr_line_2"]
script = ExtResource("3_expr")
key = "political_line"
value = 2.0

[sub_resource type="Resource" id="Expr_islamists"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents_50"), SubResource("Expr_line_2")])

[sub_resource type="Resource" id="Expr_line_1"]
script = ExtResource("3_expr")
key = "political_line"
value = 1.0

[sub_resource type="Resource" id="Expr_shah"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents_50"), SubResource("Expr_line_1")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Do not interfere"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Iranian protests and strikes continued without Chinese participation."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Support left-wing organizations"
disabled_text = "Requires 50 agents"
enable_condition = SubResource("Expr_agents_50")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Contacts were established with Tudeh, Maoist, communist, and left-nationalist organizations."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Support the Islamists"
disabled_text = "Requires 50 agents and political line above 1"
enable_condition = SubResource("Expr_islamists")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Our agents established relations with Iranian Islamic movements, including Khomeini's circle."

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "Support the ruling Shah"
disabled_text = "Requires 50 agents and political line above 0"
enable_condition = SubResource("Expr_shah")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Chinese agents joined SAVAK in supporting the Pahlavi monarchy against its opposition."

[sub_resource type="Resource" id="Option_4"]
script = ExtResource("1_option")
text = "Support the democrats"
disabled_text = "Requires 50 agents"
enable_condition = SubResource("Expr_agents_50")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Contacts and aid were arranged for the National Front and other democratic organizations."

[resource]
script = ExtResource("4_event")
event_id = "iranian_revolution"
source_event_number = 42
trigger_priority = 420
title = "Iranian revolution"
description = "Strikes and demonstrations are spreading across Iran. China can remain aloof or cultivate leftists, Islamists, the Shah, or democratic opposition before the struggle is decided."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3"), SubResource("Option_4")])
