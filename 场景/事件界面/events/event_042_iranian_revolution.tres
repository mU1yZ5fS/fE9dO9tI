script = ExtResource("3_expr")
type = 1
key = "political_line"
value = 1.0

[sub_resource type="Resource" id="Expr_left_ready"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents_50"), SubResource("Expr_line_at_most_1")])

[sub_resource type="Resource" id="Expr_line_at_least_1"]
script = ExtResource("3_expr")
type = 0
key = "political_line"
value = 1.0

[sub_resource type="Resource" id="Expr_party_at_most_7"]
