[resource]
script = ExtResource("4_def")
event_id = "event_144"
source_event_number = 144
trigger_priority = 14400
title = "二次选举"
description = "在成功击败军方反对势力后，厄瓜多尔的文官政府重要能够建立一个稳定的政治与法律体制。在屡次经历军事政变之后，厄瓜多尔终于得以进行第二轮自由多党选举。共有九个政党角逐总统与议会席位，其中呼声最高的有三：来自保守主义基督教社会党（PSC）的候选人莱昂·费夫雷斯-科尔德罗·里瓦德内拉；激进自由党所分裂出的社会民主主义人士所组成的“民主左派党”（“ID”），他们提名了罗德里戈·博尔哈·塞瓦略斯作为候选人；左翼民粹主义政党人民力量集中党（CFP）的代表是安赫尔•杜阿尔特，但是如果这一政党不能与其他左翼政党结盟，将无法赢得议会多数席位。本次选举将异常胶着。在左翼政党陷入分裂的同时，所有右翼政党都聚拢在了基社党的周围，组成了国家重建阵线（NRF）以竭尽全力获胜。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
