[resource]
script = ExtResource("4_def")
event_id = "event_137"
source_event_number = 137
trigger_priority = 13700
title = "回归民主"
description = "乌拉圭的此届大选于1984年11月25日举行。本次大选的召开标志着一个重要的历史时刻，即乌拉圭独裁统治的结束以及民主政治的回归。尽管由于政治犯仍然存在让本次大选蒙上了污点，白人领导人威尔逊·费雷拉·阿尔杜纳特和广泛阵线（BF）人士利伯·塞雷尼被关押在特立尼达军营，但无论如何，根据尼古拉斯·斯托拉切·阿罗萨的选举监督法庭报告，本次大选不存在选举违规。除决定总统人选外，本次大选还将选举产生副总统、30名参议员和99名众议员。选举的主要竞争者如下：来自科罗拉多党，公开反对军事政变，来自科罗拉多党（CP）的胡利奥·玛丽亚·桑吉内蒂；自由保守主义的国家党（NP）代表阿尔贝托·祖马兰；所有左翼力量组成的广泛阵线（BF）提名胡安·何塞·克罗托吉尼为候选人。选举的最终结果将决定乌拉圭未来几年的命运。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
