[resource]
script = ExtResource("4_def")
event_id = "event_402"
source_event_number = 402
trigger_priority = 40200
title = "驴象之争-第二幕"
description = "共和党于1980年遭遇失败后，2位候选人参与了此次总统选举：分别是反共主义战鹰，支持实现经济自由化、扩张性外交政策与国内保守主义的乔治·赫伯特·布什其对手则是吉米·卡特时代的副总统，民主党人沃尔特·蒙代尔。蒙代尔呼吁政治自由，支持暂停核试验与《平等权利修正案》，并呼吁和平，倡导与苏联实现和平共存。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
