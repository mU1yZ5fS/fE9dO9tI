[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_033_041_world_and_party.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1977.12"

[sub_resource type="Resource" id="Expr_agents"]
script = ExtResource("3_expr")
key = "agents"
value = 50.0

[sub_resource type="Resource" id="Expr_influence"]
script = ExtResource("3_expr")
key = "global_influence"
value = 50.0

[sub_resource type="Resource" id="Expr_pressure"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents"), SubResource("Expr_influence")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Do not intervene"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "The Iraqi Communist Party left the National Front and went underground."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Condemn the Baath leadership"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Condemnation worsened relations with Baghdad without saving the communist coalition."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Use intelligence and political pressure to force dialogue"
disabled_text = "Requires 50 agents and 50 global influence"
enable_condition = SubResource("Expr_pressure")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Covert pressure halted the repression and preserved a fragile Baathist-communist coalition."

[resource]
script = ExtResource("4_event")
event_id = "iraqi_coalition"
source_event_number = 36
title = "Coalition collapse?"
description = "The Baathist leadership is repressing the Iraqi Communist Party despite their formal National Front. China may abstain, protest, or pressure both sides into an unstable compromise."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
