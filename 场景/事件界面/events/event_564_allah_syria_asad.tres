[resource]
script = ExtResource("4_def")
event_id = "event_564"
source_event_number = 564
trigger_priority = 56400
title = "安拉，叙利亚，阿萨德"
description = "1970年“纠正运动”之后，阿萨德赶走了复兴社会党叙利亚支部的新左派，暂停并倒退了新左派过激的土改和国有化政策，进行实用主义政策，支持吸引外资，继续与苏联合作，引入家族政治，并将一部分阿拉伯社会主义者和科学社会主义者的党派组成亲政府的民族进步阵线，但是前任政府政策造成的后果并未完全退却。且1976年介入黎巴嫩内战和1979年的阿颇勒炮兵学校屠杀将叙利亚的反对派运动推上高潮，叙利亚局势变得愈发不稳定。\n主席同志，叙利亚是我们的老朋友，我们是否按照既往方针支持他们，亦或者，如果之前有帮助过反对派们，可以选择支持他们推翻阿萨德政权？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
