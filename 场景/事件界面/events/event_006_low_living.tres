[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]

[sub_resource type="Resource" id="Expr_trigger"]
script = ExtResource("3_expr")
type = 1
key = "living"
value = 100.0

[sub_resource type="Resource" id="E0_people"]
script = ExtResource("2_effect")
key = "people_support"
value = 50.0
[sub_resource type="Resource" id="E0_money"]
script = ExtResource("2_effect")
key = "money"
value = -100.0
[sub_resource type="Resource" id="E0_living"]
script = ExtResource("2_effect")
type = 1
key = "living"
value = 300.0
[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_option")
text = "为社会项目紧急拨款"
effects = Array[ExtResource("2_effect")]([SubResource("E0_people"), SubResource("E0_money"), SubResource("E0_living")])
result_text = "预算中大量资金被紧急拨给社会事业、住房建设和援助贫困人口。社会问题正在逐步得到解决，人民对此感到满意。"
[sub_resource type="Resource" id="Expr_usa_rel"]
script = ExtResource("3_expr")
type = 8
key = "0"
value = 500.0
[sub_resource type="Resource" id="Expr_ussr_rel"]
script = ExtResource("3_expr")
type = 8
key = "1"
value = 500.0
[sub_resource type="Resource" id="Expr_foreign"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_usa_rel"), SubResource("Expr_ussr_rel")])
[sub_resource type="Resource" id="E1_freedom"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = 200.0
[sub_resource type="Resource" id="E1_influence"]
script = ExtResource("2_effect")
key = "influence"
value = -100.0
; 差异：原版 influencePRC，端口无 effect 键，用 influence(I_INFLUENCE) 近似。
[sub_resource type="Resource" id="E1_living"]
script = ExtResource("2_effect")
type = 1
key = "living"
value = 300.0
[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_option")
text = "请求外国的人道主义救援"
disabled_text = "我们无法寻求帮助"
enable_condition = SubResource("Expr_foreign")
effects = Array[ExtResource("2_effect")]([SubResource("E1_freedom"), SubResource("E1_influence"), SubResource("E1_living")])
result_text = "我们要求外国提供人道主义援助。来自不同国家和联合国的志愿者免费分发食物，并为人们提供住房。然而，这些行动向我国人民和国际社会表明，我们无法独自处理这一人道主义危机，这大大损害了我们的声誉。"
[sub_resource type="Resource" id="Expr_dev13"]
script = ExtResource("3_expr")
key = "development"
value = 13.0
[sub_resource type="Resource" id="E2_freedom"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = 100.0
[sub_resource type="Resource" id="E2_party"]
script = ExtResource("2_effect")
key = "party_support"
value = -500.0
[sub_resource type="Resource" id="E2_living"]
script = ExtResource("2_effect")
type = 1
key = "living"
value = 300.0
[sub_resource type="Resource" id="E2_loyalty"]
script = ExtResource("2_effect")
type = 21
key = "2,3"
value = -100.0
[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_option")
text = "软硬兼施地号召企业解决社会问题"
disabled_text = "我们不能号召企业，因为我们根本没有企业"
enable_condition = SubResource("Expr_dev13")
effects = Array[ExtResource("2_effect")]([SubResource("E2_freedom"), SubResource("E2_party"), SubResource("E2_living"), SubResource("E2_loyalty")])
result_text = "通过制定劳动法、政府命令和软硬兼施，我们成功地迫使我们的商人为人民提供社会支持，改善工作条件和住房条件。然而，他们并不特别乐意与人分享他们的财富，并且利用他们与高层的关系向你施加压力。"
[sub_resource type="Resource" id="Expr_party500"]
script = ExtResource("3_expr")
key = "party_support"
value = 500.0
[sub_resource type="Resource" id="E3_party"]
script = ExtResource("2_effect")
type = 1
key = "party_support"
value = 0.0
[sub_resource type="Resource" id="E3_people"]
script = ExtResource("2_effect")
key = "people_support"
value = 100.0
[sub_resource type="Resource" id="E3_living"]
script = ExtResource("2_effect")
type = 1
key = "living"
value = 300.0
[sub_resource type="Resource" id="E3_loyalty"]
script = ExtResource("2_effect")
type = 20
value = -300.0
[sub_resource type="Resource" id="Opt3"]
script = ExtResource("1_option")
text = "牺牲党和官员的利益，安排慈善活动"
disabled_text = "白花花的银子就这样花出去？党绝不允许！"
enable_condition = SubResource("Expr_party500")
effects = Array[ExtResource("2_effect")]([SubResource("E3_party"), SubResource("E3_people"), SubResource("E3_living"), SubResource("E3_loyalty")])
result_text = "在党的特别会议上，你向党的最高领导层解释了形势的严重性，并决定拨款解决党的社会需求，带头吸引党员、干部参加慈善活动。这提高了人民的生活水平，但党并不满意。"

[resource]
script = ExtResource("4_event")
event_id = "low_living_standard"
source_event_number = 6
title = "低生活水平"
description = "你的政策导致了这个国家的生活水平的灾难性下降，人民生活在恶劣的条件下，绝大多数人甚至没有能力购买基本必需品。当然，这导致了许多抗议并要求我们解决这场危机。由于士兵们非常不乐意去逮捕抗议者，所以我们不能指望军队。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
fire_only_once = false
