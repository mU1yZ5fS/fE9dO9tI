[resource]
script = ExtResource("4_def")
event_id = "event_510"
source_event_number = 510
trigger_priority = 51000
title = "黄金海岸的再革命？——第二幕"
description = "加纳的经济状况持续恶化，利曼软弱的文官政府逐渐和前军政府一样腐败和低效。到1981年底，民众终于无法忍受Kalabule了，经济危机和种族冲突席卷了整个加纳。1982年1月1日晚，罗林斯领导了一场不流血的军事政变，推翻了利曼政府。暂停了该国的宪法，所有政党的活动都被禁止，前政府的腐败官僚被人民法庭审判。权力移交给由罗林斯担任主席的临时全国保卫委员会（NPD）。他说，军方打算进行一场“民族民主革命”，从根本上改善加纳人的生活。所有地方执行机构都被解散，其权力被移交给保卫革命委员会（CPR），全国基层组织和工矿企业成立各级“人民保卫委员会”和“工人保卫委员会”，其目的是“让人民参与治理国家并建立一种新型的民主”。这些委员会积极参与打击犯罪，腐败，走私，控制企业和机构的活动，从事食品分配等。临时全国保卫委员会进行了一系列国有化，并建立了价格控制制度。1982年1月1日晚，在几内亚的支持下，罗林斯与卡迈克尔领导全非人民革命党成功开展了一场不流血的军事政变，推翻了利曼政府。打着恩克鲁玛旗号的人民民族党被宣布为“背离恩克鲁玛的修正主义者”，除了全非人民革命党外，所有政党的活动都被禁止，前政府的腐败官僚被人民法庭公审。权力移交给由全非人民革命党领导的加纳非洲人民革命委员会，实施“人民民主的制度”，各级人民革命委员会将取代旧政府。新政府宣布将继承恩克鲁玛的遗志，致力于全非洲在科学社会主义下的真正解放。新政府开始实施国家资本主义以恢复经济，加纳将在不久后开展社会主义改造。新的政权展示出了一系列革命社会主义的色彩。我们也应该表态了。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
