[resource]
script = ExtResource("4_event")
event_id = "kazakh_german"
source_event_number = 85
title = "哈萨克斯坦的德意志族自治区"
description = "根据我方特工的情报，苏联领导层正在考虑在哈萨克斯坦的埃雷门托地区建立德意志族自治区。这一决定在哈萨克人中引起了强烈不满。哈萨克共产党中央委员会第一书记金姆哈梅塔·库纳耶夫（勃列日涅夫的亲信）暗中支持反对者。我们可以利用这场危机……"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_gate")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
