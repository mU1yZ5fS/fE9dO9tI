[resource]
script = ExtResource("4_def")
event_id = "event_307"
source_event_number = 307
trigger_priority = 30700
title = "定罪红卫兵"
description = "文革失败后，许多红卫兵被送进监狱以稳定局势。但那么多年过去了，放了他们也没什么了，毕竟我们已牢牢掌握了权力，以前的激进分子中也有有用的专家，人民对镇压红卫兵的态度也不是很好，释放他们会让我们更受支持。但先得记住，让他们回归原位会让这个国家大大回到激进的过去。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
