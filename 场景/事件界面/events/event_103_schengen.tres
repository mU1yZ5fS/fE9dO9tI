[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_def"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_103_schengen.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1985.7.1"

[sub_resource type="Resource" id="Expr_eu"]
script = ExtResource("3_expr")
type = 10
target = "0"
key = "eu"

[sub_resource type="Resource" id="Expr_soc_eu"]
script = ExtResource("3_expr")
type = 10
target = "21"
key = "soc_eu"

[sub_resource type="Resource" id="Expr_not_eu"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_eu")])

[sub_resource type="Resource" id="Expr_soc_eu_not_eu"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_soc_eu"), SubResource("Expr_not_eu")])

[sub_resource type="Resource" id="Expr_any_eu"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_eu"), SubResource("Expr_soc_eu_not_eu")])

[sub_resource type="Resource" id="Expr_econ"]
script = ExtResource("3_expr")
type = 10
target = "1"
key = "econ"

[sub_resource type="Resource" id="Expr_root"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_any_eu"), SubResource("Expr_econ")])

[sub_resource type="Resource" id="Fx0"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_opt")
