[resource]
script = ExtResource("4_def")
event_id = "event_474"
source_event_number = 474
trigger_priority = 47400
title = "维新之冬"
description = "根据我们和朝鲜特工所知道的消息，韩国的维新政体持续了多年，期间反对声音不断，在1979年9月，因反对党党首金泳三议员被驱逐出国会而导致反对派抗议规模越来越大，釜山和马山的工人，学生和市民开始上街抗议，要求维新政权下台。10月，抗议规模越来越大，甚至有了全国抗议的可能。\n我们是否应该帮釜马的市民们一把，让南朝鲜独裁政权垮台，亦或者是选择支持朴正熙政权？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
