[resource]
script = ExtResource("4_def")
event_id = "event_087"
source_event_number = 87
trigger_priority = 8700
title = "加利利的和平"
description = "由于黎巴嫩领导层的软弱，自1975年以来内战一直在黎巴嫩境内继续，再加上阿拉伯国家的积极援助，使得巴勒斯坦解放组织能够在黎巴嫩南部部署一个不受政府控制的与以色列作战的据点。双方不断地相互开火，但现在冲突似乎进入了白热化阶段。6月3日，以色列大使在伦敦遇刺（结果，其实是另一个巴勒斯坦组织对此负有责任，与巴解组织没有任何关系），这成为以色列大规模轰炸黎巴嫩的借口，6月6日，以色列军队越过黎巴嫩边界，与巴解组织的军队激战。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
