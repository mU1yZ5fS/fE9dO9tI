[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_033_041_world_and_party.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1977.4"

[sub_resource type="Resource" id="Expr_econ_not_10"]
script = ExtResource("3_expr")
type = 22
key = "economy_system"
value = 10.0

[sub_resource type="Resource" id="Expr_course_not_2"]
script = ExtResource("3_expr")
type = 22
key = "post_mao_course"
value = 2.0

[sub_resource type="Resource" id="Expr_course_not_4"]
script = ExtResource("3_expr")
type = 22
key = "post_mao_course"
value = 4.0

[sub_resource type="Resource" id="Expr_keep_normal"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_course_not_2"), SubResource("Expr_course_not_4")])

[sub_resource type="Resource" id="Expr_course_4"]
script = ExtResource("3_expr")
type = 21
key = "post_mao_course"
value = 4.0

[sub_resource type="Resource" id="Expr_gang_3"]
script = ExtResource("3_expr")
type = 21
key = "gang_of_four_path"
value = 3.0

[sub_resource type="Resource" id="Expr_line_at_most_1"]
script = ExtResource("3_expr")
type = 1
key = "political_line"
value = 1.0

[sub_resource type="Resource" id="Expr_reform_disabled"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_gang_3"), SubResource("Expr_line_at_most_1")])

[sub_resource type="Resource" id="Expr_both_others_disabled"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_course_4"), SubResource("Expr_reform_disabled")])

[sub_resource type="Resource" id="Expr_keep"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_keep_normal"), SubResource("Expr_both_others_disabled")])

[sub_resource type="Resource" id="Expr_plan"]
script = ExtResource("3_expr")
type = 22
key = "post_mao_course"
value = 4.0

[sub_resource type="Resource" id="Expr_gang_not_3"]
script = ExtResource("3_expr")
type = 22
key = "gang_of_four_path"
value = 3.0

[sub_resource type="Resource" id="Expr_course_not_1"]
script = ExtResource("3_expr")
type = 22
key = "post_mao_course"
value = 1.0

[sub_resource type="Resource" id="Expr_line_at_least_2"]
script = ExtResource("3_expr")
key = "political_line"
value = 2.0

[sub_resource type="Resource" id="Expr_reform"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_gang_not_3"), SubResource("Expr_course_not_2"), SubResource("Expr_course_not_1"), SubResource("Expr_line_at_least_2")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "我们需要维持并深化分权计划经济体系"
disabled_text = "旧制度已经过时了！"
enable_condition = SubResource("Expr_keep")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "由中央、生产单位和地方政府共同协作的的分权式计划经济再次被强调。不久后，经中共中央和国务院批准，国家计委下达了从1974年便开始编订的第五个五年计划和国民经济发展十年规划。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "恢复中央计划经济体系（需要1百万预算）"
disabled_text = "党会在你的领导下走向改革，而不是重蹈覆辙！"
enable_condition = SubResource("Expr_plan")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "在之后的政治局会议上，我们决定重建在大跃进开展后逐渐被改革的中央计划经济体制，国家计委的权力再次扩大，新的经济和数学等方面的专家被邀请加入计委。不久后，经中共中央和国务院的批准，国家计委加强了经济集权化，随后计委下达了从1974年开始编订的第五个五年计划和国民经济发展十年规划。用于转型和成立管理机构的资金已经分配下去，鉴于苏联斯大林时期的经济制度和劳动纪律正在被恢复，地方上对经济权力的收回和服从上级的纪律规章的强化有所不满。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "为了社会主义现代化，让我们准备改革！"
disabled_text = "打倒修正主义！"
enable_condition = SubResource("Expr_reform")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "在宣布对我国的经济体制进行改革之后，您和最显赫的改革派联合组成了一个特别小组，并以刘少奇的经验制定了未来的经济改革章程，全党（或者说只是中派和右派）正在等待着小组的决定。经济上的“解冻”已经开始，过去国家对经济方面的压力正在放松，并缩小了对个体经营的限制；在部分农村地区，新“三自一包”的行为也被默许。不久后，经中共中央和国务院批准，随后计委下达了从1974年开始编订的第五个五年计划和国民经济发展十年规划，但内容却变得不再详细，仅仅是在大方向上做了一些模糊的指示。中央的保守派和部分地方干部对这种“走资”的政策有所不满，群众也对此有所疑虑。"

[resource]
script = ExtResource("4_event")
event_id = "back_to_roots"
source_event_number = 38
trigger_priority = 3800
title = "回归本源"
description = "在50年代后期的大跃进运动以来，为了应对当时的形势，加上当时国家事实上无法负担中央计划经济，原本属于中央的经济权力被下放到地方，逐渐形成了分权式的计划经济体制。现在我们到达了一个新的历史节点，党内对经济体制的讨论也增加了。部分党员认为我们应该再次集权化，恢复中央计划经济体制，这能让我们的经济更好地协调发展；而改革派认为经济需要像刘少奇掌权时期那样进行一定放松甚至是进一步并且深化改革；当然，也有人认为经过了实践考验的分权式计划是当前的最好模式。我们应该如何选择？"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_econ_not_10")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
