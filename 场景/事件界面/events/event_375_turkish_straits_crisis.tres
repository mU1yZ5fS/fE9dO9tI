[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "支持土耳其（需要25.0百万预算与50.0点军事实力）"
disabled_text = "军事实力必须高于50点......"
enable_condition = SubResource("Expr_opt0_enable")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们向土耳其政府送去了军事与财政援助，并要求苏联立即撤出土耳其领土上的军队。在西方国家不计其数的“反对苏联侵略”的集会面前，苏联不得不退缩并撤回部队。然而，苏联领导层绝不会就此撤回自己的领土宣称。在我们的压力下，土耳其政府承认对哈塔伊省的占领非法。在此之后，叙利亚军进驻了该地，哈塔伊省因此回归叙利亚。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "支持苏联的要求"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "中国外交部代表在发言中表达了对苏联占据伊斯坦布尔海峡的肯定，称其为“打击帝国主义，维护苏联国家安全”的明智决策。这使得国际社会普遍将我们与苏联侵略者并列进行谴责，而罗曼诺夫则表达了对我方支持的感谢。苏联已经开始向内陆推进。从保加利亚方向出动的部队占领了土耳其的欧洲部分与海峡，驻守在那里的美军则接到了撤往希腊地区，以防冲突升级的命令。联合国安理会通过了谴责苏联侵略的决议，但除了对苏联引入新一轮制裁外，没有采取新的决定。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "木已成舟......"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "苏联已经开始向内陆推进。从保加利亚方向出动的部队占领了土耳其的欧洲部分与海峡，驻守在那里的美军则接到了撤往希腊地区，以防冲突升级的命令。.联合国安理会通过了谴责苏联侵略的决议，但除了对苏联引入新一轮制裁外，没有采取新的决定。"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "满足叙利亚的要求，但阻碍苏联的侵略野心（需要35.0百万预算与50.0点军事实力）"
disabled_text = "巧妇难为无米之炊，我们手头得有35百万才能干活......"
enable_condition = SubResource("Expr_opt3_enable")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们向土耳其政府送去了军事与财政援助，并要求苏联立即撤出土耳其领土上的军队。在西方国家不计其数的“反对苏联侵略”的集会面前，苏联不得不退缩并撤回部队。然而，苏联领导层绝不会就此撤回自己的领土宣称。在我们的压力下，土耳其政府承认对哈塔伊省的占领非法。在此之后，叙利亚军进驻了该地，哈塔伊省因此回归叙利亚。"

[sub_resource type="Resource" id="Option_4"]
script = ExtResource("1_option")
text = "满足叙利亚的要求并支持苏联（需要10.0百万预算）"
disabled_text = "巧妇难为无米之炊，我们手头得有35百万才能干活......"
enable_condition = SubResource("Expr_opt4_enable")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们向土耳其政府送去了军事与财政援助，并要求苏联立即撤出土耳其领土上的军队。在西方国家不计其数的“反对苏联侵略”的集会面前，苏联不得不退缩并撤回部队。然而，苏联领导层绝不会就此撤回自己的领土宣称。在我们的压力下，土耳其政府承认对哈塔伊省的占领非法。在此之后，叙利亚军进驻了该地，哈塔伊省因此回归叙利亚。"

[resource]
script = ExtResource("4_event")
event_id = "event_375"
source_event_number = 375
trigger_priority = 190
title = "苏联宣称土耳其领土"
description = "近日，苏联新任领导人格里戈里·罗曼诺夫提出了“反世界帝国主义理论”。西方媒体已将其称之为“罗曼诺夫主义”（类似所谓的“勃列日涅夫主义”）。因此，苏联已经开始对部分土耳其领土宣布主权。苏联领导人的声明如下：“我们已经见识到了土耳其是如何威胁苏联邻国，表露其侵略野心的。这条边界基本上被所有的延黑海国家所共用，因此，苏联不得不对其边界与海峡的安全格外关注。”因此，苏联领导人将二战结束后对土耳其的领土要求再度抛出：这也是前俄罗斯帝国控制的土地——即卡尔斯、阿尔特温和阿尔达汉；以及博斯普鲁斯与达达尼尔海峡的通行权（以及其附属附近的土地，包括伊斯坦布尔）罗曼诺夫还要求美军撤出土耳其（而苏联军队则必须进驻此地）国际社会严厉批评了“苏联的侵略野心及其帝国主义计划”，并已开始对该国引入新一轮制裁。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_ussr_leader_romanov"), SubResource("Expr_ussr_power_100"), SubResource("Expr_usa_power_100"), SubResource("Expr_data126_positive"), SubResource("Expr_data124_100"), SubResource("Expr_not_turkey_nato"), SubResource("Expr_not_china_sev")])
show_notification = false
display_script = ExtResource("5_custom")
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3"), SubResource("Option_4")])
