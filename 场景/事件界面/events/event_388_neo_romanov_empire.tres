[resource]
script = ExtResource("4_def")
event_id = "event_388"
source_event_number = 388
trigger_priority = 202
title = "新罗曼诺夫帝国"
description = "更让人始料不及的事发生了，苏联领导人格里戈里·罗曼诺夫宣称：“一些处于社会主义大家庭的国家已经表达了加入苏联的期望。出于尊重其自决权的需要，我们绝不能否认他们的要求。但事关重大，有必要为此举行一场全民公投。”\n长久以来，保加利亚便已为成为苏联的第16个加盟共和国做足了准备，驱动其加入苏联的原因很可能是其欠苏联的外债。然而，现在该国已经举行了公投，其中有{1}%的公民支持加入苏联。\n长期以来，蒙古便被看作是“主权最名不副其实的社会主义国家”，在苏联军队的监管下，那里甚至连分离主义团体产生的苗头都没有。驻守在外贝加尔湖军区的苏军牢牢把控当地局势。因此结果显而易见，有{2}%的公民支持加入苏联。\n而在相对“叛逆”得多的波兰境内，问题则要复杂的多。已经数次失去主权的国家绝不会轻易再度灭亡。但这次，华沙并没有什么新闻。因为有{2}%的公民支持波兰成为苏联境内的苏维埃共和国。\n所以究竟发生了什么，为什么发生了这种事，这些问题均悬而未决。因此，美国和西方国家指责苏联伪造全民公决结果并借机吞并这些国家。而苏联则称西方言行不一。\n可我们对此应该怎么做？毕竟在此次扩张后，我们与苏联之间的边界扩大了许多倍。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date_1985_6"), SubResource("Expr_not_china_ovd"), SubResource("Expr_not_china_sev"), SubResource("Expr_ussr_leader_romanov"), SubResource("Expr_ussr_power_250"), SubResource("Expr_mongolia_prosov"), SubResource("Expr_hungary_prosov"), SubResource("Expr_romania_prosov"), SubResource("Expr_bulgaria_prosov"), SubResource("Expr_not_war22"), SubResource("Expr_data133_zero")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
