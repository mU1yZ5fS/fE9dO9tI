[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "支持AKEL与联合政府，不要“格吕克斯堡王朝”。不自由，毋宁死！"
disabled_text = "你真的不清楚AKEL的外号是“智利共产党”？"
enable_condition = SubResource("Expr_line_ge_1")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "随着希腊军政府的倒台，法西斯党徒的靠山轰然倒塌，声名狼藉的保王党人自然是难以为继、日渐式微，而新左派亦未能形成如同欧洲本土那样的激进政治气候。于是乎，塞浦路斯的政治轨迹，似乎仍要沿着老牌政治操盘手规定的路线前进。在我们的帮助下，塞浦路斯联合政府勉强顶住了1974年事件以来持续升温的政治极化与激进浪潮；北约方面也因忌惮塞浦路斯彻底倒向东方阵营，不敢再肆意怂恿土耳其推进军事冒险。该岛由此在内外交困的窘境中，勉强获得了喘息之机。尽管残余的EOKA分子短期内仍能苟延残喘，但显而易见，“大希腊”之梦与极右翼恐怖主义的穷途末路已然注定……然而，塞浦路斯的症结绝不会因EOKA的消亡而迎刃而解。北部的占领状态依旧毫无改观，多达二十万的希腊族塞浦路斯难民亟待政府安置与救济；躁动不安的土族飞地更成了希腊民族主义者的眼中钉，即便岛屿新秩序日渐稳固，种族仇杀与相互报复的隐患依旧存在。尤其是昔日土耳其抵抗组织（TMT）领导人、如今塞浦路斯土耳其联邦总统登克塔什，对“一国方案”的彻底否定，无疑将加剧塞浦路斯局势的恶化。退居南方的希腊族政府，则推出了一个规模有限的中间派小党——民主党执掌权柄，试图为国内左右对立的政治态势降温。该党自居为马卡里奥斯最忠实的追随者，宣称将延续其所谓“社会中心主义”政策，在左右翼的钢丝绳上艰难平衡。但我们都清楚，即便是真正的马卡里奥斯，对这些沉疴积弊尚且束手无策，更何况是由其信徒组成的利益集团呢……"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "支持EOKA，致福的子弹已经射出，上帝和祖国的战士们，前进！"
disabled_text = "要不再把希腊军政府复活一下？"
enable_condition = SubResource("Expr_line_ge_3")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "尽管希腊军政府已大势已去，但“埃诺西斯”事业依旧深得希族塞人鼎力支持。更何况，数十万因土耳其入侵而背井离乡的希族难民，只要稍加挑动，完全能为日渐式微的法西斯分子补充有生力量。于是乎，在我方特勤力量的协助下，EOKA借两族积怨已久的民族仇恨之火，再度死灰复燃、卷土重来，其扩张势头之猛，大有超越独立战争时期的架势。与此同时，土族飞地遭受了前所未有的重创——数万土耳其人重蹈1963年的覆辙，被希族虐杀、驱逐，纷纷仓皇逃向北边的土耳其控制区。但考虑到这群该死的突厥蛮子在英国殖民期间，就干尽了和殖民当局的合作勾当，这完全是他们应得的！然而，塞浦路斯的症结绝不会因土族飞地的崩溃而迎刃而解。北部的占领状态依旧毫无改观，多达二十万的希腊族塞浦路斯难民亟待政府安置与救济；躁动不安的土族飞地更成了希腊民族主义者的眼中钉，即便岛屿新秩序日渐稳固，种族仇杀与相互报复的隐患依旧存在。尤其是昔日土耳其抵抗组织（TMT）领导人、如今塞浦路斯土耳其联邦总统登克塔什对“一国方案”的彻底否定，无疑将加剧塞浦路斯局势的恶化。退居南方的希腊族政府，则推出了一个规模有限的中间派小党——民主党执掌权柄，试图为国内左右对立的政治态势降温。该党自居为马卡里奥斯最忠实的追随者，宣称将延续其所谓“社会中心主义”政策，在左右翼的钢丝绳上艰难平衡。但我们都清楚，即便是真正的马卡里奥斯，对这些沉疴积弊尚且束手无策，更何况是由其信徒组成的利益集团呢……"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "支持EDEK，在国王与主教之间，我们选择工人与农民！"
disabled_text = "他们太左了"
enable_condition = SubResource("Expr_line_le_1")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "AKEL不过是另一种形式的铁托主义，甚至比那更恶劣：否定无产阶级专政，否定暴力革命，主动依附于民族资产阶级，死心塌地追随苏联修正主义的步伐，还恶语中伤我国领导人以及追随我国路线的第三世界人民。种种行径，让我们绝无可能将这样一个“小赫鲁晓夫”政党视作同志；而法西斯主义者更不配成为我们的同路人，我们必须将目光投向塞浦路斯岛内非AKEL系的左翼青年。我们最终押宝于该国从雅典理工学院起义淬炼的“六八一代”新左翼，围绕原先社会党理论刊物《社会主义表达》——这也是塞浦路斯新左翼最核心的聚集地——展开联络工作。很快，EDEK——该国“智利共产党”自己的智利社会党便和我们搭上了线。作为一个社会民主政党，由于吸收了大量新左翼青年，它不同于使用温和或中间派话语的同类政党，秉持着极为激进的政治经济诉求：根据其章程，EDEK“是工人阶级、农民阶级以及广大人民民主力量的有组织先锋队……其目标是在一个基于机会平等、消除人剥削人现象、由人民完全掌控生产资料及国家财富与资源的社会中建设社会主义”。塞浦路斯的毛主义活动家（如塞浦路斯共产党-重建）及托派活动家，几乎都源自这个以新左翼青年为主体的新锐政党。仅从核心立场来看，该党显然比那些自诩“共产主义”的AKEL更具无产阶级意识。唯一需要警惕的是，该党的反资本主义立场似乎更多根植于某种爱国主义的观点，其意识形态倾向与波兰PAX协会最为接近。党内外研究人士对我国支持这类带有强烈民族主义视角的组织持保留态度，他们的担忧并非无的放矢，我们只能寄望于该党的阶级情感能够压倒其民族本位观念……然而，塞浦路斯的问题仍旧亟需一个可行性强的解决方案。北部的占领状态依旧毫无改观，多达二十万的希腊族塞浦路斯难民亟待政府安置与救济；躁动不安的土族飞地更成了希腊民族主义者的眼中钉，即便岛屿新秩序日渐稳固，种族仇杀与相互报复的隐患依旧存在。尤其是昔日土耳其抵抗组织（TMT）领导人、如今塞浦路斯土耳其联邦总统登克塔什对“一国方案”的彻底否定，无疑将加剧塞浦路斯局势的恶化。退居南方的希腊族政府，则推出了一个规模有限的中间派小党——民主党执掌权柄，试图为国内左右对立的政治态势降温。该党自居为马卡里奥斯最忠实的追随者，宣称将延续其所谓“社会中心主义”政策，在左右翼的钢丝绳上艰难平衡。但我们都清楚，即便是真正的马卡里奥斯，对这些沉疴积弊尚且束手无策，更何况是由其信徒组成的利益集团呢……"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "我希望你下次说到这个国家的时候是在我的度假日程上，而不是别的什么"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "那个什么法马古斯塔就挺不错，我们可以在下次的行程中将其安排进去——|什么？那地方完全被土耳其人封锁了？！随着希腊军政府的倒台，法西斯党徒的靠山轰然倒塌，声名狼藉的保王党人自然是难以为继、日渐式微，而新左派亦未能形成如同欧洲本土那样的激进政治气候。于是乎，塞浦路斯的政治轨迹，似乎仍要沿着老牌政治操盘手规定的路线前进。然而，塞浦路斯的问题不会就这样轻易结束。北部的占领状态依旧毫无改观，多达二十万的希腊族塞浦路斯难民亟待政府安置与救济；躁动不安的土族飞地更成了希腊民族主义者的眼中钉，即便岛屿新秩序日渐稳固，种族仇杀与相互报复的隐患依旧存在。尤其是昔日土耳其抵抗组织（TMT）领导人、如今塞浦路斯土耳其联邦总统登克塔什对“一国方案”的彻底否定，无疑将加剧塞浦路斯局势的恶化。退居南方的希腊族政府，则推出了一个规模有限的中间派小党——民主党执掌权柄，试图为国内左右对立的政治态势降温。该党自居为马卡里奥斯最忠实的追随者，宣称将延续其所谓“社会中心主义”政策，在左右翼的钢丝绳上艰难平衡。但我们都清楚，即便是真正的马卡里奥斯，对这些沉疴积弊尚且束手无策，更何况是由其信徒组成的利益集团呢……"

[resource]
script = ExtResource("4_event")
event_id = "event_695"
source_event_number = 695
trigger_priority = 185
title = "圣徒与罪人之国"
description = "主席同志，近日，地中海小岛国塞浦路斯传来消息：该国国父、不结盟运动的推动者、铁托与纳赛尔的同道者——总统马卡里奥斯三世，于8月3日逝世。这位素有“革命神甫”之称的大主教，一生充满了各种争议。在塞浦路斯左翼民主人士眼中，马卡里奥斯是位“有缺点的好人”，他固然有着保守主义的毛病，却也保持着开明的姿态，与该国的劳动人民进步党（AKEL，即该国的共产党）和联合民主中心运动（EDEK，即该国的社会党）合作，协力建立了塞浦路斯脆弱的民主制度。且在1974年政变中，领导塞浦路斯人民坚定地保卫塞浦路斯不受保王党和雅典准法西斯“民族中心”的戕害，是当之无愧的和平圣人。而在以已故格里瓦斯将军为代表的保守派看来，马卡里奥斯三世是阻挠希腊“伟大理想”的罪人，甚至被指为苏联的傀儡——这一点在1965年塞浦路斯导弹危机中已有所体现。在原塞浦路斯全国战士组织（EOKA）成员眼中，正是马卡里奥斯与共产党人、社会党人的暧昧态度，促使他放弃“埃诺西斯”（意为“联合”），向土耳其族的“塔克西姆”（意为“分裂”）妥协退让，最终酿成塞浦路斯错失回归祖国、陷入分裂的悲剧。1974年政变的筹划方“EOKA-B”同样拒不承认自身对土耳其出兵负有责任，反倒将一切归咎于马卡里奥斯，屡次指责其软弱——即便马卡里奥斯对土耳其族裔自1963年起就开始实施系统性压制。无论如何，马卡里奥斯如今已魂归天父，但对他政治遗产的争论仍未结束。多数塞浦路斯希腊族公民，由于受希腊军政府煽动及“阿提拉行动”的冲击，完全不再认同1960年《塞浦路斯宪法》所构想的联合共和国。如今的塞浦路斯政治体制已实际将土耳其族排除在外；尽管自1963年起，土族飞地便已自行治理，但土耳其实际控制区的形成，还是给岛上希腊族裔以迎头一棒。面对右翼势力抬头、反建制极端民族主义组织蠢蠢欲动的态势，AKEL、EDEK和民主党（DIKO）于1976年的选举中不计前嫌，组成统一战线，以几乎垄断的姿态控制了当前国家机器，该届政府试图通过排挤极右翼势力，稳固摇摇欲坠的民主制度，推动国内政治风气逐步去极端化。但蠢蠢欲动的EOKA-B和右翼政党进步阵线怎可能善罢甘休，和北约勾结的他们试图借助大西洋巨人的力量，一举实现“X”未竟的事业……现在到了我们该做选择的时候了。援助现政府无疑可以维持该国的不结盟姿态，为我国在暗流涌动的东地中海争取到一个比铁托更可靠一点的盟友。而EOKA-B和进步阵线的法西斯主义倾向，也可以为其日后脱离欧洲轨道提供条件，从而为我方介入提供可乘之机。当然，您也可以选择直接忽略这样一个不起眼的小国。毕竟在某种程度上，埃及对于该岛的影响力都远强于千里之外的我国。一如既往，选择权在你，主席同志。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date_1977_8_3")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
