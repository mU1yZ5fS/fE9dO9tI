[resource]
script = ExtResource("4_def")
event_id = "event_304"
source_event_number = 304
trigger_priority = 30400
title = "华国锋的崛起"
description = "在毛去世后，国家的领导职务由他有前提的“继承人”华国锋担任。起初，这位温和的政治家似乎是一个适合所有派系的好选择，但可惜的是，他最终成为了一个不成功且无能的领导人。国家发展速度放缓，党的团结更是梦里都没有。国锋既不合极左派的口味，也不适合改革派。党员中已经有传言说，毛的继承人正在开始建立自己的威权模式。但真有那么糟糕么？也许清理一群激进分子，而不是除掉一个强大的领导人更好一些？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
