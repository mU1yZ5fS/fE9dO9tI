[resource]
script = ExtResource("4_event")
event_id = "donkey_elephant"
source_event_number = 114
title = "驴象之争"
description = "美国总统大选很快就要举行，民主党总统吉米·卡特准备在和共和党野心勃勃的罗纳德·里根的竞争中拿下第二个任期。第一个任期里吉米·卡特努力改善美国人民的福利、建设更加开放的政府、对美国政府机构在全局上进行改革。他的外交政策特点是在与苏联的对抗与缓和中找到平衡。但是，他的领导在节节攀升的油价中撞得头破血流，相对缓和的外交政策也在保守派圈子里被大大批判一番，所以共和党的胜利基本已经稳了。反正我们也管不了，等着看吧。"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Opt0")])
