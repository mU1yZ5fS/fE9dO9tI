[resource]
script = ExtResource("4_def")
event_id = "event_621"
source_event_number = 621
trigger_priority = 62100
title = "一个独裁者将会被另一个独裁者杀死"
description = "自1968年独立以来，赤道几内亚便一直处于马西埃·恩圭马的统治。在其治下，知识分子大量被屠杀，以芳族为尊并屠杀和排斥其他民族。在1979年6月，由于军队欠饷，数十个军官要求支付薪水却惨遭马西埃杀害，马西埃的侄子，国防副部长奥比昂·恩圭马因此策划了一场政变试图推翻马西埃的统治，但是失败了。不过马西埃并未发现奥比昂是政变策划者。之后马西埃谋杀了他的数个家人，其中就包括奥比昂的兄弟。此举导致了赤道几内亚执政核心圈子的恐慌，有传闻奥比昂即将发动政变推翻马西埃。在此关键时刻，我们可以选择帮助奥比昂来推翻马西埃；如果我们真的很想和马西埃拉近关系的话，也可以帮助他稳定政权；以及，我们或许可以借助周边邻国的法军力量来平定这个西非的小黑斑？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
