[resource]
script = ExtResource("4_def")
event_id = "event_149"
source_event_number = 149
trigger_priority = 14900
title = "转世轮回（圭亚那）"
description = "起初，切迪·贾根与福布斯·伯纳姆同属于人民进步党（PPP）。然而，由于丘吉尔当选之后对贾根产生了关注，担心他同苏联有所联系，伯纳姆与党内的温和派很快从党内分离出来，创建了人民全国大会党（PNC），并在英国的支持下执掌圭亚那。伯纳姆重新划分了全国选区；在公安机关安排亲信授予警察特务无限权限；建立黑人和土著印第安人的社会保障并给予政治职位；切断同英国的一切贸易往来，全面禁止进口，将自给自足作为基本国策。圭亚那转型为一个“协作共和国”，一切大型企业与外资企业被国有化；向全体公民提供食物、工作与住宅的计划被推行;英国在圭亚那的一切政治特权被收回;对伯纳姆政府的政治异见者被政治镇压；所有政府公务员被强制加入人大党；圭亚那同古巴、苏联建立了外交关系，并参加了不结盟运动。但是，由于对于持续的罢工的血腥镇压，以及蔗糖产量的下降，圭亚那陷入了经济衰退，伯纳姆政权的局势持续恶化。政府制定新宪法，取消了人大党的领导地位，设立不记名投票产生的国民议会提名总统。有传言称伯纳姆准备在选举中舞弊；来自更加左倾党派人进党的切迪·贾根、以及来自联合力量（TUF）等多个右倾自由翼政党联盟的马塞勒斯·辛格，已经站出来准备参选。但是对于辛格来说，如果他不能联合更多其他的反对派力量，可能胜选的机会不大。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
