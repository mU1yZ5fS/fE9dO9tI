[resource]
script = ExtResource("4_def")
event_id = "event_639"
source_event_number = 639
trigger_priority = 63900
title = "为了所有人的斐济"
description = "在经历反帝反殖的斗争后，瓦努阿图人民最终赢得了独立，开始了美拉尼西亚社会主义的实践。我们现在可以同他们一起将斗争扩展到南太平洋的其他国家。\n斐济独立以来仍然同英国保持着密切联系，当地的部族和酋长也继续保留着他们的特权，并想要维持斐济族在岛上的优势地位（斐济族和斐济印度裔是该国的两大民族，一直存在矛盾）。我们可以通过支持大多数由印度裔斐济人参加的中左翼政党全国联邦党（该党声称代表所有岛民）同支持多种族平等和工人阶级利益的斐济工会大会组成联盟，展开斗争。"
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
