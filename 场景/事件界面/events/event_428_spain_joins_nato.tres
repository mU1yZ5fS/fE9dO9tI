[resource]
script = ExtResource("4_def")
event_id = "event_428"
source_event_number = 428
trigger_priority = 42800
title = "西班牙加入北约"
description = "军事政变的失败，反而让政治家坚定了决心：北约组织的部队，也许比他们本国深受长枪党思想与等级制影响的部队更加可靠。西班牙领导人们开始考虑改变他们的外交政策，并寻求让西班牙加入北大西洋公约组织。倘若说在苏亚雷斯时期，前首相还怀疑如此做的可行性，并相信中立才最有利于西班牙的发展。而到了他的继承人卡尔沃·索特洛这里，外交政策便发生了显著转变。1982年5月30日，西班牙被批准加入北约。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
