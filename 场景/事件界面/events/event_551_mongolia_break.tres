[resource]
script = ExtResource("4_def")
event_id = "event_551"
source_event_number = 551
trigger_priority = 55100
title = "过河拆桥？"
description = "自中国与蒙古实现合并并再度结成一个整体后，中蒙关系事实上便被置于先前签署的《中蒙联合条约》框架下：中国以巨额投资、文化保护和确保蒙古地方建立民族权利机构为基础，交换了蒙古的效忠、领土与国家主权。内外蒙古也得以实现彻底整合：蒙古人民共和国的党政系统也被合并进中国共产党的蒙古支部内。因此，同其他已实现自我管理的民族加盟政权不同，蒙古与中国的关系并非遵循中国现行的区域管理法案，而是后者与外交草案的综合。这便意味着我们绝不可能同对待其他地区那般，能轻易地回收与限制蒙古地方机构的职权。在我国正筹备地方行政制度改革，在全国范围实行民族区域自治制度的背景下。蒙古问题必须单独列出，特别处理。这事实上也对应我们对待《中蒙联合条约》与自身外交声誉的态度：最简单的办法当然是要么放弃改革，继续实行分权联邦制度；要么则两方均批准废除条约内所有条款，让中国与蒙古恢复签约前的状态——当然，考虑到先前在当地安置的投资与暗线，蒙古仍将无法脱离中国的影响；次一等的则是以“一国两制”构想为原型，在蒙古地方实行联邦制，对国内其他地区恢复民族区域自治制度：当然，这会引起国内尤其是民族地区的空前不满；最后，我们也可以考虑切香肠战术、以渗透与政治限制手段遏制分离派，让国安局特工用枪杆子告诉蒙古官僚们该如何选择。"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
