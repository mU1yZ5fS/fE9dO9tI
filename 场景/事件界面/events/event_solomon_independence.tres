[resource]
script = ExtResource("4_def")
event_id = "solomon_independence"
source_event_number = 1601
trigger_priority = 160100
title = "所罗门群岛独立"
description = "同志，1978年7月7日，所罗门群岛正式宣布独立，成为英联邦内的主权国家。这个南太平洋上的岛国长期由英国殖民统治，如今终于迎来了自己的国旗。我们应当派代表出席独立庆典，并向这个年轻的国家表达祝贺。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
