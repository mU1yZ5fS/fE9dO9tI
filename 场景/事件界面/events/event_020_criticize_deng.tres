[resource]
script = ExtResource("4_event")
event_id = "criticize_deng"
source_event_number = 20
title = "批邓反击右倾翻案风"
description = "周恩来的去世严重影响了他的得力助手邓小平的地位，没有前总理的庇护。他现在经常受到以毛泽东夫人江青为首的激进分子的攻击，2月2日，邓小平被调到对外关系领域工作。在毛泽东及其支持者的批准下，他们成功地发起了“批邓反击右倾翻案风”运动，并在媒体上对邓进行了积极的迫害。值得注意的是，尽管毛泽东对邓小平不信任，但他还没有参与到对他的迫害中。既然华国锋和江青或邓小平都没有良好的关系，那我们该怎么办？"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
