[resource]
script = ExtResource("4_def")
event_id = "event_627"
source_event_number = 627
trigger_priority = 62700
title = "伊斯兰、民族、宪政和社会主义民主！"
description = "1975年，达达赫在毛里塔尼亚人民党全国代表大会上公布了深受欢迎的新党章，其中提出了“伊斯兰、民族、宪政和社会主义民主”的口号。尽管多年以来，人民党政府实施了许多带有反殖反帝和“社会主义”色彩的政策，但是由于该国部族主义猖獗和奴隶制广泛存在的社会情况以及其落后的经济情况，该国的“伊斯兰社会主义”实践并不见得有多么深入基层。如今，在非洲革命高歌猛进的情况下，非洲革命联盟决定帮助毛塔推进国家的变革。"
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
