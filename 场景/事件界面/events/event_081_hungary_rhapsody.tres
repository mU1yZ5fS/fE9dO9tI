[resource]
script = ExtResource("4_def")
event_id = "event_081"
source_event_number = 81
trigger_priority = 8100
title = "匈牙利狂想曲"
description = "来自布达佩斯的奇怪消息——似乎在赫鲁晓夫时代所夸耀的的卡达尔主义者的“古拉什社会主义”正处于违约的边缘——实际上，匈牙利欠下了国际货币基金组织77亿美元，而这是它无力支付的。根据我们的经济学家的看法，匈牙利人有两个选择——要么从西方和苏联获得新的贷款，要么开始全面的市场改革，这将损害大多数人的生活水平。匈牙利社会主义工人党的领导人不会采取后一个选择，因为他们还记得布拉格之春事件，所以他们很可能会接受新的贷款。我们可以利用匈牙利人民共和国的问题，向他们提供我们的经济援助——但条件是为受辱的斯大林主义者比斯库·贝洛及其集团平反，他们反对半市场改革，并可以成为我们在匈社工党内的可靠支持者。但是，我们也可以在不提出政治条件的情况下，为溺水者提供帮助…"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
