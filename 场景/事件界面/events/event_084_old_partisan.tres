[resource]
script = ExtResource("4_event")
event_id = "old_partisan"
source_event_number = 84
title = "我们的老游击队员…"
description = "彼得·马谢罗夫，白俄罗斯共产党中央委员会第一书记，二战游击队老战士，是苏共中央政治局候补委员，被视为勃列日涅夫潜在的继任者之一。他为人清廉，敢于直言，在白俄罗斯享有极高威望。根据我们特工的情报，他正逐渐成为苏共内部改革派的代表人物……"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_gate")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
