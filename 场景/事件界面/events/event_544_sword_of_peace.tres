[resource]
script = ExtResource("4_def")
event_id = "event_544"
source_event_number = 544
trigger_priority = 54400
title = "和平利剑"
description = "主席同志，得益于我国两弹一星工程的推进，我国60年代的核武器与导弹事业发展神速。但由于我国核武器起步晚，导弹投送能力的不足导致我国以反导工程为主，不过也取得了如同先锋级洲际导弹防御炮和一系列战略预警系统这样的成果。随着这几年国内经济的显著发展和周边国际环境的明显改善。我们是否应该转变我们原先的核武器发展战略？当然，您可以选择继续深化原来的方针，亦或我们下个大血本，两者都要？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_3"), SubResource("Expr_4")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
