[resource]
script = ExtResource("4_def")
event_id = "event_322"
source_event_number = 322
trigger_priority = 32200
title = "道路发展"
description = "近年来，我国人民拥有的汽车数量一直稳步攀升。当然，这是好事，因为这标志着我国人民生活水平的提高。但另一方面，我国城市塞不塞得下那么多车还是个问题。对许多省份来说，它们只有土路和铁路，而发达地区的高速公路也常常出现交通堵塞。根据工程师们传达的信息，我们迫切需要发展道路基础设施——修建新的公路和扩建旧的公路。但是我们有足够的资源来实现这一目标吗？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
