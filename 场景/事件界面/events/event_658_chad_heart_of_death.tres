[resource]
script = ExtResource("4_def")
event_id = "event_658"
source_event_number = 658
trigger_priority = 65800
title = "非洲死亡之心"
description = "乍得是一个典型的萨赫勒国家。由于特殊的地理位置和法国殖民时代刻意重用南方民族，该国南北方的民族和文化截然不同。而南方人在独立以来就一直主导着整个国家。第一任总统弗朗索瓦·托姆巴巴耶的统治以独裁、极端腐败和偏袒南方人著称，同许多非洲独裁者一样，他对内实行独裁统治，推行大萨拉族主义和歧视北方人的政策，这导致了北部和东部的伊斯兰教地区与南方基督徒主导的政府之间的对立，起义层出不穷。1966年6月19日，马克思主义者易卜拉欣·阿巴查将乍得国内大部分反对南方中央政府的组织整合起来，组织成了带有左翼革命色彩的大帐篷性质组织——乍得民族解放阵线（FROLINAT，随着1968年阿巴查的去世以及这之后阵线内各派系夺取继承人职位的斗争，FROLINAT逐渐转变为亲利比亚的左翼民族主义组织，而马克思主义的要素则被完全边缘化），这标志着内战的开始。\n随着利比亚和法国的干预，以及叛军的分裂，乍得内战逐渐演变称三足鼎立的局势——南部政府军、控制北部与中部的古库尼·韦戴、控制东部的侯赛因·哈布雷。1975年，由于托姆巴巴耶向利比亚靠拢，法国扶持了一场政变，在将他杀死后，政变军官们推举了此前被捕入狱的费利克斯·马卢姆准将为总统。在反政府武装逐渐壮大的形势下，新的军政府主张通过谈判实现民族和解和全国统一，这得到了哈布雷派的支持，而古库尼则拒绝谈判。\n1978年8月，哈布雷同政府和解，他本人被马卢姆任命为总理。但随着古库尼派武装逼近首都，联盟很快便瓦解。马卢姆总统于1979年3月出逃。随后，乍得的各个派别在尼日利亚的调解下签署《拉各斯协议》结束了内战，一个涵盖11个不同派别的代表的民族团结过渡政府（GUNT）成立了，亲利比亚的古库尼·韦戴成为了总统，而反利比亚的哈布雷成为了国防部长，古库尼派中的强硬派艾哈迈德·阿西尔被任命为外交部长。\n然而，非洲各国的努力并没能真正停止乍得的内战。短暂的和解之后，武装冲突再次爆发。1980年3月，哈布雷的部队开始攻击古库尼派武装，乍得又一次陷入全面内战。12月，在利比亚的直接介入以及苏联和东德顾问的帮助下，古库尼获得了胜利。哈布雷派撤退到东北边境地区进行游击战。\n1981年，古库尼访问利比亚，两国决定合并，这一计划引起了非洲统一组织与法国的强烈不满，由尼日利亚、塞内加尔和扎伊尔组成的泛非和平部队陆续进驻乍得维持秩序。面对国际社会的反对声音，两人后来降低了声明的调门，将其描述为两国人民之间的“联盟”。尽管如此，这一事件还是削弱了古库尼的民族主义形象。随着国际压力的增加，古库尼表示愿意接受非统组织的调解，暗示利比亚军队将撤出乍得。然而，利比亚军队在乍得的存在和行动引发了乍得国内和国际的不满。到了1981年10月，由于卡扎菲的伊斯兰军团与古库尼的军队发生冲突，古库尼要求利比亚军队撤出乍得。由于卡扎菲寻求在1982年担任非统组织主席，同时也因为利比亚在乍得的处境变得复杂，利比亚军队在11月撤离。尽管如此，卡扎菲并未放弃对乍得的影响力，而是开始寻找一个更可靠的乍得领导人来实现他的目标。随着利比亚的撤军，哈布雷领导他的北方武装部队（FAN）从东北部向首都发起反攻。看来，乍得内战仍将继续下去。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
