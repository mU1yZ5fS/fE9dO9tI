[resource]
script = ExtResource("4_def")
event_id = "event_702"
source_event_number = 702
trigger_priority = 70200
title = "寂静革命的结果"
description = "虽然加拿大自由党得以在先前选举内站稳脚跟，但这并不代表加拿大国内的所有问题均被盖棺定论。其中尤以魁北克问题最为明显：也就在1976年的地方选举中，原执政党自由党因遭遇丑闻而不得不黯然下台，让位给承诺澄清政坛、力行革新的魁北克人党。后者就此登上魁北克政坛，并获得多数议席。与此同时，魁人党许诺将在其执政期间以公投形式对魁北克命运做最终定论，以此决定当地究竟是仍作为加拿大的地区存在，还是走上主权之路。然而，进步保守党的溃败与持联邦统一立场的特鲁多迅速回归的现实打了他们个措手不及。意味着魁北克的和平分离之路将不会一帆风顺。尤其是考虑到特鲁多的胡萝卜加大棒政策很可能为此踩下刹车——毕竟，他还有指控公投违宪和许诺修改加拿大宪法，将联邦构想落实的许诺这两大杀招……"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
