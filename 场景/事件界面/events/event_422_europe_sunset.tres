[resource]
script = ExtResource("4_def")
event_id = "event_422"
source_event_number = 422
trigger_priority = 42200
title = "欧洲日落"
description = "显然，在欧洲经济共同体的基础上打造单一经济空间，并构建邦联国家架构的尝试已经落空。因此，实现全面的欧洲一体化的计划已经失败。该组织的主要成员纷纷抛弃了欧洲经济共同体。\n因此，其他仍留在欧共体的国家纷纷宣布取消绝大多数旨在建立单一的政治、货币、经济与关税空间的协定。\n欧洲共同市场实际上已不复存在。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
