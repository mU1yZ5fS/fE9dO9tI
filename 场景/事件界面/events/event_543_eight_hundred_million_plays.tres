[resource]
script = ExtResource("4_def")
event_id = "event_543"
source_event_number = 543
trigger_priority = 54300
title = "八亿人民几部戏？"
description = "领导人同志，再次感谢您在几年前的勇敢决策，全国几亿群众热情的捍卫革命文艺高地的宏伟景象得以重现在我们眼前，但很显然，我们的工作重点一直侧重于文学方面，而社会主义的文化事业肯定不只那几片封皮套白纸。随着生产力的发展，文艺产品的种类与流派也不断丰富，其发展的速度似乎远远超过了实践仍极为青涩的——“社会主义文艺革命”的速度，为适应人民群众精神需求与社会主义革命的需求，怎么将革命带到文艺的各个方面就成为了一个值得思考的问题。\n回顾过去文化大革命进行的十余年，我们高举工农兵文艺路线的旗帜，以毛主席在延安文艺座谈会上的讲话为精神，为广大工革命群众制作出了许多优秀的文艺作品，其中由江青同志指导制作的几部革命新京剧表现最为突出，为我国开展广泛的文艺普及做出来杰出贡献，收到了人民的喜爱，这种“革命样板戏”甚至一度成为了文化大革命在国际上的固有印象之一。除此之外，我们在戏剧，电影，音乐等方面的文化产出也一直有序进行，其中不乏许多优秀作品。\n但随着时间的流逝，旧文艺生产模式的弊端也逐渐暴露，社会各界反映出新的文艺作品越来越难得到群众的青睐，典型的问题就是戏剧与电影的情节与人物塑造日渐呆板与脸谱化，令不少观众感到无聊乏味。而作品的产出效率对比群众日渐提高的精神需要，速度上已经显得较为疲乏，相当一部分中心文艺工作者对新事物的抗拒态度更是令人诟病……\n对此，党内的个别同志向您提出了一个大胆的建议:深化我们对文学工作的解冻政策，将其拓展到文化事业的各个方面，一方面给我国的文艺领导层进行大换血，吸收更包容更有眼界同时也更可靠的新同志指导工作，另一方面同时也是最重要的部分——让广大革命群众更广泛的参与到文艺创作。诚然，“社会主义新文艺”对于我们，对于其他很多社会主义国家来说依然是一个年轻的名词，但这不正意味着我们应该采取革命的方法，去借助历经了几十年革命考验的革命人民的智慧，与群众一起探索出无产阶级文化事业的未来吗？\n与之前不同，这一大胆的方案并没有得到太多的支持，包括以往一直支持我们的同志在内，他们皆委婉的表达了对“可能使我党对革命文艺路线的领导受到影响”的忧虑，那些自1979年事件开始就跟我们唱反调的家伙们更不用说，他们已经开始激烈攻击其为“自由主义反动文艺路线”了，还真是讽刺……\n“to\\u00a0be\\u00a0or\\u00a0not\\u00a0to\\u00a0be”前进还是就此驻足，这的确关乎着我们革命事业的未来。是的，对于的“混乱”的恐惧压倒了我们许多人，但真正的共产党人怎会懦弱的抗拒汹涌的洪流呢？\n领导人同志，革命从未有如此需要您更大勇气……"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_5")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
