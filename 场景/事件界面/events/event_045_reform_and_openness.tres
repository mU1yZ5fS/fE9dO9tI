[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/core/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/core/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/core/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/core/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_042_047_revolution_and_reform.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1978.1"

[sub_resource type="Resource" id="Expr_stage_1"]
script = ExtResource("3_expr")
type = 21
key = "reform_stage"
value = 1.0

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "向社会主义市场经济大步前进！"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "新政府决定减少中央政府在国有企业管理中的作用，鼓励地方政府采取行动，积极引进市场化经营方式，扩大私营企业和合作企业的权利。|对这一政策的不满来自一个意料之外的地方：在阿尔巴尼亚，恩维尔·霍查激烈批评我们的修正主义政策和对马克思主义的背叛，并切断了和我们的一切联系。嗯，他想走向孤立主义——这是他的权利。"

[resource]
script = ExtResource("4_event")
event_id = "reform_and_openness"
source_event_number = 45
trigger_priority = 450
title = "改革开放：先声"
description = "在宣告了市场改革进程之后，我们的经济学家制定了第一次改革的计划，并最终提交给中国共产党领导层批准。它包括扩大企业经营自主权，引入市场机制以调节他们的工作以及支持个体与集体所有制企业。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_stage_1")])
options = Array[ExtResource("1_option")]([SubResource("Option_0")])
