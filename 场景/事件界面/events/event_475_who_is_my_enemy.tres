[resource]
script = ExtResource("4_def")
event_id = "event_475"
source_event_number = 475
trigger_priority = 47500
title = "谁是我的敌人？"
description = "在军委政权倒台后，新生的埃塞俄比亚就两个在推翻门格斯图武装斗争中的少数民族武装：提人阵和厄人阵的未来进行了长时间的讨论。在新生的政权中，有人认为应当组建一个民主的联邦，也有人支持列宁式的民族自决。作为推翻门格斯图政权的始作俑者，我们应当有始有终的解决埃塞俄比亚问题。"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
