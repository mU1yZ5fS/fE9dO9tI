[resource]
script = ExtResource("4_def")
event_id = "event_429"
source_event_number = 429
trigger_priority = 42900
title = "1982年西班牙选举"
description = "妥协候选人卡尔沃·索特洛的当选并不能解救执政党于崩溃之中。1982年8月，民主中间派联盟的创始人阿道弗·苏亚雷斯离开该党，并另建立了社会民主中心党。这导致了执政党内部派系的崩溃，该党也因此在议会内失去多数。结果，西班牙将迎来新一届议会代表选举。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
