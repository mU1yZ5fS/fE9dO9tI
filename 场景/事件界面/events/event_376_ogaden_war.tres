[resource]
script = ExtResource("4_def")
event_id = "event_376"
source_event_number = 376
trigger_priority = 37600
title = "欧加登战争"
description = "索马里自宣布独立后，便向周边邻国提出了一系列领土要求。新政府主张建立所谓的“大索马里国”，按照计划，该国将吞并全部索马里人聚居地，其中包括一部分原属埃塞俄比亚、肯尼亚与吉布提的领土。在1969年革命后，穆罕默德·西亚德·巴雷得以掌权。他宣布将在索马里建设社会主义，并同苏联与社会主义阵营发展经贸往来。然而，巴雷并没有放弃对周边国家的领土野心。\n而在埃塞俄比亚一方，自该国皇帝被推翻后，埃塞俄比亚便成立了由门格斯图领导的亲苏军政府。然而，军政府治理下的国家正走向分离主义肆虐与无政府状态蔓延的深渊。尤其是北部的厄立特里亚地区，当地分离情绪相当浓郁。索马里则试图利用埃塞俄比亚的混乱局势，并开始支持西索马里解放阵线。也就在20世纪70年代中期，解放阵线发动了一场旨在将欧加登地区从埃塞俄比亚地区分离，并让其并入索马里的武装斗争。\n最近，索马里军队则已开入了欧加登。但同巴雷的预料相反，苏联在冲突中居然支持埃塞俄比亚。因此，社会主义索马里开始越加同承诺向自己提供武器的美国走近。\n抉择的时候到了，同志。也许我们应当支持巴雷政权，作为阻止苏联在东非扩张影响力的前线，并为我们在当地寻求一位真正的盟友？又或者，我们应当支持埃塞俄比亚，从而开启我们与社会主义阵营间关系的解冻？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
