[resource]
script = ExtResource("4_def")
event_id = "event_635"
source_event_number = 635
trigger_priority = 63500
title = "Belice de Guatemala"
description = "伯利兹，或称英属洪都拉斯，一直以来都是危地马拉方面力图收复的领土。十七世纪，英国无视西班牙的领土要求侵吞蚕食了这一地区，而中美洲联邦解体后由英国所扶持的危地马拉“独立之父”则在1859年与英国签订了条约，正式将伯利兹地区的主权所出卖，使英国彻底占领了这片地区。尽管伯利兹已经于1981年独立，但英国还是在该国保留了一支一千五百人的部队。\n为了转移国民对日益加剧的社会动荡的注意力，危地马拉军政府选择了声索伯利兹领土，这一直以来都受到大半个拉丁美洲的反对。不过，英国在马尔维纳斯群岛的这场耻辱性大败彻底将这个昔日的日不落帝国的颜面丢的一干二净，这使又一个野心家将自己的目光投向了英国的势力范围……"
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
