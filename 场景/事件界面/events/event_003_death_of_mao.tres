[resource]
script = ExtResource("4_event")
event_id = "death_of_mao"
source_event_number = 3
title = "舵手逝世"
description = "糟糕的事情发生了。9月9日0时10分，在两次心脏病发作后，中国人民的伟大领袖和导师，毛主席去世了，享年83岁。尽管人民和党还在悲伤中，我们需要召集治丧委员会，决定如何送主席最后一程。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
fire_only_once = true
