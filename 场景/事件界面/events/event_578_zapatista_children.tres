[resource]
script = ExtResource("4_def")
event_id = "event_578"
source_event_number = 578
trigger_priority = 57800
title = "萨帕塔的孩子们……"
description = "主席同志，来自墨西哥合众国恰帕斯州的消息。今天，EZLN（萨帕塔民族解放军）在恰帕斯州成立了，该组织在部分成员上也与70年代的左翼游击队存在一定的继承关系。不出我们所料，作为对外国技术和投资都有较高依赖的国家，跨国公司与当地原住民的矛盾极为突出，随着卡西克（一种墨西哥地方豪强）势力的发展，当地的原住民同时受到来自外国资本、当地腐败地主和政府的三重欺压。自从阿夫萨隆·卡斯特利亚诺斯·多明戈斯担任该州州长后，当地政治暴力显著上升。我们是否要支持这些墨西哥贫苦农工的斗争？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
