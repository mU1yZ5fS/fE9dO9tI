[resource]
script = ExtResource("4_def")
event_id = "belize_independence"
source_event_number = 1602
trigger_priority = 160200
title = "伯利兹独立"
description = "同志，1981年9月21日，伯利兹正式宣布独立，成为英联邦内的主权国家。由于危地马拉长期声称对伯利兹拥有主权，英国承诺在独立后继续驻军保卫其安全。我们应当派代表出席独立庆典，并向这个中美洲的新国家表达祝贺。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
