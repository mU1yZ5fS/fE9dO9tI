[resource]
script = ExtResource("4_def")
event_id = "event_707"
source_event_number = 707
trigger_priority = 7070
title = "两河的新娘子"
description = "阿拉伯世界传来了新的消息。在十月二十四日到二十七日之间，哈菲兹·阿萨德总统率代表团亲自访问了巴格达，同伊拉克总统贝克尔签到了民族联合行动宪章。不仅全面修复了两国的关系，在军事，经济和教育方面开展通力合作，两国还决定进行在军事和经济层面的一体化，尝试使用统一的阿拉伯镑，组建联合指挥部和最高革命指挥委员会，伊拉克还恢复了流经叙利亚的输油管道，减轻了两国人民自由流动的手续，并在哈菲兹总统的邀请下向黎巴嫩增派了维和部队。两国在联合公报中再次强调了巴勒斯坦解放事业的必然性，希望以实际行动来唤醒阿拉伯各国反抗以色列的斗争；强调了戈兰高地的归属权；支持在尊重各国主权的前提下展开多元外交。同时，作为各退一步的手段，双方心照不宣的平反了流亡于对方的己方政要，同时就库尔德人及其武装的跨境活动展开商讨。复兴主义之父，哲学家米歇尔·阿弗拉克对两国的新事态感到欣喜，他以个人身份前往了阔别已久的拉塔基亚，大马士革等地。虽然两国没有进一步实现如1961年阿拉伯联合共和国一样的打算，但一切都有待观望。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
