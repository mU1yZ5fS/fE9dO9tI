[sub_resource type="Resource" id="Expr_support_andropov"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_relres"), SubResource("Expr_rel50"), SubResource("Expr_agents100")])

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1982.11.10"

[sub_resource type="Resource" id="E_custom"]
script = ExtResource("2_effect")
