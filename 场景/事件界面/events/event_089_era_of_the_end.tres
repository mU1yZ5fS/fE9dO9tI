[resource]
script = ExtResource("4_event")
event_id = "era_of_the_end"
source_event_number = 89
title = "一个时代的终结"
description = "来自苏联的紧急消息！今天，苏联领导人宣布列昂尼德·伊里奇·勃列日涅夫去世，他领导苏联接近20年。11月10日，这位苏联领导人在梦中死于突发性心力衰竭。在苏联人民哀悼之际，苏共展开了一场激烈的权力斗争，苏共中央总书记的主要竞争者是：尤里·安德罗波夫、弗拉基米尔·谢尔比茨基与康斯坦丁·契尔年科。如果我们的关系不太糟，那么我们可以支持其中一个候选人。"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
