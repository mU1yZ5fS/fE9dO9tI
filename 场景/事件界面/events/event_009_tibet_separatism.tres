[sub_resource type="Resource" id="Opt3"]
script = ExtResource("1_option")
text = "顺水推舟，举行主权公投，但暗中使绊子"
disabled_text = "我们既没有造假的手段，也没有造假的实力"
enable_condition = SubResource("Expr_opt3_enable")
effects = Array[ExtResource("2_effect")]([SubResource("E3_free"), SubResource("E3_man"), SubResource("E3_people"), SubResource("E3_agents"), SubResource("E3_money")])
result_text = "我们组织了一次全民公决，大多数人投票赞成保留西藏的现有地位。不满的民族主义者和其他激进分子走上街头，他们声称公投结果是伪造的，但是没有了过去我们对他们的纵容，这些抗议活动不再构成严重威胁。"

