[resource]
script = ExtResource("4_event")
event_id = "tibet_separatism"
source_event_number = 9
title = "西藏的分离主义"
description = "在自由主义者和民族主义者的鼓励下，西藏自治区居民举行了群众性的要求独立和脱离中华人民共和国的示威活动，并逐渐演变为骚乱。人们要求从“1950年的占领”中“解放”，大多数藏族人支持他们。然而，有些人只是满足于更高度的自治的要求，这是我们可以利用的。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
