[ext_resource type="Script" path="res://数据脚本/事件效果/event_009_tibet_separatism.gd" id="5_custom"]

[sub_resource type="Resource" id="E0_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_option")
text = "我们管不着啊"
effects = Array[ExtResource("2_effect")]([SubResource("E0_custom")])
result_text = "（结果由 event_009_tibet_separatism.gd 动态生成）"

[sub_resource type="Resource" id="Expr_terr23"]
script = ExtResource("3_expr")
type = 1
key = "territory"
value = 22.0

[sub_resource type="Resource" id="E1_free"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = 70.0

[sub_resource type="Resource" id="E1_man"]
script = ExtResource("2_effect")
key = "manpower"
value = -20.0

[sub_resource type="Resource" id="E1_party"]
script = ExtResource("2_effect")
key = "party_support"
value = -200.0

[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_option")
text = "给予他们更多自治权"
disabled_text = "我们不能给予更多的自治权"
enable_condition = SubResource("Expr_terr23")
effects = Array[ExtResource("2_effect")]([SubResource("E1_free"), SubResource("E1_man"), SubResource("E1_party")])
result_text = "我们进一步扩大地方的权力和西藏的自治权。大多数人似乎都很满意，但这给了激进派更多的机会来发展分离主义，其他自治区也有了更大的独立倾向。"

