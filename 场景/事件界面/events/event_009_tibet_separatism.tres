value = 50.0

[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_option")
text = "派部队去恢复秩序"
disabled_text = "只用军队镇压他们是行不通的"
enable_condition = SubResource("Expr_opt2_enable")
effects = Array[ExtResource("2_effect")]([SubResource("E2_free"), SubResource("E2_man"), SubResource("E2_people"), SubResource("E2_army"), SubResource("E2_diplo")])
result_text = "忠诚的解放军进入西藏，并且迅速恢复了西藏的秩序。但民族主义者和反对派不会忘记这一天。"

