[resource]
script = ExtResource("4_def")
event_id = "event_241"
source_event_number = 241
trigger_priority = 2410
title = "新时代，新面孔"
description = "华国锋同志，在我们扫清新赫鲁晓夫反革命集团的伟大胜利之后，陷入了一个尴尬的问题。我们缺少能堪大任的干部。对此，有人建议我们提拔来自山西的“农民总理”陈永贵，以及工人孙健和吴桂贤。这样既保证了极左派对我们的忠诚，也更好的体现了我们对工农联盟国家的重视。\n但是您的同事，现在的王副主席给出了另一个解决方案。如您所知，他在上海的时期结识了不少志同道合的战友，他的方案便是在提拔上述人选的时候，再任命徐景贤，马天水和王秀珍三人。他们的革命热情不可阻挡也不可否认。但党内的温和派担心他们的极左倾向会加速党的分裂。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_done240")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
