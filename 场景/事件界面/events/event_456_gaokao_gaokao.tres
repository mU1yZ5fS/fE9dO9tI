[resource]
script = ExtResource("4_def")
event_id = "event_456"
source_event_number = 456
trigger_priority = 45600
title = "高考？高考！"
description = "自党中央的一纸号令以来，我国采取了“工农兵大学生”制度。即在接受正常理工科教育的同时，参与生产实践活动。同样的也有工人，农民，解放军士兵接受高等教育。和从前的应试考试不同，这套政策开创性的将群众引入了招生中，不以做题而以实践来招生。\n但同时，党内也有一部分人认为这一套应当慢慢的结束，转而恢复老一套的高等教育考试体系。他们的论点是过去的生源质量欠佳，过于强调根正苗红反而扼杀了真正有才华的学生。主席同志，我们是否要恢复高考？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
