[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1976.2"

[resource]
script = ExtResource("4_event")
event_id = "five_no"
source_event_number = 19
title = "五“不准”"
description = "祝贺你被任命为国务院总理，华国锋同志！如你所知，你的前任周恩来同志因他的诚实和行政天赋在海内外颇受人民热爱和尊敬。但他也是经济改革的积极推动者，并在党内提拔改革派，如他的门徒邓小平。为此，76年1月8日，周的去世引起了人民极大的悲伤，但根据周恩来“丧事从简”的遗愿，党发起了五个“不提倡”的运动－不提倡戴黑纱，不提倡送花圈，不提倡设灵堂，不提倡开追悼会，不提倡挂周恩来遗像，但一些地方政府为了规避被指责工作不到位的风险，选择了“一刀切”：将五个“不提倡”执行成了五“不准”，即禁止一切关于周恩来的纪念行为——这到目前为止，只是引起了不满。而你，作为新任总理，可以影响此事的执行。又或许，你可以什么都不做，而是放任事态扩大化？"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
