[resource]
script = ExtResource("4_def")
event_id = "event_546"
source_event_number = 546
trigger_priority = 54600
title = "塞上赤日耀玉关"
description = "新疆人民有着悠久的斗争传统。迪化起义和伊犁辛亥革命粉碎了清王朝妄图西迁以偏安一隅的幻想，而三区革命中的马列主义者们则积极地反抗盛世才、国民党政府的腐朽统治，并且协助我党促成了新疆的和平解放。这片土地上有的不仅仅是黑金与沙粒，更是有着前仆后继的仁人志士和英雄儿女。如今，新疆人民无比热忱地期盼在社会主义制度下的新一波经济建设高潮、新一波的社会革命高潮，还有，自身命运彻底解放的共产主义运动高潮。主席同志，让我们回应人民的呼声，将新疆无产阶级文化大革命推到一个新高度、新阶段！"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
