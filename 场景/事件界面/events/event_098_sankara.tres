[resource]
script = ExtResource("4_def")
event_id = "event_098"
source_event_number = 98
trigger_priority = 9800
title = "非洲的切·格瓦拉"
description = "前法国殖民地上沃尔特注定是个事故频发之地：自民选总统桑古尔·拉米扎纳于1977年被军方推翻后，该国便陷入不断政变的治乱循环。率先坐上头号交椅的亲法军政府领袖赛耶·泽博试图引入军官稳固政权的做法最终却成了引狼入室：亲近共产主义思想的军官们得以借势做大，并在其魅力非凡的领导人托马斯·桑卡拉的旗下逐渐登上权力巅峰。此后，桑卡拉与其同僚在数次政变中先是推翻极不得民心的盗贼政客赛耶·泽博，随后又将军方内物色的妥协领导人让-巴蒂斯特·韦德拉奥果排挤出局。结束了反泽博两派势力的二元共治局面。此后，这个国家的名称立即从殖民地的“上沃尔特”转为“布基纳法索”，意为“正人君子之国”，国旗国徽国歌等都跟着改头换面。如今，深受非洲反帝思潮影响的托马斯·桑卡拉得以彻底摊牌，并宣布将在布基纳法索推进下述几项全新议程：建设非洲社会主义、反对反革命阶级、以及试图基于格瓦拉式的输出革命理论彻底砸碎“法非”概念。上述激进政策显然会让他的政权陷入不稳定中，且桑卡拉试图将权力保持在军事色彩极强的人民解放委员会内，缺乏交权意愿的做法也只会让其统治宛如红色军头，他因此遭到包括多家工会与社会主义政党如沃尔特革命共产党等左翼团体的批评。显然，目前的桑卡拉政权正处于四面开弓与急需盟友支持的境地。我们的支持或许足以扮演关键作用，并改变布基纳法索的力量对比。如果我们想要在西非培育一个忠于革命的窗口，大可押注桑卡拉或正得势的布基纳法索左翼与其事业；又或者，我们可以物色其他角色扭转局势，让非洲回归正轨。谁知道桑卡拉这极具个人色彩的统治会不会演化为黑人波拿巴独裁的又一类变体……"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
