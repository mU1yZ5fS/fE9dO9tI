[resource]
script = ExtResource("4_def")
event_id = "event_511"
source_event_number = 511
trigger_priority = 51100
title = "黄金海岸的再革命？——第三幕"
description = "两年以来，罗林斯将社会主义、民族主义和民粹主义混合起来的理念的实施并未能为加纳经济带来十分乐观的发展，政府补贴为财政带来了负担并造成了通货膨胀。有报告显示，罗林斯正在寻求外部的经济援助和投资，苏东阵营甚至是西方控制的IMF都将可能成为加纳的帮助者。很明显，现在正是我们掺和加纳的时候，应不应该为罗林斯提供一笔无息贷款？这将能为我们争取一个盟友，并保住非洲的一个进步政权。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
