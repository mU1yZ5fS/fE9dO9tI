[resource]
script = ExtResource("4_def")
event_id = "event_613"
source_event_number = 613
trigger_priority = 61300
title = "黑暗大陆的自由斗士"
description = "蒙博托也许不会预料到，自己最亲昵的战友会背叛自己。艾迪安·奇塞克蒂作为蒙博托长久以来的战友和忠实拥蹩，在被蒙博托因为政治洗牌中踢出了中央后竟然自立山头。他组建了民主与社会进步联盟，这是扎伊尔国内最大，也是唯一的一个反对派组织。主席同志，扎伊尔的领袖越发变得偏执而又狂热，也许我们及时的跳船是更好的选择？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
