[resource]
script = ExtResource("4_event")
display_script = ExtResource("5_custom")
event_id = "event_116"
source_event_number = 116
trigger_priority = 11650
title = "两个中国"
description = "如你所知，解放战争胜利后，国民党败逃到台湾岛，西方社会长期认为他们是中国的合法政府。由于美国在台湾的基地和舰队，我们无法解放它，就像国民党无法反攻大陆一样，随着时间的推移，越来越多的国家承认中华人民共和国为中国唯一合法政府，尽管中华人民共和国和台湾政府都没有正式拒绝对全中国的主张。当然，我们之间的关系一直很糟糕，但是最近自由化和中国共产党结束了对权力的垄断之后，我们之间的关系明显升温。现在双方高层都在谈论期待已久的国家统一的可能性。但是，在这种情况下，台湾会旗帜鲜明地要求自治，我们需要在他们的根据地地位上与美国达成一致，而台湾人民成功地发展了他们的文化认同，这将如何影响这个国家已经不稳定的局势，目前还不知道。因此，有人建议我们与台湾相互承认对方为独立国家，建立睦邻友好关系。既然在这种情况下，美国的基地将继续存在，西方公司将免于官僚主义的大惊小怪，那就很好地暗示美国，年轻的民主需要钱……"
fire_only_once = true
show_notification = false
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date_1985"), SubResource("Expr_data107_eq_1"), SubResource("Expr_event_95_done"), SubResource("Expr_event_96_done"), SubResource("Expr_taiwan_dev_0"), SubResource("Expr_taiwan_status_le_0"), SubResource("Expr_not_decision_6"), SubResource("Expr_not_decision_7"), SubResource("Expr_event_461_not_done")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])