[resource]
script = ExtResource("4_def")
event_id = "event_346"
source_event_number = 346
trigger_priority = 34600
title = "在军委会中任职的平民"
description = "一些具有民主思想的党员提议，我们应允许与军队有关联的非直接军事人员当选为军委会成员。一方面，这能解决许多普通士兵没有意识到的问题——军人家眷问题、军工联合体问题、后勤问题。但另一方面，这也会让军队大为不满。我们需要这样的改革吗？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
