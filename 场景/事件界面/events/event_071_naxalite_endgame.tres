[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_071_073_india_and_iran_war.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_power"]
script = ExtResource("3_expr")
type = 0
key = "naxalite_power"
value = 500.0

[sub_resource type="Resource" id="Expr_influence"]
script = ExtResource("3_expr")
type = 0
key = "global_influence"
value = 100.0

[sub_resource type="Resource" id="Expr_trade"]
script = ExtResource("3_expr")
type = 10
key = "对华贸易"
target = "19"

[sub_resource type="Resource" id="Expr_negotiate"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_influence"), SubResource("Expr_trade")])

[sub_resource type="Resource" id="Expr_no_trade"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_trade")])

[sub_resource type="Resource" id="Expr_peace"]
script = ExtResource("3_expr")
type = 21
key = "war_state"
value = 0.0

[sub_resource type="Resource" id="Expr_war"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_no_trade"), SubResource("Expr_peace")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "让他们继续进行游击战，这对我们来说已经足够了"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "以停止敌对行动换取纳萨尔派进入地方政府"
disabled_text = "他们不会和我们谈判"
enable_condition = SubResource("Expr_negotiate")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "准备好战争，派遣部队"
disabled_text = "我们现在不是为了发动战争而加强联系！"
enable_condition = SubResource("Expr_war")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[resource]
script = ExtResource("4_event")
event_id = "naxalite_endgame"
source_event_number = 71
trigger_priority = 710
title = "东方红…"
description = "多亏了我们的支持，在印度东部的毛派反政府武装，即纳萨尔派分子，在东部各州获得了相当大的影响力和一些公众支持。他们控制着大片地区，他们不断的攻击已经成为令东部各州和印度中央政府头疼的问题。一些印度政客已经在考虑与他们谈判，我们可以利用这一点使印度东部的地方政府接纳纳萨尔派，并在谈判中进行调停，这将大大增加我们对印度的影响力，并在印度东部实行相对坚定的左翼政策。这是以纳萨尔派和印度当局能开始与我们谈判为前提的。是的，保持印度东部的不稳定状况可以给我们一个有相对机动余地的机会，而不是和现在一样的未来……然而，部分将领和党员已经制定了一个行动计划，他们提出利用该形势，向伪阿鲁纳恰尔邦（即我国藏南地区）境内派兵，我们假装“保护平民，恢复秩序”，然后就可以毫无问题地将之收回中国。但这将意味着与印度爆发新的边境战争…"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_power")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
