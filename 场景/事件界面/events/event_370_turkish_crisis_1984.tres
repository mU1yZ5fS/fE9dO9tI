[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "我们将不遗余力支持中东国家的反侵略斗争（需要25.0百万预算、15.0点特工网络与40.0点军事实力）"
disabled_text = "军事实力必须强于40......"
enable_condition = SubResource("Expr_opt0_enable")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们向送去了军事援助，以支援他们对抗土耳其侵略者。现在仍很难预测战争的结果如何。但很显然，双方之间的力量对比并不平衡作为对我国支援上述政权的回应，土耳其宣布与中国断交。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "施压美方，将土耳其逐出北约"
disabled_text = "还未签署中美合作协定......"
enable_condition = SubResource("Expr_opt1_enable")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "尽管在北大西洋公约组织的宪章中，并没有关于开除其成员的相关规定，但美国与西欧地区多国已经在北约理事会上提出了一项议案，土耳其“因发动侵略战争并违背民主价值观”而被开除出该联盟。现在仍很难预测战争的结果如何。但很显然，双方之间的力量对比并不平衡。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "我们对此爱莫能助"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "现在仍很难预测战争的结果如何。但很显然，双方之间的力量对比并不平衡。"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "用土耳其式铁拳对付国内分离主义者（需要15.0百万预算与20.0点军事实力）"
disabled_text = "分离主义？我国没有这些东西！"
enable_condition = SubResource("Expr_opt3_enable")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们打算借题发挥，好好借用土耳其人的方法。我们宣称，西藏与维吾尔斯坦的分离主义分子在边界进行了多次挑衅，因此，我国将以“稳定当地局势”为名，向上述地区派出部队。从而迫使那些“割据藩镇”同我们缔结不平等经济协定，并允许我们在当地建立军事基地。至于发生在土耳其的冲突，现在仍很难预测战争的结果如何。但很显然，双方之间的力量对比并不平衡。"

[sub_resource type="Resource" id="Option_4"]
script = ExtResource("1_option")
text = "在联合国安理会发言，建议对土耳其发起维和行动"
disabled_text = "希腊应该是北约成员国......"
enable_condition = SubResource("Expr_opt4_enable")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "联合国安理会同意了实行维和行动的必要性。根据行动计划，苏联将从高加索方向出兵土耳其，而北约将以希腊为入口。对此，土耳其宣布退出北约。"

[resource]
script = ExtResource("4_event")
event_id = "event_370"
source_event_number = 370
trigger_priority = 182
title = "种族灭绝出口"
description = "极其重要的大新闻！本周，土耳其国内的所有主要大城市均发生了爆炸，例如，对安卡拉机场的恐怖袭击导致了超过30人死亡。国家安全委员会政府宣布，库尔德斯坦工人党因对上述事件负全责。尽管该党在土耳其国内的运动已经屡遭打击，但据称，他们依然得到了来自土耳其阿拉伯邻国的援助，以实行其动摇土耳其社会秩序的阴谋。政府领导人凯南·埃夫伦宣称，将对叙利亚伊拉克伊朗开展“增进和平的特别军事行动”。依照既定计划，该行动将花费6个月的时间，彻底摧毁土耳其边界的库尔德人地下恐怖组织。被土耳其侵略的国家们已经向国际社会寻求援助。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_turkey_sub9"), SubResource("Expr_any_neutral"), SubResource("Expr_not_war9"), SubResource("Expr_date_1984_12_21")])
show_notification = false
display_script = ExtResource("5_custom")
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3"), SubResource("Option_4")])
