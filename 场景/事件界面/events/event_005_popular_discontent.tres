key = "people_support"
value = 99.0

[sub_resource type="Resource" id="Expr_freedom_1200"]
script = ExtResource("3_expr")
key = "thought_freedom"
value = 1200.0

[sub_resource type="Resource" id="Expr_trigger"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_support_minus_freedom"), SubResource("Expr_support_negative"), SubResource("Expr_freedom_1200")])

[sub_resource type="Resource" id="Expr_444_done"]
script = ExtResource("3_expr")
type = 5
ref_event_id = "event_444"

[sub_resource type="Resource" id="Expr_444_result0"]
script = ExtResource("3_expr")
type = 4
ref_event_id = "event_444"
value = 0.0

[sub_resource type="Resource" id="Expr_444_both"]
script = ExtResource("3_expr")
