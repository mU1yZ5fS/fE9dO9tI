script = ExtResource("3_expr")
key = "people_support"
value = 501.0

[sub_resource type="Resource" id="Effect_supporters_freedom"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = -200.0

[sub_resource type="Resource" id="Effect_supporters_party"]
