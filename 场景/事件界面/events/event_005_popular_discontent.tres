value = -100.0

[sub_resource type="Resource" id="Option_army"]
script = ExtResource("1_option")
text = "驱散抗议者"
disabled_text = "军方不会支持我们"
enable_condition = SubResource("Expr_army_100")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_army_freedom"), SubResource("Effect_army_cost"), SubResource("Effect_army_diplo"), SubResource("Effect_repression"), SubResource("Effect_liberal_loyalty")])
result_text = "军队最终执行了你的命令并用装甲车辆驱散了城市内的抗议者，双方都有伤亡者出现。当然，这种行为使你被国际社会所谴责。"

