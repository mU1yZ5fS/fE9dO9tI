[sub_resource type="Resource" id="Option_supporters"]
script = ExtResource("1_option")
text = "向忠诚的人民寻求帮助"
disabled_text = "人民已经受够了大鸣大放，你想复辟文革余毒？"
enable_condition = SubResource("Expr_people_500")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_supporters_freedom"), SubResource("Effect_supporters_party"), SubResource("Effect_supporters_diplo"), SubResource("Effect_supporters_people"), SubResource("Effect_reform_loyalty")])
result_text = "通过媒体直播，你呼吁支持你的人保护你的成果不被美国和苏联资助的叛徒的破坏。他们立刻组织起了集会，你的支持者与抗议者大打出手且大部分人被逮捕。当街头抗议尘埃落定，抗议者败下阵来四处逃窜，你的支持者向着天安门前进。"

[sub_resource type="Resource" id="Expr_agents_100"]
script = ExtResource("3_expr")
key = "agents"
value = 150.0

[sub_resource type="Resource" id="Effect_agents_cost"]
script = ExtResource("2_effect")
key = "agents"
value = -150.0

[sub_resource type="Resource" id="Effect_agents_freedom"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = -150.0

[sub_resource type="Resource" id="Effect_agents_people"]
script = ExtResource("2_effect")
key = "people_support"
value = 100.0

[sub_resource type="Resource" id="Option_agents"]
script = ExtResource("1_option")
text = "利用特勤，从内部分化瓦解抗议"
disabled_text = "我们的情报机构对此无能为力"
enable_condition = SubResource("Expr_agents_100")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_agents_cost"), SubResource("Effect_agents_freedom"), SubResource("Effect_agents_people")])
result_text = "国安部从事着通常的业务——贿赂某人，消灭某人，因为国家利益我们会把各种组织和个人从其内部瓦解。反对派只能在内部斗争中衰弱，抗议变成了没有任何策略的集会，很快就会干涸。"

[resource]
script = ExtResource("4_event")
event_id = "popular_discontent"
source_event_number = 5
title = "民众不满"
description = "人民对你政策不满，在全国范围内举行了大规模集会，在广场搭起帐篷营地，分发传单，甚至冲击地方政府建筑。来自不同团体的抗议者对你政府不同的方面不满，但一致要求体制民主化，以限制你在国家政治的影响力。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger_final")])
options = Array[ExtResource("1_option")]([SubResource("Option_speech"), SubResource("Option_democratize"), SubResource("Option_army"), SubResource("Option_supporters"), SubResource("Option_agents")])
fire_only_once = true
