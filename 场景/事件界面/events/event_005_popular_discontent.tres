type = 22
key = "party_system"
value = 9.0

[sub_resource type="Resource" id="Expr_press_not_19"]
script = ExtResource("3_expr")
type = 22
key = "press_policy"
value = 19.0

[sub_resource type="Resource" id="Expr_democratize"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_party_not_9"), SubResource("Expr_press_not_19")])

[sub_resource type="Resource" id="Effect_dem_party_support"]
script = ExtResource("2_effect")
key = "party_support"
value = -50.0

[sub_resource type="Resource" id="Effect_dem_people"]
script = ExtResource("2_effect")
key = "people_support"
value = 100.0

[sub_resource type="Resource" id="Effect_dem_diplo"]
script = ExtResource("2_effect")
key = "diplo"
value = -50.0

[sub_resource type="Resource" id="Expr_party_is_9"]
script = ExtResource("3_expr")
type = 21
key = "party_system"
value = 9.0

[sub_resource type="Resource" id="Effect_press_19"]
script = ExtResource("2_effect")
type = 1
key = "press_policy"
value = 19.0
condition = SubResource("Expr_party_is_9")

[sub_resource type="Resource" id="Effect_party_9"]
script = ExtResource("2_effect")
type = 1
key = "party_system"
value = 9.0
condition = SubResource("Expr_party_not_9")

[sub_resource type="Resource" id="Effect_dem_loyalty"]
script = ExtResource("2_effect")
type = 20
value = -100.0

[sub_resource type="Resource" id="Option_democratize"]
script = ExtResource("1_option")
text = "同意民主化"
disabled_text = "我们已经不能再进一步地民主化了"
enable_condition = SubResource("Expr_democratize")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_dem_party_support"), SubResource("Effect_dem_people"), SubResource("Effect_dem_diplo"), SubResource("Effect_press_19"), SubResource("Effect_party_9"), SubResource("Effect_dem_loyalty")])
result_text = "你亲自与全国各地的抗议者进行了交谈。你承诺将尽一切努力改变政策，考虑到所有公民的利益，并建立真正的民主机制，一些民主机制即将开始实行。人民受到鼓舞，但与此同时，批评的浪潮也因为新获的自由而涌来。"

[sub_resource type="Resource" id="Expr_army_100"]
script = ExtResource("3_expr")
key = "army"
