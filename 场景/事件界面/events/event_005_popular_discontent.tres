[sub_resource type="Resource" id="Expr_503_guard"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_503_result0")])

[sub_resource type="Resource" id="Expr_trigger_final"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_trigger"), SubResource("Expr_444_guard"), SubResource("Expr_503_guard")])

[sub_resource type="Resource" id="Effect_speech"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_speech"]
script = ExtResource("1_option")
text = "向人民群众喊话，安抚他们"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_speech")])
result_text = "（结果由 event_005_popular_discontent.gd 动态生成）"

[sub_resource type="Resource" id="Expr_party_not_9"]
