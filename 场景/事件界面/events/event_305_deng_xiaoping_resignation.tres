[resource]
script = ExtResource("4_def")
event_id = "event_305"
source_event_number = 305
trigger_priority = 30500
title = "小平的辞呈？"
description = "近年来，邓小平在党内的呼声越来越高。他和他的支持者正为自己获得了越来越多的政府职位。如果他的观点不是很可疑的话，我们也可以对此视而不见。是的，他的想法仍然很温和，但在与志同道合的人交谈时，他已在讨论国家的完全自由化。一些有关他与西方情报机构合作的信息也正在收到。值得组织一个阴谋来对抗崛起的密谋自由主义分子吗？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
