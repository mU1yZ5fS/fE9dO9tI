[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_001_elections.gd" id="5_custom"]

[sub_resource type="Resource" id="Custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_option")
text = "不要介入，静待结果"
effects = Array[ExtResource("2_effect")]([SubResource("Custom")])
result_text = "（结果由 event_001_elections.gd 动态生成）"

[sub_resource type="Resource" id="Expr_party501"]
script = ExtResource("3_expr")
key = "party_support"
value = 501.0
[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_option")
text = "推动公务员投票"
disabled_text = "我党绝不容许这种无耻贿选"
enable_condition = SubResource("Expr_party501")
effects = Array[ExtResource("2_effect")]([SubResource("Custom")])
result_text = "（结果由 event_001_elections.gd 动态生成）"

[sub_resource type="Resource" id="Expr_agents50"]
script = ExtResource("3_expr")
key = "agents"
value = 50.0
[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_option")
text = "伪造大选结果"
disabled_text = "情报部门实力不足"
enable_condition = SubResource("Expr_agents50")
effects = Array[ExtResource("2_effect")]([SubResource("Custom")])
result_text = "（结果由 event_001_elections.gd 动态生成）"

[resource]
script = ExtResource("4_event")
event_id = "npc_elections"
source_event_number = 1
title = "金豆豆，银豆豆，投到……"
description = "今天是全国人大选举的日子。既然我们在中国政治上占主导地位，我们就可以稍微干预一下他们的选票去向，这样什么都不会被改变。或者我们仅仅依靠中国人民的信任就好了。"
show_notification = false
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
fire_only_once = false
