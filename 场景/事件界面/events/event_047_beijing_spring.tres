[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_042_047_revolution_and_reform.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1978.6"

[sub_resource type="Resource" id="Expr_stage_0"]
script = ExtResource("3_expr")
type = 21
key = "reform_stage"
value = 0.0

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "让国安部和中共人力资源部长解决这些问题。"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "在旧的方式下，国安和警察开始撕开大字报，寻找地下出版物，中国共产党再次通过了一场对改革派的清洗浪潮（然而，由于改革派在许多中国共产党组织中的统治地位，这场清洗并没有那么顺利）。人民和改革派都不高兴，但抗议浪潮已经停止。希望现在不满的人不会采取更激进的行动"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "加入与改革派的争论并否定他们"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们控制的媒体积极发表了我们的文章，驳斥了改革派的论文，在党的会议室里，左翼和右翼之间的争论再次爆发。当然，改革派也用新的文章和杂志来回应。人民对你们的争论很感兴趣，尽管由于改革派的民粹主义，大多数同情者站在他们一边，但也有站在你们的立场上的支持者。但如此广泛讨论政治问题的事实（这是自“百花齐放”运动以来首次）增强了人民对民主变革不可避免的信心。谁知道结果会是什么…"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "我们的媒体会处理这种低廉的宣传"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "你没有特别的反应。左翼和右翼之间的斗争大多不会超出中共会议室的墙壁，我们的媒体继续在你的支持下发言，批评改革派和他们的支持者的文章（事实证明媒体不是特别有用），学生们继续悬挂大字报。嗯，至少没有看到大规模的不满。"

[resource]
script = ExtResource("4_event")
event_id = "beijing_spring"
source_event_number = 47
trigger_priority = 470
title = "北京之春"
description = "从今年年中开始，全国各地的学生和知识分子开始了激烈的活动，尤其是在北京，大街上挂着大字报（带有用于宣传和抗议的大象形文字的壁报），出版自制的杂志。大字报和报刊反对中国共产党的保守主义，批评文化大革命，呼吁经济和政治的自由化，对中国共产党内积极的改革派表示支持。此外，1977年，改革派们在他们控制下的期刊和报纸上发表了激烈的对我们政策的批评，他们说我们的政策“不符合马克思主义”，又主张“经济发展应该压倒意识形态工作”，“实践是检验真理的唯一标准”，并在他们的愿景中描述了市场改革的远大前景。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_stage_0")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
