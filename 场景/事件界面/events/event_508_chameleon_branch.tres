[resource]
script = ExtResource("4_def")
event_id = "event_508"
source_event_number = 508
trigger_priority = 50800
title = "树枝不会在变色龙手里折断"
description = "随着克雷库政权走社会主义道路以来已经过去了十余年。但贝宁的一切都说不上算多好，过于急切的追求工业化导致了经济发展的失衡。而公开反对法帝国主义则成为了压垮骆驼的最后一根稻草克雷库多次表示希望西方国家能帮助贝宁度过难关。他首先强调“贝宁革命的最终目的是社会主义，但社会主义要分阶段实现。”克雷库政权对小资产阶级和外国资本的态度也有了显著的转变。从一开始的完全打压与限制，再到仅在国家层面进行监管，最后则是开始准备扭转国有化进程。很明显，贝宁革命正在危机边缘，领导人同志，我们也许可以提供一笔无息贷款？这会为我们带来一个革命同志，同时狠狠的打苏联的脸。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
