[resource]
script = ExtResource("4_def")
event_id = "event_106"
source_event_number = 106
trigger_priority = 10600
title = "民主国际"
description = "在安盟反共反叛运动的主要基地安哥拉城市贾姆巴，正在筹备一次会议，与会者希望在会议结果之后建立所谓的会议。“民主国际”-来自不同国家的反共叛军联盟。除安盟外，阿富汗圣战者、尼加拉瓜反对派和老挝苗族的代表也出席了会议，银行家刘易斯·勒曼（活动金融家）、著名说客和电影制片人杰克·阿布拉莫夫（活动发起人）和奥利弗·诺斯中校等美国保守派人士也积极参加了会议。尽管即将成立的同盟会具有鲜明的反苏倾向，但它也与我们的利益区相交叉，并可能在未来造成问题。另一方面，我们也可以在与苏联的地缘政治斗争中对其加以利用。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
