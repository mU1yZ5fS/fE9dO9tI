[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/core/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/core/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/core/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/core/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_067_070_crises_and_plenums.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1980.2"

[sub_resource type="Resource" id="Expr_reform"]
script = ExtResource("3_expr")
type = 0
key = "reform_stage"
value = 1.0

[sub_resource type="Resource" id="Expr_power"]
script = ExtResource("3_expr")
type = 35
key = "1,2"
target = "0"
value = 1.0

[sub_resource type="Resource" id="Expr_party_650"]
script = ExtResource("3_expr")
type = 0
key = "party_support"
value = 650.0

[sub_resource type="Resource" id="Expr_party_600"]
script = ExtResource("3_expr")
type = 0
key = "party_support"
value = 600.0

[sub_resource type="Resource" id="Expr_promote"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_party_650"), SubResource("Expr_power")])

[sub_resource type="Resource" id="Expr_remove"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_party_600"), SubResource("Expr_power")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "什么也不做。不同的观点是民主的保证"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "在党的全会上攻击保守派，支持改革派"
disabled_text = "中国共产党可不会陪你玩过家家"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "在党的全会上攻击保守派"
disabled_text = "中国共产党不会让你轻易的消灭他们"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[resource]
script = ExtResource("4_event")
event_id = "little_gang_of_four"
source_event_number = 69
trigger_priority = 690
title = "另一个四人帮？"
description = "主席同志，在你的努力下，我们终于铲除了文化大革命的遗毒，我们的国家正在走向光明的市场经济未来！然而，仍然有一些人不同意这样的发展，并竭尽全力抗议市场化政策的实施，破坏了我们良好的改革倡议。这些人主要是保守的毛派，由四名党内高层领导，他们拒绝进一步的改革。通过打击他们和他们的支持者，我们可以让更多的权力掌握在改革派手中。此外，在那些没有保守派的地方，我们将有可能促进对改革的积极支持者的产生，毕竟这些改革已在民众和官僚中受到欢迎。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_reform")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
