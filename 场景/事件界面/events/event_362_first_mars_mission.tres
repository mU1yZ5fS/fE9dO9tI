[resource]
script = ExtResource("4_def")
event_id = "event_362"
source_event_number = 362
trigger_priority = 36200
title = "第一次火星任务"
description = "中国很可能执行一次火星任务。问题是，这仅是一次着陆任务，还是我们决定创造一种从未有人尝试过的东西——探测器。当然，这十分复杂，但也能给科学带来难以置信的好处！"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("E362_date"), SubResource("E362_tech"), SubResource("E362_done360")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
