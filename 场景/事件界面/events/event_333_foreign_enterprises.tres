[resource]
script = ExtResource("4_def")
event_id = "event_333"
source_event_number = 333
trigger_priority = 33300
title = "外国企业"
description = "不久前，我们便允许外国企业在我国活动，现在一些党员要改变他们的经营条件。我们要怎么做？是为了国家和人民的利益，大幅提高对外企尊重工人权利的要求，并令其为国家工作，还是为了外交政策的成功而与国际资本达成合作，完全对其免税？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
