[resource]
script = ExtResource("4_def")
event_id = "event_705"
source_event_number = 705
trigger_priority = 70500
title = "冠礼"
description = "自1971年接过父亲的权柄以来，让-克洛德·杜瓦利埃便作为海地最有权势的人——没有之一，行使着对伊斯帕尼奥拉岛西侧领土的绝对统治权。尽管如此，小杜瓦利埃似乎并没有做好准备，像他父亲那样“执敲扑而鞭笞天下”。比起成为一位“帝王总统”，他更愿意将时间花在享乐、敛财和花天酒地之上。此前，他通过象征性的民主改革和强硬的反共姿态来维系与美国的关系，从而免于被美国的武力施压所推翻。\n但随着庇护伞的撤离，尤其是“邦交国”的覆灭和美利坚合众国极速的战略收缩，迫使小杜瓦利埃不得不采取更积极的态度，为自己寻求一条生路。既然美国即将抛弃小杜瓦利埃，那我们为什么不也给美国人一点教训呢？在与我们的盟邦进行了充分而恳切的意见交换后，我们决定为他献上一场“巫术仪式”。\n也就是在这一时刻，两位大人物分别找上了小杜瓦利埃：中非人民帝国的君主让-贝德尔·博卡萨亲自飞抵太子港。在交流治国经验时，博卡萨声情并茂地展示了在东方智者指导下，中非人民帝国所发生的翻天覆地的变化。原先连温饱都无法解决的农业国，如今已成为自给足的非洲乐土，任何反对声音都完全臣服于唯一的君主——也就是博卡萨本人。小杜瓦利埃在看完讲述中非革命发展的纪录片后拍手叫好，脱口而出道：“我看中非搞得不错！要是再加上我们海地的通顿马库特和伏都教，那这就是海地理想的未来！”\n没过多久，法兰西社会主义王国的特使莫里斯·克拉维尔出访该国，更是动之以情、晓之以理。他以该国目前第二大贸易伙伴的身份，向其展示了真正的天下大道：一种不同于共产主义和资本主义、更适合海地的道路。莫里斯谈道：“社会主义和君主制从来都不矛盾。甚至，如果海地也能有一位君主，这个国家将会更伟大！”莫里斯一语点醒梦中人：海地向来不缺乏将民族主义、社会正义和君主制相结合的伟大领袖——让-雅克·德萨林和苏鲁克大帝，不都是在水深火热之中拯救国家、再造伟业而被万世铭记的人吗？\n那一夜，让-克洛德·杜瓦利埃沉思良久。他想起了自己的父亲，想起了自己这个伟大的国家，以及两位访客所谈起的那些高深言论。终于，他在自己的自传中感慨道：“德萨林、苏鲁克之事，吾知之矣！”他意识到，自己的父亲其实与东方的伟大智者毛泽东不谋而合！海地人民不正是美洲地位最低贱、却最富反抗精神的民族吗？数十年来，政府如走马灯一般更迭，但海地人民依然蓬勃如斯，这种低烈度的内战何尝不是一种“打倒一切权威”的体现？天将降大任于斯人也，他的父亲弗朗索瓦·杜瓦利埃正是接过天命和历代革命者旗帜的人，而小杜瓦利埃，则注定是要将这面旗帜举得更高的、唯一的领袖。\n海地最高领导人让-克洛德·杜瓦利埃亲自致信给英明的领袖华国锋同志，邀请其飞抵太子港，参加庆祝海地革命的宴席。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
