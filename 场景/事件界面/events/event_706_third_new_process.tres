[resource]
script = ExtResource("4_def")
event_id = "event_706"
source_event_number = 706
trigger_priority = 70600
title = "第三次“新进程”"
description = "自1967年执政以来，纳辛贝·埃亚德马中校便长期大权独揽，建立起了一个围绕其个人的军事独裁政权。虽然埃亚德马政府在宣传中始终宣称自己“对内维护民族独立与国家统一，反对地方主义和分裂主义；对外奉行反帝、反殖民和不结盟政策”，但整个西非终究仍被名为“法兰西帝国主义”的魔爪牢牢攥住，弱小的多哥自然难以独善其身。|因此，这位“进步军人”不得不长期背负着“法兰西傀儡”的名声苟且度日。|但现在，世界格局正在迅速变化。法兰西在西非的影响力日渐衰退，而中国所代表的新型革命道路则蒸蒸日上。就在不久前，埃亚德马刚刚接见了由扎伊尔共和国总统蒙博托·塞塞·塞科率领的人民革命运动代表团。|在友好的会谈中，蒙博托向埃亚德马抛出了一个耐人寻味的问题：“既然法兰西殖民帝国已是江河日下，那么多哥共和国又怎能不受到波及？”还未等埃亚德马作出回答，扎伊尔人民的领袖便亲自给出了自己的答案：“审时度势，拥抱真正的反帝爱国力量——比如中国。”|在送别人民革命运动代表团后，埃亚德马沉思良久。他想起了自己参与的第一次革命。1963年，在奥林匹欧总统遇刺之后，正是他扶持格鲁尼茨基政府上台，使国家避免了彻底陷入内乱。随后，他又想起了自己的第二次革命——他亲手推翻了那个由自己一手扶植、却已腐败无能的格鲁尼茨基政府，并最终确立了以自己为核心的统治集团。|但现在，是时候发动第三次革命了。他将利用自己手中的王牌——多哥武装部队，去完成一次真正正确的事业。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
