[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_053_062_reform_and_alliances.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1979.10"

[sub_resource type="Resource" id="Expr_agents"]
script = ExtResource("3_expr")
type = 0
key = "agents"
value = 60.0

[sub_resource type="Resource" id="Expr_budget"]
script = ExtResource("3_expr")
type = 0
key = "budget"
value = 40.0

[sub_resource type="Resource" id="Expr_reserve"]
script = ExtResource("3_expr")
type = 0
key = "reserve"
value = 40.0

[sub_resource type="Resource" id="Expr_funds"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_budget"), SubResource("Expr_reserve")])

[sub_resource type="Resource" id="Expr_japan_stable"]
script = ExtResource("3_expr")
type = 25
key = "stability"
value = 1.0
target = "44"

[sub_resource type="Resource" id="Expr_aid"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents"), SubResource("Expr_funds"), SubResource("Expr_japan_stable")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "This does not concern us"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "The Liberal Democratic Party retained power and continued Japan's pro-Western course."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Provide covert financial assistance to the Japanese Communist Party"
disabled_text = "Requires 60 agents, 40 combined budget and reserves, and a stable Japan"
enable_condition = SubResource("Expr_aid")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Chinese covert aid enabled a left coalition victory, ending Japan's military alignment with the United States."

[resource]
script = ExtResource("4_event")
event_id = "red_rising_sun"
source_event_number = 57
trigger_priority = 570
title = "Red rising sun"
description = "Japan's election offers Beijing a narrow opportunity to revive the communist opposition and break the country's pro-American alignment."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1")])
