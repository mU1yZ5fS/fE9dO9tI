[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/core/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/core/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/core/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/core/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_053_062_reform_and_alliances.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1979.10"

[sub_resource type="Resource" id="Expr_agents_60"]
script = ExtResource("3_expr")
type = 0
key = "agents"
value = 60.0

[sub_resource type="Resource" id="Expr_japan_stable"]
script = ExtResource("3_expr")
type = 25
key = "stab"
value = 1.0
target = "44"

[sub_resource type="Resource" id="Expr_aid"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents_60"), SubResource("Expr_japan_stable")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "我们不关心此事"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "结果自民党利用了反对派的分裂，获得了44%的选票，继续执政。大平正芳首相继续日本的自由—亲西方路线。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "向日共提供财政和特工援助"
disabled_text = "日共不会听我们的话的。"
enable_condition = SubResource("Expr_aid")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "由于我们及时地消灭了宫本显治，日共愉快地回到了北京的控制下，并接受了我们的帮助。多亏了我们的资金帮助，他们得以开展有效的选前活动，我们的情报部门也编造了自民党的黑材料，并干扰他们的演说。结果，日共破纪录地得到了31%的选票，并且和社会党，公明党和其他中左翼反对党组成了联盟。不久对自民党官员腐败和滥用职权的诉讼被提起，之后一项关于将日本退出与美国和北约签订的军事条约并逐步剔除美国在日军事存在的条约在人民广泛支持下被通过了。"

[resource]
script = ExtResource("4_event")
event_id = "red_rising_sun"
source_event_number = 57
trigger_priority = 5700
title = "红色旭日"
description = "不久日本将举行众议院选举。由于政府不稳定和腐败丑闻的背景，日本共产党在近期逐渐获得人民支持，其他一些中左翼的反对派也是如此。假如我们对日共有影响力，就可以帮助他们的竞选活动。如果他们胜选了，我们可以与历史对手改善关系，并最终使美军基地撤出日本。"
trigger_conditions = Array[ExtResource("3_expr")]([])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1")])
