[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_064_066_international.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1980.8"

[sub_resource type="Resource" id="Expr_government"]
script = ExtResource("3_expr")
type = 25
key = "government"
value = 2.0
target = "30"

[sub_resource type="Resource" id="Expr_funds"]
script = ExtResource("3_expr")
type = 23
keys = Array[String](["budget", "reserve"])
value = 70.0

[sub_resource type="Resource" id="Expr_agents"]
script = ExtResource("3_expr")
type = 0
key = "agents"
value = 50.0

[sub_resource type="Resource" id="Expr_prosov"]
script = ExtResource("3_expr")
type = 10
key = "亲苏"
target = "30"

[sub_resource type="Resource" id="Expr_not_prosov"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_prosov")])

[sub_resource type="Resource" id="Expr_relres"]
script = ExtResource("3_expr")
type = 14
key = "relres"

[sub_resource type="Resource" id="Expr_alignment"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_not_prosov"), SubResource("Expr_relres")])

[sub_resource type="Resource" id="Expr_intervene"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_funds"), SubResource("Expr_agents"), SubResource("Expr_alignment")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "It is not worth our strength"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "The Arab states remained fragmented, preserving Israel's strategic advantage."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Assist the creation of a United Arab Republic"
disabled_text = "Requires 70 combined budget and reserves, 50 agents, and either an independent target or Soviet reconciliation"
enable_condition = SubResource("Expr_intervene")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Chinese mediation and aid created a confederal United Arab Republic of Egypt, Libya and Syria."

[resource]
script = ExtResource("4_event")
event_id = "pan_arabism"
source_event_number = 64
trigger_priority = 640
title = "Pan-Arabism"
description = "Egypt, Libya and Syria again discuss political union. Chinese intervention could turn another paper project into a functioning confederation."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_government")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1")])
