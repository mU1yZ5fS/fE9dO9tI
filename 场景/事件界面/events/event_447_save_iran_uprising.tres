[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "给伊朗人卖个人情，泄漏关于政变的内容"
disabled_text = "别和神权分子走那么近！"
enable_condition = SubResource("Expr_cond_opt1")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们决定打电话给伊斯兰共和国政府总理，告知了他们关于政变的阴谋。7月9日晚，莫哈格吉和几名飞行员散会后，在路边等待接应的车辆时，突然看见革命卫队的吉普正这朝边奔来。他们迅速钻进路旁的小树林逃避。莫哈格吉懵了，他不清楚是不是他们已经暴露。跑回公寓后，他直接拨通了原防空司令马赫迪奥的电话。随后，二人开车在德黑兰街头碰面。哥俩现在都不排除计划已泄露的可能性，但如箭在弦，已无回头路。马赫迪奥告诉莫哈格吉将联系陆军的阿梅里，准备提前动手。无论是否成功，他们都将坦然面对。这终将是一场灾难性的失败……第二天一早，伊斯兰革命卫队开始了对“面具”的清剿。包括莫哈格吉、马赫迪奥在内的600多人先后被捕，一些人在抵抗中遭击毙。陆军上校阿梅里和少数人成功逃进了土耳其。在伊朗政府安排的电视审判上，还有相当戏剧性的一幕，莫哈格吉准将挣脱了两旁的革命卫队成员，怒吼道：“我是一名伊朗军人！……我之所以参与行动，是因为我对祖国所发生的一切感到幻灭。阿訇先生（在伊朗是对毛拉的贬义称呼），请不要问我是否后悔！我们参加行动不是为了金钱或地位，而是为了拯救我的祖国！他（霍梅尼）是你们这些蠢货的伊玛目，不是我的！！”伊朗人感谢我们的通风报信，并决定扩大和我们的贸易往来。并决定为我们的主席颁发一枚伊朗伊斯兰共和国二级国旗勋章。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "我们最好关注自己的事情。"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "人民党利用其在军中的情报网络，无意间获取了部分武装力量将发动起义的消息。时任该党中央委员的穆罕默德·阿里·阿穆伊在与党魁基亚努里商议后，决定抓住这个机会向老霍头邀功、表忠心！希望以此让霍梅尼认为自己这个共产主义者将和他永远穿一条裤子。7月9日晚，莫哈格吉和几名飞行员散会后，在路边等待接应的车辆时，突然看见革命卫队的吉普正这朝边奔来。他们迅速钻进路旁的小树林逃避。莫哈格吉懵了，他不清楚是不是他们已经暴露。跑回公寓后，他直接拨通了原防空司令马赫迪奥的电话。随后，二人开车在德黑兰街头碰面。哥俩现在都不排除计划已泄露的可能性，但如箭在弦，已无回头路。马赫迪奥告诉莫哈格吉将联系陆军的阿梅里，准备提前动手。无论是否成功，他们都将坦然面对。这终将是一场灾难性的失败……第二天一早，伊斯兰革命卫队开始了对“面具”的清剿。包括莫哈格吉、马赫迪奥在内的600多人先后被捕，一些人在抵抗中遭击毙。陆军上校阿梅里和少数人成功逃进了土耳其。在伊朗政府安排的电视审判上，还有相当戏剧性的一幕，莫哈格吉准将挣脱了两旁的革命卫队成员，怒吼道：“我是一名伊朗军人！……我之所以参与行动，是因为我对祖国所发生的一切感到幻灭。阿訇先生（在伊朗是对毛拉的贬义称呼），请不要问我是否后悔！我们参加行动不是为了金钱或地位，而是为了拯救我的祖国！他（霍梅尼）是你们这些蠢货的伊玛目，不是我的！！"

[resource]
script = ExtResource("4_event")
event_id = "event_447"
source_event_number = 447
trigger_priority = 65
title = "拯救伊朗大起义"
description = "随着伊朗文化大革命的进行，越来越多的人开始意识到，霍梅尼的野望也许不止是大权独揽，而是将伊斯兰渗透到政治的方方面面。1980年4月，以空军准将艾亚特·莫哈格吉、原首都防空司令赛义德·马赫迪奧和巴盖尔·阿梅里上校为首的一批军中精英，成立了代号“面具”的组织。前过渡政府总理沙普尔·巴赫蒂亚尔资助了他们的活动。根据他们的声明，这似乎是一个意图推翻伊斯兰共和国的运动。然而，在另一方面，我们获得了不太一样的情报：除了前述的密谋者外，该运动的背后还存在一个“阿扎德甘组织”-自由灵魂运动，它是由一位前法西斯政党成员，祆教徒巴赫拉姆·雅利安纳（本名侯赛因·马努切里，自称为伊朗民族主义者和温和社会主义者）创建，据称获得了从温和左翼到君主主义者和民族主义者的支持，具有强硬的君主制倾向。可见政变团体内部并非铁板一块，我们说不定能够借机掺上一脚。我们可以为他们提供来自我方的帮助。当然也可以借助这个机会卖伊朗当局一个人情。主席同志，我们该怎么办？"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_prev_446_done"), SubResource("Expr_date_any")])
show_notification = false
fire_only_once = true
display_script = ExtResource("5_custom")
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
