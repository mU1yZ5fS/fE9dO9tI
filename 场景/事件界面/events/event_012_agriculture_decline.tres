[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]

[sub_resource type="Resource" id="Expr_ind0"]
script = ExtResource("3_expr")
type = 1
key = "agriculture"
value = 0.0

[sub_resource type="Resource" id="E0_ind"]
script = ExtResource("2_effect")
key = "agriculture"
value = 100.0

[sub_resource type="Resource" id="E0_money"]
script = ExtResource("2_effect")
key = "money"
value = -100.0

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_option")
text = "紧急拨款用于发展"
effects = Array[ExtResource("2_effect")]([SubResource("E0_ind"), SubResource("E0_money")])
result_text = "大量资金被紧急从预算中拨出，用于农业现代化、引进这一领域的技术和专家。问题开始被解决了。"

[sub_resource type="Resource" id="Expr_usa60"]
script = ExtResource("3_expr")
type = 8
key = "0"
value = 600.0

[sub_resource type="Resource" id="Expr_dev13"]
script = ExtResource("3_expr")
key = "economy_system"
value = 13.0

[sub_resource type="Resource" id="Expr_sez"]
script = ExtResource("3_expr")
type = 14
key = "sez"

[sub_resource type="Resource" id="Expr_opt1_b"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_dev13"), SubResource("Expr_sez")])

[sub_resource type="Resource" id="Expr_opt1_enable"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_usa60"), SubResource("Expr_opt1_b")])

[sub_resource type="Resource" id="E1_ind"]
script = ExtResource("2_effect")
key = "agriculture"
value = 100.0

[sub_resource type="Resource" id="E1_living"]
script = ExtResource("2_effect")
key = "living"
value = -50.0

[sub_resource type="Resource" id="E1_free"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = -50.0

[sub_resource type="Resource" id="E1_rel"]
script = ExtResource("2_effect")
type = 8
key = "0"
value = -50.0

[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_option")
text = "吸引外国投资"
disabled_text = "投资者嫌弃我们"
enable_condition = SubResource("Expr_opt1_enable")
effects = Array[ExtResource("2_effect")]([SubResource("E1_ind"), SubResource("E1_living"), SubResource("E1_free"), SubResource("E1_rel")])
result_text = "我们的招商引资活动非常成功！外国人自己现在建造和现代化我们的农场，我们没有从预算里花半毛钱。诚然，为此，有必要降低最低工资、安全生产要求等劳动法规的要求，但没关系，人民会承受住的。"

[sub_resource type="Resource" id="Expr_ussr70"]
script = ExtResource("3_expr")
type = 8
key = "1"
value = 700.0

[sub_resource type="Resource" id="Expr_relres"]
script = ExtResource("3_expr")
type = 14
key = "relres"

[sub_resource type="Resource" id="Expr_opt2_enable"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_ussr70"), SubResource("Expr_relres")])

[sub_resource type="Resource" id="E2_ind"]
script = ExtResource("2_effect")
key = "agriculture"
value = 100.0

[sub_resource type="Resource" id="E2_power"]
script = ExtResource("2_effect")
type = 10
key = "1"
value = 10.0

[sub_resource type="Resource" id="E2_rel1"]
script = ExtResource("2_effect")
type = 8
key = "1"
value = -50.0

[sub_resource type="Resource" id="E2_rel0"]
script = ExtResource("2_effect")
type = 8
key = "0"
value = -100.0

[sub_resource type="Resource" id="E2_loyalty"]
script = ExtResource("2_effect")
type = 21
key = "3,2"
value = -100.0

[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_option")
text = "请求苏联的帮助"
disabled_text = "我们不需要修正主义者的施舍！"
enable_condition = SubResource("Expr_opt2_enable")
effects = Array[ExtResource("2_effect")]([SubResource("E2_ind"), SubResource("E2_power"), SubResource("E2_rel1"), SubResource("E2_rel0"), SubResource("E2_loyalty")])
result_text = "苏联同意像过去如何帮助我们一样使我们现在实现农业现代化。然而，他并不特别喜欢无偿派遣专家和机器，我们对苏联也有一些依赖。"

[sub_resource type="Resource" id="Expr_agr500"]
script = ExtResource("3_expr")
key = "industry"
value = 500.0

[sub_resource type="Resource" id="E3_ind"]
script = ExtResource("2_effect")
key = "agriculture"
value = 100.0

[sub_resource type="Resource" id="E3_agr"]
script = ExtResource("2_effect")
key = "industry"
value = -100.0

[sub_resource type="Resource" id="Opt3"]
script = ExtResource("1_option")
text = "以牺牲农业为代价促进发展"
disabled_text = "农业的处境也好不到哪里去"
enable_condition = SubResource("Expr_agr500")
effects = Array[ExtResource("2_effect")]([SubResource("E3_ind"), SubResource("E3_agr")])
result_text = "通过对企业预算资金和收入的再分配，我们能够将工业的力量引导到农业的发展。这对农业有帮助，但工业遭受了巨大打击。"

[resource]
script = ExtResource("4_event")
event_id = "agriculture_decline"
source_event_number = 12
title = "农业衰退"
description = "我们的农业正处于空前的衰退之中—即使在大跃进时期也没有这种情况！"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_ind0")])
show_notification = false
fire_only_once = false
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
