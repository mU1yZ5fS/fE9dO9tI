[resource]
script = ExtResource("4_def")
event_id = "event_673"
source_event_number = 673
trigger_priority = 67300
title = "乞丐死时不会有彗星出现……"
description = "主席同志，大事不妙！由于此前我们借爱尔兰共和军之手投向英国的那几枚炸弹，现在，整个英国的形势已经乱成了一锅粥。\n正在威斯敏斯特宫举行内阁会议的撒切尔政府被SAM-7导弹一锅端，首相与整个内阁十余名大臣尽数被邀请到天国造访，而携家人度假的女王伊丽莎白二世也在巴尔莫勒尔野狩途中变成了继路易斯·蒙巴顿后英国第二位王室出身的宇航员。\n因此，在巨大的权力真空与狂热的复仇情绪面前，国防参谋长埃德温·布拉莫尔元帅、陆军总司令弗兰克·基特森上将、总参谋长约翰·斯坦尼尔上将、特种空勤团指挥官彼得·德拉·比利埃尔等高级军官迅速作出反应，协同皇家海军、皇家空军与情报机构一道以不列颠国防政府的名义接管了群龙无首的政权，亲手为不列颠数百年来一直引以为傲的威斯敏斯特议会民主制画上了句号。\n幸免于难的王太子在一场匆忙筹备的典礼上紧急加冕为查尔斯三世。新政府宣布引入内安法令，在全国范围内进行戒严，议会活动也被无限期暂停。保守党强硬派（星期一俱乐部、托利行动、斯文顿圈等利益集团）乃至新法西斯主义的民族阵线、英国民族党均成为了政府的合作伙伴，光头党和足球流氓们也纷纷被招揽，纳入有国防政府背书的极右翼民兵团体。\n不列颠尼亚上空乌云密布，全欧洲都在翘首以待利维坦的新主权者出现……"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
