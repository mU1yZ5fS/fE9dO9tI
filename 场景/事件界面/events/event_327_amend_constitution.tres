[resource]
script = ExtResource("4_def")
event_id = "event_327"
source_event_number = 327
trigger_priority = 32700
title = "修宪？"
description = "在1978年的旧宪法中，带有革命浪漫色彩与“革命委员会”风格的名词比比皆是。但是我们的革命已经结束了，我们想要韬光养晦，而在此过程中，革命的悲情和浪漫就显得不太合适了。也许去掉这些名词，用更枯燥些的文字取而代之是值当的？很明显，保留这些名词将表明极左派在政治舞台上仍占据一席之地。如果这些名词被除掉了，党和人民就会明白我们站在改革派一边。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
