[resource]
script = ExtResource("4_def")
event_id = "event_882"
source_event_number = 882
trigger_priority = 88200
title = "罗德斯与伊安的土地"
description = "最终，独立的津巴布韦最担心的事情还是发生了。随着南非状态在多方驰援之下不断的稳定下来了，越来越多的部队开始越境袭扰津巴布韦的定居点，在放一把火或掠夺一番后便班师回朝。如果仅仅是这样，津巴布韦的武装力量尚能反制，那么当南非大军压境，他们还能做什么呢？而这样的噩梦已经成真了。就在最近，南非外交部对外宣布发起“石英”行动，名义上是打击在藏身于津巴布韦南部的黑人游击队，事实上就是针对津巴布韦现政权的军事行动。许多车上同时挂着绿白旗和橙白蓝的南非国旗，许多士兵喊着“为1980复仇”之类的口号，冲着前往布拉瓦约和哈拉雷。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
