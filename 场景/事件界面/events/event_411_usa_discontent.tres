[resource]
script = ExtResource("4_def")
event_id = "event_411"
source_event_number = 411
trigger_priority = 41100
title = "美国对我国内政不满"
description = "这天，一家美国电视台对某位中国反对派兼持不同政见者进行了采访，后者指责中国在内政问题上“毫无民主，采取极权手腕，并完全用行政命令手段解决政治问题”。此外，美国还显著降低了中国本年度的“民主自由指数”评级。美国方面的这些反应可被看作是一个信号：显然，美国领导人要求我们调转航向。否则，就得做好应对一切手段的准备。可我们对此该怎么做呢？"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4"), SubResource("Opt5")])
