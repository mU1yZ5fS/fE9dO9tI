[resource]
script = ExtResource("4_def")
event_id = "event_476"
source_event_number = 476
trigger_priority = 47600
title = "富特-本恩阴谋论？"
description = "自1983年工党左派政府实行激进的社会主义政策以来，许多企业都被国有化或被工人合作社接管，撒切尔政府遗留的失业问题和经济问题因为社会主义政策的实施被极大改善。而因为工党右翼被边缘化，内阁和议会工党都相当团结，政府在工人中很受欢迎，英国的工人运动和工会活动都因此更活跃了。政府将在不久后推行此前承诺的共和主义政策，对上议院和君主制开刀。\n但是左翼和共和主义的高歌猛进和工人阶级力量的壮大让英国的保守势力十分不满。保守党强硬派（星期一俱乐部、托利行动、斯文顿圈等利益集团）已经同国防参谋长埃德温·布拉莫尔元帅等军方高级成员、情报机构以及不满工党政府经济政策的英格兰银行行长罗伯特·利-彭伯顿和一众商业大亨联合起来了，来自保守党内强硬派利益集团“星期一俱乐部”的退伍将军沃尔特·沃克爵士被推举为该阴谋团体的领导人，他们正准备发起针对左翼政府的政变。一时间，英国的上空布满了阴云与危机。\n我们要不要做些什么，趁一切还来得及之前……"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("6_trigger")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
