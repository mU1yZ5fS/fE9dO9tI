[resource]
script = ExtResource("4_def")
event_id = "event_147"
source_event_number = 147
trigger_priority = 14700
title = "双头体系"
description = "自1973年的大选之后，委内瑞拉的两党抗衡局面便十分明朗了，即在大选中只有两大政党有赢得选举的现实可能性。而作为第三大势力的左翼政党如果不能达成统一意见，在四位受提名者中决定唯一的一位候选人，便难以获得大选的胜利。总体而言，目前有两位总统候选人：其一是来自社会基督教党（COPEI）的路易斯·埃雷拉·坎平斯。他主张国家对经济强有力的干预，发展石油出口产业同英国竞争；其二是来自民主行动党（AD）的路易斯·皮涅拉·奥尔达斯，他批判国际货币基金组织和世界银行对世界各国的不公正约束，以及对“普通工人的全球压迫”。当然还有第三个选择——如果奇迹发生——如果委内瑞拉的左翼力量能够联合起来，那么备受瞩目的批评记者，何塞·文森特·兰格，将有机会领导一个联合的左翼政府。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
