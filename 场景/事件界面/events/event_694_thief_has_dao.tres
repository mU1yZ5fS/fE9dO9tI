[resource]
script = ExtResource("4_def")
event_id = "event_694"
source_event_number = 694
trigger_priority = 69400
title = "盗亦有道"
description = "显然，您已在如何窃国的问题上有所精进，并靠直截了当地转移国家预算为自己积累了不少本钱。不过，如果只将鸡蛋装在一个笼子内的话，那可是走不远的。想想我们北部邻居在处理“党管干部”方面的经验，更别提太平洋对岸国家在创业致富，积极吸纳政治献金与社会捐款方面的神通——同他们相比，您在敛财这方面的认识水平只能被称为“初出茅庐”。为了未来，您当然有理由给自己多谋出路，尽可能将现有的权力转化为硬通货！而如今赚到的越多，日后能担心的只会越少！目前，我们有的是手段打拼：您所持有的国家领导身份便是最好的交易筹码，不论在何处发挥，都能为自己的事业打出片天地。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4"), SubResource("Opt5")])
