[resource]
script = ExtResource("4_def")
event_id = "event_464"
source_event_number = 464
trigger_priority = 46400
title = "团结起来，争取更大胜利"
description = "主席同志！在布鲁塞尔的前欧洲共同体办公处中，我们找到了一项名为“申根协定”的秘密协定，其中包括在协定签字国之间不再对公民进行边境检查；外国人一旦获准进入“协议领土”内，即可在协定签字国领土上自由通行；设立警察合作与司法互助的制度，建立统一电脑系统，建立有关各类非法活动分子情况的共用档案库。我们现在的科技水平足够发达，而我们同盟内的国家也足够多，签发签证是一个巨大的问题。这个方案足够大胆，但或许会有很好的成效。不过定夺权在您手上。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_econ21"), SubResource("Expr_econ17"), SubResource("Expr_econ16"), SubResource("Expr_dev17_3"), SubResource("Expr_or17"), SubResource("Expr_and16"), SubResource("Expr_econ89"), SubResource("Expr_econ88"), SubResource("Expr_econ0"), SubResource("Expr_econ1"), SubResource("Expr_not_soc85"), SubResource("Expr_soc85"), SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
