[resource]
script = ExtResource("4_def")
event_id = "event_643"
source_event_number = 643
trigger_priority = 64300
title = "解放台湾？"
description = "华国锋同志，台湾，不仅是我国不可分割的一部分，也是美帝封锁我国的前哨站。尤其是在我国已经接受了先进的红色基因理论后，美国更是下定决心全力武装台湾。原本美国卖给台湾的都是些落后时代的装备，而现在，各式美军现役装备都被以低价卖予台湾。甚至，有些声称奉行“一个中国”政策的国家，也暗中与台湾伪政权有着联系，真不知道他们所说的那个“一个中国”到底是哪个！现在，是时候一劳永逸地解决蒋伪政权了。人民解放军即将完成他们的最大的使命，完成伟大领袖的未竟之业，解放台湾人民！"
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
