[resource]
script = ExtResource("4_def")
event_id = "event_628"
source_event_number = 628
trigger_priority = 62800
title = "保佑这高尚的土地"
description = "自独立以来，博茨瓦纳一直被视为一个南部非洲的奇迹。该国有稳定的政治局势以及相对发达的经济。国父塞雷茨·卡马爵士用相对温和的威权主义确保了该国的稳定。但这一优势随着该国周围局势日新月异而悄悄发展着。很快，一场声援该国周围左翼国家的游行在该国首都哈伯罗内爆发了，而其幕后推手正是我们早日支持的博茨瓦纳争取社会主义运动。我们将借此机会把脆弱的该国掀个底朝天。"
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
