[resource]
script = ExtResource("4_def")
event_id = "event_082"
source_event_number = 82
trigger_priority = 8200
title = "福克兰群岛战争"
description = "英国最近正在经历困难时刻，失去了它曾经显赫的影响力。由莱奥波尔多·加尔铁里领导的阿根廷军政府决定利用这一机会发动“小规模胜利战争”。4月2日，阿根廷伞兵登陆英属福克兰群岛，群岛的归属长期受阿根廷挑战，但小规模英国驻军的抵抗很快就被击溃了。作为回应，英国向群岛派出舰队，意在封锁群岛。看起来世界上又要爆发新的冲突了。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
