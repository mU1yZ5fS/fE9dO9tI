[resource]
script = ExtResource("4_def")
event_id = "event_632"
source_event_number = 632
trigger_priority = 63200
title = "牙买加，我们热爱的家乡"
description = "让我们把时间拨前面一些。在1972年，人民民族党赢得了大选，该党领袖迈克尔·曼利当选为牙买加总理。曼利在这八年统治中着手进行民主的社会主义：其为所有工人制定了最低工资，从小学到高中的免费教育，降低最低投票年龄至18岁，实行女性同工同酬和产假，提供免费医疗，进行土改，提供免费医疗，与古巴关系密切。由于政策开销过高，使其不得不接受国际货币基金组织的条件，此举导致进一步的经济压力，曼利最终决定断绝国际货币基金组织的贷款，但也因此导致公务员和国营公司的工资难以支付，导致了一次电力工人罢工，几乎使70%的牙买加陷入黑暗。在如此时刻，曼利决定提前一年进行选举，而此举也导致了牙买加工党和人民民族党之间的党争变得更为激烈，政治暴力更为频繁，这不由得让人们想起1976年选举年的政治暴力时刻。\n如今，牙买加即将进入选举，我们或许可以趁此机会帮助曼利？毕竟，曼利对社会主义的观感还算不错。当然，如果我们想和美国继续搞好关系，我们也可以支持牙买加工党。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_all")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
