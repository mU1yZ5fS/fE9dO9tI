[resource]
script = ExtResource("4_def")
event_id = "event_522"
source_event_number = 522
trigger_priority = 52200
title = "保革伯仲：第一幕"
description = "1955年，当时执政的自由党与民主党合并为自由民主党，而1945年成立的社会党也在该年结束分裂状态。之后的历次国会选举中，代表保守的自由民主党均保持着半数以上的席位以维持一党执政的状态，但无法取得三分之二的多数从而不能修改和平宪法。而代表革新的，以社会党为首的各在野党则长期占据着三分之一以上的席位，但同样无法取得半数以上从而不能执政。这一特殊的对峙情况也被称为：55年体制。|而这一格局在70年代迎来了松动。60年代的高速经济增长被1973年度的负增长画上了句号。田中角荣提出的“日本列岛改造论”与相关政策带来的土地投机化投资又使得批发物价与消费者物价暴涨。同时以四大公害病为代表的公害也接连发生，使得城市市民已极为反感只会提倡经济发展的自由民主党。在1972年的选举中，自由民主党遭遇大败，减少了足足17个席位。而社会党和共产党的席位纷纷增多。革新阵营力量大幅加强，日本政坛也进入到了“保革伯仲”的新局面。|新一届众议院选举将于1976年12月5日举行。此时的自由民主党已经深陷洛克希德丑闻（该公司向日本政界高层提供巨额贿款以确保旗下客机得到订购）中，而由此爆发的激烈内部派系斗争的曝光更让该党受到舆论普遍谴责。|而在野党同样问题重重。作为势力最大的社会党，其内部矛盾的激烈程度丝毫不亚于对手，各派系对该党的定位与路线一直争论不休。而公明党在1969年底的“言论出版事件”之后被迫与其核心组织创价学会相分离，从宗教政党转型为国民政党，其根基变得更加薄弱。宫本显治领导的共产党则不断讨好城市市民阶层以吸引其选票。但纵然该党已经扔掉了马克思主义中几乎所有与暴力和激进相关的内容，其天然的特殊性还是让其格格不入，大部分在野党也不愿与其合作。\n面对即将到来的选举，党内形成了几种不同意见：一部分人主张全力援助社会党并促成革新联合政权的成立，而改革派和一些外交人员给出了不同意见：他们认为我们可以考虑帮助自由民主党渡过危机。毕竟之前推动中日建交的也是该党政府，如果能再助力他们一把，我们便有机会寻求中日之间的大规模贸易合同并引进日本的先进技术。此外还有一种意见，认为我们不应局限于议会之内而是应该直接向青年组织、工会等力量予以帮助。你怎么看，主席同志？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
