[resource]
script = ExtResource("4_def")
event_id = "event_111"
source_event_number = 111
trigger_priority = 11100
title = "在幽灵般的灯光下"
description = "主席同志！IECS系统部分实施后，政府开始逐步、系统地削减基层国家机构，解放不必要的技术工人，优化预算。这些措施遭到了地方官僚机构的强烈抵制，他们已经宣布你们是“资产阶级反革命”了。现在连党的最高领导层都反对你，而且已经在准备罢免你。我们需要立即采取行动！我们需要争取广大民众的支持，胜利将属于我们！但问题是，他们会支持我们吗？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
