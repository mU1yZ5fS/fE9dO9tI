[resource]
script = ExtResource("4_def")
event_id = "event_419"
source_event_number = 419
trigger_priority = 41900
title = "正常化"
description = "葡萄牙的局势终于稳定了下来。尽管面临长期的经济下行，通货膨胀，失业高企与频繁的政府更迭，人们对激进政治势力的热情还是走到了尽头。对葡萄牙革命委员会的压力也与日俱增——民主政党与政府已发起支持解散委员会的群众运动。毕竟，革命委员会是一个凌驾于民主体制的部门，并阻碍了该国深化改革。葡萄牙的新任民主主义政府选择加入欧洲经济共同体，并启动与其他欧洲国家的一体化进程。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_0"), SubResource("Expr_1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
