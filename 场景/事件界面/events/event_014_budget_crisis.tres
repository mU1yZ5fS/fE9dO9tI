value = 13.0
condition = SubResource("Expr_econ12")

[sub_resource type="Resource" id="Opt3"]
script = ExtResource("1_option")
text = "加快国有企业私有化"
disabled_text = "我们不能进一步推动私有化"
enable_condition = SubResource("Expr_opt3_gate")
effects = Array[ExtResource("2_effect")]([SubResource("E3_living"), SubResource("E3_money"), SubResource("E3_ind"), SubResource("E3_agr"), SubResource("E3_serv"), SubResource("E3_olig"), SubResource("E3_econ")])
result_text = "许多国有企业最后变成了私人财产，这使得我国的生活标准下降并使得我们的经济体制开始被慢慢瓦解。但我们的赤字减少了。"

[sub_resource type="Resource" id="Expr_budget_sum"]
script = ExtResource("3_expr")
type = 24
keys = Array[String](["money", "budget_army", "budget_mgb", "budget_science", "budget_admin", "budget_envelope", "budget_propaganda", "budget_agriculture", "budget_industry", "budget_services", "budget_welfare", "budget_diplomacy"])
value = 799.0

[sub_resource type="Resource" id="Expr_budget300"]
script = ExtResource("3_expr")
type = 1
key = "money"
value = 299.0

[sub_resource type="Resource" id="Expr_trigger"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_budget_sum"), SubResource("Expr_budget300")])

[resource]
script = ExtResource("4_event")
event_id = "budget_crisis"
source_event_number = 14
title = "我们没有钱，但是你要撑住啊！"
description = "我们的预算和储备金太少了。如果继续这样下去，我们很快就无法维持我们国家的正常工作。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = false
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
