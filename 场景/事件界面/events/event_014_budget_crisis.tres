[sub_resource type="Resource" id="Expr_loan_cond"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_rel1_501"), SubResource("Expr_infl50")])

[sub_resource type="Resource" id="Expr_econ14_max"]
script = ExtResource("3_expr")
type = 1
key = "economy_system"
value = 14.0

[sub_resource type="Resource" id="Expr_line0_not"]
