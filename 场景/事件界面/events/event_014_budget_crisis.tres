children = Array[ExtResource("3_expr")]([SubResource("Expr_econ14_max"), SubResource("Expr_line0_not"), SubResource("Expr_opt3_b")])

[sub_resource type="Resource" id="Expr_any_gate"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_opt0_enable"), SubResource("Expr_econ14"), SubResource("Expr_opt3_gate")])

[sub_resource type="Resource" id="Expr_not_gate"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_any_gate")])

[sub_resource type="Resource" id="Expr_opt2_enable"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_rel0_501"), SubResource("Expr_loan_cond"), SubResource("Expr_not_gate")])

[sub_resource type="Resource" id="E2_money"]
script = ExtResource("2_effect")
key = "money"
value = 100.0

[sub_resource type="Resource" id="E2_loan"]
script = ExtResource("2_effect")
key = "loan"
value = 100.0

[sub_resource type="Resource" id="E2_infl"]
script = ExtResource("2_effect")
key = "influence_prc"
value = -50.0

[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_option")
text = "接受外国贷款"
disabled_text = "没人愿意借钱给我们"
enable_condition = SubResource("Expr_opt2_enable")
effects = Array[ExtResource("2_effect")]([SubResource("E2_money"), SubResource("E2_loan"), SubResource("E2_infl")])
result_text = "我国的外债逐渐攀升，这使得我们能够继续减小我们的赤字，但是这会对我们的国际影响力造成负面结果。而且我们还是要还钱，只不过晚了一会而已........"

[sub_resource type="Resource" id="E3_living"]
script = ExtResource("2_effect")
key = "living"
value = -100.0

[sub_resource type="Resource" id="E3_money"]
script = ExtResource("2_effect")
key = "money"
value = 100.0

[sub_resource type="Resource" id="E3_ind"]
