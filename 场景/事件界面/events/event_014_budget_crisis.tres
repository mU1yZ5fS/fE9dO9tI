[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]

[sub_resource type="Resource" id="Expr_econ13"]
script = ExtResource("3_expr")
key = "economy_system"
value = 13.0

[sub_resource type="Resource" id="Expr_living500"]
script = ExtResource("3_expr")
key = "living"
value = 500.0

[sub_resource type="Resource" id="Expr_opt0_enable"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_econ13"), SubResource("Expr_living500")])

[sub_resource type="Resource" id="E0_people"]
script = ExtResource("2_effect")
key = "people_support"
value = -100.0

[sub_resource type="Resource" id="E0_free"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = 50.0

[sub_resource type="Resource" id="E0_money"]
script = ExtResource("2_effect")
key = "money"
value = 100.0

[sub_resource type="Resource" id="E0_living"]
script = ExtResource("2_effect")
key = "living"
value = -300.0

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_option")
text = "提高税收和削减社会项目"
effects = Array[ExtResource("2_effect")]([SubResource("E0_people"), SubResource("E0_free"), SubResource("E0_money"), SubResource("E0_living")])
result_text = "税率和费用已经增长，且服务大众的社会福利项目拨款也随之减少。这个当然是有利于减少赤字的，但是谁喜欢这样啊？"

[sub_resource type="Resource" id="Expr_econ14"]
script = ExtResource("3_expr")
key = "economy_system"
value = 14.0

[sub_resource type="Resource" id="E1_money"]
script = ExtResource("2_effect")
key = "money"
value = 100.0

[sub_resource type="Resource" id="E1_party"]
script = ExtResource("2_effect")
key = "party_support"
value = -500.0

[sub_resource type="Resource" id="E1_free"]
script = ExtResource("2_effect")
key = "thought_freedom"
value = 300.0

[sub_resource type="Resource" id="E1_rel"]
script = ExtResource("2_effect")
type = 8
key = "0"
value = -50.0

[sub_resource type="Resource" id="E1_olig"]
script = ExtResource("2_effect")
key = "oligarch"
value = -5.0

[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_option")
text = "提高奢侈品税和巨富税"
disabled_text = "我国没有寡头可被榨油水"
enable_condition = SubResource("Expr_econ14")
effects = Array[ExtResource("2_effect")]([SubResource("E1_money"), SubResource("E1_party"), SubResource("E1_free"), SubResource("E1_rel"), SubResource("E1_olig")])
result_text = "奢侈品税和富人税已经增长，这使得我们可以在不伤害普通民众的基础上减小赤字。但是寡头们开始利用他们的影响力来向群众哭诉“党是如何掠夺勤劳致富的人”的，而且党内高层也有一些人赞同这一意见。"

[sub_resource type="Resource" id="Expr_rel0_501"]
script = ExtResource("3_expr")
type = 8
key = "0"
value = 501.0

[sub_resource type="Resource" id="Expr_rel1_501"]
script = ExtResource("3_expr")
type = 8
key = "1"
value = 501.0

[sub_resource type="Resource" id="Expr_infl50"]
script = ExtResource("3_expr")
