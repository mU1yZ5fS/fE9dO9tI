type = 22
key = "political_line"
value = 0.0

[sub_resource type="Resource" id="Expr_sys7"]
script = ExtResource("3_expr")
key = "party_system"
value = 8.0

[sub_resource type="Resource" id="Expr_line1_not"]
script = ExtResource("3_expr")
type = 22
key = "political_line"
value = 1.0

[sub_resource type="Resource" id="Expr_opt3_b"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_sys7"), SubResource("Expr_line1_not")])

[sub_resource type="Resource" id="Expr_opt3_gate"]
script = ExtResource("3_expr")
