[resource]
script = ExtResource("4_def")
event_id = "event_143"
source_event_number = 143
trigger_priority = 14300
title = "寡头政治的终结"
description = "在阿罗塞梅纳·蒙罗伊担任厄瓜多尔总统的20个月内，他推动了包括廉租房、累进税制和工人年度绩效金等改革，成功恢复了厄瓜多尔贸易平衡、减少外债、提高国民福利。然而，蒙罗伊对菲德尔·卡斯特罗的古巴革命持支持态度，这引发了他同国民议会和军方的长期冲突。经历两次弹劾未遂后，在美国对厄瓜多尔当局的反对下，蒙多伊在1963年的军事政变中被推翻。军政府政权巩固后，组织了一连串的镇压，然后将权力移交给了由寡头克莱门特·耶罗维的文官政府。1968年，保守主义者何塞·马里亚·贝拉斯科·伊瓦拉赢得选举后解散议会、废除宪法，建立了独裁政府。1972年2月15日，伊瓦拉被一场不流血的军事政变推翻，权力移交到吉列尔莫·罗德里格斯·拉腊将军手中，厄瓜多尔的通胀率与外债在其任内达到惊人的规模。1976年，军方将他赶下台，并宣布在两年的时间内逐渐将权力移交给一个自由选举产生的文官政府手中。即将到来的选举中有三个最受欢迎的政党：左翼民粹主义的人民力量联盟（CFP）、支持私有化与社会保障的文化保守主义政党基督教社会党（PSC），以及谋求建立一个理想的自由市场经济民主国的激进自由党（PLRE）。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
