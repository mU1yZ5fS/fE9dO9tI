[resource]
script = ExtResource("4_def")
event_id = "event_360"
source_event_number = 360
trigger_priority = 36000
title = "月球计划——载人登月"
description = "每个人都明白太空计划的最后阶段是什么——中国宇航员登陆月球。但是，正如美国太空计划所表明的那样，这更多像是一种政治行动，在科学上的好处可以忽略不计。那么，我们是现在就要登月，还是继续为月球站制定长期计划要更好一些呢？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("E360_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
