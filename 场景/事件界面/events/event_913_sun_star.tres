[resource]
script = ExtResource("4_def")
event_id = "event_913"
source_event_number = 913
trigger_priority = 91300
title = "一颗名为太阳的星星"
description = "华国锋同志，也许是时候更近一步了，我们的宣传机器开足马力也无法更好的宣传我国的伟大。所以是时候犯下一点“小错误”了。我们将向全国人民播报这样的一条新闻，我国宇航员既没有登上月球，也没有在火星留下脚印，而是……太阳！多么闪耀的一颗星啊！就如同您的名字一般闪耀！"
display_script = ExtResource("5_custom")
