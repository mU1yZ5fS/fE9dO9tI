[resource]
script = ExtResource("4_def")
event_id = "event_562"
source_event_number = 562
trigger_priority = 56200
title = "橄榄之国，永远屹立"
description = "在辉煌的1970年代，突尼斯经济凭借着农业与石油出口的繁荣以及旅游业的蓬勃发展，实现了年均约8%的高速增长，展现出前所未有的活力。然而，这一繁荣景象在步入1980年代初时遭遇了欧洲经济停滞的逆风，对高度依赖欧洲市场出口与游客的突尼斯经济构成了重大冲击。1983年末，石油价格的暴跌更是雪上加霜，政府面临着巨大的财政压力，需竭力应对不断攀升的支出。\n面对经济困境，布尔吉巴总统决定向国际货币基金组织（IMF）寻求援助。然而，这份援助并非无代价，IMF提出了包括削减政府开支、废除外汇管制、取消保护性关税以及实施货币贬值等一系列严苛条件。\n为了履行IMF的贷款协议，政府不得不做出艰难抉择，于1983年12月29日宣布终止对小麦及粗面粉（作为面包基础原料）的补贴政策。这一举措在当时尤为敏感，因为食品补贴占据了GDP的3.1%和国家预算的十分之一，且其惠及范围广泛，无差别地惠及了社会各个阶层。补贴的取消直接导致面包与面粉价格飙升，涨幅超过100%，成为近十五年来首次如此大幅度的价格变动，对贫困家庭造成了尤为沉重的打击，因为许多家庭将高达80%的食品预算投入于这两项基本生活物资上。\n在此背景下，面包迅速成为了民众抗议贫困、压迫及新自由主义经济政策的标志性符号。这一系列变革恰逢政治局势的紧张加剧，左翼势力（以毛主义的民主爱国者运动和突尼斯工人组织的强硬派、民主社会主义的进步民主党等组织为首）与民主派伊斯兰主义势力（伊斯兰趋势运动）的影响力日益增强，在民间获得了较大影响力。政治精英内部则围绕着权力交接展开激烈角逐，年迈的总统健康状况成为各方关注的焦点。同时，南部地区的持续干旱导致农作物歉收，进一步加剧了当地的经济困境与民生压力。该地区男性劳动力大量外流至突尼斯沿海城市或作为移民劳工前往利比亚，却难以找到工作，加剧了社会不满情绪。最终，南部地区公开表达了对政府的不满，他们发起了大型抗议，而群众运动大有蔓延至全国之势。\n主席同志！我们应该做点什么！"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_3"), SubResource("Expr_4"), SubResource("Expr_7")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
