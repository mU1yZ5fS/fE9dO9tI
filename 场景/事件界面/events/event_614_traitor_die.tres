[resource]
script = ExtResource("4_def")
event_id = "event_614"
source_event_number = 614
trigger_priority = 61400
title = "叛徒去死"
description = "在沙巴战争之后，刚果民族解放阵线艰难的维持着所谓“加丹加人民共和国”的政府班子。但随着刚果的彻底解放。这一政权的地位略显尴尬，其原因有三：体量太小，政局不稳，依赖外援。更别提刚果新政府从他国获得了大量的军火，他们也渴望收复故土。就在近日，刚果官方宣布展开收复失地的“帕特里克·卢蒙巴”行动，旨在一举击溃境外势力扶植的伪政权。"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
