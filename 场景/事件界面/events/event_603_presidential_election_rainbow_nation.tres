[resource]
script = ExtResource("4_def")
event_id = "event_603"
source_event_number = 603
trigger_priority = 60300
title = "总统大选：彩虹之国"
description = "德克勒克政府的改革在1985年内便驶入快车道：也就在宣布对种族隔离制度进行改革的四个月后，南非便废除人口登记法、原住民土地法等法规，在法律上彻底废除了种族隔离。上述功绩足以促使其与曼德拉分享今年的诺贝尔和平奖。接下来，就让我们静待南非历史上首次不分种族的公平大选及其结果。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
