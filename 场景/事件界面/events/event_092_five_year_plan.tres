[resource]
script = ExtResource("4_def")
event_id = "event_092"
source_event_number = 92
trigger_priority = 9200
title = "超额完成是荣誉！"
description = "主席同志！考虑到即将实施新的五年计划，部分来自计委的专家和经济学家建议为下个五年选择一个重点发展的经济部门。你需要决定国民经济中哪个部门需要特别关注和政府投资－工业、农业、服务业或者发展科学？但是，我们也可以更谨慎地使用资金，将力量集中到同时均衡发展三个产业，这会使它们的发展更均衡。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
