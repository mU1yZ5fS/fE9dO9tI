[resource]
script = ExtResource("4_def")
event_id = "event_507"
source_event_number = 507
trigger_priority = 50700
title = "“虾”行动"
description = "1972年10月26日，马蒂厄·克雷库以少校身份发动武装政变，并获得贝宁政府控制权，且随即自立为总统。1975年，他不但将“达荷美共和国”更名为“贝宁人民共和国”，还成立了贝宁人民革命党，使该国成为一个社会主义国家。这一激进的举动吓傻了周边的国家和法国。一个说法语的社会主义国家定会摧毁法国在非洲的势力范围。它与法国和该地区其他非洲政府的关系显著恶化了。吉斯卡尔·德斯坦的法国政府担心马克思主义在西非的传播，并决定做出反应。乌弗埃·博瓦尼、纳辛贝·埃亚德马、约瑟夫-德西雷·蒙博托和哈桑二世，他们除了在外交上孤立，内部破坏贝宁的经济外，还决定组织一场政变。臭名昭著的雇佣兵头子鲍勃·德纳尔牵头展开了“虾”行动，计划除掉克雷库，一举推翻克雷库政府。主席同志，也许我们应该警告克雷库关于政变的事？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
