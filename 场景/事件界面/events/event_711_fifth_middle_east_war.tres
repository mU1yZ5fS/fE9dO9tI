[resource]
script = ExtResource("4_def")
event_id = "event_711"
source_event_number = 711
trigger_priority = 7110
title = "碾碎他们，我的兄弟们"
description = "伊拉克最高指挥部决定发动针对犹太复国主义实体“以色列”的最终决战。虽然以色列拥有核武器，且拥有不逊色于伊拉克的军事力量。但现在，以色列已经失去了离间阿拉伯国家的实力。并且要独自承受近十年来最好战而最狂热的阿拉伯国家的怒火。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
