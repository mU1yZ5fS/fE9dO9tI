[resource]
script = ExtResource("4_def")
event_id = "event_596"
source_event_number = 596
trigger_priority = 59600
title = "瓦加拉大屠杀"
description = "1984年2月，肯尼亚东北省的瓦吉尔镇爆发了一次部族冲突，肯尼亚国防军奉命制止冲突，随后将五千余名当地人赶到瓦加拉机场的跑道上，一周之内断绝了他们的水源和粮食并开枪随意射杀。索马里当局对此十分不满，并要求肯尼亚政府停止种族屠杀，否则将会推翻现政权并进行占领。我们是否可以借此机会彻底打击肯尼亚的种族灭绝行为，或者对拥有着大索马里美梦的索马里进行一次打击？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
