[resource]
script = ExtResource("4_def")
event_id = "event_344"
source_event_number = 344
trigger_priority = 34400
title = "兵役制度"
description = "有人提议改变解放军的服役期限。但如今的问题是应征士兵应当服役多长时间。一方面，就训练一个士兵而言，服役一年并不算多，而且还不够，但另一方面，哪怕是两到三年的服役期限也已经对经济造成了沉重的打击，减缓了我们的发展速度。那么，我们是否可以完全取消征兵制度呢？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
