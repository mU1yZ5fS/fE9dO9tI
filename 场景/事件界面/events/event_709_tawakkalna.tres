[resource]
script = ExtResource("4_def")
event_id = "event_709"
source_event_number = 709
trigger_priority = 7090
title = "“托靠真主-6号”行动"
description = "在粉碎了科威特的无谓挣扎后，伊拉克政府将目光放向了南部孱弱的沙特王国。占据了富庶肥饶的产油之地的沙特王国却屡屡向伊拉克的敌人们暗送秋波，也许在两伊战争之前，伊拉克还有求于沙特。现在，是时候让沙特人付出代价了。伊拉克军队决定执行“托靠真主-6号行动”，以武力攻取哈萨绿洲，彻底切断沙特的产油区。\n伊拉克军队已经开始动员了，国际观察家对沙特的抵抗力表示悲观。"
trigger_script = ExtResource("6_trigger")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
