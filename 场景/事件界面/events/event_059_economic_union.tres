[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "无视该建议"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "什么都没有发生，让我们希望这只是为了更好。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "建立经济同盟（需要8百万元预算）"
disabled_text = "我们还没准备好（需要8百万元预算）"
enable_condition = SubResource("Expr_eco_ready")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由 event_053_062_reform_and_alliances.gd 动态生成）"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "加入经互会"
disabled_text = "和修正主义者没有谈判！"
enable_condition = SubResource("Expr_cmea")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "中国继续奉行“与苏联重新建立关系”的方针，申请加入经济互助委员会。根据这一设想，这项倡议应能恢复和加强在“苏中分裂”期间被割裂的中国和社会主义国家之间的经济联系。为此，召开了一次特别会议，中国被接纳为本组织正式成员。党内最激进的成员“带着敌意迈出了这一步”，称之为“对苏修的纵容”，但现在我们与苏联的关系比以往任何时候都要好。不能说美国对我们外交政策的方向的变化很满意。然而，现在的社会主义阵营比以往任何时候都要强大。"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "加入不结盟运动"
disabled_text = "他们不喜欢你"
enable_condition = SubResource("Expr_nam")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "中国政府向不结盟运动提出加入申请，并不出意料的以多数票被接纳。如果动用了军事手段解决争端，我们将被谴责并剥夺会员国资格。战略中立允许我们在苏联和美国间游走，接受来自两边超级大国的政策倾斜，这对我们来说是有利的。"

[resource]
script = ExtResource("4_event")
event_id = "economic_union"
source_event_number = 59
trigger_priority = 590
title = "经济联盟"
description = "主席同志！考虑到国际舞台上的形式，一些党员提议组织一个苏联领导的经济同盟，即经互会，和欧洲人的欧共体的替代物，以继续我们在亲中国家中扩大影响力，深化贸易和经济纽带的政策。但是，政治局的一些成员觉得这样做太过匆忙和激进，也缺乏考虑，建议推迟此事，等待一个更好的时机。然而忘记与苏联的争议，加入经济互助委员会也许是最好的选择？"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_ally")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
