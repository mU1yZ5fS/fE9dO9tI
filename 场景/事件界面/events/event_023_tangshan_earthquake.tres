[resource]
script = ExtResource("4_def")
event_id = "event_023"
source_event_number = 23
trigger_priority = 2300
title = "唐山大地震"
description = "7月28日，3时42分，河北省唐山市发生了震级8.2级的地震，完全摧毁了整个城市。距唐山西140公里的天津和北京也遭到破坏。最高震级为7.1级的几波余震，导致了更高的伤亡。根据初步数据，有20—60万人死于地震。据上海市地震局局长张俊所讲，巨大破坏的主要原因是建筑建造时缺乏必要的抗震措施。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
