[resource]
script = ExtResource("4_def")
event_id = "event_124"
source_event_number = 124
trigger_priority = 12400
title = "回归社会主义"
description = "在王明的言论、文章与论点被用于消除对毛泽东的个人崇拜后，党内出现了希望为他平反并让其家庭成员回国的一派。而伴随着去毛泽东化带来的灾难及其所暴露的问题，这一派不仅变得更为声势浩大，而且还提出了将王明的思想继承人与“纯粹的马克思列宁主义”引入现政权的想法。一方面，这能使共产党重获合法性，另一方面，在中国没有任何影响力的王明的继承人将成为听话的傀儡，服务于新兴的马克思列宁主义者的统治事业。这些想法很快就演变成为了一场政变，在中国领导人访问外国期间，王明一家被平反并归国，在他们出示党证后，紧急代表大会随即召开，现任领导人因唯意志主义和隐瞒自己在毛泽东时代的诸多劣行而被罢免。现在，大会面临着谁应该被宣布为新的——尽管是不太正式的——国家领导人的问题。孟庆树，她是王明的妻子、革命者、中共活动家，在1956年之前一直在妇女委员会与儿童保育协会工作；或是王丹芝，王明的长子，物理学和数学博士，中国历史与语言专家，在1969-1974年间积极参与了王明的书籍整理出版工作。王明的其他子女要么太过年轻，要么根本没有从政。大会将为此作出决定。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
