[resource]
script = ExtResource("4_def")
event_id = "event_406"
source_event_number = 406
trigger_priority = 40600
title = "英国大选-1983"
description = "自上次议会选举以来，英国的政党制度发生了显著变化。以两党霸权制度为基础的体制已发生了严重的分化，而另一股显赫的势力也加入了政治游戏中。保守党的支持率因实行激进的新自由主义改革而严重受损，它在人群当中已变得不受欢迎。工党也因为党内分裂与极左倾向而遭遇重创。自由党与社会民主党则已在联合竞选上达成共识，有望在选战中超越工党。但明枪暗箭带来的结果，直到最后才会水落石出......"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
