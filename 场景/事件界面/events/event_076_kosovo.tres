[resource]
script = ExtResource("4_def")
event_id = "event_076"
source_event_number = 76
trigger_priority = 7600
title = "落井下石！"
description = "主席同志，来自南斯拉夫的紧急新闻！在科索沃社会主义自治省，阿尔巴尼亚族人的大规模暴动开始了，根据我们的信息，这是由阿尔巴尼亚的特勤部门“西古里米”组织的。抗议者袭击了行政建筑，警察局和南斯拉夫人民军的驻军，反塞族的屠杀开始了。省领导和科索沃的共产主义者联盟的领导层并没有怎么抵抗，这实际上是在支持抗议者。南斯拉夫主席团在贝尔格莱德举行了紧急会议，决定强力镇压“反革命分离主义叛乱”。在铁托死后，南斯拉夫的局势开始恶化，看起来凡尔赛条约创造出来的怪物正在解体。也许我们应该再推一把，把他推入深渊？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
