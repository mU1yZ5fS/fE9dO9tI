[resource]
script = ExtResource("4_def")
event_id = "event_332"
source_event_number = 332
trigger_priority = 33200
title = "企业扩张"
description = "党已被问及，是否允许企业超越其经营范围？特别是，一些军工企业可能会开始生产民用设备。一方面，这将为一切经营不顺的经济部门提供商品供给，但另一方面，这可能会让那些本已经营着不甚成功的经济部门的人陷于恶性竞争中去......"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
