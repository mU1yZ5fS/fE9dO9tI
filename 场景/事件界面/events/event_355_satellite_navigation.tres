[resource]
script = ExtResource("4_def")
event_id = "event_355"
source_event_number = 355
trigger_priority = 35500
title = "卫星导航网络"
description = "一年多前，美国开始构建自己的卫星全球定位系统——GPS。情报部门还报告说，在今后几年里，苏联也将开始进行一个类似的项目。在大势所趋下，有些人建议我们构建一个属于我们中国自己的系统。当然，这需要资源，但回报将无可估计......"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("E355_date"), SubResource("E355_tech"), SubResource("E355_not354r2")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
