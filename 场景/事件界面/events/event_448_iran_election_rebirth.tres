[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "支持伊朗人民联盟"
disabled_text = "左翼，一盘散沙！"
enable_condition = SubResource("Expr_cond_opt0")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们决定支持伊朗人民联盟，在我们雄厚资金的支持下，该党设法取得了立宪会议和伊朗人民议会的绝对多数席位，即便只获得了23%的选票而大量弃票表示对“拯救伊朗大起义”的否定。人民联盟上台便开始着手实现其竞选诺言，对原先被外资垄断的石油工业被迅速的收为国有，土地改革在我们特勤的帮助下，也得以稳定的进行。借着石油和我们的一笔无息贷款，人民联盟开始组建更为完善的福利体系，包括了全民医保和直至高中的义务教育。同时，他们也没有忘记过去几年所受到的耻辱。新政府上台以来颁布的第一项法令，便是逮捕（如果没有在小型内战中罹害的话）原伊斯兰革命卫队成员和伊朗伊斯兰共和党党员。他们的后代被禁止参与到政府的决策中，部分阿訇和毛拉也被丢进了监狱。新政府也决定放下对伊拉克的敌视，双方再次确定了对入海口和胡齐斯坦/阿拉伯斯坦自治权对保障，作为回报，伊拉克将帮助新生的共和国训练一支足够强大的陆军。新政府也没有忘记打井人，伊朗宣布将“和中华人民共和国开展更广泛且深入的合作。”一张又一张的贸易协定在北京和德黑兰之间签成。我们也收获了一位强大的盟友。然而，大量对于该国新生民主持有反对的团体依然在进行城市游击战，其中除了意料之中的伊斯兰派外，甚至包括不少左翼团体。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "支持伊朗解放阵线"
disabled_text = "右翼和霍梅尼有什么区别？"
enable_condition = SubResource("Expr_cond_opt1")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "我们决定支持伊朗解放阵线，在我们雄厚资金的支持下，该党设法取得了立宪会议和伊朗人民议会的绝对多数席位即便只获得了21%的选票而大量弃票表示对“拯救伊朗大起义”的否定。自由运动上台便开始着手实现其竞选诺言，对原先被外资垄断的石油工业再次被外资所把握，中石化和中石油得以继承美国人所留下的一切。同时，他们也没有忘记过去几年所受到的耻辱。新政府上台以来颁布的第一项法令，便是逮捕（如果没有在小型内战中罹害的话）原伊斯兰革命卫队成员和伊朗伊斯兰共和党党员。他们的后代被禁止参与到政府的决策中，部分阿訇和毛拉也被丢进了监狱。作为“新摩萨台主义”，政府大力鼓励伊朗民族主义，强调历史和解。新政府拒绝同伊拉克和解，伊朗的F-4“鬼怪”战机和Q-5“番摊”型攻击机频频飞入伊拉克领空，伊拉克也开始试射自己的小型导弹，并谴责伊朗新政府为“帝国主义安插在阿拉伯湾的一枚楔子”。新政府也没有忘记打井人，伊朗宣布将“和中华人民共和国开展更广泛且深入的合作。”一张又一张的贸易协定在北京和德黑兰之间签成。我们也收获了一位强大的盟友。然而，大量对于该国新生民主持有反对的团体依然在进行城市游击战，其中除了意料之中的伊斯兰派外，甚至包括不少左翼团体。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "我们想要，但是怎么也做不到"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "即便只获得了23%的选票而大量弃票表示对“拯救伊朗大起义”的否定，人民联盟得以以微弱的优势击败伊朗解放阵线。人民联盟上台便开始着手实现其竞选诺言，对原先被外资垄断的石油工业被迅速的收为国有，土地改革几乎是灾难性的，大量自耕农以杀死耕畜和毁坏农机，烧毁粮食作为抵制。借着石油，人民联盟开始组建更为完善的福利体系，包括了全民医保和直至高中的义务教育。罢工和罢课频频发生。同时，他们也没有忘记过去几年所受到的耻辱。新政府上台以来颁布的第一项法令，便是逮捕（如果没有在小型内战中罹害的话）原伊斯兰革命卫队成员和伊朗伊斯兰共和党党员。他们的后代被禁止参与到政府的决策中，部分阿訇和毛拉也被丢进了监狱。新政府也决定放下对伊拉克的敌视，双方再次确定了对入海口和胡齐斯坦/阿拉伯斯坦自治权对保障，作为回报，伊拉克将帮助新生的共和国训练一支足够强大的陆军。然而，大量对于该国新生民主持有反对的团体依然在进行城市游击战，其中除了意料之中的伊斯兰派外，甚至包括不少左翼团体。不过，目前的伊朗当局再差，也比伊斯兰好，对吧？"

[resource]
script = ExtResource("4_event")
event_id = "event_448"
source_event_number = 448
trigger_priority = 44800
title = "伊朗选举：涅槃？"
description = "随着伊朗伊斯兰共和国在一场小型内战中灰飞烟灭，伊斯兰共和党已经完全溃败。在革命军政府对“政治伊斯兰”力量的镇压与禁止参选和参与未来伊朗政治的最大公约数下，从“伊朗文化大革命”中存活下来的政治力量们不得不组成“大帐篷”型的党派-他们分别是左翼的伊朗人民联盟和右翼的伊朗解放阵线：伊朗人民联盟是一个代表左翼思想和价值观的政治组织。由伊朗人民党，民族阵线的左翼，少数派敢死队等左翼团体组成。他们主张社会公正、经济平等和政治民主。该联盟强调人民的权力和参与，主张通过一定程度上的直接民主来实现决策的合法性和可靠性。由剔除了对霍梅尼投降的伊朗人民党的领导层牵头，伊拉杰·伊斯坎达里是议会斗争的老将，作为伊朗人民联盟的领导人，支持社会福利制度的建立，旨在为所有公民提供平等的机会和资源分配。他们强调公共教育、医疗保健和社会保障的重要性，以确保人民的基本需求得到满足。在外交政策方面，伊朗人民联盟倡导通过对话和外交途径解决国际争端，主张反帝与不结盟政策。相反，阿里.阿米尼，前巴列维王朝的自由派改革家的伊朗解放阵线代表着自由右翼的政治观点和理念。放弃了君主制复辟的宣称，这些“新摩萨台主义者”，强调个人自由和市场经济的重要性。伊朗解放阵线主张最小化政府干预，提倡市场的自由竞争和私有财产权的保护。而在外交政策方面，他们支持坚定的鹰派立场，与欧洲和非社会主义国家的友好。主席同志，我们是不是应该支持其中的某一派？我们花了大功夫把美国人和苏联人挤出去，可不是为了让他们坐享其成的。"
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
