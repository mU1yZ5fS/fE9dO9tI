[resource]
script = ExtResource("4_event")
event_id = "stavropol_agronomist"
source_event_number = 83
title = "斯塔夫罗波尔农学家的问题"
description = "我们的特勤部门设法获得了重要的信息。据了解，苏联的农业问题相当严重，今年的强降雨更加剧了情况。农业书记费多尔·库拉科夫，苏共中央委员会书记，是现任苏维埃领导人列昂尼德·勃列日涅夫最有可能的继任者之一。根据我方特工获得的信息，库拉科夫热衷于积极研究并将匈牙利和南斯拉夫的经验引入苏联农业（即分散集体农场和国营农场的管理，根据家庭合同和独资农场创建农业合作社）。在即将召开的苏共中央全会上，我们可以以此来诋毁他，从而从道路上消除这种危险的改革派。"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
