[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_071_073_india_and_iran_war.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_day"]
script = ExtResource("3_expr")
type = 0
key = "day"
value = 15.0

[sub_resource type="Resource" id="Expr_month"]
script = ExtResource("3_expr")
type = 0
key = "month"
value = 9.0

[sub_resource type="Resource" id="Expr_year_1980"]
script = ExtResource("3_expr")
type = 0
key = "year"
value = 1980.0

[sub_resource type="Resource" id="Expr_1980_date"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_day"), SubResource("Expr_month"), SubResource("Expr_year_1980")])

[sub_resource type="Resource" id="Expr_year_1981"]
script = ExtResource("3_expr")
type = 0
key = "year"
value = 1981.0

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_1980_date"), SubResource("Expr_year_1981")])

[sub_resource type="Resource" id="Expr_pro_usa"]
script = ExtResource("3_expr")
type = 10
key = "亲美"
target = "8"

[sub_resource type="Resource" id="Expr_not_pro_usa"]
script = ExtResource("3_expr")
type = 20
children = Array[ExtResource("3_expr")]([SubResource("Expr_pro_usa")])

[sub_resource type="Resource" id="Expr_authoritarian"]
script = ExtResource("3_expr")
type = 25
key = "government"
value = 0.0
target = "8"

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "War is hell"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Iraq invaded Iran, beginning a major regional war with both superpowers initially backing Baghdad."

[resource]
script = ExtResource("4_event")
event_id = "iran_iraq_war"
source_event_number = 73
trigger_priority = 730
title = "Iran–Iraq War"
description = "Iraq has attacked an isolated authoritarian Iran. The new war is now part of the global influence system."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_not_pro_usa"), SubResource("Expr_authoritarian")])
options = Array[ExtResource("1_option")]([SubResource("Option_0")])
