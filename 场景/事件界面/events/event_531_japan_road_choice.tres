[resource]
script = ExtResource("4_def")
event_id = "event_531"
source_event_number = 531
trigger_priority = 53100
title = "变则善，常变则至善"
description = "多亏了我们的帮助，社会党终于摆脱了“万年在野党”的尴尬名头，实现了“保革逆转”。在飞鸟田一雄的带领下，社会党在坚持护宪平和主义的同时也根据国际局势的变化做出了一定调整：巩固工人权益的同时平衡市民阶层与劳工之间的关系，推动公有化进程并准备筹划建立“国家计划委员会”。对外则全面加强了与各国社会主义政党的联系，与苏联和社会主义阵营的经贸关系也愈发紧密，《日美安保条约》的重新谈判已经启动，同时积极组织国际会议以试图推动全球裁军以及无核化。这些政策自然引起了许多人的不满（尤其是保守势力），美国也对新政府的行为十分警惕，秘密加强了在太平洋区域的兵力和演习次数。\n同时在日本国内，反对党自由民主党对社会党的“激进左倾”政策表示强烈不满，称其“希望把日本置于苏联的势力范围之下”。而处于联合政府内的公明党和民主社会党也对社会党的政策颇有微词，尽管他们已经为了适应社会党的主要主张已经对自身的纲领路线进行了调整。而在另一边，共产党对社会党不再坚持“社共共斗”路线以及两党势力的此消彼长（尤其是在基层）极为不满，共产党领导人宫本显治多次在公开场合批评社会党，称其不仅是一个“中道政党”且有进一步右倾化的苗头。但需要注意的是，共产党内仍有一部分人希望保持与社会党的关系。\n主席同志，考虑到目前的情况，现在是我们做出选择的时候了。是促使联合政府的三党更加紧密地团结在一起，还是重建“社共共斗”的路线。请务必谨慎选择，考虑到日本的政坛现状，您的任何选择都将产生巨大影响。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_5"), SubResource("Expr_6"), SubResource("Expr_7")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
