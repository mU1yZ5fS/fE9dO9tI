[resource]
script = ExtResource("4_def")
event_id = "event_450"
source_event_number = 450
trigger_priority = 45000
title = "永恒之光"
description = "自伊朗——伊拉克爆发大规模冲突以来，拉贾维和前总统巴尼萨德尔的伊朗全国抵抗委员会NCRI，已融入了包括人民圣战者，库尔德斯坦民主党，民族阵线、共产主义者联盟等倒霍力量。虽然其人数众多，但缺少强有力的支持。而伊拉克同时也陷入了和伊朗的堑壕战中，如果能得到NCRI，那么对于快速结束两伊战争也会有很大帮助。而随着伊拉克倒向我们，也许组建一支伊朗人自己的反神权武装力量或许也是可行的？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_done447"), SubResource("Expr_not448"), SubResource("Expr_no_iranrev"), SubResource("Expr_war3_going"), SubResource("Expr_date"), SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
