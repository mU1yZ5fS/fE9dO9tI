[resource]
script = ExtResource("4_def")
event_id = "event_570"
source_event_number = 570
trigger_priority = 57000
title = "命运的战争已然开始"
description = "随着革命战争的告一段落，新生的伊拉克社会主义共和国把目光转向了东南角的弹丸小国————科威特。自独立以来的伊拉克领袖们从未忘记这块弹丸之国，更别提新生的社会主义共和国有多渴望推翻科威特的埃米尔政权了。最近，伊拉克外交部正式谴责了科威特“残酷的迫害伊拉克和巴勒斯坦劳工，在重要问题上多次追随美帝国主义者”。并正式宣布对科威特发动特别军事行动。很快，精锐的“两河”师团，“劳动者”机械化步兵营和七月十四革命卫队以闪电一般的攻势快速穿插，攻入了这个就比烟台大一点的小国。"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
