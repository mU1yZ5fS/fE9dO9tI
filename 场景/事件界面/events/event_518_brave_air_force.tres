[resource]
script = ExtResource("4_def")
event_id = "event_518"
source_event_number = 518
trigger_priority = 51800
title = "人民空军，勇敢去闯荡"
description = "随着我们工业体系，尤其是航空电子科技的进一步发展，一个大胆的计划正在酝酿。我们的科学家和工程师正在研究电子层面的低可侦测型涂装，这将会是一件非常烧钱的计划，但其回报将是超出我们想象的：要是在将来爆发战争，我们的空军将会有难以匹敌的优势。这款飞机的雷达系统和数字化控制系统将会超出我们所有人的预料，远远的把同级的F15，Mig-29甩在身后。最高领导人同志，您的意向如何？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_t0")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
