[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/core/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/core/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/core/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/core/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_033_041_world_and_party.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1977.7"

[sub_resource type="Resource" id="Expr_agents"]
script = ExtResource("3_expr")
key = "agents"
value = 60.0

[sub_resource type="Resource" id="Expr_budget"]
script = ExtResource("3_expr")
key = "budget"
value = 30.0

[sub_resource type="Resource" id="Expr_reserve"]
script = ExtResource("3_expr")
key = "reserve"
value = 30.0

[sub_resource type="Resource" id="Expr_money"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_budget"), SubResource("Expr_reserve")])

[sub_resource type="Resource" id="Expr_help"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents"), SubResource("Expr_money")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "保持距离"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "7月4日午夜时分，齐亚-乌尔-哈克将军命令拉瓦尔品第111旅包围所有主要的联邦政府大楼、警察局和国民议会。在那之后，他下令警方逮捕佐勒菲卡尔·布托、巴基斯坦人民党部长和其他领导人。齐亚将军在国家电视台向人民发表的讲话中说，巴基斯坦国民议会和各省议会已经解散，《巴基斯坦宪法》不再有效。新政府开始将巴基斯坦伊斯兰化，并回归亲美外交政策。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "帮助布托"
disabled_text = "我们不能帮助"
enable_condition = SubResource("Expr_help")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "由于我们的警告，布托设法躲开叛军，并组织了忠诚的部队对付他们，他们在抵达的国安部特勤部队的帮助下阻止叛军，并抓获了政变领导人。齐亚-乌尔-哈克将军因叛国罪被处决，由于我们的物质援助和在打击抗议者方面的帮助，巴基斯坦的局势得以正常化。布托继续建设伊斯兰社会主义，在经济中引入了越来越多的社会主义方法。与印度的关系也略有升温。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "放任事态发展并和新政府建立外交关系"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "7月4日午夜左右，齐亚-乌尔-哈克将军命令第111旅从拉瓦尔品第包围所有主要联邦政府大楼、警察局和国民议会。在那之后，他命令警方逮捕扎尔菲卡·布托、巴基斯坦人民党的部长和其他领导人。齐亚将军在国家电视台向人民发表的讲话中表示，巴基斯坦国民议会和各省级议会解散，巴基斯坦宪法也不再有效。新政府朝着巴基斯坦的伊斯兰化方向前进，并返回亲美外交政策，这并不妨碍我们与巴基斯坦保持密切互利的关系。"

[resource]
script = ExtResource("4_event")
event_id = "pakistan_coup"
source_event_number = 33
trigger_priority = 3300
title = "星月之眼"
description = "佐勒菲卡尔·阿里·布托自1971年担任巴基斯坦总统，自1973年来担任总理，他遵循伊斯兰社会主义的路线，这在广泛的社会项目和经济中许多行业的国有化得到体现。在外交政策方面，他坚持反帝国主义，尝试与邻国建立友好关系，脱离亲美的东南亚条约组织和英联邦，并成功与印度在第三次印巴战争后缓和关系。但是在布托的巴基斯坦人民党赢得1977年3月的大选后，反对派指责他欺诈，并开始抗议，遭到布托严厉的镇压。穆罕默德·齐亚·乌尔·哈克领导的军队不喜欢此事，在美国的支持下，他在准备军事政变。通过阻止政变，提供布托建设社会主义的物质协助，我们可以坚实地确保我们在巴基斯坦的地位。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
