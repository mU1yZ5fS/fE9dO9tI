[resource]
script = ExtResource("4_def")
event_id = "event_380"
source_event_number = 380
trigger_priority = 38000
title = "罗曼诺夫宣布实施“再斯大林化”"
description = "新近掌权的苏联领导人格里戈里·罗曼诺夫对国内人事进行了变动，提拔了曾任《共产党人》杂志主编的著名斯大林主义者理查德·科索拉波夫作为自己的第二书记（即苏共中央宣传鼓动部部长）\n随后，科索拉波夫立即开始对1957年遭遇镇压的斯大林主义团体实现完全平反。并在20世纪60年代后，对已定调的斯大林的个人崇拜问题再度重提。并得出了“苏共20大所发表的秘密报告犯了大错，相关指控均不存在，必须对其进行重新审视”。\n这会是新一轮的“再斯大林化”吗？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
