[resource]
script = ExtResource("4_def")
event_id = "event_494"
source_event_number = 494
trigger_priority = 49400
title = "防患于未然？"
description = "主席同志，在大规模推广自动化生产后，一些科研人员担心我们的自动化经济系统可能会遭到敌人入侵，用来破坏我们最新的社会主义现代化经济成果。不过得益于我们已经研究了信息化时代的战争方式，或许我们应该给IECS系统研究一种“防火墙”，来抵御未来潜在的威胁？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
