[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_053_062_reform_and_alliances.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1977.11"

[sub_resource type="Resource" id="Expr_agents"]
script = ExtResource("3_expr")
type = 0
key = "agents"
value = 40.0

[sub_resource type="Resource" id="Expr_budget"]
script = ExtResource("3_expr")
type = 0
key = "budget"
value = 20.0

[sub_resource type="Resource" id="Expr_reserve"]
script = ExtResource("3_expr")
type = 0
key = "reserve"
value = 20.0

[sub_resource type="Resource" id="Expr_funds"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_budget"), SubResource("Expr_reserve")])

[sub_resource type="Resource" id="Expr_burma_stable"]
script = ExtResource("3_expr")
type = 25
key = "stability"
value = 1.0
target = "33"

[sub_resource type="Resource" id="Expr_coup"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents"), SubResource("Expr_funds"), SubResource("Expr_burma_stable")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "This does not concern us"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Ne Win purged communist sympathizers and consolidated his regime without Chinese interference."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Aid Ne Win and establish friendly relations"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "China funded Burma's recovery and established trade, while Ne Win continued purging communist sympathizers."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "Help the communists organize an internal party coup"
disabled_text = "Requires 40 agents, 20 combined budget and reserves, and a stable Burmese regime"
enable_condition = SubResource("Expr_coup")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "Chinese intelligence enabled the BSPP left to remove Ne Win and align a socialist Burma with Beijing."

[resource]
script = ExtResource("4_event")
event_id = "burmese_socialism"
source_event_number = 55
trigger_priority = 550
title = "The Burmese road to socialism"
description = "Ne Win is preparing another purge of the Burmese socialist party. Beijing may stay out, support him, or aid the communist wing."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
