[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_053_062_reform_and_alliances.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1980.8.10"

[sub_resource type="Resource" id="Expr_burma_sub10"]
script = ExtResource("3_expr")
type = 25
key = "sub_government"
value = 10.0
target = "33"

[sub_resource type="Resource" id="Expr_not_event663"]
script = ExtResource("3_expr")
type = 6
ref_event_id = "event_663"

[sub_resource type="Resource" id="Expr_agents_40"]
script = ExtResource("3_expr")
type = 0
key = "agents"
value = 40.0

[sub_resource type="Resource" id="Expr_burma_stable"]
script = ExtResource("3_expr")
type = 25
key = "stab"
value = 1.0
target = "33"

[sub_resource type="Resource" id="Expr_coup"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents_40"), SubResource("Expr_burma_stable")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "你还记得午门抗缅吗？"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "将天鹅、梭子鱼和虾团结起来并非易事，奈温与巴登顶的会谈很快便以失败告终。奈温试图以“苏加诺二世”身份同我国建立统一战线的计划也跟着胎死腹中。显然，我们更愿意和真正的胞波，而非酒肉朋友、同床异梦的蒋介石打交道！巴登顶则对我们的表态持积极态度，接下来就请拭目以待……"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "是时候放下旧恨了，我们应该重谈和平共处与历史友谊！"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由 event_053_062_reform_and_alliances.gd 动态生成）"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "押注革命者与奈温都只是慢性死亡，我们将通过打入主义的方式结束缅甸动荡！"
disabled_text = "我们在仰光没有信得过的人"
enable_condition = SubResource("Expr_coup")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由 event_053_062_reform_and_alliances.gd 动态生成）"

[resource]
script = ExtResource("4_event")
event_id = "burmese_socialism"
source_event_number = 55
trigger_priority = 550
title = "江水下游的胞波"
description = "主席同志，是时候谈谈我们南边的邻居了。看上去和平的曙光即将将出现在“亚洲巴尔干”缅甸的地平线上：政府不仅启动了新一轮特赦，甚至在同民族地方武装的谈判上取得了令人印象深刻的转折。“中国人民的老朋友”，适应东南亚隐士国度国情的“蒋介石”吴奈温将军突访北京，并点名同流亡我国的缅甸共产党领导人德钦巴登顶会面谈判，以实现该国的持久和平。德钦巴登顶是与德钦丹东同期的缅甸共产党（白旗派）领导人，该党自1948年以来便走上了发动游击战争对抗反法西斯人民自由联盟政府，实现国家完全独立的道路。也就在1962年的吴奈温政变后，缅甸共产党更是借机扩大斗争规模，将根据地扩大至缅甸北部各地，形成了多民族统一战线，并以对中国社会主义路线的高度忠诚著称：德钦丹东在根据地开展缅版文化大革命的消息并非秘密，甚至可说是最早响应这一运动的组织。这只会让以毛泽东主席为代表的一代领导层将其作为东南亚革命敲门砖进行运营。\n当然，我们也并非那种将鸡蛋全装在一个篮子内的人：考虑到缅甸政府是最早承认我国合法性的非社会主义政权，我们很快便通过正常外交渠道达成了联系，并在和平共处五项原则与防范流亡国民党部队的基础上实现了亚洲新兴民族政权间的合作。吴努与吴奈温政府也就成了可同中国言欢的好酒友。考虑到现任领导人吴奈温性格独特，不拘小节，甚至有打“红色高棉牌”的前科，很显然是想借试探“胞波”关系对亚洲版不结盟运动故事重提……"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_burma_sub10"), SubResource("Expr_not_event663")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
