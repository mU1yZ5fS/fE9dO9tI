[resource]
script = ExtResource("4_def")
event_id = "event_492"
source_event_number = 492
trigger_priority = 49200
title = "狂风怒吼，巴尔干咆哮"
description = "随着苏联影响力的进一步衰退，一度被视为稳定与发展的保加利亚人民共和国也开始暗流涌动。民族主义者，改革派，正统派共产主义者都试图踢开日夫科夫掌握大权。由于日夫科夫的政策，保加利亚的经济一直处于下滑阶段。内部的局势似乎已经到了一个引爆点，而我们只需要扇下风，不需放屁，试看天翻地覆。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
