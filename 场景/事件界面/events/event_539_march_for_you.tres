[resource]
script = ExtResource("4_def")
event_id = "event_539"
source_event_number = 539
trigger_priority = 53900
title = "献给你的进行曲"
description = "为了纪念518光州事件，数十名首尔地区的大学生占领了首尔美国文化中心，并高举“美国为光州事件负责，必须道歉”的口号。美国大使为此前来与学生们交流，但在交流无果后离开文化中心。在静坐了数天以后，军警突然闯入二楼并将学生全部抓捕。这一消息使得本就因为镇压民主化导致左翼化激进化的学生运动变得更加激进，更多的学生走上街头要求释放学生，因为被封锁导致失业的工人们也开始上街游行，民主派们也正蠢蠢欲动。或许，我们应该趁此出手，使这个东亚最后的反共堡垒从内部摧毁？"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
