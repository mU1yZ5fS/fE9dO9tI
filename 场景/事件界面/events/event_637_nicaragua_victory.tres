[resource]
script = ExtResource("4_def")
event_id = "event_637"
source_event_number = 637
trigger_priority = 63700
title = "在胜利的门前"
description = "到1979年，索摩查王朝已经摇摇欲坠。然而，桑解阵的胜利绝不是不可避免的。尽管其军队在各个战场上屡遭挫折，但国民警卫队仍然是一支重要的军事力量，仍然有能力对对手进行严厉打击，其兵力和武器装备远远超过桑解阵。尽管支持索摩查独裁政权极大损害了美国的国际威望，但卡特政府依然在担心尼加拉瓜成为“第二个古巴”的风险，对反索摩查运动态度模棱两可。\n而反索摩查运动内部也并非铁板一块，相比桑解阵，精英和资产阶级反对派更希望维持国民警卫队，愿意“维持索摩查政府的机构，即使索摩查本人下台了”，并寻求将桑解阵排除在未来政府之外（不过，独裁者更愿意与游击队继续战争，而不是与查莫罗等“温和”反对派人士通过谈判解决问题）。桑解阵则强烈反对美国与资产阶级反对派主张的这种“没有索摩查的索摩查主义”，他们坚持致力于武力推翻独裁者，进而争取桑解阵在反索摩查斗争中的领导地位以及尼加拉瓜未来的转型。为了争取到民主反对派的支持和国际社会的同情、减少美国武力干涉尼加拉瓜的可能，桑解阵还缓和了自己的反帝国主义言辞。\n民主解放联盟与其他温和反对派组成了广泛反对派阵线（由“尼加拉瓜民主运动”党领导人、商人阿方索·罗贝洛领导）。1978年夏天，桑解阵将22个独立的支持团体完全协调成一个单一组织——人民联合运动（MPU），六个月后创建了一个更大的伞式组织，全国爱国阵线（FPN）。\n经过四个月的顽强攻势，在北方，桑解阵解放了埃斯特利、新塞哥维亚、马德里斯、马塔加尔帕和希诺特加等省份，在南方与哥斯达黎加的边界线上，奥斯塔约、索蒂卡巴洛、萨波阿、托拉、南西米、贝伦和波托西等城市也已经被解放，中部马萨亚省的大部分地区也已经被桑解阵所控制。\n1979年6月，托马斯·博尔赫和温贝托·奥尔特加通过桑地诺广播电台正式宣布总起义开始，面对不可避免的局面，精英们开始撤离并逃往美国和其他地方。国民警卫队开始瓦解，部队崩溃，士兵纷纷逃往邻国。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
