[resource]
script = ExtResource("4_def")
event_id = "event_350"
source_event_number = 350
trigger_priority = 35000
title = "劫持米格-25"
description = "不久前，一名苏联叛逃者成功地劫持了一架最新的米格-25截击机，将其运到了日本。考虑到我们的工程师正在开发我国的歼-8截击机，对苏联飞机进行研究将对我们大有裨益。我们在苏联境内的特工可以说服那些对体制不满的人飞往中国境内。但这将恶化与苏联的关系，这架飞机值得我们的特工公开行动么？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
