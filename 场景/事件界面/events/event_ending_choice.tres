[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/core/event_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://数据脚本/core/effect_node.gd" id="2_fx"]
[ext_resource type="Script" path="res://数据脚本/core/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/core/event_def.gd" id="4_def"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_ending_choice.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date_1986"]
script = ExtResource("3_expr")
type = 12
key = "1986.1.1"

[sub_resource type="Resource" id="Fx_left"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt_left"]
script = ExtResource("1_opt")
text = "继续掌权，直至永远"
effects = Array[ExtResource("2_fx")]([SubResource("Fx_left")])
result_text = "（结果由 event_ending_choice.gd 动态生成）"

[sub_resource type="Resource" id="Fx_right"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt_right"]
script = ExtResource("1_opt")
text = "功成身退，结束游戏进入摘要"
effects = Array[ExtResource("2_fx")]([SubResource("Fx_right")])
result_text = "（结果由 event_ending_choice.gd 动态生成）"

[resource]
script = ExtResource("4_def")
event_id = "ending_choice"
source_event_number = -1
title = "历史的十字路口"
description = "同志！我们已经迈上实现中华民族伟大复兴的光明大道！未来纵有艰难险阻，但只要不忘初心，砥砺前行，必然能赢得更加伟大的胜利和荣光。你就像我们的太阳，指引着人民前进的方向：|在这里可以选择继续掌权，直至永远，按照你的意愿塑造世界秩序，且在任何时候都可以结束游戏。但从新的时间段开始，将无法取得任何成就。|当然，也可以就此功成身退，只要选取右侧的按钮，即可结束游戏进入摘要窗口，此界面将对你这几年的执政作出评判，同时也会展示全球未来的走向。最最重要的是，可以解锁成就！|现在由你抉择"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date_1986")])
options = Array[ExtResource("1_opt")]([SubResource("Opt_left"), SubResource("Opt_right")])
fire_only_once = true
