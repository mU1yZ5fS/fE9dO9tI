[resource]
script = ExtResource("4_def")
event_id = "event_482"
source_event_number = 482
trigger_priority = 48200
title = "回归正统"
description = "法国共产党在选择转向欧洲共产主义理念，并逐渐远离苏联与无产阶级专政原则后，其内部便形成了三大派系：分别是支持回归马克思列宁主义和无产阶级专政原则正轨的“正统派”；追随总书记乔治·马歇的法国特色社会主义路线的“保守派”；以及支持新左派或欧洲共产主义的“改革派”——后两派处于结盟的状态。\n在我们与苏联的帮助下，法国共产党正统派的力量在党内已经不断壮大。现在我们已经可以和苏联人一起把马歇这个右倾机会主义分子踢下去了。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
