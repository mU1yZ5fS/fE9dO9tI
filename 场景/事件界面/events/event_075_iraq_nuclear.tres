[resource]
script = ExtResource("4_def")
event_id = "event_075"
source_event_number = 75
trigger_priority = 7500
title = "伊拉克核问题"
description = "刚刚从伊拉克传来的消息，以色列空军在“歌剧”行动中攻击了“塔木兹”反应堆，将其摧毁。由于这次袭击，伊拉克的核计划结束了。萨达姆现在正在推行一项非常激进的外交政策，这将破坏已经紧张的中东局势。然而，我们或许可以帮助伊拉克继续进行核计划，从而在这个战略地区获得一个有用的盟友。尽管我不建议依赖萨达姆·侯赛因的可靠性——他是与美国、苏联、我们和不结盟运动合作的多向政策的著名支持者。有可能，即使它拥有自己的原子弹也不会改变这一点…"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
