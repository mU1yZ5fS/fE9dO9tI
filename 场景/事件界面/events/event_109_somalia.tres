[resource]
script = ExtResource("4_def")
event_id = "event_109"
source_event_number = 109
trigger_priority = 10900
title = "索马里的黄金时代"
description = "在索马里灾难性的政治冒险后，西亚德·巴雷从索马里炙手可热的红星变为了人人喊打的灾星。为了维护自己的统治，他大力抓捕并处决参与欧加登战争的军官。一部分军官们认为，西亚德·巴雷故意将其他部落的士兵用作“炮灰”，而他自己的马烈汉部族的军官则得到了更安全的命令。至少是出于对巴雷的种族歧视政策的恼怒，以及欧加登惨败后对其政权的失望。由奥斯曼·伊罗和阿卜杜拉希·优素福·艾哈迈德等人意图推翻索马里政府，至少换上一个能够解决内部矛盾的更平等的政府。\n主席同志，也许是时候了？我们该给这个狂妄的索马里人一点东方教训？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
