[resource]
script = ExtResource("4_def")
event_id = "event_540"
source_event_number = 540
trigger_priority = 54000
title = "达芬奇的遗产"
description = "随着我国航空器技术的进步，过去的直-5，直-6等装备实在过于老旧，难以执行预定的战略目标。研发新型直升机的计划迫在眉睫，但也有一个好消息，法国人愿意为我们提供SA365-N1型直升机。这是一个相当不错的机会，法国的直升机相当耐用，且能为未来的改装做更多准备。当然，更多的委员希望能建造自己的直升机，哪怕失败了也可以当成是为未来最准备。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
