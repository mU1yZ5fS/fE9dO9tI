[resource]
script = ExtResource("4_def")
event_id = "event_315"
source_event_number = 315
trigger_priority = 31500
title = "以日为师"
description = "二战后，日本表现出惊人的经济增长，每年约10%，成为世界上第二大名义经济强国，超过法国、意大利、加拿大、英国、苏联，仅次于美国。在西方，他们甚至称其为“日本经济奇迹”。但许多自由派坚持认为，这样的成功是由大企业和国家结合这种非市场方式造成的。左派指责日本领导层压低工作条件，让工人过度劳累，并在日本创造了一种法团文化。但是我们可以考虑他们在我们国家的经历，再考虑到我们的具体情况......"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
