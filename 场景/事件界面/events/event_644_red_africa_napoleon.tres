[resource]
script = ExtResource("4_def")
event_id = "event_644"
source_event_number = 644
trigger_priority = 64400
title = "红色非洲拿破仑"
description = "自从让-贝德尔·博卡萨在我们的帮助下1979年挫败了法帝国主义的侵略以来，他已经采取了一系列政策来实行他“博卡萨运动”下的“科学社会主义”，并宣传“软弱的共和制法兰西白人匪帮丢弃了伟大先皇拿破仑的传统，事实上走向了堕落，而只有中非的博卡萨一世皇帝才是波拿巴主义的真正继承人”。\n作为中非人民帝国和执政党黑非洲社会发展运动的领导人，他颁布了一系列改革措施——首先是要求人们称他为“陛下同志”，并拾起了我们的经验，将革命委员会作为各级行政机构，各级革委会采取忠于博卡萨的军管代表、黑非洲社会发展运动党员和博卡萨家族成员的“三结合”；当然，对于执政党党员、政府的文官和军队内的军官，博卡萨陛下同志也在我们的帮助下进行了清洗，党领导政府和军队的体制被初步建立起来。对于反革命分子，系统化的“劳动改造营”（实际上是特种监狱）则是他们的去处。\n中非革命的硕果来之不易，帝国主义者的窥伺和周边各国对革命扩散的不满始终威胁着这个非洲中央的“革命明珠”。为了全力支持非洲人民的革命，让我们向中非放出我们领袖同志的“精神原子弹”吧！"
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
