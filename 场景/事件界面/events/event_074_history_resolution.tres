[resource]
script = ExtResource("4_event")
event_id = "history_resolution_1981"
source_event_number = 74
title = "关于建国以来党的若干历史问题的决议"
description = "经过数年的努力，我们的写作组终于完成了1979年末党中央赋予的神圣使命，《关于建国以来党的若干历史问题的决议》的终稿就此出炉。接下来便是在党的十一届六中全会上对其进行审议。可考虑到我们正处在变革时代，这份旨在实现“盖棺定论”的文件可不太可能被立即盖棺定论。"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_gate")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
