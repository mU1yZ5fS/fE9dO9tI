[resource]
script = ExtResource("4_def")
event_id = "event_391"
source_event_number = 391
trigger_priority = 39100
title = "最后斗争"
description = "随着意大利当局越加倾向于用武力手段对抗极端运动，激进主义潮流近乎直接转向各路主打恐怖主义袭击的武装团体：如果说在“火热之秋”与“铅色岁月”时期，武装行动只是作为罢课罢工、政治集会与占领社会中心等政治动员策略的辅助手段。如今它们则成为了夺取政权的万能公式本身。而极端主义武装组织本身的变迁亦证明了这点：在左翼阵营内，由马里奥·莫雷蒂领导的“红色旅”重写了其活动纲领，宣称“国家机器即跨国帝国主义实体”，至此将工作重心由“鼓励怠工”转向直截了当的“政治斩首”，事实上为该国其他的抵抗者做出了表率。挂靠“持续斗争”等工人主义团体运作的武装团体“前线”等组织也试着越来越自行其是，并以攻击政府官员、警察部队与右翼活动家的方式“回敬”1977年的系列镇压，逐渐盖过其服务者的威风。而右翼阵营的情况亦如此，出于意大利社会运动无力保障民族免受卡宾枪骑兵与无政府主义者侵害的担忧，新法西斯主义者们按照所谓自我防卫原则对城市游击队照猫画虎，决心以黑色恐怖回应红色-白色恐怖。缝合了新法西斯主义，去中心化架构，叛乱无政府主义与革命自发性原则的“革命武装核心”便是其中的集大成者。其领导人更宣称“革命仰赖组织，无需领袖”，“只要打出‘革命武装核心’旗帜，便是运动同路人”而这只会导致意大利的政治局势进一步复杂化，并为有心人士干涉该国内政创造良机。这其中自然也包括我们：考虑到目前意大利主要政党均在不同程度上持拥护现存体制与参与大西洋同盟的立场。从恨屋及乌，将北约集团视为帝国主义黑司令的那些边缘团体内寻找突破点的做法便显得理所应当？且考虑到各派恐怖组织均不为该国政治主流所容的事实，或许我们可以试着对其中的部分角色合纵连横，以最小代价达成最大效益？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
