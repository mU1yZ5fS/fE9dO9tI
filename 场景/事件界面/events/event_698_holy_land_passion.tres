[resource]
script = ExtResource("4_def")
event_id = "event_698"
source_event_number = 698
trigger_priority = 69800
title = "圣地受难日"
description = "1979年11月20日，正值伊朗人质危机爆发十余天后，另一个伊斯兰大国沙特阿拉伯也发生了类似的袭击事件。一伙由前伊赫万成员（伊本·沙特早年组织的贝都因人武装）和激进分子组成的团体突袭了麦加大清真寺，他们自称“萨拉菲正义组织”。其领导人朱海曼要求在场民众向他的女婿——“被等待的马赫迪”穆罕默德·阿卜杜拉·卡塔尼宣誓效忠，并在宣礼塔上向晨祷信徒发表演说，激烈抨击他所认为的“腐败无能、违背伊斯兰教义、与西方勾结”的沙特王室。他宣称马赫迪降临后将仅以《古兰经》为统治正典，而非依赖当前政权下的裙带关系和官方乌里玛的经释。此外，朱海曼还呼吁麦加民众和沙特特种部队悔改并服从马赫迪的统治。\n然而，该组织在计算马赫迪降临的时间上出现了严重错误：按照伊斯兰希吉来历，次年的穆哈兰姆月一号才是马赫迪出世的时间。更严重的是，武装分子在禁寺内枪杀了一名警卫，这严重违反了清真寺内禁止流血的戒律，导致大多数当地居民与朝觐者站到了他们的对立面，国际媒体也纷纷谴责这一骇人暴行。\n沙特统治家族在获得高级教法学家的多数同意后，迅速调遣部队前往麦加展开围剿，并在法国军事代表团的协助下进行部署。一场举世瞩目的反恐行动即将展开，其结局正受到全球观察者的密切关注……"
display_script = ExtResource("5_custom")
trigger_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
