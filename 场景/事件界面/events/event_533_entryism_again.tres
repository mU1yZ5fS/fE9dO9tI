[resource]
script = ExtResource("4_def")
event_id = "event_533"
source_event_number = 533
trigger_priority = 53300
title = "打入主义的再实践？"
description = "在我们的帮助下，日本共产主义抵抗者同盟不仅再次拥有了充足的武器装备，并且吸纳了更多成员。大批活跃分子开始再次深入工厂、学校等地，宣传革命思想并发展新人。日本政府虽然多次针对这一组织展开围剿行动，但多亏了我们在当地的特工网络，同盟成员每次都能及时得到消息并迅速化整为零隐蔽起来。现在他们的力量已经足够壮大，是时候建立一个新的政党以便更好地筹划下一次全共斗运动了。但考虑到目前同盟内部的派系问题并未完全解决，相当一批人也并不愿意脱离自己原先的小组织而融合进这个“陌生”的新组织中。我们也许应该学习托洛茨基主义中的打入主义方针，让他们渗透进日本共产党中？毕竟此时的日本共产党已经是一个烂透了的资产阶级议会政党了。与其让它继续打着“共产党”的名号唬骗工农，还不如由同盟成员对其进行彻头彻尾的改造。你觉得呢，主席同志？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_3"), SubResource("Expr_4"), SubResource("Expr_5"), SubResource("Expr_6")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
