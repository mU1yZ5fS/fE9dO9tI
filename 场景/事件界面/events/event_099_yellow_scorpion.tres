[resource]
script = ExtResource("4_def")
event_id = "event_099"
source_event_number = 99
trigger_priority = 9900
title = "黄蝎"
description = "主席同志，从社会主义阿尔及利亚传来的紧急消息！第二任阿尔及利亚人民民主共和国总统胡阿里·布迈丁，那位曾经推翻了我们的老朋友艾哈迈德·本·贝拉并终止了本·贝拉激进的社会主义实验、以神秘与狡诈被人民昵称黄蝎的总统，在暴病后猝死。在十五年的总统生涯中，他在落后的法国殖民地里建设起一个强大的非洲工业巨人。尽管布迈丁政权实际上是由军队、官僚和技术专家构成的精英集团进行统治的反共军政府，但布迈丁上校执政时的国有化、土地改革和外交上的反帝国主义立场使得他的政权受到了处于地下状态的社会主义先锋党（由阿尔及利亚共产党在反布迈丁政变失败被镇压后改组而成）的积极支持，他领导下的阿尔及利亚也依然是阿拉伯社会主义与不结盟运动的标杆。布迈丁的猝然离世使得国家权力一时进入真空状态，由军队组成的革命委员会暂时接管了政治权力。现在，由于继承危机，执政的民族解放阵线中两派已经开始争夺权力。他们是由“布迈丁主义的象征”穆罕默德·萨拉赫·雅伊奥维上校领导、由工会积极支持的、受到社会主义先锋党欢迎的、忠于布迈丁上校的社会主义路线的正统派，与支持向西方开放的外交部长、“资产阶级潮流”的代表阿卜杜勒阿齐兹·布特弗利卡领导的一个更偏自由化的派别。而军队则对布迈丁的社会主义立场和掌控国家政权十五年之久的乌季达帮（布迈丁总统的亲信）十分不满，他们另外挑出了一个乌季达帮中的边缘人物——第二军区司令沙德利·本·杰迪德上校。支持任何一派都会扩大我们在这里的影响，但是这值得吗？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
