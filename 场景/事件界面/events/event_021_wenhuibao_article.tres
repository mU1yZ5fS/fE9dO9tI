[resource]
script = ExtResource("4_def")
event_id = "event_021"
source_event_number = 21
trigger_priority = 2100
title = "周恩来的再放送"
description = "1976年3月25日，上海报纸《文汇报》刊登了一篇文章，尖锐地批评了邓小平及其改革思想，不仅如此，文章还批判了邓小平及其“后台”，称还有另一个“走资派”、“资本主义道路的支持者”。这些材料看上去是在影射已故的总理周恩来，但负责《文汇报》四人帮和周恩来的关系似乎并没有坏到要在他死后作文章污蔑。但不可否认的是，这篇文章一经大规模出版，绝对会有不少人将其当作对已故总理的公开谴责与侮辱，而你可以和四人帮直接挑明此事，抑或是顺水推舟火上浇油，又或者什么都不做。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
