[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/core/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/core/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/core/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/core/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_033_041_world_and_party.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1977.3"

[sub_resource type="Resource" id="Expr_agents_50"]
script = ExtResource("3_expr")
type = 0
key = "agents"
value = 50.0

[sub_resource type="Resource" id="Expr_line_not_0"]
script = ExtResource("3_expr")
type = 22
key = "political_line"
value = 0.0

[sub_resource type="Resource" id="Expr_gandhi"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_agents_50"), SubResource("Expr_line_not_0")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")


[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "保持距离"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "因为甘地和国大党失去人气，也因为人民把对抗国家紧急状态的人民党和为印度从英国占领中解放出来的自由斗士联系起来，人民党超过了国大党。莫拉尔吉·德赛当选了新任总理。他组建的政府恢复了与我国的关系，与巴基斯坦改善关系，保卫印度在世界舞台上的核政策。成立了一个用以调查国家紧急状态期间滥用权力的特殊法庭，但甘地却逃过一劫。但是，在新执政党内部，成员间在关于国家发展未来发展方向上，已经出现明显的分裂。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "支持反对派"
disabled_text = "我们没有足够的力量"
enable_condition = SubResource("Expr_agents_50")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "因为甘地和国大党失去人气，也因为人民把对抗国家紧急状态的人民党和为印度从英国占领中解放出来的自由斗士联系起来，人民党超过了国大党。莫拉尔吉·德赛当选了新任总理。他组建的政府恢复了与我国的关系，与巴基斯坦改善关系，保卫印度在世界舞台上的核政策。成立了一个用以调查国家紧急状态期间滥用权力的特殊法庭，但甘地却逃过一劫。但是，在新执政党内部，成员间在关于国家发展未来发展方向上，已经出现明显的分裂。我们希望我们与人民党的良好关系可以帮助其免于垮台。"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "支持英迪拉·甘地"
disabled_text = "支持甘地？甚至可能把西藏领土给她？"
enable_condition = SubResource("Expr_gandhi")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "尽管过去与我们有过分歧，甘地还是很感激地接受了我们的帮助，这要归功于印度国大党成功地击败了对手并赢得胜利。英迪拉·甘地继续担任总理，中印外交关系恢复，但我们之间仍有明显的紧张关系，领土争端仍未解决。希望印度国大党能和我们进一步和睦相处，而苏联不会阻止。"

[resource]
script = ExtResource("4_event")
event_id = "indian_elections"
source_event_number = 41
trigger_priority = 410
title = "印度大选"
description = "自1966年就任的前印度总理，国大党党首，英迪拉·甘地，在她执政期间在社会经济领域积极地开展了左派改革，这甚至激起了国大党内的分裂，和党内右翼的退出。她执政期间取得了经济成功，有效解决贫困问题，但自1971年宣布国家紧急状态以来，反对派人民党开始掌握优势，该党指责甘地腐败，搞裙带关系，和威权主义。在这些情况下，甘地决定举行早期议会选举。考虑到甘地一直在支持亲苏政策和对我们不友好的外交政策，还和与我们关系友好的巴基斯坦冲突，直到最近关系才缓和，也许反对派当选可以增强我们的影响力？人民党团结不同观点的群体，从社会主义者到保守主义者，并且没有明确的党纲，但这有助于我们更好地掌控他们。尽管也许如果我们帮助英迪拉，她也许会记得我们的好，并推动关系的重建？…"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])
