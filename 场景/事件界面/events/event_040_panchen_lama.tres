[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "让他接着蹲监狱！"
disabled_text = "我们不能继续把他关在监狱里了！"
enable_condition = SubResource("Expr_line_at_most_1")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "你的信下达了如下的决议：“第十世班禅喇嘛为西藏和中国人民做出了伟大的贡献，但他对于西藏和中国的国际声誉的打击更大。释放他是不合时宜且危险的。1979年3月，中国的持不同政见者魏京生发表了一封公开信，谴责关押班禅喇嘛的秦城监狱的恶劣条件，在那之后他被送往拉萨软禁。然而，第十世班禅喇嘛直到1989年1月28日去世后才获得了自由。"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "以放弃宗教信条为条件放出来"
disabled_text = "对他施压太重了！"
enable_condition = SubResource("Expr_line_at_most_2")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "确吉坚赞断然拒绝接受这一条件，理由是我们对西藏神职人员的压迫很严重。好吧，这是他自找的——让他在秦城待到他尘世的尽头吧……"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "释放他，让他回拉萨，但要在国安部的监督下（需要4单位特工网络）"
disabled_text = "或使他成为阶下囚，或给他自由"
enable_condition = SubResource("Expr_supervision")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "你的信下达了如下的决议：“十世班禅喇嘛在拘留期间花了足够的时间来思考和反省他的错误行为。我同意尽快释放他，允许他返回西藏，但要保持对他的监视。”1959年扎什伦布寺被毁时，曾有一批班禅喇嘛的遗体被掩埋，但回到拉萨后，确吉坚赞将他们的遗体重新安葬了。总的来说，他表现得很平静，没有尝试和流亡的十四世达赖喇嘛或他的支持者取得联系。因此，在1983年，一部有关他的自传电影被拍摄出来。班禅喇嘛的赦免受到了人民、西方和西藏移民的热烈欢迎。"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "释放这位政治犯和给他平反！"
disabled_text = "平反？！毛主席亲自谴责过他！"
enable_condition = SubResource("Expr_line_at_least_2")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "回到拉萨之后，十世班禅对外界宣布他对中国政府没有任何不满，对他的囚禁使得他能思考他之前作为一个西藏人民的剥削者所犯下的种种罪孽，这使他更加的理解了佛法。在重新安葬了因扎什伦布寺被破坏而无处安葬的前几代班禅喇嘛的遗体之后，确吉坚赞现在的任务是参加慈善活动，访问（经苏联领导层同意）卡尔梅克、布里亚特和图瓦苏维埃自治社会主义共和国和向这些蒙古族自治共和国传播佛法，帮助西藏与这些苏维埃自治共和国建立宗教联系。人民和国际社会都很满意。"

[sub_resource type="Resource" id="Option_4"]
script = ExtResource("1_option")
text = "在心脏病发作的掩盖下清除他，强迫选举诺布成为新的班禅喇嘛。（需要7单位特工网络）"
disabled_text = "班禅喇嘛应该由僧侣自己选择！"
enable_condition = SubResource("Expr_eliminate")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "1977年10月28日，秦城监狱的警卫发现班禅喇嘛倒在牢房的地板上，没有任何生命迹象。当天早上，以注射补品的名义，他被注射了一种特殊的引起心肌梗塞的毒药。尽管《西藏日报》（西藏人民代表大会的一个机构）发表了一份官方公报，称班禅喇嘛的死因为心脏病发作，但很少有人相信。流亡政府已经公开表示，“班禅喇嘛因不同意中国吞并西藏而被国安部杀害”。我们任命的寻找新班禅喇嘛委员会的负责人在得到批准之后秘密与逃亡的达赖喇嘛保持联系，这没有逃过国安部的注意。仁波切被逮捕，取而代之的是曾任达赖喇嘛和已故班禅喇嘛政治对手的生钦·洛桑坚赞。他达成了我们需要的效果——11月11日，坚赞诺布被宣布为第11世班禅喇嘛。“藏传佛教向国家和社会郑重宣誓，要保护国家，为人民谋福利。”诺布说，中国社会是藏传佛教信仰的良好环境。他还赞扬他的前任“为加强国家统一和人民团结作出的杰出贡献”。然而，第十四世达赖喇嘛和他所谓的“西藏流亡政府”已经宣布更登确吉尼玛为新的第十一世班禅喇嘛。我们必须逮捕他…藏族喇嘛破坏新班禅喇嘛的活动，支持达赖喇嘛的任命，分裂情绪在他们中间蔓延……"

[resource]
script = ExtResource("4_event")
event_id = "panchen_lama"
source_event_number = 40
trigger_priority = 4000
title = "班禅喇嘛的命运"
description = "主席同志，一大批藏族神职人员来信，要求你们考虑释放十世班禅喇嘛（班禅喇嘛是仅次于藏传佛教格鲁派达赖喇嘛之后的第二位喇嘛——注释：国安部）。一九四九年九月，十世班禅喇嘛洛桑·特林利·拉杜鲁布·确吉坚赞拒绝随国民党逃往台湾，支持中华人民共和国的成立。后来在西藏与祖国统一中发挥了重要作用。然而，他随后严厉谴责了西藏自治区的中国化，1964年他被宣布为“西藏人民的敌人”，被捕并被关进在他目前居住的北京秦城监狱。我们可以释放他，从而大大改善与藏族僧侣和自治区人民的关系。但这有意义吗？也许最好是清除这位不可靠的喇嘛，让我们的保护人坚赞诺布当选班禅喇嘛？"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_religion_not_27")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3"), SubResource("Option_4")])
