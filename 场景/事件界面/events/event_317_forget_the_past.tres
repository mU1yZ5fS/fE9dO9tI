[resource]
script = ExtResource("4_def")
event_id = "event_317"
source_event_number = 317
trigger_priority = 31700
title = "忘却过去？"
description = "距日本在我国领土上犯下桩桩罪行已过去40多年了。当然，这些罪行都称得上是人间悲剧，但我们赢了，战犯们在审判中被判有罪，日本政府已与从前大不相同了。为了两国之间的稳定和友好关系，是时候原谅他们过去所有的罪行了。但这一决定在党和人民内非常不受欢迎。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
