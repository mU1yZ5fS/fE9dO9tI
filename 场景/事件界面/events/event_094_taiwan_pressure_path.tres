[resource]
script = ExtResource("4_event")
display_script = ExtResource("5_custom")
event_id = "event_094"
source_event_number = 94
trigger_priority = 9400
title = "又一次天安门事件？！"
description = "对各个涉及人民生活领域的大规模改革政策、日益猖獗的腐败、中国共产党与商界的勾结以及权贵与商人之间秘密的腐败联系，导致资产阶级自由化思想在相当一部分的中国知识分子和青年中广泛传播，他们要求更激进的改革，反对“共产主义传染病”。因此他们组织了一场由持不同政见的天体物理学家方励之（在西方被称为“中国的萨哈罗夫”）所领导的“退党”运动，运动的主张是宣布中国共产党为“犯罪组织”，并剥夺党的一切权力、要求国家的自由化和西方化、打击腐败和消灭官僚的特权。利用了政府内部的混乱，十万“退党”支持者聚集在北京天安门广场举行群众活动。他们要求“自由”、“民主”、“打击腐败官僚”和“打倒腐败的党的领导”，而其他包括工人在内的对我们的改革不满的人，每天都在加入他们的行列。中国共产党党内的自由派领导人{name}，倾向于对抗议者妥协让步，希望通过抗议活动执掌党政大权。国内局势极不稳定，但现在仍有机会进行干预——在动乱蔓延到其他城市之前..."
fire_only_once = true
show_notification = false
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_reform_momentum_90"), SubResource("Expr_date_1983"), SubResource("Expr_not_event_444_result_0")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])