type = 39
key = "1"
value = 1.0

[sub_resource type="Resource" id="Expr_leader2"]
script = ExtResource("3_expr")
type = 39
key = "1"
value = 2.0

[sub_resource type="Resource" id="Expr_leader_gate"]
script = ExtResource("3_expr")
