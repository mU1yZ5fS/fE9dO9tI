[resource]
script = ExtResource("4_event")
event_id = "wind_of_change"
source_event_number = 102
title = "变革之风？"
description = "来自苏联的紧急消息！1985年3月10日19时20分，苏共中央总书记康斯坦丁·乌斯季诺维奇·契尔年科死于心脏骤停。在人民哀悼时，环绕新任总书记的竞争在克里姆林宫的长廊里展开了。候选者有: 米哈伊尔·戈尔巴乔夫，一位年轻而可靠的党员，曾是安德罗波夫的人马，以改革思维著称。格里戈里·罗曼诺夫，有活力而适于探索，一位年轻但经验丰富的管理者，曾是列宁格勒州委书记，以铁腕保证了列宁格勒的繁荣与经济发展。以及维克托·格里申，上个时代政治局的代表，保守派的最爱，莫斯科市委书记，勃列日涅夫对内对外政策的支持者，在这些年里在苏联上下发展了巨大的关系网（以及腐败网）。我们要支持谁? 如果我们能支持的话。"
show_notification = false
fire_only_once = true
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_gate")])
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
