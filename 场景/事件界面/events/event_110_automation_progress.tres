[resource]
script = ExtResource("4_def")
event_id = "event_110"
source_event_number = 110
trigger_priority = 11000
title = "自动化的缓慢进展"
description = "主席同志!在过去的五年里，我们在国民经济和科学研究方面取得了很大的进步，我们不应该止步于此。现在应该巩固我们的成就，重新建立几代人关于一个完美的世界秩序的梦想，迈出从社会主义到共产主义社会的第一步。我国最优秀的头脑——数学家和控制论者——提出要建立一个全面的、统一的、自动化的生产计划系统。OGAS的概念由苏联数学家维克多·格鲁什科夫提出。因此，我们将能够通过把最复杂和最昂贵的计算转移到计算机上来摆脱计划经济的所有问题和缺陷。但要实施如此庞大的项目，需要大量的资金和时间，同时国家机器像害怕火灾一样害怕激进的变化，特别是那些可能会侵蚀他们的领地和繁荣的变化。选择权在你……"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
