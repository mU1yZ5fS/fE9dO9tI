script = ExtResource("4_def")
event_id = "event_470"
source_event_number = 470
trigger_priority = 47000
title = "哪个东方才是红色的"
description = "自1966年以来，毛泽东思想鼓舞了东欧的年轻人。现在他们已经势不可挡，我们的东风已然压倒了苏联的东风。是时候做出最大胆的决定了：我们将直接夺取苏联的几个摇摆不定的卫星国。并把它们作为毛主义向苏联与东欧其余地方传播的堡垒。考虑到苏联现行政策，我们需要做好在苏联衰弱甚至解体后直接干涉的准备，这也是为了苏联革命必不可少的一环。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
