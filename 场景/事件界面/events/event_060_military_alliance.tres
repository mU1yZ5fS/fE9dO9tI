[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_053_062_reform_and_alliances.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1979.6"

[sub_resource type="Resource" id="Expr_china_econ"]
script = ExtResource("3_expr")
type = 10
key = "econ"
target = "1"

[sub_resource type="Resource" id="Expr_budget"]
script = ExtResource("3_expr")
type = 0
key = "budget"
value = 50.0

[sub_resource type="Resource" id="Expr_reserve"]
script = ExtResource("3_expr")
type = 0
key = "reserve"
value = 50.0

[sub_resource type="Resource" id="Expr_money"]
script = ExtResource("3_expr")
type = 19
children = Array[ExtResource("3_expr")]([SubResource("Expr_budget"), SubResource("Expr_reserve")])

[sub_resource type="Resource" id="Expr_army"]
script = ExtResource("3_expr")
type = 0
key = "army"
value = 100.0

[sub_resource type="Resource" id="Expr_agents"]
script = ExtResource("3_expr")
type = 0
key = "agents"
value = 50.0

[sub_resource type="Resource" id="Expr_ready"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_money"), SubResource("Expr_army"), SubResource("Expr_agents")])

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "Create a collective security alliance"
disabled_text = "Requires 50 budget or reserves, 100 army strength, and 50 agents"
enable_condition = SubResource("Expr_ready")
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "China and every pro-Chinese state entered a common military bloc independent of both NATO and the Warsaw Pact."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "Remain outside military alliances"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "China kept its economic organization outside any military bloc."

[resource]
script = ExtResource("4_event")
event_id = "military_alliance"
source_event_number = 60
trigger_priority = 600
title = "Military alliance"
description = "Members of China's economic organization now ask for collective defense against the two established military blocs."
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_china_econ")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1")])
