[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_fx"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_def"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_090_triads.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1980.12.1"

[sub_resource type="Resource" id="Expr_hk1"]
script = ExtResource("3_expr")
type = 21
key = "hk_macau_status"
value = 1.0

[sub_resource type="Resource" id="Expr_trigger"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_hk1")])

[sub_resource type="Resource" id="Fx0"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_opt")
text = "我们会对三合会开出他们无法拒绝的条件的（需要4特工网络）"
effects = Array[ExtResource("2_fx")]([SubResource("Fx0")])
result_text = "（结果由 event_090_triads.gd 动态生成）"

[sub_resource type="Resource" id="Fx1"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_opt")
text = "我们可以与犯罪辛迪加们结成战略同盟。但这可不意味着他们有了免死金牌（需要2特工网络）"
effects = Array[ExtResource("2_fx")]([SubResource("Fx1")])
result_text = "（结果由 event_090_triads.gd 动态生成）"

[sub_resource type="Resource" id="Fx2"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_opt")
text = "我们关心这些强盗干什么？"
effects = Array[ExtResource("2_fx")]([SubResource("Fx2")])
result_text = "（结果由 event_090_triads.gd 动态生成）"

[sub_resource type="Resource" id="Fx3"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt3"]
script = ExtResource("1_opt")
text = "现在是时候对我国南方省份的有组织犯罪进行有力打击了！（需要8特工网络）"
effects = Array[ExtResource("2_fx")]([SubResource("Fx3")])
result_text = "（结果由 event_090_triads.gd 动态生成）"

[resource]
script = ExtResource("4_def")
event_id = "event_090"
source_event_number = 90
trigger_priority = 9000
title = "香港再见，澳门再见？"
description = "如你所知，我们就香港和澳门在1997年和1999年回归后获取的广泛自治权问题达成了数项协议，我们甚至为此设立了一个新的行政单位——“特别行政区”。然而，港澳部分大资产阶级人士反对这项协议，而我们的情报机构查明，他们正准备进行一系列挑衅活动，以破坏协议签署，并维持英国和葡萄牙的殖民统治（特别是最大限度地拖延特别行政区的基本法的制定，举行反华集会，并在媒体上发表有煽动性的材料）。在这种情况下，一些党员提出了一个令人出乎意料的建议——与所谓的三合会建立联系。三合会是香港第七大最有影响力的犯罪集团，他们在整个东南亚都有强大的关系。我们可以向他们提供优惠的经济优惠和司法豁免保障，但条件是他们要协助香港和澳门回归祖国。所以你的决定是？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_trigger")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
