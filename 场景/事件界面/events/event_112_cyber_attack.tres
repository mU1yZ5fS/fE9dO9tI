[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_fx"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_def"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_112_cyber_attack.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_mod11"]
script = ExtResource("3_expr")
type = 2
key = "11"

[sub_resource type="Resource" id="Expr_okb"]
script = ExtResource("3_expr")
type = 10
target = "1"
key = "okb"

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1984.1.1"

[sub_resource type="Resource" id="Expr_done110"]
script = ExtResource("3_expr")
type = 5
ref_event_id = "event_110"

[sub_resource type="Resource" id="Expr_root"]
script = ExtResource("3_expr")
type = 18
children = Array[ExtResource("3_expr")]([SubResource("Expr_mod11"), SubResource("Expr_okb"), SubResource("Expr_date"), SubResource("Expr_done110")])

[sub_resource type="Resource" id="Fx0"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt0"]
script = ExtResource("1_opt")
text = "继续升级我们的自动化系统的防护系统"
effects = Array[ExtResource("2_fx")]([SubResource("Fx0")])
result_text = "（结果由 event_112_cyber_attack.gd 动态生成）"

[sub_resource type="Resource" id="Fx1"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt1"]
script = ExtResource("1_opt")
text = "继续升级我们的自动化系统的防护系统，并要求苏联科学家提供援助"
effects = Array[ExtResource("2_fx")]([SubResource("Fx1")])
result_text = "（结果由 event_112_cyber_attack.gd 动态生成）"

[sub_resource type="Resource" id="Fx2"]
script = ExtResource("2_fx")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Opt2"]
script = ExtResource("1_opt")
text = "看来中国还没有准备好应对这种变化，有必要放慢自动化进程"
effects = Array[ExtResource("2_fx")]([SubResource("Fx2")])
result_text = "（结果由 event_112_cyber_attack.gd 动态生成）"

[resource]
script = ExtResource("4_def")
event_id = "event_112"
source_event_number = 112
trigger_priority = 11200
title = "来自0和1的冲击"
description = "主席同志，怪事发生了!全国各地的部门间组织都失败了。基层企业之间的信息被破坏，食品被运送到有中断的地区，商店里的队伍越来越长。根据管理者们的保证，我们的设备遭到了来自外部的计算机攻击。情报机构认为，这些人是我们的外部对手，担心我们在世界舞台上的影响力不可避免地增长，所以他们与自动化的敌人合谋，他试图通过破坏IECS来打击我们的经济。如果我们仍然无所作为，这将导致我们国家的崩溃。专家建议为我们的规划系统开发特殊保护，但这需要一些时间。但是，我们可以请求苏联专家的支持，这将使我们能够迅速地使设备恢复运作。还是……自动化真的只是乌托邦吗?"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
