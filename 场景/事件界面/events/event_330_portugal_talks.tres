[resource]
script = ExtResource("4_def")
event_id = "event_330"
source_event_number = 330
trigger_priority = 33000
title = "对葡谈判"
description = "今天，我国代表团将会见葡萄牙代表团。这次会议非常重要，因此我们需要明确我们在谈判中的立场。我们可以采取中立立场，通过签署平平无奇的文件冷静地讨论些小问题。但或许我们应当步子迈大些，达成大规模贸易协定？与此同时，有些人主张澳门问题也应坚定地摆在台上说......"
