[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://数据脚本/event_option.gd" id="1_option"]
[ext_resource type="Script" path="res://数据脚本/effect_node.gd" id="2_effect"]
[ext_resource type="Script" path="res://数据脚本/expr_node.gd" id="3_expr"]
[ext_resource type="Script" path="res://数据脚本/event_def.gd" id="4_event"]
[ext_resource type="Script" path="res://数据脚本/事件效果/event_053_062_reform_and_alliances.gd" id="5_custom"]

[sub_resource type="Resource" id="Expr_date"]
script = ExtResource("3_expr")
type = 12
key = "1978.2"

[sub_resource type="Resource" id="Expr_no_war_result"]
script = ExtResource("3_expr")
type = 22
key = "war_resolve"
value = 2.0

[sub_resource type="Resource" id="Expr_east_red"]
script = ExtResource("3_expr")
type = 1
key = "political_line"
value = 1.0

[sub_resource type="Resource" id="Expr_new_words"]
script = ExtResource("3_expr")
type = 1
key = "political_line"
value = 2.0

[sub_resource type="Resource" id="Effect_custom"]
script = ExtResource("2_effect")
type = 18
custom_script = ExtResource("5_custom")

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("1_option")
text = "让我们选用改词版《义勇军进行曲》"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "恢复原版的《义勇军进行曲》"
disabled_text = "有些事情…宜粗不宜细"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "最响亮的歌是《东方红》，它将成为我国的正式国歌！"
disabled_text = "这首歌……实在不合适"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "我们怎能拘泥于眼前的这一切？英特纳雄耐尔，就一定要实现！"
disabled_text = "哪怕是对于我们党最为激进的左翼分子而言，这也太夸张了"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_4"]
script = ExtResource("1_option")
text = "《歌唱祖国》，这是一首怎么样都不会错的歌"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"

[sub_resource type="Resource" id="Option_5"]
script = ExtResource("1_option")
text = "鲜红的太阳永不落，这是首好歌哇"
effects = Array[ExtResource("2_effect")]([SubResource("Effect_custom")])
result_text = "（结果由事件脚本动态生成）"


[resource]
script = ExtResource("4_event")
event_id = "anthem_problem"
source_event_number = 61
trigger_priority = 6100
title = "起来，起来，起来！"
description = "主席同志，既然您决定正式的，以万分严肃的态度处理我国的国歌问题。那么，请现听我稍稍介绍一下我国国歌目前的问题。在我国建国前的政治协商会议上，我国就确立了以田汉作词，聂耳谱曲的《义勇军进行曲》作为代国歌。但并未以正式的法律程序确立其地位，五四宪法中也没有与国歌相关的内容。一切看起来都相对正常……直到无产阶级文化大革命波及到了田汉本人。田汉在文化大革命早期被打倒，因此，义勇军进行曲的歌词被删去，在公共场合一般之采用纯音乐。在造反派占优势的地区和特殊情况下，我国也会演奏赞颂毛泽东主席和共和国的歌曲《东方红》作为国歌。在1977年筹备第五届人大的时候，我国就国歌问题发动了全国各族人民进行大讨论，有许多富有创意的观点得到了讨论。目前我国现行的义勇军进行曲为改词版，在修改了部分歌词的前提下，额外强调了毛泽东主席以及他所缔造的中国共产党在革命中的贡献。同时，还有几份法案得到了人大的支持。其中包括恢复原版作词的义勇军进行曲；党内的左派支持正式确立《东方红》的国歌地位、而将《义勇军进行曲》改为代国歌；更有甚者认为我国有必要效仿苏维埃俄国，立足国内，放眼全球的革命共产主义运动，将《国际歌》确认为我国的正式国歌。当然，也有人支持按照我国的实际国情，对《歌唱祖国》进行改编；1977年所谱成的新歌《中国，鲜红的太阳永不落》也有不少支持者。主席同志，只要您确定好了大体方案，我们就会在下次的人大大会上对此表决。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_no_war_result")])
options = Array[ExtResource("1_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3"), SubResource("Option_4"), SubResource("Option_5")])
