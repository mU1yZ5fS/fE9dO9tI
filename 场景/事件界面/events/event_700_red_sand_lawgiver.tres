[resource]
script = ExtResource("4_def")
event_id = "event_700"
source_event_number = 700
trigger_priority = 70000
title = "红沙的立法者"
description = "法赫德临时内阁的崩溃似乎并不令人意外。随着沙特政府在一系列灾难性事件中接连失利并蒙受耻辱，本就缺乏法理基础的王室统治进一步削弱，不得不对过去不得人心的恶法进行修改，开始引入一些现代人权与言论自由制度的雏形，试图仿效邻国的“圣裔家族”现代化形象，为自身披上一层进步外衣。\n然而恶果早已种下，接连胜利的人民群众不可能会在这一时刻止步，更不愿放弃追究政权责任的机会。事实上，已经被严重削弱的沙特监守政府甚至经不起内部考验——王室成员们很快就因为各项装缀门庭的“进步”政策，严厉地指责起法赫德本人。最终，法赫德以“无法继续承担国家重任”为由辞去政府职务，离开了这个国家。但随后接手政务的王室委员会则更加软弱无能、内斗不休，而愤怒的群众使其法令几乎难以推行。\n在这场僵局持续数月后，一位长期处于边缘位置的王室成员被推举出来——塔拉勒王子。他是沙特家族里少数具有进步思想的成员，曾在五六十年代成立了“自由亲王”组织，与纳赛尔的阿拉伯民族主义形成呼应。尽管该组织中的许多王室成员更像是投机客，但就塔拉勒本人而言，他较为真诚地支持改革——他与前石油部长，一位进步的民族主义者阿不杜拉·塔里基私交不错，并出资设立了许多改良性的公益机构。因此，他最终被众王室子弟推举为新的“代理首相”，既是为了消除人民的怒火，也是为了让一个边缘角色来承担潜在的主要责任。\n作为一位被临时推上前台的执政者，塔拉勒政府似乎面临两种选择。第一种选择是温和而稳妥的路径：实施有限程度的自由化改革，聘请西方顾问，尝试模仿西方式的君主立宪体制，从而最大限度上保住王室内部的忠诚，同时在短期内满足大部分民众的诉求。而第二个选项更加危险，却可能更有利于国家未来：即真正意义上与反对派合作，从阿拉伯世界追求复兴与进步的现实需求出发，实施结构性改革——与东部什叶派、老朋友塔里基与穆斯塔法·瓦赫巴（现已转变为共产主义立场），甚至是这个国家最激烈的、社会主义倾向的反对者——流放在外的纳西尔·赛义德开展合作，共建一个民主、进步、开明的新阿拉伯半岛？但问题是，他做了这一切后，王室本身的存在意义在何处？他们又将何去何从？"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
