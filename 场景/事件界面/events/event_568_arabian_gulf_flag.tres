[resource]
script = ExtResource("4_def")
event_id = "event_568"
source_event_number = 568
trigger_priority = 56800
title = "阿拉伯湾旗帜飘"
description = "随着阿湾人阵在我们的持续支持下在游击战争中获得的优势，尽管君主们都在帝国主义的援助下竭力开展改革，并用发放免费物资贿赂人民，期望以此消解人民的斗争，但他们的算盘并没有如他们的意——整个阿拉伯湾陷入到内乱之中了，在帝国主义的支持下，阿拉伯湾的各个君主国不得不开展全面动员，对阿湾人阵展开全面的战争，而沙特也自然意识到了唇亡齿寒的道理，他们直接向海湾各君主国派出了军队，宣称“将帮助友邦开展维和行动”。阿湾人阵也宣布要基于现有的根据地，开展“全阿拉伯湾的暴动”。阿拉伯湾的革命进入了新的阶段。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0")])
