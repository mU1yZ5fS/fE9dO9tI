result_text = "（结果由 event_300_vietnam_war.gd 动态生成）"

[sub_resource type="Resource" id="Opt3"]
script = ExtResource("1_opt")
text = "愿毛泽东的核太阳升起！"
disabled_text = "哪怕是为了对抗修正主义者，我们也不会先发动核打击"
enable_condition = SubResource("Expr_faction0")
effects = Array[ExtResource("2_fx")]([SubResource("Fx3")])
result_text = "（结果由 event_300_vietnam_war.gd 动态生成）"

[resource]
script = ExtResource("4_def")
event_id = "event_300"
source_event_number = 300
trigger_priority = 30000
title = "越南战争"
description = "我们的部队能够在边境冲突中击败敌人，并开始向内陆推进，但我们走得越远，面临的问题就越多。越军成功地利用了不可逾越的地形优势，在已经占领的地区，解放军不得不对付积极破坏我们补给线的游击队。部分军队领导层和党员主张，应立即停止军事行动，并隐瞒事态。另一派则建议联系联合国，与越南谈判让步，以换取我们停止进攻行动和撤军。然而，我们可以继续进攻，我们有巨大的动员潜力，我们在人力和武器上超过越南，如果我们定期向前线增援，我们迟早会粉碎他们的防御。然而，你现在可以用核打击来结束一切，即使这样做的后果将是真正的灾难。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_done56"), SubResource("Expr_result56_1"), SubResource("Expr_war_eq1"), SubResource("Expr_year_ge1979"), SubResource("Expr_month_ge3")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3")])
