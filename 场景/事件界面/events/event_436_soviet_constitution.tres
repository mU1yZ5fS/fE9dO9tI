[resource]
script = ExtResource("4_def")
event_id = "event_436"
source_event_number = 436
trigger_priority = 4360
title = "《苏联1977年宪法》"
description = "早在1962年，苏联便已经开始筹备制定一部新宪法。不过，在长达数十年的时间内。制宪进度都同现在苏联的领导层换届般缓慢。直到1977年3月，在苏联领导人列昂尼德·勃列日涅夫的亲自过问下，这一进程才得以回归正轨。同年4月初，康斯坦丁·契尔年科被指派去完成宪法的最终修订。很快，政治局便建议最高苏维埃将法案推上前台，并在同时修改苏联国歌歌词（自赫鲁晓夫对斯大林拨乱反正后，这首歌便被改为无词演奏）。经由全国范围内的大讨论，并获得了来自民众的800多万条意见后；全篇为174条法案构成的《宪法》内，有117条草案被修改。《1977年宪法》就此大功告成。该宪法巩固了苏联实行的一党制（即宪法第六款，对苏共领导作用的描述），但也在同时引入了许多具有进步意义的改变：劳动集体将被视为合法群众组织，国家宣布保障居民免费接受医疗保障、免费住房，到享受各类文化成就、自由接受各类教育（包括夜校与自学）等方面的权利。同时，宪法还首次规定了全国讨论与全民公投等“直接民主”形式。公民权方面也得到了扩充：苏联公民有对官员行为提出上诉的权利，其人身荣誉与尊严也得到司法保护。苏联公民的劳动权也被大大扩充，现在，该国公民享有择业自由、工作自由，并将在考虑公民的出行、能力、技术训练水平、教育水平与公众需要的情况下的匹配岗位。同时，宪法还对公民在保护自然环境、历史古迹和文化遗产上提出了新要求，并赋予了其促进与其他国家人民间互惠合作，推动世界和平事业的国际义务。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
