[resource]
script = ExtResource("4_def")
event_id = "event_022"
source_event_number = 22
trigger_priority = 2200
title = "天安门事件"
description = "中国共产党对周恩来纪念运动的多次压制反而在人民群众里引起了反对。在正值清明节的四月四日，北京市民带着纪念周恩来的挽联走进天安门广场到人民英雄纪念碑前。日落前有大约二百万人前来悼念，挽联堆了二十米高。此时中共中央政治局紧急会议在毛主席主持下召开，会议通过了镇压游行的决议，你和北京市长吴德被要求督办此事。趁夜你清理了挽联，但是第二天早上来继续悼念的人民要求归还它们，同时已经有人号召推翻毛泽东与江青的领导并回到真正的马克思列宁主义革命路线上来。你准备在事态难以控制后镇压，而汪东兴和叶剑英要求你尽快下令驱散群众。但是四人帮和吴德看起来并不想动手，而是希望以和平的方式解决。但无论如何，决定权在你。"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2")])
