[resource]
script = ExtResource("4_def")
event_id = "event_537"
source_event_number = 537
trigger_priority = 53700
title = "一月风暴"
description = "国际局势的变化与欧美的新一轮经济危机让高度依赖西方市场的日本经济愈发动荡。政府试图进行宏观调控（措施包括剥离大企业的不良资产、推行新货币政策等）以挺过危机，但一波未平一波又起，无数新问题接踵而至：企业亏损致使大批工人被裁，农产品销售额下跌导致旧的农协体制全面告急，缺乏资金设备和工具的农民纷纷涌入城市，这又使得城市压力成几何倍数上涨。为了安抚他们的情绪，政府不得不颁布福利政策，而对多个行业开征新税或上调税率以填补新政策所需资金缺口的行为又彻底惹恼了早就满腹怨言的市民阶层。很快日本多地均爆发了规模不等的游行，新的风暴正在酝酿之中。\n得益于长期的积极活动，日本共产主义抵抗者同盟已经成功“打入”日本共产党之中并开始互相配合：宫本显治的追随者被不断从各级分部中驱逐出去，取代他们位置的则是同盟这段时间以来发展的新成员，共产主义抵抗者同盟的影响力也越来越大。而等到宫本显治等人察觉这一点时，同盟已经成功在各级委员会均成为了多数。最终在一次短暂的中央会议之后，他与其他右派分子均被开除出党。很快，日本共产党便改名为日本社会主义工人党。\n主席同志，现在是难得的时间窗口！日本现政府已经摇摇欲坠，而美国因为总统换届以及欧洲的糟糕局势尚未出手干预日本事务。我们必须尽快援助日本同志掀起新的运动浪潮。否则一切就都太迟了！"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_1"), SubResource("Expr_2"), SubResource("Expr_3"), SubResource("Expr_7"), SubResource("Expr_8"), SubResource("Expr_12"), SubResource("Expr_13"), SubResource("Expr_14"), SubResource("Expr_15"), SubResource("Expr_16"), SubResource("Expr_17"), SubResource("Expr_18")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
