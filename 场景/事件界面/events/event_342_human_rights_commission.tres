[resource]
script = ExtResource("4_def")
event_id = "event_342"
source_event_number = 342
trigger_priority = 34200
title = "人权委员会"
description = "在我国在联合国获得其应有的地位后，有人提议我国加入人权委员会。当然，人权是很重要，是我们珍视保护之物，但这些国际机构里面大多是亲西方的吹牛皮代表......我们可以简简单单地加入他们，走与西方和解的道路，或者我们可以带有挑衅意味地拒绝该提议，以此博得众多帝国主义暴政受害者的支持！"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date1")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
