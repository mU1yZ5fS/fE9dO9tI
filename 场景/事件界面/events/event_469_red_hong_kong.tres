[resource]
script = ExtResource("4_def")
event_id = "event_469"
source_event_number = 469
trigger_priority = 46900
title = "红色香江"
description = "在1967年5月7日，距今约十五年，由九龙一家胶花厂的劳资纠纷发展而成的震动整个香港的五月风暴。香港的同志们一直坚持了七个多月，我们也曾为他们的斗争进行倾力援助。然而，随着抗英斗争的激化，香港的左派愈发开始倾向于与港英当局进行公开斗争，甚至于通过炸弹恐怖袭击的方式来对抗港英当局的反动镇压。最终，在时任总理周恩来的直接命令下，香港的左派同志最终停止了这场抵抗英国暴政的活动。\n现在，随着英国在马岛战争的失利，日不落帝国正在走向落幕。部分同志已经开始提出要重启对香港同志们的援助。这无疑是一个耗资巨大且短时间内不一定看到成效的事情，却能在很大程度上向世界展示我们对固有领土和世界革命的态度，但一些不那么激进党员有所顾虑，认为这么做会严重损害我们和西方世界的外交关系。又或者说，我们应该用更稳妥的方式来处理港澳问题?"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_brit_lost"), SubResource("Expr_hk_status"), SubResource("Expr_root")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1")])
