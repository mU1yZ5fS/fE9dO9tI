[resource]
script = ExtResource("4_def")
event_id = "event_493"
source_event_number = 493
trigger_priority = 49300
title = "我们需要石油？"
description = "随着我国工业的飞速发展，另一项问题开始浮出水面：我国的石油储量越显尴尬。工业的运转需要石油的润滑，一旦石油储备见底，我们所遇到的危机可能就不只是工厂停工了。为此，我们的委员会出台了一些方案。我们可以采购更新更好的开采工具，也可以发动“石油会战”来鼓舞我们的石油工人。或者直接买外国人的会更好？无论如何，决定权在您的手上！"
display_script = ExtResource("5_custom")
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_opt")]([SubResource("Opt0"), SubResource("Opt1"), SubResource("Opt2"), SubResource("Opt3"), SubResource("Opt4")])
