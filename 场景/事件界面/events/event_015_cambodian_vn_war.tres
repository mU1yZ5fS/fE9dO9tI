[resource]
script = ExtResource("4_event")
event_id = "cambodian_vietnam_war"
source_event_number = 15
title = "柬越战争"
description = "越共对印度支那地区的共产主义运动一直存在“老子党”情结——老挝党和早期的柬埔寨党一直都处于越南的控制之下。而高棉劳动党在重建以来一直在执行独立路线，和“听话的”老挝截然不同，这令越南很不高兴——越共一直想恢复对柬埔寨共产党的控制，建立一个统一的社会主义印支。看起来越南的耐心也到头了——最近越南军队对柬埔寨发起了全面侵略，以推翻民主柬埔寨政权，利用包括高棉左翼异见者和流亡的亲越派的柬埔寨民族救亡阵线作为掩盖。考虑到民主柬埔寨一直是我们忠实的盟友，帮助他们是有价值的。"
trigger_conditions = Array[ExtResource("3_expr")]([SubResource("Expr_date"), SubResource("Expr_no_vietnam_peace")])
show_notification = false
fire_only_once = true
options = Array[ExtResource("1_option")]([SubResource("Opt0"), SubResource("Opt1")])
