[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://数据脚本/ui/调试控制台.gd" id="1_console"]

[node name="调试控制台" type="CanvasLayer"]
visible = false
layer = 100
process_mode = 3
script = ExtResource("1_console")

[node name="背景遮罩" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.35)

[node name="居中" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="面板" type="PanelContainer" parent="居中"]
custom_minimum_size = Vector2(900, 600)
layout_mode = 2

[node name="布局" type="VBoxContainer" parent="居中/面板"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="标题栏" type="HBoxContainer" parent="居中/面板/布局"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="标题" type="Label" parent="居中/面板/布局/标题栏"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 30
text = "调试控制台"

[node name="关闭" type="Button" parent="居中/面板/布局/标题栏"]
layout_mode = 2
text = "关闭"

[node name="输出" type="RichTextLabel" parent="居中/面板/布局"]
custom_minimum_size = Vector2(860, 480)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true
text = "欢迎使用调试控制台。输入 help 查看命令。"

[node name="输入行" type="HBoxContainer" parent="居中/面板/布局"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="输入" type="LineEdit" parent="居中/面板/布局/输入行"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "输入命令，help 查看帮助"

[node name="执行" type="Button" parent="居中/面板/布局/输入行"]
layout_mode = 2
text = "执行"

[connection signal="pressed" from="居中/面板/布局/标题栏/关闭" to="." method="_on_关闭_pressed"]
[connection signal="pressed" from="居中/面板/布局/输入行/执行" to="." method="_on_执行_pressed"]
