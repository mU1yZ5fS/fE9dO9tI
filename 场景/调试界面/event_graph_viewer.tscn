[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.06, 0.09, 1)

[node name="Root" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Root"]
layout_mode = 2

[node name="TopBar" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Root/VBox/TopBar"]
layout_mode = 2
text = "事件拓扑图"

[node name="Filter" type="LineEdit" parent="Root/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "全文过滤：编号 / ID / 标题 / 条件 / 选项 / 效果…"

[node name="GateChk" type="CheckBox" parent="Root/VBox/TopBar"]
layout_mode = 2
tooltip_text = "只列带门槛提示（🔒）选项的事件"
text = "含门槛"

[node name="ScriptChk" type="CheckBox" parent="Root/VBox/TopBar"]
layout_mode = 2
tooltip_text = "只列走 CUSTOM_SCRIPT 动态结果的事件"
text = "含脚本"

[node name="AuditBtn" type="Button" parent="Root/VBox/TopBar"]
layout_mode = 2
tooltip_text = "全项目扫描解析失败的事件引用（迁移 QA）"
text = "审计悬空引用"

[node name="RefreshBtn" type="Button" parent="Root/VBox/TopBar"]
layout_mode = 2
tooltip_text = "重跑全部事件的实时条件判定（游戏内有效）"
text = "刷新状态"

[node name="ClearBtn" type="Button" parent="Root/VBox/TopBar"]
layout_mode = 2
text = "清空画布"

[node name="CloseBtn" type="Button" parent="Root/VBox/TopBar"]
layout_mode = 2
text = "返回主菜单"

[node name="Main" type="HSplitContainer" parent="Root/VBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 300

[node name="LeftPanel" type="VBoxContainer" parent="Root/VBox/Main"]
layout_mode = 2
