[node name="Right" type="VSplitContainer" parent="Root/VBox/Main"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Graph" type="GraphEdit" parent="Root/VBox/Main/Right"]
layout_mode = 2
size_flags_vertical = 3
