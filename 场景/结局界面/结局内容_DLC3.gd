## 结局内容 批D3 — DLC 第三面板 Ending17..23 的 TextOfEnding 中文分支。
## 源码出处：Assets/Scripts/Ending17.cs~Ending23.cs（每个函数注释标注行号段）。
## 文案出处：Assets/Resources/Events_text_en.txt 按行 split（new_events_text[i] = 文件第 i+1 行），
##   全部下标已并入 结局内容_基础.gd 的 NEW_EVENTS_TEXT，本文件统一经 _net(i) 读取；
##   GameObject.Find("Ach(Clone)") 无效果忽略；text ?? "" 空值保护忽略；Update() 滚动不迁移。
extends "res://场景/结局界面/结局内容_基础.gd"


## 原版 allcountries[N].dev（Country.dev）。c() 为 null 时返回哨兵值，使 dev<=0 / dev==X 按不满足处理。
func _dev(w: WorldState, idx: int) -> int:
	var cc := c(w, idx)
	return cc.development if cc != null else 2147483647


## 原版 allcountries[N].inflCh（Country.inflCh）。null 时返回 0。
func _infl_ch(w: WorldState, idx: int) -> int:
	var cc := c(w, idx)
	return cc.influence_china if cc != null else 0


## 原版 empires[i].now_leader；empire 缺失时返回 -1（不满足任何 == 比较）。
func _emp_leader(w: WorldState, idx: int) -> int:
	var e := emp(w, idx)
	return e.current_leader if e != null else -1


## panel: 1=FirstDLC 2=SecondDLC 3=ThirdDLC；page 为面板内页码（0 起）。不属于本面板返回 {}。
func try_build_dlc(panel: int, page: int, w: WorldState) -> Dictionary:
	if panel != 3:
		return {}
	match page:
		0:
			return _ending_17(w)
		1:
			return _ending_18(w)
		2:
			return _ending_19(w)
		3:
			return _ending_20(w)
		4:
			return _ending_21(w)
		5:
			return _ending_22(w)
		6:
			return _ending_23(w)
	return {}


