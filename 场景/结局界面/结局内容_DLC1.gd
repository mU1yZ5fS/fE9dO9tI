## panel: 1=FirstDLC 2=SecondDLC 3=ThirdDLC；page 为面板内页码（0 起）。不属于本面板返回 {}。
func try_build_dlc(panel: int, page: int, w: WorldState) -> Dictionary:
	if panel != 1:
		return {}
	match page:
		0:
			return _ending_1(w)
		1:
			return _ending_2(w)
		2:
			return _ending_3(w)
		3:
			return _ending_4(w)
		4:
			return _ending_5(w)
		5:
			return _ending_6(w)
		6:
			return _ending_7(w)
		7:
			return _ending_8(w)
	return {}


