## 领导人姓名：原版 names1 + names2 拼接；Godot 用显示全名（leader 为 null 时按空串，与原版未初始化语义一致）。
func _leader_name(w: WorldState) -> String:
	if w == null or w.leader == null:
		return ""
	return w.leader.name_display


## new_texts[i] 统一读取（NEW_TEXTS 优先，其次 NEW_TEXTS_EXTRA；未收录下标按空串）。
func _nt(i: int) -> String:
	if NEW_TEXTS.has(i):
		return NEW_TEXTS[i]
	if NEW_TEXTS_EXTRA.has(i):
		return NEW_TEXTS_EXTRA[i]
	return ""


## new_events_text[i] 统一读取；未收录下标按空串。
func _net(i: int) -> String:
	if NEW_EVENTS_TEXT.has(i):
		return NEW_EVENTS_TEXT[i]
	return ""


## C# string.Format 兼容：把 {0}/{1}/... 占位符按序替换为 args（支持同一参数复用，
## 与原版 string.Format("{0}{1}", names1, names2) 语义一致）。
func _fmt(fmt: String, args: Array) -> String:
	var out := fmt
	for i in args.size():
		out = out.replace("{%d}" % i, str(args[i]))
	return out
