## 接口：try_build_dlc(panel, page, w) -> {name, text}；panel!=2 返回 {}。page 0-6 → Ending10..16。
extends "res://场景/结局界面/结局内容_基础.gd"

const W = preload("res://数据脚本/world_state.gd")


## 原版 party_number[i] → Godot factions[i].support（faction_data.gd 已建模：support ≡ party_number）；越界/缺失按 0。
func _pn(w: WorldState, i: int) -> int:
	if w != null and i >= 0 and i < w.factions.size():
		var f: FactionData = w.factions[i]
		return f.support if f != null else 0
	return 0


## 原版 is_party_enabled[i] → Godot factions[i].is_enabled；越界/缺失按 false。
func _pe(w: WorldState, i: int) -> bool:
	if w != null and i >= 0 and i < w.factions.size():
		var f: FactionData = w.factions[i]
		return f != null and f.is_enabled
	return false


## 原版 empires[i].now_leader → Godot EmpireData.current_leader；empire 缺失按 -1（不满足任何领导分支）。
func _nl(w: WorldState, i: int) -> int:
	var e := emp(w, i)
	return e.current_leader if e != null else -1


## EndingSecondDLC：page 0-6 → Ending10..16（Ending.unity end1 数组顺序）。
func try_build_dlc(panel: int, page: int, w: WorldState) -> Dictionary:
	if panel != 2:
		return {}
	match page:
		0: return _ending_10(w)
		1: return _ending_11(w)
		2: return _ending_12(w)
		3: return _ending_13(w)
		4: return _ending_14(w)
		5: return _ending_15(w)
		6: return _ending_16(w)
	return {}


