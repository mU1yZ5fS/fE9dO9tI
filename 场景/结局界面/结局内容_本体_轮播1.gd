## 负责页 1-4；不属于本批返回 {}。页0 由主控调 build_good_end，本批不实现。
func try_build_page(page: int, w: WorldState) -> Dictionary:
	match page:
		1:
			return _page_1(w)
		2:
			return _page_2(w)
		3:
			return _page_3(w)
		4:
			return _page_4(w)
	return {}


## 原版 allcountries[N].dev（Country.dev 冷却/标记位）。基础层未提供 _cdev，
## 此处按 外交互动_批1.gd:1076 _cdev 同款实现。
func _dev(w: WorldState, idx: int) -> int:
	var cc := c(w, idx)
	return cc.development if cc != null else 0


## 原版 politics[politics_dolshnost[1]].name_1 + name_2（EndingScript.cs L1277-1278）；
## Godot 用 politicians/politics_positions + name_display 等价显示。
func _politics_slot_name(w: WorldState, slot: int) -> String:
	if w == null or w.politics_positions.size() <= slot:
		return ""
	var idx: int = w.politics_positions[slot]
	if idx < 0 or idx >= w.politicians.size() or w.politicians[idx] == null:
		return ""
	return w.politicians[idx].name_display


