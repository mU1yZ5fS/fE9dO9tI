## 原版 party_number[i] → Godot factions[i].support（faction_data.gd 已建模：support ≡ party_number）；越界/缺失按 0。
func _pn(w: WorldState, i: int) -> int:
	if w != null and i >= 0 and i < w.factions.size():
		var f: FactionData = w.factions[i]
		return f.support if f != null else 0
	return 0


